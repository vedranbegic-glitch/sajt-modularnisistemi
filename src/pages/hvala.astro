---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../data/siteData';

const canonicalURL = 'https://modularnisistemi.com/hvala/';
const pageTitle = 'Hvala na upitu';
const pageDescription = 'Vaš upit je primljen. Javićemo vam se u najkraćem roku.';

const koraci = [
  {
    num: '01',
    title: 'Pregled upita',
    text: 'Pregledamo vaš opis i priložene crteže ili skice.',
  },
  {
    num: '02',
    title: 'Predlog i predmer',
    text: 'Pripremamo predlog rešenja sa specifikacijom elemenata.',
  },
  {
    num: '03',
    title: 'Javljamo vam se',
    text: 'Pozivamo vas ili šaljemo ponudu na email koji ste ostavili.',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalURL} noindex={true}>
  <!--
    Ova stranica se učitava samo posle uspešnog slanja forme.
    Ovde se kasnije dodaje kod za merenje konverzija (Google Ads / Meta),
    npr. gtag('event', 'conversion', {...}).
  -->
  <div class="hvala-page">
    <section class="hero">
      <div class="hero__glow"></div>
      <div class="hero__grid"></div>

      <div class="hero__content wrap">
        <div class="check" aria-hidden="true">✓</div>

        <div class="eyebrow">
          <span></span>
          Upit je poslat
        </div>

        <h1>
          Hvala vam,<br />
          <em>upit je primljen.</em>
        </h1>

        <p class="hero__lead">
          Javićemo vam se u najkraćem roku. Ako je hitno, pozovite nas direktno.
        </p>

        <div class="hero__actions">
          <a class="btn btn--orange" href="/">
            Nazad na početnu <b>→</b>
          </a>
          <a class="btn btn--ghost" href="/proizvodi/">
            Pogledajte proizvode <b>↗</b>
          </a>
          <a class="btn btn--ghost" href={`tel:${CONTACT.phoneFormatted}`}>
            Pozovite: {CONTACT.phone} <b>↗</b>
          </a>
        </div>
      </div>
    </section>

    <section class="steps-section">
      <div class="wrap">
        <div class="eyebrow">
          <span></span>
          Šta sledi
        </div>
        <h2>Šta se dešava <em>posle slanja?</em></h2>

        <div class="steps-grid">
          {koraci.map((k) => (
            <div class="step-card">
              <span class="step-num">{k.num}</span>
              <h3>{k.title}</h3>
              <p>{k.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <style>
    .hvala-page {
      --navy: #06131f;
      --navy2: #0b1d2b;
      --orange: #ff6900;
      --orange-hover: #e85e00;
      --line: #dce2e7;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }

    .wrap {
      width: min(1280px, calc(100% - 40px));
      margin-inline: auto;
    }

    h1, h2, h3, p {
      margin: 0;
    }

    em {
      font-style: normal;
      color: var(--orange);
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .eyebrow span {
      display: inline-block;
      width: 20px;
      height: 2px;
      background: var(--orange);
      flex-shrink: 0;
    }

    .hero {
      position: relative;
      min-height: 520px;
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
      color: #fff;
      isolation: isolate;
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    .hero__glow {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 70% at 85% 20%, rgba(255, 105, 0, 0.16), transparent 70%),
        radial-gradient(ellipse 50% 60% at 10% 100%, rgba(255, 255, 255, 0.05), transparent 70%);
      z-index: -2;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(90deg, black, transparent 80%);
      -webkit-mask-image: linear-gradient(90deg, black, transparent 80%);
      z-index: -1;
    }

    .hero__content {
      padding-top: 120px;
      padding-bottom: 72px;
    }

    .check {
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
      border: 2px solid var(--orange);
      border-radius: 50%;
      color: var(--orange);
      font-size: 26px;
      font-weight: 800;
    }

    .hero h1 {
      margin-top: 18px;
      font-size: clamp(36px, 4.4vw, 56px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .hero__lead {
      margin-top: 20px;
      max-width: 560px;
      color: #d4dee4;
      font-size: 15px;
      line-height: 1.65;
    }

    .hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 32px;
    }

    .btn {
      min-height: 48px;
      padding: 0 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: all 0.25s ease;
    }

    .btn b {
      font-size: 15px;
      font-weight: 600;
    }

    .btn--orange {
      background: var(--orange);
      color: #fff;
      border: 1px solid var(--orange);
    }

    .btn--orange:hover {
      background: var(--orange-hover);
      border-color: var(--orange-hover);
      transform: translateY(-2px);
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
      background: rgba(0, 0, 0, 0.15);
    }

    .btn--ghost:hover {
      background: #fff;
      color: var(--navy);
      border-color: #fff;
    }

    .steps-section {
      padding: 80px 0;
      background: #f6f7f9;
      border-bottom: 1px solid var(--line);
    }

    .steps-section h2 {
      margin-top: 12px;
      font-size: clamp(28px, 3.2vw, 42px);
      line-height: 1.1;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #07111e;
    }

    .steps-grid {
      margin-top: 32px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .step-card {
      background: #fff;
      border: 1px solid var(--line);
      border-top: 3px solid var(--orange);
      border-radius: 2px;
      padding: 26px 22px 28px;
      box-shadow: 0 4px 16px rgba(6, 19, 31, 0.04);
    }

    .step-num {
      display: block;
      color: var(--orange);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.1em;
    }

    .step-card h3 {
      margin-top: 10px;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: #07111e;
    }

    .step-card p {
      margin-top: 10px;
      color: #55636e;
      font-size: 13.5px;
      line-height: 1.6;
    }

    @media (max-width: 980px) {
      .steps-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .wrap {
        width: min(100% - 24px, 1280px);
      }

      .hero {
        min-height: 0;
      }

      .hero__content {
        padding-top: 90px;
        padding-bottom: 48px;
      }

      .hero h1 {
        font-size: 32px;
      }

      .steps-section {
        padding: 56px 0;
      }

      .hero__actions .btn {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .btn {
        transition: none;
      }

      .btn--orange:hover {
        transform: none;
      }
    }
  </style>
</BaseLayout>
