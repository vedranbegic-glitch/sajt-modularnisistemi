---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../data/siteData';
const phoneHref = `tel:${(CONTACT.phoneFormatted || CONTACT.phone || '+38166241386').replace(/[^+\d]/g, '')}`;
const email = 'kontakt@modularnisistemi.com';
---
<BaseLayout title="Hvala na upitu" description="Hvala što ste kontaktirali Modularne Sisteme." noindex={true}>
  <div class="thank-you">
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">MODULARNI SISTEMI / POTVRDA UPITA</p>
          <div class="check" aria-hidden="true">✓</div>
          <h1>Hvala na poverenju.<br /><span>Upit je primljen.</span></h1>
          <p class="lead">Vaša poruka je uspešno poslata. Pregledaćemo informacije koje ste dostavili i javiti vam se radi dogovora o sledećim koracima.</p>
          <div class="actions"><a class="btn primary" href="/">Nazad na početnu <span aria-hidden="true">↗</span></a><a class="btn outline" href="/proizvodi/">Istražite proizvode <span aria-hidden="true">↗</span></a></div>
        </div>
        <aside class="study"><div class="study-top">MS / PROJECT STUDY <span>01 — 03</span></div><div class="study-body"><small>SLEDEĆI KORAK</small><strong>Razumevanje zadatka.<br /><em>Razrada rešenja.</em></strong></div><div class="study-bottom">RAZGOVOR / KONSTRUKCIJA / IZRADA <span>↗</span></div></aside>
      </div>
    </section>
    <section class="steps"><div class="wrap"><p class="eyebrow">NASTAVAK SARADNJE</p><h2>Šta sledi <span>nakon upita?</span></h2><div class="step-grid"><div><small>01 / PREGLED</small><h3>Razmotrićemo vaš zahtev</h3><p>Pregledaćemo opis i dokumentaciju koju ste nam dostavili.</p></div><div><small>02 / DOGOVOR</small><h3>Uskladićemo detalje</h3><p>Po potrebi ćemo zatražiti dodatne podatke radi jasnije razrade zadatka.</p></div><div><small>03 / REŠENJE</small><h3>Predložićemo sledeći korak</h3><p>Dogovorićemo dalji način saradnje u skladu sa prirodom projekta.</p></div></div></div></section>
    <section class="contact"><div class="wrap contact-grid"><div><p class="eyebrow">DIREKTNA KOMUNIKACIJA</p><h2>Imate dodatno pitanje?<br /><span>Tu smo za razgovor.</span></h2></div><div class="contact-actions"><a class="btn primary" href={phoneHref}>Pozovite nas <span aria-hidden="true">↗</span></a><a class="mail" href={`mailto:${email}`}>{email} ↗</a></div></div></section>
  </div>
  <style>
    .thank-you{color:#071e2a;--orange:#ff6900;overflow-x:clip}.wrap{width:min(1180px,calc(100% - 40px));margin-inline:auto}.hero{padding:78px 0 88px;background:linear-gradient(120deg,#061723,#082330);color:#fff}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:9%;align-items:center}.eyebrow{display:flex;align-items:center;gap:12px;color:#ff6900;font-size:10px;letter-spacing:.14em;font-weight:800;margin:0 0 22px}.eyebrow:before{content:"";width:22px;height:2px;background:#ff6900}.check{border:1px solid #ff6900;color:#ff6900;width:47px;height:47px;display:grid;place-items:center;font-size:26px;margin-bottom:22px}.hero h1{font-size:clamp(39px,4.4vw,62px);line-height:1.08;letter-spacing:-.055em;margin:0 0 20px}.hero h1 span,h2 span,.study em{color:#ff6900;font-style:normal}.lead{max-width:530px;font-size:15px;line-height:1.8;color:#b6c8d2}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:29px}.btn{min-height:44px;padding:0 19px;display:inline-flex;align-items:center;justify-content:space-between;gap:26px;text-decoration:none;font-size:12px;font-weight:800;border:1px solid transparent}.primary{background:#ff6900;color:#071e2a}.outline{border-color:#52707e;color:#fff}.btn:hover{filter:brightness(1.12)}.study{border:1px solid #274553;background:#0a2735;display:flex;flex-direction:column;min-height:245px}.study-top,.study-bottom{padding:15px 19px;color:#91adbb;font-size:10px;letter-spacing:.1em;display:flex;justify-content:space-between}.study-top{border-bottom:1px solid #274553}.study-bottom{margin-top:auto;border-top:1px solid #274553}.study-bottom span{color:#ff6900}.study-body{padding:29px 24px}.study-body small{color:#ff6900;font-size:10px;font-weight:800}.study-body strong{display:block;margin-top:18px;font-size:clamp(24px,2.6vw,35px);line-height:1.16;letter-spacing:-.03em}.steps{background:#f0f4f5;padding:70px 0}.steps h2,.contact h2{font-size:clamp(30px,3vw,43px);line-height:1.12;letter-spacing:-.045em;margin:0 0 30px}.step-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #cedce2}.step-grid>div{padding:27px 24px 24px 0;border-right:1px solid #d1dee4}.step-grid>div+div{padding-left:24px}.step-grid>div:last-child{border:0}.step-grid small{font-size:10px;color:#d75a11;font-weight:800}.step-grid h3{font-size:16px;margin:22px 0 10px}.step-grid p{color:#647e89;font-size:13px;line-height:1.7}.contact{background:#071e2a;color:#fff;padding:62px 0}.contact-grid{display:grid;grid-template-columns:1fr auto;align-items:center;gap:40px}.contact h2{margin-bottom:0}.contact-actions{display:grid;gap:12px}.mail{font-size:12px;color:#c5d6dd;text-decoration:none;border-bottom:1px solid #41606c;padding-bottom:11px}@media(max-width:760px){.hero-grid,.contact-grid{grid-template-columns:1fr}.study{min-height:200px}.step-grid{grid-template-columns:1fr}.step-grid>div,.step-grid>div+div{padding:21px 0;border-right:0;border-bottom:1px solid #d1dee4}.hero{padding:50px 0}.contact-actions{justify-items:stretch}}@media(max-width:500px){.wrap{width:calc(100% - 32px)}.actions .btn{width:100%}}
  </style>
</BaseLayout>
