---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE, CONTACT } from '../data/siteData';
import { PRODUCT_CATEGORIES_LIST } from '../data/products';

const breadcrumbItems = [
  { label: 'O nama' },
];
---

<BaseLayout
  title="O nama · Inženjerska preciznost i modularni sistemi"
  description="Ne prodajemo samo proizvod. Projektujemo rešenje prema prostoru. Saznajte više o inženjerskom pristupu brenda MODULARNI SISTEMI."
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Hero sekcija -->
  <section class="pt-14 pb-16 bg-navy bg-grid-pattern border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-navy-surface border border-accent/40 text-accent font-mono text-[11px] uppercase tracking-architectural font-bold">
          <span class="w-2 h-2 bg-accent inline-block" aria-hidden="true"></span>
          <span>Inženjering · Arhitektura · Modularity</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Tehnička preciznost.<br />
          Inženjerski pristup prostoru.
        </h1>

        <p class="text-base sm:text-lg text-accent font-mono font-bold pt-2">
          "{SITE.philosophy}"
        </p>

        <p class="text-sm sm:text-base text-slate-muted leading-relaxed">
          Specijalizovani smo za razvoj i proizvodnju preciznih modularnih sistema u oblastima linijskog i radijalnog inox odvodnjavanja, savremene arhitektonske rasvete i industrijskih podnih sistema.
        </p>
      </div>
    </div>
  </section>

  <!-- Glavni inženjerski manifest -->
  <section class="py-16 lg:py-24 bg-navy-dark border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-5">
          <SectionHeading
            eyebrow="Naša filozofija"
            title="Sistemi konfigurisani prema realnim zahtevima gradilišta"
          />

          <p class="text-xs sm:text-sm text-slate-muted leading-relaxed">
            Standardni serijski proizvodi često zahtevaju kompromise na objektu: sečenje profila, nepravilno lomljenje krivina, vidljive spojnice i rizik od curenja vode u slojeve izolacije.
          </p>

          <p class="text-xs sm:text-sm text-slate-muted leading-relaxed">
            <strong class="text-white">MODULARNI SISTEMI</strong> postavlja suprotan princip. Polazimo od geometrije vašeg crteža. Kroz saradnju sa arhitektama, konstruktivnim inženjerima i izvođačima definišemo dužine segmenata, radijuse i pozicije odvoda pre početka proizvodnje.
          </p>

          <div class="p-6 bg-navy border-l-2 border-accent border-y border-r border-white/10 space-y-2">
            <span class="text-xs font-mono uppercase tracking-architectural text-accent font-bold block">
              Suština modularnog razmišljanja
            </span>
            <p class="text-xs sm:text-sm text-white leading-relaxed italic">
              "Prefabrikovani elementi sa fabrički kontrolisanim tolerancijama omogućavaju brzu montažu bez improvizacija, uz postizanje monolitnog vizuelnog sklada u završnoj oblozi poda."
            </p>
          </div>
        </div>

        <!-- Arhitektonske vrednosti brenda -->
        <div class="lg:col-span-6 space-y-4">
          <div class="p-6 bg-navy border border-white/10 space-y-2">
            <span class="text-accent font-mono text-xs font-bold block">01 / GEOMETRIJSKO PRILAGOĐAVANJE</span>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider">Forma prati arhitekturu</h3>
            <p class="text-xs text-slate-muted leading-relaxed">
              Projektujemo pravolinijske kanale, radijalne segmente po meri i slot proreze koji precizno prate ivice bazena, fasada i popločanih platoa.
            </p>
          </div>

          <div class="p-6 bg-navy border border-white/10 space-y-2">
            <span class="text-accent font-mono text-xs font-bold block">02 / POUZDANOST MATERIJALA</span>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider">Otpornost na agresivna okruženja</h3>
            <p class="text-xs text-slate-muted leading-relaxed">
              Izrada od nerđajućeg čelika (AISI 304 i kiselootpornog AISI 316) garantuje dugovečnost u kontaktu sa bazenskom vodom, industrijskim tečnostima i solima.
            </p>
          </div>

          <div class="p-6 bg-navy border border-white/10 space-y-2">
            <span class="text-accent font-mono text-xs font-bold block">03 / SARADNJA SA STRUČNJACIMA</span>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider">Direktna inženjerska veza</h3>
            <p class="text-xs text-slate-muted leading-relaxed">
              Svaki upit preuzima inženjer koji analizira zadate padove, protoke i opterećenja, pripremajući specifikaciju spremnu za izvođenje.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Tri primarna sistema programa -->
  <section class="py-16 lg:py-24 bg-navy border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Proizvodni stubovi"
        title="Tri primarne kategorije sistema"
        subtitle="Sveobuhvatna inženjerska rešenja razvijena za stambene, komercijalne i javne prostore."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {PRODUCT_CATEGORIES_LIST.map((category, idx) => (
          <div class="p-8 bg-navy-surface border border-white/10 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <span class="text-accent font-mono text-xs font-bold block">
                PROGRAM 0{idx + 1}
              </span>
              <h3 class="text-xl font-bold text-white tracking-tight">
                {category.title}
              </h3>
              <p class="text-xs font-mono text-accent uppercase tracking-wider font-semibold">
                "{category.headline}"
              </p>
              <p class="text-xs text-slate-muted leading-relaxed">
                {category.description}
              </p>

              <div class="pt-4 border-t border-white/10 space-y-1.5">
                <span class="text-[10px] font-mono uppercase tracking-architectural text-slate-surface font-semibold block mb-2">
                  Karakteristike linije:
                </span>
                {category.highlights.slice(0, 3).map((item) => (
                  <div class="text-[11px] text-slate-surface flex items-start gap-2">
                    <span class="w-1.5 h-1.5 bg-accent mt-1 flex-shrink-0" aria-hidden="true"></span>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-4">
              <a
                href={category.slug}
                class="inline-flex items-center gap-2 text-xs uppercase tracking-architectural font-bold text-white hover:text-accent transition-colors"
              >
                <span>Saznajte više</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA sekcija -->
  <section class="py-16 bg-navy-dark bg-grid-pattern">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
      <span class="text-accent font-mono text-xs uppercase tracking-architectural font-bold block">
        Projektantski dijalog
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        Planirate nov objekat ili rekonstrukciju?
      </h2>
      <p class="text-xs sm:text-sm text-slate-muted max-w-xl mx-auto leading-relaxed">
        Povežite nas sa vašim projektantskim timom u ranoj fazi kako bismo zajednički definisali optimalne drenažne, svetlosne i podne linije.
      </p>
      <div class="pt-3 flex flex-col sm:flex-row justify-center items-center gap-4">
        <a
          href="/posaljite-projekat/"
          class="px-8 py-3.5 bg-accent hover:bg-accent-hover text-white text-xs uppercase tracking-architectural font-bold transition-all border border-accent"
        >
          Pošaljite nacrt na analizu
        </a>
        <a
          href={`tel:${CONTACT.phoneFormatted}`}
          class="px-8 py-3.5 bg-navy-surface hover:bg-white/10 text-white text-xs uppercase tracking-architectural font-bold border border-white/20 transition-all font-mono"
        >
          {CONTACT.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>