---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, CONTACT } from '../data/siteData';

const breadcrumbItems = [
  { label: 'O nama' },
];

const canonicalURL = 'https://modularnisistemi.com/o-nama/';
const pageTitle = 'O nama · Tehnička preciznost i inženjerski pristup | Modularni Sistemi';
const pageDescription = 'Ne prodajemo samo proizvod. Projektujemo rešenje prema prostoru. Saznajte više o inženjerskom pristupu brenda MODULARNI SISTEMI.';

// Hero slajder sa 3 slike koje se smenjuju na svake 3 sekunde
const heroSlides = [
  {
    src: '/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp',
    alt: 'Modularni sistemi — lučni inox kanal u pejzažnom parteru',
    position: 'center',
  },
  {
    src: '/images/rasveta/z-lampa-moderna-led-rasveta-za-dvoriste-ulicna-rasveta.webp',
    alt: 'Z lampa — moderna LED rasveta za dvorište i ulicu',
    position: '70% center',
  },
  {
    src: '/images/podovi/modularni-pod-terasa-kamene-staze-basta-2.webp',
    alt: 'Modularni podni sistemi — fabrički sklopljeni paneli za terase i partere',
    position: 'center',
  },
];

const stubovi = [
  {
    num: '01',
    title: 'Inox sistemi odvodnjavanja',
    headline: 'Precizno odvodnjavanje koje prati geometriju prostora.',
    description: 'Modularni inox kanali sa fabričkim padom i nivelirajućim stopama za ravne, lučne, kružne i S-forme partera.',
    image: '/images/inox/elipsasti-inox-kanal-za-odvodnjavanje.webp',
    slug: '/inox-sistemi-odvodnjavanja/',
    points: ['AISI 304 / 316 nerđajući čelik', 'Fabrički integrisan unutrašnji pad', 'Izrada prema crtežu projekta'],
  },
  {
    num: '02',
    title: 'Moderna rasveta',
    headline: 'Arhitektonska rasveta koja spaja funkciju i estetiku.',
    description: 'Arhitektonska Z-lampa u visinama od 3m, 4m i 5m sa IP65 zaštitom i podesivom LED snagom za javne i privatne eksterijere.',
    image: '/images/rasveta/z-lampa-dimenzije-visina-tehnicki-detalji.webp',
    slug: '/moderna-rasveta/',
    points: ['Tipske visine 3m, 4m i 5m', 'Podesiva LED snaga 50W – 100W', 'Pocinčana i plastificirana konstrukcija'],
  },
  {
    num: '03',
    title: 'Modularni podni sistemi',
    headline: 'Jedan sistem. Bezbroj mogućnosti. 4 završne obloge.',
    description: 'Prefabrikovani monoblok paneli 1x1m sa teleskopskim stopama za suvu montažu i trenutnu prohodnost na svakom terenu.',
    image: '/images/podovi/gres-premium-monoblok-keramika-1.webp',
    slug: '/modularni-podni-sistemi/',
    points: ['Teleskopske zglobne stope 4–12 cm', '100% suva montaža bez lepkova', 'Keramika, trava, deking i rešetka'],
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
  </Fragment>

  <div class="onama-page">
    <div class="wrap breadcrumbs-container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- HERO SEKCIJA (AUTOMATSKI SLAJDER SA 3 SLIKE) -->
    <section class="hero">
      <div class="hero__slides">
        {heroSlides.map((slide, i) => (
          <img
            class={`hero__slide ${i === 0 ? 'is-active' : ''}`}
            src={slide.src}
            alt={slide.alt}
            style={`object-position: ${slide.position};`}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))}
      </div>
      <div class="hero__shade"></div>
      <div class="hero__grid"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            Inženjering · Arhitektura · Modularnost
          </div>

          <h1>
            Tehnička preciznost.<br />
            <em>Inženjerski pristup prostoru.</em>
          </h1>

          <p class="hero__lead">
            Ne prodajemo samo proizvod. Projektujemo rešenje prema prostoru. 
            Specijalizovani smo za razvoj i proizvodnju preciznih modularnih sistema u oblastima 
            linijskog i radijalnog inox odvodnjavanja, savremene arhitektonske rasvete i monoblok podova.
          </p>

          <div class="hero__actions">
            <a class="btn btn--orange" href="/proizvodi/">
              Pogledajte sisteme <b>→</b>
            </a>
            <a class="btn btn--ghost" href="/posaljite-projekat/">
              Pošaljite nam projekat <b>↗</b>
            </a>
          </div>
        </div>

        <div class="hero__specs">
          <div>
            <strong>01 / PREFABRIKACIJA</strong>
            <span>Fabrički kontrolisane tolerancije</span>
          </div>
          <div>
            <strong>02 / MATERIJALI</strong>
            <span>AISI 304/316 i toplo pocinkovani čelik</span>
          </div>
          <div>
            <strong>03 / BEZ KOMPROMISA</strong>
            <span>Forma prati crtež, a ne obrnuto</span>
          </div>
          <div>
            <strong>04 / B2B PODRŠKA</strong>
            <span>Direktna veza sa inženjerskim timom</span>
          </div>
        </div>
      </div>

      <!-- Tačkice slajdera -->
      <div class="hero__dots" role="tablist" aria-label="Izbor slike">
        {heroSlides.map((_, i) => (
          <button
            type="button"
            class={`hero__dot ${i === 0 ? 'is-active' : ''}`}
            aria-label={`Slika ${i + 1}`}
            data-index={i}
          ></button>
        ))}
      </div>
    </section>

    <!-- INŽENJERSKI MANIFEST (DVE KOLONE) -->
    <section class="manifest-section">
      <div class="wrap manifest-grid">
        
        <!-- Leva kolona: Filozofija i citat -->
        <div class="manifest-left">
          <div class="eyebrow eyebrow--dark">
            <span></span>
            Naša filozofija
          </div>
          <h2>Sistemi konfigurisani prema <em>zahtevima gradilišta.</em></h2>
          
          <p class="manifest-desc">
            Standardni serijski proizvodi često nameću nepotrebne kompromise na terenu: 
            sečenje gotovih profila, nepravilno lomljenje krivina, vidljive spojnice i trajni 
            rizik od curenja vode u slojeve hidroizolacije.
          </p>
          
          <p class="manifest-desc">
            <strong>MODULARNI SISTEMI</strong> postavlja suprotan inženjerski princip. Polazimo direktno od geometrije vašeg crteža. Kroz saradnju sa arhitektama, konstruktivnim inženjerima i izvođačima definišemo dužine segmenata, radijuse i pozicije odvoda pre početka proizvodnje.
          </p>

          <div class="quote-box">
            <span class="quote-tag">Suština modularnog razmišljanja</span>
            <p>
              "Prefabrikovani elementi sa fabrički kontrolisanim tolerancijama omogućavaju brzu montažu bez improvizacija, uz postizanje monolitnog vizuelnog sklada u završnoj oblozi poda."
            </p>
          </div>
        </div>

        <!-- Desna kolona: 3 inženjerske vrednosti -->
        <div class="manifest-right">
          <div class="value-card">
            <span class="value-num">01 / GEOMETRIJSKO PRILAGOĐAVANJE</span>
            <h3>Forma prati arhitekturu</h3>
            <p>
              Projektujemo pravolinijske kanale, radijalne segmente po meri i slot proreze koji precizno prate ivice bazena, fasada i popločanih platoa.
            </p>
          </div>

          <div class="value-card">
            <span class="value-num">02 / POUZDANOST MATERIJALA</span>
            <h3>Otpornost na agresivna okruženja</h3>
            <p>
              Izrada od sertifikovanog nerđajućeg čelika (AISI 304 i kiselootpornog AISI 316) garantuje dugovečnost u kontaktu sa bazenskom vodom, industrijskim tečnostima i solima.
            </p>
          </div>

          <div class="value-card">
            <span class="value-num">03 / SARADNJA SA STRUČNJACIMA</span>
            <h3>Direktna inženjerska veza</h3>
            <p>
              Svaki upit preuzima inženjer koji analizira zadate padove, protoke i opterećenja, pripremajući 2D/3D specifikaciju spremnu za izvođenje.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- PROIZVODNI STUBOVI (3 KARTICE SA SLIKAMA) -->
    <section class="pillars-section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Proizvodni stubovi
            </div>
            <h2>Tri primarne kategorije <em>sistema.</em></h2>
          </div>
          <p>
            Sveobuhvatna inženjerska rešenja razvijena za stambene, komercijalne i javne prostore.
          </p>
        </div>

        <div class="pillars-grid">
          {stubovi.map((item) => (
            <article class="pillar-card">
              <div class="pillar-card__image">
                <img src={item.image} alt={item.title} loading="lazy" />
                <span>0{item.num}</span>
              </div>
              <div class="pillar-card__body">
                <div class="pillar-card__tag">Program {item.num}</div>
                <h3>{item.title}</h3>
                <p class="pillar-card__headline">"{item.headline}"</p>
                <p class="pillar-card__desc">{item.description}</p>
                
                <ul class="pillar-card__points">
                  {item.points.map((pt) => (
                    <li>
                      <span class="bullet"></span>
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>

                <a href={item.slug} class="pillar-card__link">
                  Saznajte više <b>→</b>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA BANER IZNAD FOOTERA -->
    <section class="cta">
      <img
        src="/images/inox/cta-parter-zardinjera.webp"
        alt="Planirate nov objekat ili rekonstrukciju?"
        loading="lazy"
      />
      <div class="cta__shade"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Projektantski dijalog
          </div>
          <h2>Planirate nov objekat <em>ili rekonstrukciju?</em></h2>
          <p>
            Povežite nas sa vašim projektantskim timom u ranoj fazi kako bismo zajednički 
            definisali optimalne drenažne, svetlosne i podne linije bez improvizacija na terenu.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--orange" href="/posaljite-projekat/">
            Pošaljite nacrt na analizu <b>→</b>
          </a>
          <a class="btn btn--ghost" href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`}>
            Pozovite: {CONTACT.phone || '066 241 386'} <b>↗</b>
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #f6f7f9;
      color: #07111e;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .onama-page {
      --navy: #06131f;
      --navy2: #0b1d2b;
      --orange: #ff6900;
      --orange-hover: #e85e00;
      --line: #dce2e7;
      --muted: #64717c;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }

    .wrap {
      width: min(1280px, calc(100% - 40px));
      margin-inline: auto;
    }

    .breadcrumbs-container {
      padding-top: 14px;
      padding-bottom: 14px;
    }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      min-height: 640px;
      background: var(--navy);
      color: #fff;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
    }

    .hero__slides {
      position: absolute;
      inset: 0;
      z-index: -3;
    }

    .hero__slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 1s ease;
    }

    .hero__slide.is-active {
      opacity: 1;
    }

    .hero__shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(105deg, rgba(6, 19, 31, 0.95) 0%, rgba(6, 19, 31, 0.85) 38%, rgba(6, 19, 31, 0.4) 68%, rgba(6, 19, 31, 0.1) 100%),
        linear-gradient(0deg, rgba(6, 19, 31, 0.75) 0%, transparent 48%);
      z-index: -2;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(90deg, black, transparent 68%);
      z-index: -1;
    }

    .hero__content {
      padding-top: 100px;
      padding-bottom: 56px;
      display: grid;
      grid-template-columns: minmax(0, 720px) 1fr;
      gap: 50px;
      align-items: end;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .eyebrow span {
      display: inline-block;
      width: 20px;
      height: 2px;
      background: var(--orange);
      flex-shrink: 0;
    }

    .eyebrow--dark {
      color: var(--orange);
    }

    h1, h2, h3, p {
      margin: 0;
    }

    .hero h1 {
      margin-top: 18px;
      max-width: 860px;
      font-size: clamp(36px, 4.4vw, 56px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .hero h1 em,
    .manifest-left h2 em,
    .section-head h2 em,
    .cta h2 em {
      font-style: normal;
      color: var(--orange);
    }

    .hero__lead {
      margin-top: 20px;
      max-width: 620px;
      color: #d4dee4;
      font-size: 15px;
      line-height: 1.65;
    }

    .hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 32px;
    }

    /* Tačkice slajdera */
    .hero__dots {
      position: absolute;
      right: max(20px, calc((100% - 1280px) / 2));
      bottom: 24px;
      display: flex;
      gap: 8px;
      z-index: 3;
    }

    .hero__dot {
      width: 28px;
      height: 4px;
      padding: 0;
      border: 0;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.35);
      cursor: pointer;
      transition: background 0.3s ease, width 0.3s ease;
    }

    .hero__dot:hover {
      background: rgba(255, 255, 255, 0.7);
    }

    .hero__dot.is-active {
      width: 44px;
      background: var(--orange);
    }

    .hero__dot:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__slide { transition: none; }
    }

    .btn {
      min-height: 48px;
      padding: 0 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn b {
      font-size: 15px;
      font-weight: 600;
    }

    .btn--orange {
      background: var(--orange);
      color: #fff;
      border: 1px solid var(--orange);
    }

    .btn--orange:hover {
      background: var(--orange-hover);
      border-color: var(--orange-hover);
      transform: translateY(-2px);
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
      background: rgba(0, 0, 0, 0.15);
    }

    .btn--ghost:hover {
      background: #fff;
      color: var(--navy);
      border-color: #fff;
    }

    .hero__specs {
      border-left: 1px solid rgba(255, 255, 255, 0.2);
      padding-left: 28px;
      display: grid;
      gap: 20px;
    }

    .hero__specs strong {
      font-size: 14px;
      letter-spacing: 0.03em;
      font-weight: 700;
      color: #fff;
    }

    .hero__specs span {
      margin-top: 4px;
      color: #94a3ad;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }

    /* ========== MANIFEST (DVE KOLONE) ========== */
    .manifest-section {
      padding: 80px 0;
      background: #fff;
      border-bottom: 1px solid var(--line);
    }

    .manifest-grid {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: 50px;
      align-items: start;
    }

    .manifest-left h2 {
      margin-top: 12px;
      font-size: clamp(28px, 3.2vw, 42px);
      line-height: 1.1;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #07111e;
    }

    .manifest-desc {
      margin-top: 16px;
      font-size: 14.5px;
      line-height: 1.65;
      color: #55636e;
    }

    .manifest-desc strong {
      color: #07111e;
    }

    .quote-box {
      margin-top: 28px;
      padding: 24px;
      background: #f6f7f9;
      border-left: 3px solid var(--orange);
      border-radius: 2px;
    }

    .quote-tag {
      display: block;
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .quote-box p {
      font-size: 13.5px;
      line-height: 1.6;
      font-style: italic;
      color: #07111e;
    }

    .manifest-right {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .value-card {
      background: #f6f7f9;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 24px;
      transition: all 0.25s ease;
    }

    .value-card:hover {
      border-color: var(--orange);
      background: #fff;
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(6, 19, 31, 0.05);
    }

    .value-num {
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: block;
      margin-bottom: 6px;
    }

    .value-card h3 {
      font-size: 16px;
      font-weight: 800;
      color: #07111e;
      letter-spacing: -0.01em;
      text-transform: uppercase;
    }

    .value-card p {
      margin-top: 8px;
      font-size: 13px;
      line-height: 1.55;
      color: #55636e;
    }

    /* ========== PILLARS (3 KARTICE) ========== */
    .pillars-section {
      padding: 80px 0;
      background: #eef1f4;
      border-bottom: 1px solid var(--line);
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 36px;
      margin-bottom: 36px;
    }

    .section-head > div {
      max-width: 680px;
    }

    .section-head > p {
      max-width: 360px;
      padding-bottom: 4px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.6;
    }

    .section-head h2 {
      margin-top: 12px;
      font-size: clamp(30px, 3.4vw, 46px);
      line-height: 1.02;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #07111e;
    }

    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .pillar-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 2px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.3s ease;
      box-shadow: 0 4px 16px rgba(6, 19, 31, 0.04);
    }

    .pillar-card:hover {
      transform: translateY(-5px);
      border-color: var(--orange);
      box-shadow: 0 16px 36px rgba(6, 19, 31, 0.1);
    }

    .pillar-card__image {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      background: #06131f;
    }

    .pillar-card__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .pillar-card:hover .pillar-card__image img {
      transform: scale(1.05);
    }

    .pillar-card__image span {
      position: absolute;
      left: 12px;
      top: 12px;
      color: #fff;
      background: var(--orange);
      font-size: 11px;
      font-weight: 800;
      padding: 4px 8px;
      letter-spacing: 0.04em;
      z-index: 2;
    }

    .pillar-card__body {
      padding: 24px 22px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .pillar-card__tag {
      color: var(--orange);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .pillar-card h3 {
      margin-top: 6px;
      font-size: 17px;
