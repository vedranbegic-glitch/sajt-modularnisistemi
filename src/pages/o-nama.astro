---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../data/siteData';

const canonicalURL = 'https://modularnisistemi.com/o-nama/';
const pageTitle = 'O nama · Inženjerski pristup';
const pageDescription = 'Ne prodajemo samo proizvod. Projektujemo rešenje prema prostoru. Saznajte više o inženjerskom pristupu brenda MODULARNI SISTEMI.';
const ogImage = '/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp';

const koraci = [
  {
    num: '01',
    title: 'Upit i crtež',
    text: 'Pošaljete nam crtež, skicu ili samo opis prostora. Dovoljno je da znamo šta gradite i šta vam je potrebno.',
  },
  {
    num: '02',
    title: 'Inženjerska analiza',
    text: 'Naš inženjer pregleda zadate dimenzije, padove i opterećenja i predlaže rešenje prilagođeno vašem objektu.',
  },
  {
    num: '03',
    title: 'Fabrička izrada',
    text: 'Elementi se izrađuju prema usvojenom crtežu, sa kontrolisanim tolerancijama, kako bi se na terenu montirali bez improvizacije.',
  },
  {
    num: '04',
    title: 'Montaža i podrška',
    text: 'Tokom ugradnje ostajemo na raspolaganju izvođaču i projektantu za sva pitanja i dopune.',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalURL}
  ogImage={ogImage}
>
  <div class="onama-page">
    <!-- HERO SEKCIJA (BEZ SLIKA, AKCENAT NA TEKSTU) -->
    <section class="hero">
      <div class="hero__glow"></div>
      <div class="hero__grid"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            Inženjering · Arhitektura · Modularnost
          </div>

          <h1>
            Tehnička preciznost.<br />
            <em>Inženjerski pristup prostoru.</em>
          </h1>

          <p class="hero__lead">
            Ne prodajemo samo proizvod. Projektujemo rešenje prema prostoru.
            Specijalizovani smo za razvoj i proizvodnju preciznih modularnih sistema u oblastima
            linijskog i radijalnog inox odvodnjavanja, savremene arhitektonske rasvete,
            monoblok podova i Fire Pit Grill ložišta.
          </p>

          <div class="hero__actions">
            <a class="btn btn--orange" href="/proizvodi/">
              Pogledajte sisteme <b>→</b>
            </a>
            <a class="btn btn--ghost" href="/posaljite-projekat/">
              Pošaljite nam projekat <b>↗</b>
            </a>
          </div>
        </div>

        <div class="hero__specs">
          <div>
            <strong>01 / PREFABRIKACIJA</strong>
            <span>Fabrički kontrolisane tolerancije</span>
          </div>
          <div>
            <strong>02 / MATERIJALI</strong>
            <span>AISI 304/316 i toplo pocinkovani čelik</span>
          </div>
          <div>
            <strong>03 / BEZ KOMPROMISA</strong>
            <span>Forma prati crtež, a ne obrnuto</span>
          </div>
          <div>
            <strong>04 / PODRŠKA PARTNERIMA</strong>
            <span>Direktna veza sa inženjerskim timom</span>
          </div>
        </div>
      </div>
    </section>

    <!-- INŽENJERSKI MANIFEST (DVE KOLONE) -->
    <section class="manifest-section">
      <div class="wrap manifest-grid">
        <div class="manifest-left">
          <div class="eyebrow">
            <span></span>
            Naša filozofija
          </div>
          <h2>Sistemi konfigurisani prema <em>zahtevima gradilišta.</em></h2>

          <p class="manifest-desc">
            Standardni serijski proizvodi često nameću nepotrebne kompromise na terenu:
            sečenje gotovih profila, nepravilno lomljenje krivina, vidljive spojnice i trajni
            rizik od curenja vode u slojeve hidroizolacije.
          </p>

          <p class="manifest-desc">
            <strong>MODULARNI SISTEMI</strong> postavlja suprotan inženjerski princip. Polazimo direktno od geometrije vašeg crteža. Kroz saradnju sa arhitektama, konstruktivnim inženjerima i izvođačima definišemo dužine segmenata, radijuse i pozicije odvoda pre početka proizvodnje.
          </p>

          <div class="quote-box">
            <span class="quote-tag">Suština modularnog razmišljanja</span>
            <p>
              „Prefabrikovani elementi sa fabrički kontrolisanim tolerancijama omogućavaju brzu montažu bez improvizacija, uz postizanje monolitnog vizuelnog sklada u završnoj oblozi poda."
            </p>
          </div>
        </div>

        <div class="manifest-right">
          <div class="value-card">
            <span class="value-num">01 / GEOMETRIJSKO PRILAGOĐAVANJE</span>
            <h3>Forma prati arhitekturu</h3>
            <p>
              Projektujemo pravolinijske kanale, radijalne segmente po meri i uske podužne proreze koji precizno prate ivice bazena, fasada i popločanih platoa.
            </p>
          </div>

          <div class="value-card">
            <span class="value-num">02 / POUZDANOST MATERIJALA</span>
            <h3>Otpornost na agresivna okruženja</h3>
            <p>
              Izrada od nerđajućeg čelika (AISI 304 i kiselootpornog AISI 316) obezbeđuje dugovečnost u kontaktu sa bazenskom vodom, industrijskim tečnostima i solima.
            </p>
          </div>

          <div class="value-card">
            <span class="value-num">03 / SARADNJA SA STRUČNJACIMA</span>
            <h3>Direktna inženjerska veza</h3>
            <p>
              Svaki upit preuzima inženjer koji analizira zadate padove, protoke i opterećenja i priprema tehničku specifikaciju spremnu za izvođenje.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- NAČIN RADA -->
    <section class="process-section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow">
              <span></span>
              Način rada
            </div>
            <h2>Od crteža do <em>gotovog sistema.</em></h2>
          </div>
          <p>
            Jasan tok saradnje u četiri koraka, od prvog upita do ugradnje na objektu.
          </p>
        </div>

        <div class="process-grid">
          {koraci.map((k) => (
            <div class="process-card">
              <span class="process-num">{k.num}</span>
              <h3>{k.title}</h3>
              <p>{k.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA BANER IZNAD FOOTERA (BEZ SLIKE) -->
    <section class="cta">
      <div class="cta__glow"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Projektantski dijalog
          </div>
          <h2>Planirate nov objekat <em>ili rekonstrukciju?</em></h2>
          <p>
            Povežite nas sa vašim projektantskim timom u ranoj fazi kako bismo zajednički
            definisali optimalne drenažne, svetlosne i podne linije bez improvizacija na terenu.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--orange" href="/posaljite-projekat/">
            Pošaljite nacrt na analizu <b>→</b>
          </a>
          <a class="btn btn--ghost" href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`}>
            Pozovite: {CONTACT.phone || '066 241 386'} <b>↗</b>
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #f6f7f9;
      color: #07111e;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .onama-page {
      --navy: #06131f;
      --navy2: #0b1d2b;
      --orange: #ff6900;
      --orange-hover: #e85e00;
      --line: #dce2e7;
      --muted: #64717c;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }

    .wrap {
      width: min(1280px, calc(100% - 40px));
      margin-inline: auto;
    }

    h1, h2, h3, p {
      margin: 0;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .eyebrow span {
      display: inline-block;
      width: 20px;
      height: 2px;
      background: var(--orange);
      flex-shrink: 0;
    }

    em {
      font-style: normal;
      color: var(--orange);
    }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      min-height: 560px;
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
      color: #fff;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }

    .hero__glow {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 70% at 85% 20%, rgba(255, 105, 0, 0.16), transparent 70%),
        radial-gradient(ellipse 50% 60% at 10% 100%, rgba(255, 255, 255, 0.05), transparent 70%);
      z-index: -2;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(90deg, black, transparent 80%);
      -webkit-mask-image: linear-gradient(90deg, black, transparent 80%);
      z-index: -1;
    }

    .hero__content {
      padding-top: 120px;
      padding-bottom: 64px;
      display: grid;
      grid-template-columns: minmax(0, 720px) 1fr;
      gap: 50px;
      align-items: end;
    }

    .hero h1 {
      margin-top: 18px;
      max-width: 860px;
      font-size: clamp(36px, 4.4vw, 56px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .hero__lead {
      margin-top: 20px;
      max-width: 640px;
      color: #d4dee4;
      font-size: 15px;
      line-height: 1.65;
    }

    .hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 32px;
    }

    .btn {
      min-height: 48px;
      padding: 0 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn b {
      font-size: 15px;
      font-weight: 600;
    }

    .btn--orange {
      background: var(--orange);
      color: #fff;
      border: 1px solid var(--orange);
    }

    .btn--orange:hover {
      background: var(--orange-hover);
      border-color: var(--orange-hover);
      transform: translateY(-2px);
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
      background: rgba(0, 0, 0, 0.15);
    }

    .btn--ghost:hover {
      background: #fff;
      color: var(--navy);
      border-color: #fff;
    }

    .hero__specs {
      border-left: 1px solid rgba(255, 255, 255, 0.2);
      padding-left: 28px;
      display: grid;
      gap: 20px;
    }

    .hero__specs strong {
      display: block;
      font-size: 14px;
      letter-spacing: 0.03em;
      font-weight: 700;
      color: #fff;
    }

    .hero__specs span {
      display: block;
      margin-top: 4px;
      color: #94a3ad;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }

    /* ========== MANIFEST ========== */
    .manifest-section {
      padding: 88px 0;
      background: #fff;
      border-bottom: 1px solid var(--line);
    }

    .manifest-grid {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: 56px;
      align-items: start;
    }

    .manifest-left h2 {
      margin-top: 12px;
      font-size: clamp(28px, 3.2vw, 42px);
      line-height: 1.1;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #07111e;
    }

    .manifest-desc {
      margin-top: 18px;
      font-size: 15px;
      line-height: 1.7;
      color: #55636e;
    }

    .manifest-desc strong {
      color: #07111e;
    }

    .quote-box {
      margin-top: 30px;
      padding: 24px;
      background: #f6f7f9;
      border-left: 3px solid var(--orange);
      border-radius: 2px;
    }

    .quote-tag {
      display: block;
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .quote-box p {
      font-size: 14px;
      line-height: 1.65;
      font-style: italic;
      color: #07111e;
    }

    .manifest-right {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .value-card {
      background: #f6f7f9;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 26px;
      transition: all 0.25s ease;
    }

    .value-card:hover {
      border-color: var(--orange);
      background: #fff;
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(6, 19, 31, 0.05);
    }

    .value-num {
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: block;
      margin-bottom: 6px;
    }

    .value-card h3 {
      font-size: 16px;
      font-weight: 800;
      color: #07111e;
      letter-spacing: -0.01em;
      text-transform: uppercase;
    }

    .value-card p {
      margin-top: 8px;
      font-size: 13.5px;
      line-height: 1.6;
      color: #55636e;
    }

    /* ========== NAČIN RADA ========== */
    .process-section {
      padding: 88px 0;
      background: #eef1f4;
      border-bottom: 1px solid var(--line);
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 36px;
      margin-bottom: 36px;
    }

    .section-head > div {
      max-width: 680px;
    }

    .section-head > p {
      max-width: 360px;
      padding-bottom: 4px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.6;
    }

    .section-head h2 {
      margin-top: 12px;
      font-size: clamp(30px, 3.4vw, 46px);
      line-height: 1.02;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #07111e;
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .process-card {
      background: #fff;
      border: 1px solid var(--line);
      border-top: 3px solid var(--orange);
      border-radius: 2px;
      padding: 26px 22px 28px;
      transition: all 0.3s ease;
      box-shadow: 0 4px 16px rgba(6, 19, 31, 0.04);
    }

    .process-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 36px rgba(6, 19, 31, 0.09);
    }

    .process-num {
      display: block;
      color: var(--orange);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.1em;
    }

    .process-card h3 {
      margin-top: 10px;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: #07111e;
    }

    .process-card p {
      margin-top: 10px;
      color: #55636e;
      font-size: 13.5px;
      line-height: 1.6;
    }

    /* ========== CTA ========== */
    .cta {
      position: relative;
      min-height: 300px;
      display: flex;
      align-items: center;
      color: #fff;
      overflow: hidden;
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
      isolation: isolate;
    }

    .cta__glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 50% 90% at 90% 50%, rgba(255, 105, 0, 0.14), transparent 70%);
      z-index: -1;
    }

    .cta__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 36px;
      padding: 56px 0;
    }

    .cta h2 {
      margin-top: 12px;
      font-size: clamp(26px, 3.3vw, 42px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .cta p {
      margin-top: 12px;
      max-width: 520px;
      color: #b5c2ca;
      font-size: 14px;
      line-height: 1.6;
    }

    .cta__actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex-shrink: 0;
    }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 1024px) {
      .manifest-grid {
        grid-template-columns: 1fr;
        gap: 40px;
      }
      .process-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 980px) {
      .hero__content {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .hero__specs {
        border-left: 0;
        border-top: 1px solid rgba(255, 255, 255, 0.2);
        padding-left: 0;
        padding-top: 24px;
      }

      .section-head {
        display: block;
        margin-bottom: 24px;
      }

      .section-head > p {
        margin-top: 12px;
      }

      .cta__inner {
        flex-direction: column;
        align-items: flex-start;
      }

      .cta__actions {
        flex-direction: row;
        flex-wrap: wrap;
      }
    }

    @media (max-width: 640px) {
      .wrap {
        width: min(100% - 24px, 1280px);
      }

      .hero {
        min-height: 0;
      }

      .hero__content {
        padding-top: 90px;
        padding-bottom: 40px;
      }

      .hero h1 {
        font-size: 32px;
      }

      .manifest-section,
      .process-section {
        padding: 56px 0;
      }

      .process-grid {
        grid-template-columns: 1fr;
      }

      .cta__inner {
        padding: 40px 0;
      }

      .cta__actions {
        flex-direction: column;
        width: 100%;
      }

      .cta__actions .btn {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
