    /* ========== CTA BANER ========== */
    .cta {
      position: relative;
      min-height: 340px;
      display: flex;
      align-items: center;
      color: #fff;
      overflow: hidden;
      background: var(--navy);
    }

    .cta > img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .cta__shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(100deg, rgba(6, 19, 31, 0.95) 0%, rgba(6, 19, 31, 0.75) 55%, rgba(6, 19, 31, 0.45) 100%);
    }

    .cta__inner {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 36px;
      padding: 56px 0;
    }

    .cta h2 {
      margin-top: 12px;
      font-size: clamp(26px, 3.3vw, 42px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .cta p {
      margin-top: 12px;
      max-width: 520px;
      color: #b5c2ca;
      font-size: 14px;
      line-height: 1.6;
    }

    .cta__actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex-shrink: 0;
    }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 1024px) {
      .profiles-grid {
        grid-template-columns: 1fr;
      }
      .steps-grid {
        grid-template-columns: 1fr;
        gap: 36px;
      }
    }

    @media (max-width: 980px) {
      .hero__content {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .hero__specs {
        display: none;
      }

      .hero__dots {
        right: 12px;
        bottom: 16px;
      }

      .section-head {
        display: block;
        margin-bottom: 24px;
      }

      .section-head > p {
        margin-top: 12px;
      }

      .cta__inner {
        flex-direction: column;
        align-items: flex-start;
      }

      .cta__actions {
        flex-direction: row;
      }
    }

    @media (max-width: 640px) {
      .wrap {
        width: min(100% - 24px, 1280px);
      }

      .hero {
        min-height: 540px;
      }

      .hero__content {
        padding-top: 70px;
        padding-bottom: 40px;
      }

      .hero h1 {
        font-size: 32px;
      }

      .step-card {
        padding: 20px 16px;
      }

      .cta {
        min-height: 340px;
      }

      .cta__inner {
        padding: 40px 0;
      }

      .cta__actions {
        flex-direction: column;
        width: 100%;
      }

      .cta__actions .btn {
        width: 100%;
      }
    }
  </style>

  <script>
    // Hero slajder: automatska rotacija sve 3 slike na svake 3 sekunde
    const slides = document.querySelectorAll<HTMLElement>('.hero__slide');
    const dots = document.querySelectorAll<HTMLButtonElement>('.hero__dot');

    if (slides.length > 1) {
      let current = 0;
      let timer: number | undefined;

      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((s, i) => s.classList.toggle('is-active', i === current));
        dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
      };

      const stop = () => {
        if (timer) window.clearInterval(timer);
      };
      const start = () => {
        stop();
        timer = window.setInterval(() => show(current + 1), 3000);
      };

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          show(Number(dot.dataset.index));
          start();
        });
      });

      start();
    }
  </script>
</BaseLayout>