---

import BaseLayout from '../layouts/BaseLayout.astro';

import { CONTACT } from '../data/siteData';

const profiles = [

  { number: '01', name: 'Arhitekte i projektanti', category: 'PROJEKTOVANJE', description: 'Razrada geometrije, konstrukcionih detalja i rešenja koja prate projektantsku zamisao.', items: ['Usklađivanje sa projektom', 'Geometrija i detalji na zahtev', 'Tehnička komunikacija tokom razrade'] },

  { number: '02', name: 'Izvođači i montažni timovi', category: 'REALIZACIJA', description: 'Konstrukcija koja uzima u obzir stvarne uslove izvođenja, povezivanja i montaže.', items: ['Dogovor oko spojeva i pozicija', 'Usklađivanje sa uslovima na terenu', 'Razrada detalja za izradu'] },

  { number: '03', name: 'Industrija i kompanije', category: 'INŽENJERING', description: 'Prilagođeni metalni elementi, čelične konstrukcije i tehnička rešenja za proizvodne i radne prostore.', items: ['Konstrukcije po zadatku', 'Podesti i tehničke platforme', 'Projektovanje i mašinska izrada'] },

  { number: '04', name: 'Investitori i poslovni partneri', category: 'SARADNJA', description: 'Jasan razgovor o nameni, izgledu, materijalu i mogućnostima realizacije od prvog upita.', items: ['Razumevanje ciljeva projekta', 'Dogovor oko tehničkog rešenja', 'Komunikacija do realizacije'] },

];

const steps = [

  { num: '01', title: 'Predstavite zadatak', body: 'Pošaljite opis, skicu, fotografiju ili postojeći crtež.' },

  { num: '02', title: 'Razradimo rešenje', body: 'Razmatramo funkciju, geometriju, materijal i konstrukciju.' },

  { num: '03', title: 'Uskladimo detalje', body: 'Dogovaramo ključne tehničke zahteve pre izrade.' },

  { num: '04', title: 'Pređemo na realizaciju', body: 'Nastavljamo prema usaglašenom obimu i planu projekta.' },

];

const email = CONTACT.generalEmail;

---

<BaseLayout

  title="Partneri · Inženjerska saradnja"

  description="Saradnja Modularnih Sistema sa projektantima, arhitektama, izvođačima, industrijom i poslovnim partnerima. Konstrukcija i izrada prema konkretnom zadatku."

  canonical="https://modularnisistemi.com/partneri/"

>

  <div class="partner-page">

    <section class="hero">

      <div class="wrap hero-grid">

        <div class="hero-copy">

          <p class="eyebrow">MODULARNI SISTEMI / PREMIUM ENGINEERING</p>

          <h1>Dobri projekti.<br /><span>Pravi partneri.</span></h1>

          <p class="lead">Od prve skice do gotove konstrukcije. Sarađujemo sa ljudima koji od tehničkog zadatka očekuju promišljeno i funkcionalno rešenje.</p>

          <div class="actions">

            <a class="btn primary" href="/kontakt/">Započnite saradnju <span aria-hidden="true">↗</span></a>

            <a class="btn secondary" href="/proizvodi/">Istražite proizvode <span aria-hidden="true">↗</span></a>

          </div>

          <p class="micro">OBLIK. FUNKCIJA. KONSTRUKCIJA.</p>

        </div>

        <div class="hero-panel" aria-label="Inženjerski pristup saradnji">

          <div class="panel-top"><span>MS / PARTNERSHIP STUDY</span><span>01 — 04</span></div>

          <div class="panel-center"><span class="tiny">JEDAN PRINCIP SARADNJE</span><h2>Razumemo zadatak.<br /><span>Razvijamo rešenje.</span></h2><div class="drawing" aria-hidden="true"><i></i><i></i><i></i><i></i></div></div>

          <div class="panel-bottom">PROJEKTOVANJE / KONSTRUKCIJA / REALIZACIJA <span aria-hidden="true">↗</span></div>

        </div>

      </div>

    </section>

    <section class="audience section-light">

      <div class="wrap">

        <div class="section-heading"><div><p class="eyebrow">OBLASTI SARADNJE</p><h2>Različiti partneri.<br /><span>Zajednički cilj.</span></h2></div><p>Saradnju oblikujemo prema ulozi partnera i specifičnostima projekta — bez nametanja unapred definisanog rešenja.</p></div>

        <div class="partner-list">

          {profiles.map((p) => (

            <article class="partner-row">

              <div class="row-id"><span>{p.number}</span><small>{p.category}</small></div>

              <div class="row-title"><h3>{p.name}</h3><p>{p.description}</p></div>

              <ul>{p.items.map((item) => <li>{item}</li>)}</ul>

              <a href="/kontakt/" aria-label={`Kontakt za saradnju: ${p.name}`} class="row-arrow">↗</a>

            </article>

          ))}

        </div>

      </div>

    </section>

    <section class="principles section-dark">

      <div class="wrap">

        <div class="section-heading"><div><p class="eyebrow">NAŠ PRISTUP</p><h2>Ne prilagođavamo zadatak proizvodu.<br /><span>Prilagođavamo konstrukciju zadatku.</span></h2></div><p>Razmišljamo o celom sistemu: nameni, materijalu, spojevima, dostupnosti za održavanje i uslovima ugradnje.</p></div>

        <div class="principle-grid"><div><b>01 / FUNKCIJA</b><h3>Razumevanje primene</h3><p>Polazimo od toga šta sistem treba da omogući.</p></div><div><b>02 / KONSTRUKCIJA</b><h3>Detalj koji ima smisla</h3><p>Oblik i povezivanje elemenata razrađujemo prema zadatku.</p></div><div><b>03 / SARADNJA</b><h3>Otvoren tehnički dijalog</h3><p>Rešenje usklađujemo sa partnerima uključenim u projekat.</p></div></div>

      </div>

    </section>

    <section class="process section-light">

      <div class="wrap"><div class="section-heading"><div><p class="eyebrow">TOK SARADNJE</p><h2>Prvo razumevanje.<br /><span>Zatim realizacija.</span></h2></div><p>Jednostavan put od prvog razgovora do usaglašenog tehničkog rešenja.</p></div>

      <div class="step-grid">{steps.map((step) => <div class="step"><b>{step.num}</b><h3>{step.title}</h3><p>{step.body}</p></div>)}</div>

      </div>

    </section>

    <section class="contact-strip"><div class="wrap contact-grid"><div><p class="eyebrow">VAŠ ZADATAK / NAŠA KONSTRUKCIJA</p><h2>Imate projekat?<br /><span>Razgovarajmo.</span></h2><p>Dovoljni su skica, fotografija, crtež ili kratak opis onoga što želite da realizujete.</p></div><div class="contact-links"><a href="/kontakt/" class="btn primary">Pošaljite upit <span aria-hidden="true">↗</span></a><a href={`mailto:${email}`} class="email-link">{email} <span aria-hidden="true">↗</span></a></div></div></section>

  </div>

</BaseLayout>

<style>

.partner-page{--navy:#061b28;--navy-deep:#06131f;--accent:#ff6900;--muted:#748896;--line:#d8e0e4;color:#0b2030;font-family:Manrope,Montserrat,system-ui,sans-serif;overflow:hidden}.wrap{width:min(1200px,calc(100% - 48px));margin-inline:auto}.partner-page h1,.partner-page h2,.partner-page h3,.partner-page p{margin:0}.eyebrow{display:flex;align-items:center;gap:12px;color:var(--accent);font-size:10px;letter-spacing:.14em;font-weight:800;text-transform:uppercase}.eyebrow:before{content:'';width:20px;height:2px;flex:none;background:var(--accent)}h1,h2{letter-spacing:-.052em;line-height:1.09}.hero{background:radial-gradient(ellipse at 64% 34%,#0a2a39 0%,#061a27 43%,#051520 100%);color:#fff}.hero-grid{padding:72px 0 66px;display:grid;grid-template-columns:.95fr 1.05fr;align-items:center;gap:76px}.hero h1{font-size:clamp(42px,4.8vw,68px);font-weight:800;margin-top:27px}.hero h1 span,.section-heading h2 span,.contact-strip h2 span,.panel-center h2 span{color:var(--accent)}.lead{margin-top:18px!important;max-width:490px;color:#afc0ca;font-size:14px;line-height:1.8}.actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}.btn{display:inline-flex;justify-content:space-between;align-items:center;gap:22px;min-height:43px;padding:0 16px;font-size:11px;font-weight:800;text-decoration:none;transition:background .2s,border-color .2s}.btn span{font-size:17px}.primary{background:var(--accent);color:#06131f;border:1px solid var(--accent)}.primary:hover{background:#ff852d}.secondary{background:transparent;color:#fff;border:1px solid #435667}.secondary:hover{border-color:#fff}.micro{font-size:9px;letter-spacing:.14em;color:#78909d;margin-top:33px!important}.micro:before{content:'';display:inline-block;width:20px;height:1px;vertical-align:middle;background:var(--accent);margin-right:10px}.hero-panel{border:1px solid #254150;min-height:320px;display:flex;flex-direction:column;position:relative;background:linear-gradient(140deg,#0b2938,#071b29);box-shadow:13px 14px 0 #092231}.panel-top,.panel-bottom{display:flex;justify-content:space-between;padding:12px 16px;color:#83a8bd;letter-spacing:.15em;font-size:9px}.panel-top{border-bottom:1px solid #294352}.panel-bottom{border-top:1px solid #294352;margin-top:auto}.panel-bottom span{color:var(--accent)}.panel-center{padding:36px 28px;position:relative;min-height:230px}.tiny{font-size:10px;letter-spacing:.13em;font-weight:800;color:var(--accent)}.panel-center h2{position:relative;z-index:1;font-size:clamp(24px,2.5vw,36px);max-width:360px;margin-top:12px;font-weight:800}.drawing{position:absolute;right:22px;bottom:14px;width:38%;height:80%;overflow:hidden;opacity:.48}.drawing i{display:block;position:absolute;width:175%;height:1px;background:#4f8298;transform:rotate(-34deg);right:-45%;bottom:15%}.drawing i:nth-child(2){bottom:27%}.drawing i:nth-child(3){bottom:39%}.drawing i:nth-child(4){bottom:51%}.section-light{background:#f0f4f5;padding:70px 0 76px}.section-dark{background:#061b28;color:#fff;padding:70px 0 76px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:42px;margin-bottom:30px}.section-heading h2{font-size:clamp(29px,3vw,43px);margin-top:16px;font-weight:800}.section-heading>p{max-width:360px;line-height:1.75;font-size:13px;color:var(--muted)}.section-dark .section-heading>p{color:#a3b8c3}.partner-list{border-top:1px solid var(--line)}.partner-row{display:grid;grid-template-columns:170px minmax(230px,1fr) minmax(210px,.9fr) 35px;align-items:center;gap:20px;padding:24px 0;border-bottom:1px solid var(--line)}.row-id{display:flex;gap:14px;align-items:center}.row-id span{font-size:13px;font-weight:800;color:var(--accent)}.row-id small{font-size:9px;font-weight:800;color:#7790a0;letter-spacing:.08em}.row-title h3{font-size:19px;font-weight:800;letter-spacing:-.025em}.row-title p{font-size:12px;line-height:1.7;color:#657885;margin-top:7px}.partner-row ul{margin:0;padding:0;list-style:none}.partner-row li{font-size:11px;line-height:1.9;color:#526b7b}.partner-row li:before{content:'—';color:var(--accent);margin-right:8px}.row-arrow{display:grid;place-items:center;color:var(--accent);font-size:21px;text-decoration:none;align-self:stretch;transition:background .2s}.row-arrow:hover{background:#e2eaed}.principle-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.principle-grid>div{border:1px solid #284252;background:#092434;min-height:158px;padding:22px}.principle-grid b{font-size:10px;letter-spacing:.1em;color:var(--accent)}.principle-grid h3{font-weight:700;margin-top:25px;font-size:17px}.principle-grid p{margin-top:8px;color:#a0b3bf;font-size:12px;line-height:1.6}.step-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.step{padding:23px 20px 6px;border-right:1px solid var(--line)}.step:first-child{padding-left:0}.step:last-child{border-right:0}.step b{color:var(--accent);font-size:11px}.step h3{margin-top:25px;font-size:16px;font-weight:800}.step p{color:#657885;font-size:12px;line-height:1.7;margin-top:9px}.contact-strip{background:#071c29;color:#fff;padding:59px 0}.contact-grid{display:flex;align-items:center;justify-content:space-between;gap:40px}.contact-strip h2{font-size:clamp(31px,3vw,44px);margin-top:13px;font-weight:800}.contact-strip p:not(.eyebrow){font-size:12px;color:#abc0ca;line-height:1.7;margin-top:10px}.contact-links{min-width:270px;display:grid;gap:12px}.email-link{font-size:11px;text-decoration:none;color:#d1dce2;border-bottom:1px solid #354955;padding:8px 0;display:flex;justify-content:space-between;gap:12px;overflow-wrap:anywhere}.email-link span{color:var(--accent)}.email-link:hover{color:#fff}

@media(max-width:1000px){.hero-grid{gap:35px}.partner-row{grid-template-columns:120px 1fr 1fr 30px;gap:14px}.row-id{display:block}.row-id small{display:block;margin-top:5px}}

@media(max-width:760px){.wrap{width:min(100% - 32px,1200px)}.hero-grid{grid-template-columns:1fr;padding:50px 0;gap:34px}.hero h1{font-size:clamp(39px,9vw,58px)}.hero-panel{min-height:250px}.section-light,.section-dark{padding:50px 0 55px}.section-heading{display:block}.section-heading>p{margin-top:16px}.partner-row{grid-template-columns:45px 1fr 27px;gap:13px}.row-id small{display:none}.partner-row ul{grid-column:2;grid-row:2}.row-arrow{grid-column:3;grid-row:1 / 3}.principle-grid{grid-template-columns:1fr}.principle-grid>div{min-height:auto}.principle-grid h3{margin-top:16px}.step-grid{grid-template-columns:repeat(2,1fr);gap:12px}.step{border:1px solid var(--line);padding:18px!important}.contact-grid{display:block}.contact-links{margin-top:28px;min-width:0;max-width:390px}}

@media(max-width:440px){.step-grid{grid-template-columns:1fr}.hero-panel{min-height:230px}.panel-center{padding:25px 18px;min-height:185px}.panel-center h2{font-size:24px}.partner-row{padding:18px 0}.row-title h3{font-size:17px}.row-title p{font-size:11px}.partner-row li{font-size:10px}}

@media(prefers-reduced-motion:reduce){.partner-page .btn,.partner-page .row-arrow{transition:none}}

</style>
