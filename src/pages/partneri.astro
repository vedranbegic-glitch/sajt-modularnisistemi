---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../data/siteData';

const canonicalURL = 'https://modularnisistemi.com/partneri/';
const pageTitle = 'Partneri · B2B saradnja i podrška';
const pageDescription = 'B2B saradnja za arhitektonske biroe, projektante, izvođače radova i investitore. Razrada rešenja i tehnička podrška brenda MODULARNI SISTEMI.';

const targetProfiles = [
  {
    num: '01',
    role: 'Arhitekte i projektanti',
    subtitle: 'Autorska sloboda i čiste linije',
    description: 'Pomažemo vam da ostvarite složene geometrije bez vizuelnih kompromisa. Dobijate 2D i 3D CAD detalje koje direktno ubacujete u tehničku dokumentaciju.',
    benefits: [
      'CAD podloge i preseci za glavne projekte',
      'Izrada radijalnih formi prema željenom radijusu (R)',
      'Konsultacije o detaljima prelaza i visinskim kotama',
      'Predmer i opis stavki za tendersku dokumentaciju',
    ],
  },
  {
    num: '02',
    role: 'Građevinski izvođači i monteri',
    subtitle: 'Brza montaža bez improvizacija na terenu',
    description: 'Isporučujemo prefabrikovane sisteme sa numerisanim segmentima, pripremljenim spojevima i nivelirajućim stopama, tako da na licu mesta nema dorade ni sečenja.',
    benefits: [
      'Numerisani elementi usklađeni sa montažnom šemom',
      'Prirubnički spojevi sa EPDM zaptivkama',
      'Jasna tehnička uputstva za postavljanje i nivelisanje',
      'Direktna telefonska podrška tokom radova na terenu',
    ],
  },
  {
    num: '03',
    role: 'Investitori',
    subtitle: 'Pouzdanost na duži rok',
    description: 'Konstrukcije od kvalitetnog nerđajućeg čelika štite objekat od prodiranja vode i zahtevaju minimalno održavanje tokom dugog veka korišćenja.',
    benefits: [
      'Materijal otporan na koroziju i dugotrajan',
      'Jednostavan pristup sifonskim korpama i revizijama',
      'Pojedinačni segmenti rešetki se lako zamenjuju',
      'Niži troškovi zahvaljujući tipskim prefabrikovanim rešenjima',
    ],
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalURL}>
  <div class="partneri-page">
    <!-- HERO SEKCIJA (BEZ SLIKA, AKCENAT NA TEKSTU) -->
    <section class="hero">
      <div class="hero__glow"></div>
      <div class="hero__grid"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            B2B saradnja · Tehnička podrška
          </div>

          <h1>
            Pouzdan partner u realizaciji<br />
            <em>arhitektonskih zamisli.</em>
          </h1>

          <p class="hero__lead">
            Nudimo namensku tehničku i operativnu podršku projektantima, inženjerima i građevinskim kompanijama.
            Sarađujemo na objektu od idejnog crteža do završne ugradnje, bez zastoja.
          </p>

          <div class="hero__badges">
            <span class="badge-tag">Arhitektonski biroi</span>
            <span class="badge-tag">Glavni izvođači</span>
            <span class="badge-tag">Investitori</span>
          </div>

          <div class="hero__actions">
            <a class="btn btn--orange" href="/posaljite-projekat/">
              Pošaljite nam projekat <b>→</b>
            </a>
            <a class="btn btn--ghost" href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`}>
              Pozovite: {CONTACT.phone || '+381 66 241 386'} <b>↗</b>
            </a>
          </div>
        </div>

        <div class="hero__specs">
          <div>
            <strong>2D / 3D CAD MODELI</strong>
            <span>Direktno u vaš projekat</span>
          </div>
          <div>
            <strong>100% PREFABRIKACIJA</strong>
            <span>Elementi obeleženi po segmentima</span>
          </div>
          <div>
            <strong>ANALIZA KOTA I PADOVA</strong>
            <span>Procena u roku od 24h</span>
          </div>
          <div>
            <strong>DIREKTNA LINIJA</strong>
            <span>Naš tim uz vas tokom montaže</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROFILI SARADNJE (3 B2B KARTICE) -->
    <section class="profiles-section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow">
              <span></span>
              Kome pomažemo
            </div>
            <h2>Podrška prilagođena <em>vašoj ulozi.</em></h2>
          </div>
          <p>
            Poznajemo tok planiranja, tendera i svakodnevne zahteve gradilišta.
          </p>
        </div>

        <div class="profiles-grid">
          {targetProfiles.map((profile) => (
            <article class="profile-card">
              <div class="profile-card__head">
                <span class="profile-num">Sektor {profile.num}</span>
                <h3>{profile.role}</h3>
                <p class="profile-subtitle">„{profile.subtitle}"</p>
                <p class="profile-desc">{profile.description}</p>
              </div>

              <div class="profile-card__benefits">
                <span class="benefits-title">Šta dobijate:</span>
                <ul>
                  {profile.benefits.map((b) => (
                    <li>
                      <span class="bullet"></span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="profile-card__footer">
                <a href="/posaljite-projekat/" class="btn btn--profile">
                  Započnite saradnju <b>→</b>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- RADNI KORACI SARADNJE (DVE KOLONE) -->
    <section class="steps-section">
      <div class="wrap steps-grid">

        <!-- Leva kolona -->
        <div class="steps-left">
          <div class="eyebrow">
            <span></span>
            Tok saradnje
          </div>
          <h2>Kako započinjemo <em>saradnju?</em></h2>

          <p class="steps-desc">
            Svaki projekat ima jedinstvene parametre. Dovoljno je da nam pošaljete osnovne podatke o geometriji ili preliminarni crtež, a naš tim preuzima analizu i proračun.
          </p>

          <div class="contact-box">
            <div>
              <span class="contact-box__label">Prijem crteža i projekata</span>
              <a href={`mailto:${CONTACT.projectEmail || 'projekti@modularnisistemi.com'}`} class="contact-box__val">
                {CONTACT.projectEmail || 'projekti@modularnisistemi.com'}
              </a>
            </div>
            <div class="contact-box__sep"></div>
            <div>
              <span class="contact-box__label">Telefon za konsultacije</span>
              <a href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`} class="contact-box__val contact-box__val--phone">
                {CONTACT.phone || '+381 66 241 386'}
              </a>
            </div>
          </div>
        </div>

        <!-- Desna kolona: 3 numerisana koraka -->
        <div class="steps-right">
          <div class="step-card">
            <span class="step-card__num">01</span>
            <div class="step-card__content">
              <h4>Dostava podloga i crteža</h4>
              <p>
                Pošaljite nam DWG ili PDF osnovu sa zadatim padovima, kotama i željenom završnom oblogom ili drenažnim linijama.
              </p>
            </div>
          </div>

          <div class="step-card">
            <span class="step-card__num">02</span>
            <div class="step-card__content">
              <h4>Predlog i predmer</h4>
              <p>
                Dostavljamo predlog podele na modularne segmente, uz specifikaciju spremnu za ponudu.
              </p>
            </div>
          </div>

          <div class="step-card">
            <span class="step-card__num">03</span>
            <div class="step-card__content">
              <h4>Prefabrikacija i isporuka</h4>
              <p>
                Izrađeni elementi dolaze na gradilište obeleženi po segmentima, spremni za brzu ugradnju.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- CTA BANER IZNAD FOOTERA (BEZ SLIKE) -->
    <section class="cta">
      <div class="cta__glow"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Prvi korak
          </div>
          <h2>Dostavite nacrt za analizu <em>bez obaveze.</em></h2>
          <p>
            Naš tim detaljno pregleda vaše crteže i predlaže najekonomičniju i tehnički najčistiju konfiguraciju elemenata.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--orange" href="/posaljite-projekat/">
            Pošaljite nam projekat <b>→</b>
          </a>
          <a class="btn btn--ghost" href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`}>
            Pozovite: {CONTACT.phone || '+381 66 241 386'} <b>↗</b>
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #f6f7f9;
      color: #07111e;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .partneri-page {
      --navy: #06131f;
      --navy2: #0b1d2b;
      --orange: #ff6900;
      --orange-hover: #e85e00;
      --line: #dce2e7;
      --muted: #64717c;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }

    .wrap {
      width: min(1280px, calc(100% - 40px));
      margin-inline: auto;
    }

    h1, h2, h3, h4, p {
      margin: 0;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .eyebrow span {
      display: inline-block;
      width: 20px;
      height: 2px;
      background: var(--orange);
      flex-shrink: 0;
    }

    em {
      font-style: normal;
      color: var(--orange);
    }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      min-height: 560px;
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
      color: #fff;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }

    .hero__glow {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 70% at 85% 20%, rgba(255, 105, 0, 0.16), transparent 70%),
        radial-gradient(ellipse 50% 60% at 10% 100%, rgba(255, 255, 255, 0.05), transparent 70%);
      z-index: -2;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(90deg, black, transparent 80%);
      -webkit-mask-image: linear-gradient(90deg, black, transparent 80%);
      z-index: -1;
    }

    .hero__content {
      padding-top: 120px;
      padding-bottom: 64px;
      display: grid;
      grid-template-columns: minmax(0, 720px) 1fr;
      gap: 50px;
      align-items: end;
    }

    .hero h1 {
      margin-top: 18px;
      max-width: 860px;
      font-size: clamp(36px, 4.4vw, 56px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .hero__lead {
      margin-top: 20px;
      max-width: 620px;
      color: #d4dee4;
      font-size: 15px;
      line-height: 1.65;
    }

    .hero__badges {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 24px;
    }

    .badge-tag {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.18);
      padding: 6px 14px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border-radius: 2px;
      color: #fff;
    }

    .hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 28px;
    }

    .btn {
      min-height: 48px;
      padding: 0 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn b {
      font-size: 15px;
      font-weight: 600;
    }

    .btn--orange {
      background: var(--orange);
      color: #fff;
      border: 1px solid var(--orange);
    }

    .btn--orange:hover {
      background: var(--orange-hover);
      border-color: var(--orange-hover);
      transform: translateY(-2px);
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
      background: rgba(0, 0, 0, 0.15);
    }

    .btn--ghost:hover {
      background: #fff;
      color: var(--navy);
      border-color: #fff;
    }

    .hero__specs {
      border-left: 1px solid rgba(255, 255, 255, 0.2);
      padding-left: 28px;
      display: grid;
      gap: 20px;
    }

    .hero__specs strong {
      display: block;
      font-size: 14px;
      letter-spacing: 0.03em;
      font-weight: 700;
      color: #fff;
    }

    .hero__specs span {
      display: block;
      margin-top: 4px;
      color: #a9b6be;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }

    /* ========== PROFILI SARADNJE ========== */
    .profiles-section {
      padding: 80px 0;
      background: #f6f7f9;
      border-bottom: 1px solid var(--line);
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 36px;
      margin-bottom: 36px;
    }

    .section-head > div {
      max-width: 680px;
    }

    .section-head > p {
      max-width: 380px;
      padding-bottom: 4px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.6;
    }

    .section-head h2 {
      margin-top: 12px;
      font-size: clamp(30px, 3.4vw, 46px);
      line-height: 1.02;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #07111e;
    }

    .profiles-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .profile-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 32px 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.3s ease;
      box-shadow: 0 4px 16px rgba(6, 19, 31, 0.04);
    }

    .profile-card:hover {
      transform: translateY(-5px);
      border-color: var(--orange);
      box-shadow: 0 16px 36px rgba(6, 19, 31, 0.08);
    }

    .profile-num {
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      display: block;
      margin-bottom: 8px;
    }

    .profile-card h3 {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #07111e;
    }

    .profile-subtitle {
      margin-top: 8px;
      color: var(--orange);
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      line-height: 1.4;
    }

    .profile-desc {
      margin-top: 12px;
      color: #55636e;
      font-size: 13.5px;
      line-height: 1.6;
    }

    .profile-card__benefits {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid var(--line);
    }

    .benefits-title {
      display: block;
      color: #07111e;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 12px;
    }

    .profile-card__benefits ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .profile-card__benefits li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      color: #3d4a55;
      font-size: 12.5px;
      line-height: 1.45;
    }

    .bullet {
      width: 6px;
      height: 6px;
      background: var(--orange);
      border-radius: 1px;
      margin-top: 5px;
      flex-shrink: 0;
    }

    .profile-card__footer {
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }

    .btn--profile {
      width: 100%;
      background: #f6f7f9;
      color: #07111e;
      border: 1px solid var(--line);
      box-sizing: border-box;
      transition: all 0.25s ease;
    }

    .btn--profile:hover {
      background: var(--orange);
      color: #fff;
      border-color: var(--orange);
    }

    /* ========== RADNI KORACI SARADNJE ========== */
    .steps-section {
      padding: 80px 0;
      background: #fff;
      border-bottom: 1px solid var(--line);
    }

    .steps-grid {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 50px;
      align-items: start;
    }

    .steps-left h2 {
      margin-top: 12px;
      font-size: clamp(28px, 3.2vw, 42px);
      line-height: 1.1;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #07111e;
    }

    .steps-desc {
      margin-top: 16px;
      font-size: 14.5px;
      line-height: 1.65;
      color: #55636e;
    }

    .contact-box {
      margin-top: 28px;
      padding: 24px;
      background: var(--navy);
      border-radius: 2px;
      color: #fff;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .contact-box__label {
      display: block;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #8c9da8;
      margin-bottom: 4px;
    }

    .contact-box__val {
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      overflow-wrap: anywhere;
      transition: color 0.2s;
    }

    .contact-box__val:hover {
      color: var(--orange);
    }

    .contact-box__val--phone {
      font-size: 18px;
      color: var(--orange);
    }

    .contact-box__sep {
      height: 1px;
      background: rgba(255, 255, 255, 0.1);
    }

    .steps-right {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .step-card {
      background: #f6f7f9;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 24px;
      display: flex;
      align-items: flex-start;
      gap: 20px;
      transition: all 0.25s ease;
    }

    .step-card:hover {
      border-color: var(--orange);
      background: #fff;
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(6, 19, 31, 0.05);
    }

    .step-card__num {
      font-size: 28px;
      font-weight: 900;
      color: var(--orange);
      line-height: 1;
      flex-shrink: 0;
    }

    .step-card__content h4 {
      font-size: 15px;
      font-weight: 800;
      color: #07111e;
      text-transform: uppercase;
      letter-spacing: -0.01em;
    }

    .step-card__content p {
      margin-top: 6px;
      font-size: 13px;
      line-height: 1.55;
      color: #55636e;
    }

    /* ========== CTA BANER ========== */
    .cta {
      position: relative;
      min-height: 300px;
      display: flex;
      align-items: center;
      color: #fff;
      overflow: hidden;
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
      isolation: isolate;
    }

    .cta__glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 50% 90% at 90% 50%, rgba(255, 105, 0, 0.14), transparent 70%);
      z-index: -1;
    }

    .cta__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 36px;
      padding: 56px 0;
    }

    .cta h2 {
      margin-top: 12px;
      font-size: clamp(26px, 3.3vw, 42px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .cta p {
      margin-top: 12px;
      max-width: 520px;
      color: #b5c2ca;
      font-size: 14px;
      line-height: 1.6;
    }

    .cta__actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex-shrink: 0;
    }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 1024px) {
      .profiles-grid {
        grid-template-columns: 1fr;
      }
      .steps-grid {
        grid-template-columns: 1fr;
        gap: 36px;
      }
    }

    @media (max-width: 980px) {
      .hero__content {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .hero__specs {
        border-left: 0;
        border-top: 1px solid rgba(255, 255, 255, 0.2);
        padding-left: 0;
        padding-top: 24px;
      }

      .section-head {
        display: block;
        margin-bottom: 24px;
      }

      .section-head > p {
        margin-top: 12px;
