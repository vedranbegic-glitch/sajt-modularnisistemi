---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { CONTACT } from '../data/siteData';

const breadcrumbItems = [
  { label: 'Partneri' },
];

const targetProfiles = [
  {
    role: 'Arhitekti i projektanti',
    subtitle: 'Autorska sloboda i čiste linije',
    description: 'Pomažemo vam da realizujete složene geometrije bez vizuelnih kompromisa. Obezbeđujemo 2D i 3D CAD detalje koji se direktno ugrađuju u tehničku dokumentaciju.',
    benefits: [
      'CAD podloge i preseci za glavne projekte',
      'Izrada radijalnih formi prema željenom radijusu (R)',
      'Konsultacije o detaljima prelaza i visinskim kotama',
      'Predmer i tekstualni opis za tendersku dokumentaciju',
    ],
  },
  {
    role: 'Građevinski izvođači i instalateri',
    subtitle: 'Brza montaža bez improvizacija na terenu',
    description: 'Isporučujemo prefabrikovane sisteme sa numerisanim segmentima, pripremljenim spojevima i zaptivnim setovima. Eliminišemo potrebu za doradom i sečenjem na licu mesta.',
    benefits: [
      'Numerisani elementi usklađeni sa montažnom šemom',
      'Zaptivni prirubnički spojevi sa EPDM dihtunzima',
      'Jasna tehnička uputstva za postavljanje i nivelisanje',
      'Direktna telefonska podrška tokom radova na terenu',
    ],
  },
  {
    role: 'Investitori i Facility menadžeri',
    subtitle: 'Dugoročna eksploataciona sigurnost',
    description: 'Konstrukcije od visokokvalitetnog nerđajućeg čelika i otpornih legura štite objekat od prodiranja vode i obezbeđuju lako održavanje tokom višegodišnjeg korišćenja.',
    benefits: [
      'Trajna postojanost materijala bez korozije',
      'Jednostavan pristup sifonskim korpicama i revizijama',
      'Modularna zamenljivost pojedinačnih segmenata rešetki',
      'Optimizacija troškova kroz prefabrikovana rešenja',
    ],
  },
];
---

<BaseLayout
  title="Partneri · Saradnja sa arhitektama i izvođačima"
  description="B2B saradnja za arhitektonske biroe, inženjere, izvođače radova i investitore. Inženjerska razrada i tehnička podrška brenda MODULARNI SISTEMI."
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Hero sekcija -->
  <section class="pt-14 pb-16 bg-navy bg-grid-pattern border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-navy-surface border border-accent/40 text-accent font-mono text-[11px] uppercase tracking-architectural font-bold">
          <span class="w-2 h-2 bg-accent inline-block" aria-hidden="true"></span>
          <span>B2B Partnerstvo &amp; Inženjering</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Pouzdan partner u realizaciji arhitektonskih zamisli.
        </h1>

        <p class="text-sm sm:text-base text-slate-muted leading-relaxed">
          Nudimo namensku tehničku i operativnu podršku projektantima, inženjerima i građevinskim kompanijama. Sarađujemo na objektu od idejnog crteža do završne ugradnje.
        </p>

        <div class="pt-2 flex flex-wrap gap-4 font-mono text-xs">
          <span class="px-3 py-1.5 bg-navy-surface border border-white/10 text-white">ARHITEKTONSKI BIROI</span>
          <span class="px-3 py-1.5 bg-navy-surface border border-white/10 text-white">GLAVNI IZVOĐAČI</span>
          <span class="px-3 py-1.5 bg-navy-surface border border-white/10 text-white">DEVELOPERI</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Profili saradnje -->
  <section class="py-16 lg:py-24 bg-navy-dark border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Modeli podrške"
        title="Stručna asistencija prilagođena vašoj ulozi"
        subtitle="Razumemo specifičnosti procesa planiranja, tenderskih procedura i samog gradilišta."
      />

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {targetProfiles.map((profile, index) => (
          <div class="p-8 bg-navy border border-white/10 flex flex-col justify-between space-y-6 hover:border-accent/40 transition-colors">
            <div class="space-y-4">
              <span class="text-accent font-mono text-xs font-bold block">
                SEKTOR 0{index + 1}
              </span>
              <h3 class="text-xl font-bold text-white tracking-tight">
                {profile.role}
              </h3>
              <p class="text-xs font-mono text-accent uppercase tracking-wider font-semibold">
                {profile.subtitle}
              </p>
              <p class="text-xs text-slate-muted leading-relaxed">
                {profile.description}
              </p>

              <div class="pt-4 border-t border-white/10 space-y-2">
                <span class="text-[10px] font-mono uppercase tracking-architectural text-slate-surface font-semibold block mb-2">
                  Šta obezbeđujemo:
                </span>
                {profile.benefits.map((b) => (
                  <div class="text-[11px] text-slate-surface flex items-start gap-2">
                    <span class="w-1.5 h-1.5 bg-accent mt-1 flex-shrink-0" aria-hidden="true"></span>
                    <span>{b}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-white/10">
              <a
                href="/posaljite-projekat/"
                class="block w-full py-3 bg-navy-surface hover:bg-accent text-center text-white text-xs uppercase tracking-architectural font-bold border border-white/15 hover:border-accent transition-all duration-200"
              >
                Inicirajte saradnju
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Radni koraci saradnje -->
  <section class="py-16 lg:py-24 bg-navy border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 space-y-5">
          <SectionHeading
            eyebrow="Brz operativni tok"
            title="Kako započinjemo inženjersku saradnju?"
            subtitle="Transparentan proces bez nepotrebnih administrativnih zastoja."
          />
          <p class="text-xs sm:text-sm text-slate-muted leading-relaxed">
            Svaki projekat ima jedinstvene parametre. Dovoljno je da nam dostavite osnovne podatke o geometriji ili preliminarni crtež, a naš tim preuzima tehničku analizu.
          </p>
          <div class="p-4 bg-navy-surface border border-white/10 font-mono text-xs">
            <span class="text-slate-muted block text-[10px] uppercase">Zvanični inženjerski kontakt</span>
            <a href={`mailto:${CONTACT.projectEmail}`} class="text-white hover:text-accent font-bold block mt-1">
              {CONTACT.projectEmail}
            </a>
            <span class="text-slate-muted block text-[10px] uppercase mt-3">Telefon za konsultacije</span>
            <a href={`tel:${CONTACT.phoneFormatted}`} class="text-accent hover:text-white font-bold block mt-1">
              {CONTACT.phone}
            </a>
          </div>
        </div>

        <div class="lg:col-span-7 space-y-4">
          <div class="p-6 bg-navy-surface border border-white/10 flex items-start gap-4">
            <span class="text-2xl font-mono font-extrabold text-accent">01</span>
            <div>
              <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-1">Dostava podloga</h4>
              <p class="text-xs text-slate-muted leading-relaxed">
                Pošaljite nam DWG ili PDF osnovu sa zadatim padovima, kotama i željenom završnom oblogom.
              </p>
            </div>
          </div>

          <div class="p-6 bg-navy-surface border border-white/10 flex items-start gap-4">
            <span class="text-2xl font-mono font-extrabold text-accent">02</span>
            <div>
              <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-1">Inženjerski predlog i predmer</h4>
              <p class="text-xs text-slate-muted leading-relaxed">
                U roku od 24-48h dostavljamo vam predlog podele na modularne segmente sa hidrauličkim kapacitetima i specifikacijom.
              </p>
            </div>
          </div>

          <div class="p-6 bg-navy-surface border border-white/10 flex items-start gap-4">
            <span class="text-2xl font-mono font-extrabold text-accent">03</span>
            <div>
              <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-1">Prefabrikacija i isporuka</h4>
              <p class="text-xs text-slate-muted leading-relaxed">
                Izrađeni elementi dolaze na lokaciju obeleženi po segmentima, spremni za brzu ugradnju od strane vašeg tima.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA sekcija -->
  <section class="py-16 bg-navy-dark bg-grid-pattern">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
      <span class="text-accent font-mono text-xs uppercase tracking-architectural font-bold block">
        Započnite komunikaciju
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        Dostavite nacrt za analizu bez obaveze
      </h2>
      <p class="text-xs sm:text-sm text-slate-muted max-w-xl mx-auto leading-relaxed">
        Naš inženjerski tim radi uvid u vaše crteže i predlaže najekonomičniju i tehnički najčistiju konfiguraciju elemenata.
      </p>
      <div class="pt-3 flex flex-col sm:flex-row justify-center items-center gap-4">
        <a
          href="/posaljite-projekat/"
          class="px-8 py-3.5 bg-accent hover:bg-accent-hover text-white text-xs uppercase tracking-architectural font-bold transition-all border border-accent"
        >
          Pošaljite nam projekat
        </a>
        <a
          href={`tel:${CONTACT.phoneFormatted}`}
          class="px-8 py-3.5 bg-navy-surface hover:bg-white/10 text-white text-xs uppercase tracking-architectural font-bold border border-white/20 transition-all font-mono"
        >
          {CONTACT.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>