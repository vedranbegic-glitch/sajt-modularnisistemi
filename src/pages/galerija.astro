---
import BaseLayout from '../layouts/BaseLayout.astro';
import LightboxModal from '../components/LightboxModal.astro';

const pageTitle = 'Galerija sistema i realizacija';
const pageDescription = 'Fotografije primene modularnih sistema: inox drenažni kanali, arhitektonska rasveta, čelični monoblok podovi i Fire Pit vatrišta.';
const ogImage = '/images/inox/lucni-skriveni-inox-kanal-zalazak-sunca.webp';

// Galerija: po dve slike od svakog proizvoda, hronološki (kasnije se menjaju stvarnim slikama)
const galleryGroups = [
  {
    category: 'inox',
    categoryLabel: 'Inox odvodnjavanje',
    num: '01',
    title: 'S-forma i lučna forma',
    images: [
      {
        src: '/images/inox/skriveni-modularni-inox-kanal-s-forma-bazen-suva-plaza.webp',
        alt: 'S-forma skriveni inox kanal uz bazen i suvu plažu',
        desc: 'Skriveni modularni inox kanal u S-formi uz bazen i suvu plažu.',
      },
      {
        src: '/images/inox/lucni-skriveni-inox-kanal-zalazak-sunca.webp',
        alt: 'Lučni skriveni inox kanal na parteru u zalasku sunca',
        desc: 'Lučni skriveni inox kanal na parteru u zalasku sunca.',
      },
    ],
  },
  {
    category: 'rasveta',
    categoryLabel: 'Moderna rasveta',
    num: '02',
    title: 'Z lampa za dvorišta i šetališta',
    images: [
      {
        src: '/images/rasveta/z-lampa-moderna-led-rasveta-za-dvoriste-ulicna-rasveta-sneg.webp',
        alt: 'Z lampa — moderna LED rasveta za dvorište i ulicu',
        desc: 'Z lampa — moderna LED rasveta za dvorišta i ulice.',
      },
      {
        src: '/images/rasveta/led-rasveta-za-setalista-i-parkove.webp',
        alt: 'LED rasveta za šetališta i parkove',
        desc: 'LED rasveta za šetališta i parkove.',
      },
    ],
  },
  {
    category: 'podovi',
    categoryLabel: 'Modularni podovi',
    num: '03',
    title: 'Terase i eksterijeri',
    images: [
      {
        src: '/images/podovi/modularni-pod-terasa-kisa-noc-1.webp',
        alt: 'Modularni pod na terasi u večernjem ambijentu',
        desc: 'Modularni pod na terasi u večernjem ambijentu.',
      },
      {
        src: '/images/podovi/modularni-pod-terasa-exterijer-moderna-4.webp',
        alt: 'Savremena terasa sa modularnim podnim sistemom',
        desc: 'Savremena eksterijerna terasa sa modularnim podom.',
      },
    ],
  },
  {
    category: 'firepit',
    categoryLabel: 'Fire Pit Grill',
    num: '04',
    title: 'Čelično ložište i roštilj',
    images: [
      {
        src: '/images/fire-pit/fire-pit-grill-celicna-vatra-rostilj.webp',
        alt: 'Fire Pit Grill — čelično ložište i roštilj sa laserskim ornamentima',
        desc: 'Čelično ložište i roštilj sa laserski sečenim ornamentima.',
      },
      {
        src: '/images/fire-pit/fire-pit-grill-terasa-vatra-sumrak.webp',
        alt: 'Fire Pit Grill na terasi u sumrak',
        desc: 'Fire Pit Grill na terasi u sumrak.',
      },
    ],
  },
];

const totalImages = galleryGroups.reduce((sum, group) => sum + group.images.length, 0);
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={ogImage}>
  <div class="galerija-page">
    <!-- HERO & FILTER HEADER -->
    <section class="gallery-hero">
      <div class="wrap">
        <div class="gallery-hero__inner">
          <div class="gallery-hero__text">
            <div class="eyebrow">
              <span></span>
              Vizuelna tehnička arhiva
            </div>
            <h1>Galerija sistema <em>i realizacija.</em></h1>
            <p>
              Fotografije primene naših modularnih sistema na stambenim, javnim i industrijskim objektima.
            </p>
          </div>

          <!-- INTERAKTIVNI FILTER TABOVI -->
          <div class="gallery-filters" role="group" aria-label="Filter galerije">
            <button type="button" class="filter-btn is-active" data-filter="all">Sve ({totalImages})</button>
            <button type="button" class="filter-btn" data-filter="inox">Inox odvodnjavanje</button>
            <button type="button" class="filter-btn" data-filter="rasveta">Moderna rasveta</button>
            <button type="button" class="filter-btn" data-filter="podovi">Modularni podovi</button>
            <button type="button" class="filter-btn" data-filter="firepit">Fire Pit Grill</button>
          </div>
        </div>
      </div>
    </section>

    <!-- GALERIJA PO PROIZVODIMA -->
    <section class="gallery-content">
      <div class="wrap">
        {galleryGroups.map((group) => (
          <div class="gallery-group" data-category={group.category}>
            <div class="group-head">
              <div class="eyebrow">
                <span></span>
                {group.num} · {group.categoryLabel}
              </div>
              <h2>{group.title}</h2>
            </div>

            <div class="group-grid">
              {group.images.map((image) => (
                <button
                  type="button"
                  class="gallery-item"
                  data-src={image.src}
                  data-title={group.title}
                  data-desc={image.desc}
                  data-category-label={group.categoryLabel}
                  aria-label={`Uvećaj: ${image.alt}`}
                >
                  <img src={image.src} alt={image.alt} loading="lazy" />
                  <span class="gallery-item__hover">
                    <span>Uvećaj <b>↗</b></span>
                  </span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA BANER IZNAD FOOTERA -->
    <section class="cta">
      <img
        src="/images/inox/kruzni-skriveni-inox-kanal-oko-zardinjere.webp"
        alt="Zainteresovani ste za primenu ovih rešenja?"
        loading="lazy"
      />
      <div class="cta__shade"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Prilagođena proizvodnja prema projektu
          </div>
          <h2>Zainteresovani ste za primenu <em>ovih rešenja na objektu?</em></h2>
          <p>
            Pošaljite nam arhitektonske podloge, DWG skice ili dimenzije prostora.
            Naš tim priprema kompletan proračun i specifikaciju sistema.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--orange" href="/posaljite-projekat/">
            Pošaljite nam projekat <b>→</b>
          </a>
          <a class="btn btn--ghost" href="tel:+38166241386">
            Pozovite: 066 241 386 <b>↗</b>
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- LIGHTBOX MODAL -->
  <LightboxModal />
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f6f7f9;
    color: #07111e;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .galerija-page {
    --navy: #06131f;
    --navy2: #0b1d2b;
    --orange: #ff6900;
    --orange-hover: #e85e00;
    --line: #dce2e7;
    --muted: #64717c;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .wrap {
    width: min(1280px, calc(100% - 40px));
    margin-inline: auto;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow span {
    display: inline-block;
    width: 20px;
    height: 2px;
    background: var(--orange);
    flex-shrink: 0;
  }

  /* ========== HERO HEADER ========== */
  .gallery-hero {
    background: var(--navy);
    color: #fff;
    padding: 70px 0 54px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .gallery-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .gallery-hero__text h1 {
    margin: 14px 0 0;
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .gallery-hero__text h1 em,
  .cta h2 em {
    font-style: normal;
    color: var(--orange);
  }

  .gallery-hero__text p {
    margin: 14px 0 0;
    max-width: 640px;
    color: #b8c4cb;
    font-size: 15px;
    line-height: 1.6;
  }

  /* ========== FILTER TABOVI ========== */
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-btn {
    background: rgba(255, 255, 255, 0.08);
    color: #d4dee4;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 10px 18px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  .filter-btn.is-active {
    background: var(--orange);
    color: #fff;
    border-color: var(--orange);
    box-shadow: 0 4px 14px rgba(255, 105, 0, 0.3);
  }

  /* ========== GRUPE SLIKA ========== */
  .gallery-content {
    padding: 70px 0 90px;
    background: #f6f7f9;
  }

  .gallery-group + .gallery-group {
    margin-top: 64px;
  }

  .gallery-group.is-hidden {
    display: none;
  }

  .group-head {
    margin-bottom: 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }

  .group-head h2 {
    margin: 10px 0 0;
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #07111e;
  }

  .group-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .gallery-item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: #06131f;
    cursor: pointer;
    font: inherit;
    box-shadow: 0 4px 16px rgba(6, 19, 31, 0.04);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-item:hover,
  .gallery-item:focus-visible {
    transform: translateY(-5px);
    border-color: var(--orange);
    box-shadow: 0 16px 36px rgba(6, 19, 31, 0.12);
  }

  .gallery-item:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 3px;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-item__hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 19, 31, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .gallery-item:hover .gallery-item__hover,
  .gallery-item:focus-visible .gallery-item__hover {
    opacity: 1;
  }

  .gallery-item__hover span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    color: var(--orange);
    background: var(--navy);
    border: 1px solid var(--orange);
    border-radius: 2px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ========== CTA BANER ========== */
  .cta {
    position: relative;
    min-height: 340px;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
    background: var(--navy);
  }

  .cta > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cta__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(6, 19, 31, 0.95) 0%, rgba(6, 19, 31, 0.75) 55%, rgba(6, 19, 31, 0.45) 100%);
  }

  .cta__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    padding: 56px 0;
  }

  .cta h2 {
    margin: 12px 0 0;
    font-size: clamp(26px, 3.3vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: #fff;
  }

  .cta p {
    margin: 12px 0 0;
    max-width: 520px;
    color: #b5c2ca;
    font-size: 14px;
    line-height: 1.6;
  }

  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-shrink: 0;
  }

  .btn {
    min-height: 48px;
    padding: 0 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .btn b { font-size: 15px; font-weight: 600; }

  .btn--orange {
    background: var(--orange);
    color: #fff;
    border: 1px solid var(--orange);
  }

  .btn--orange:hover {
    background: var(--orange-hover);
    border-color: var(--orange-hover);
    transform: translateY(-2px);
  }

  .btn--ghost {
    border: 1px solid rgba(255, 255, 255, 0.45);
    color: #fff;
    background: rgba(0, 0, 0, 0.15);
  }

  .btn--ghost:hover {
    background: #fff;
    color: var(--navy);
    border-color: #fff;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 980px) {
    .cta__inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .cta__actions {
      flex-direction: row;
    }
  }

  @media (max-width: 640px) {
    .wrap {
      width: min(100% - 24px, 1280px);
    }

    .group-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .gallery-group + .gallery-group {
      margin-top: 48px;
    }

    .gallery-filters {
      width: 100%;
    }

    .filter-btn {
      flex: 1 1 calc(50% - 6px);
      text-align: center;
    }

    .cta {
      min-height: 340px;
    }

    .cta__inner {
      padding: 40px 0;
    }

    .cta__actions {
      flex-direction: column;
      width: 100%;
    }

    .cta__actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  // Filtriranje grupa po proizvodu
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const groups = document.querySelectorAll<HTMLElement>('.gallery-group');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      filterButtons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      groups.forEach((group) => {
        const show = filter === 'all' || group.dataset.category === filter;
        group.classList.toggle('is-hidden', !show);
      });
    });
  });

  // Uvećanje slike u lightbox-u (komponenta LightboxModal izlaže window.openModularLightbox)
  type LightboxData = { src: string; title: string; desc: string; category: string };
  const lightboxWindow = window as unknown as {
    openModularLightbox?: (data: LightboxData) => void;
  };

  document.querySelectorAll<HTMLButtonElement>('.gallery-item').forEach((item) => {
    item.addEventListener('click', () => {
      lightboxWindow.openModularLightbox?.({
        src: item.dataset.src ?? '',
        title: item.dataset.title ?? '',
        desc: item.dataset.desc ?? '',
        category: item.dataset.categoryLabel ?? '',
      });
    });
  });
</script>
