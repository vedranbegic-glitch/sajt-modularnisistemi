---
import BaseLayout from '../layouts/BaseLayout.astro';
import LightboxModal from '../components/LightboxModal.astro';

// Galerija koristi postojeće WEBP fotografije; sadržaj se kasnije menja samo ovde.
const gallery = [
  {
    id: 'inox', label: 'Inox odvodnjavanje',
    images: [
      { src: '/images/inox/skriveni-modularni-inox-kanal-s-forma-bazen-suva-plaza.webp', title: 'S-forma · Linija koja prati prostor', alt: 'S-forma inox kanalice uz bazen', desc: 'Prikaz primene inox odvodnjavanja uz bazen.' },
      { src: '/images/inox/lucni-skriveni-inox-kanal-zalazak-sunca.webp', title: 'Lučna forma · Kontinuitet linije', alt: 'Lučni inox kanal u arhitektonskom parteru', desc: 'Prikaz lučnog inox odvodnjavanja u spoljašnjem prostoru.' },
    ],
  },
  {
    id: 'podkonstrukcije', label: 'Čelične podkonstrukcije',
    images: [
      { src: '/images/podovi/modularni-pod-terasa-kisa-noc-1.webp', title: 'Podna površina · Eksterijer', alt: 'Terasa sa modularnim podnim sistemom u večernjem ambijentu', desc: 'Prikaz završne podne površine. Čelična podkonstrukcija nije vidljiva.' },
      { src: '/images/podovi/modularni-pod-terasa-exterijer-moderna-4.webp', title: 'Podna površina · Terasa', alt: 'Moderna terasa sa podnom oblogom', desc: 'Primer završne obloge; izbor obloge zavisi od namene prostora.' },
    ],
  },
  {
    id: 'firepit', label: 'Fire Pit Grill',
    images: [
      { src: '/images/fire-pit/fire-pit-grill-celicna-vatra-rostilj.webp', title: 'Fire Pit Grill · Konstrukcija', alt: 'Čelični Fire Pit Grill sa ornamentima', desc: 'Prikaz čeličnog ložišta i roštilja.' },
      { src: '/images/fire-pit/fire-pit-grill-terasa-vatra-sumrak.webp', title: 'Fire Pit Grill · Atmosfera', alt: 'Fire Pit Grill u ambijentu terase u sumrak', desc: 'Prikaz upotrebe Fire Pit Grill proizvoda u spoljašnjem prostoru.' },
    ],
  },
];

const items = gallery.flatMap((group, groupIndex) => group.images.map((item, imageIndex) => ({
  ...item,
  category: group.id,
  categoryLabel: group.label,
  number: String(groupIndex * 2 + imageIndex + 1).padStart(2, '0'),
})));
---
<BaseLayout
  title="Galerija proizvoda i primene"
  description="Galerija Modularnih Sistema: inox odvodnjavanje, čelične podkonstrukcije i Fire Pit Grill. Fotografije proizvoda, detalja i primene u prostoru."
  ogImage="/images/inox/lucni-skriveni-inox-kanal-zalazak-sunca.webp"
>
  <div class="gallery-page">
    <section class="hero" aria-labelledby="gallery-title">
      <div class="wrap hero__inner">
        <div>
          <p class="eyebrow">Modularni Sistemi / Premium Engineering</p>
          <h1 id="gallery-title">Detalji koji <span>govore za sebe.</span></h1>
        </div>
        <p class="hero__description">Proizvodi, konstrukcija i primena u prostoru. Istražite postojeće prikaze, od inženjerskog detalja do završnog ambijenta.</p>
      </div>
    </section>

    <section class="gallery" aria-label="Fotografije proizvoda">
      <div class="wrap">
        <div class="gallery__top">
          <div>
            <p class="eyebrow">Vizuelna arhiva</p>
            <h2>Proizvodi <span>u fokusu.</span></h2>
          </div>
          <p class="gallery__counter" id="gallery-count" aria-live="polite">{items.length} fotografija</p>
        </div>

        <div class="filters" role="group" aria-label="Filtrirajte fotografije">
          <button class="filter is-active" type="button" data-filter="all" aria-pressed="true">Sve fotografije</button>
          {gallery.map((group) => (
            <button class="filter" type="button" data-filter={group.id} aria-pressed="false">{group.label}</button>
          ))}
        </div>

        <div class="gallery-grid" id="gallery-grid">
          {items.map((item) => (
            <button
              type="button"
              class="gallery-card"
              data-category={item.category}
              data-src={item.src}
              data-title={item.title}
              data-desc={item.desc}
              data-category-label={item.categoryLabel}
              aria-label={`Otvori fotografiju: ${item.title}`}
            >
              <span class="gallery-card__media">
                <img src={item.src} alt={item.alt} loading="lazy" decoding="async" width="960" height="600" />
                <span class="gallery-card__number">{item.number}</span>
                <span class="gallery-card__arrow" aria-hidden="true">↗</span>
              </span>
              <span class="gallery-card__caption">
                <span class="gallery-card__category">{item.categoryLabel}</span>
                <span class="gallery-card__title">{item.title}</span>
              </span>
            </button>
          ))}
        </div>
        <p class="gallery__footnote">Prikazani ambijenti služe za predstavljanje mogućnosti primene. Tehnički podaci nalaze se na stranicama proizvoda.</p>
      </div>
    </section>

    <section class="contact" aria-labelledby="contact-title">
      <div class="wrap contact__inner">
        <div>
          <p class="eyebrow">Vaša ideja je dobar početak</p>
          <h2 id="contact-title">Imate zadatak? <span>Pronađimo rešenje.</span></h2>
          <p>Fotografija, skica ili dimenzije dovoljni su za početak razgovora.</p>
        </div>
        <div class="contact__actions">
          <a class="contact__button" href="/kontakt/">Pošaljite upit <span aria-hidden="true">↗</span></a>
          <a class="contact__email" href="mailto:kontakt@modularnisistemi.com">kontakt@modularnisistemi.com <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>
  <LightboxModal />
</BaseLayout>

<style>
  .gallery-page { --navy: #061b28; --ink: #102432; --orange: #ff6900; --muted: #738794; background: #f1f4f5; color: var(--ink); }
  .wrap { width: min(1200px, calc(100% - 48px)); margin-inline: auto; }
  .eyebrow { display: flex; align-items: center; gap: 11px; margin: 0; color: var(--orange); font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; }
  .eyebrow::before { content: ''; display: block; width: 20px; height: 2px; background: var(--orange); }
  .hero { background: var(--navy); color: #fff; padding: 62px 0 56px; }
  .hero__inner { display: grid; grid-template-columns: 1.3fr .7fr; gap: 55px; align-items: end; }
  .hero h1 { font-size: clamp(38px, 4.3vw, 66px); line-height: 1.02; letter-spacing: -.055em; font-weight: 800; margin: 22px 0 0; max-width: 760px; }
  .hero h1 span, .gallery h2 span, .contact h2 span { color: var(--orange); }
  .hero__description { max-width: 390px; color: #bfd0da; font-size: 14px; line-height: 1.8; margin: 0 0 6px; }
  .gallery { padding: 66px 0 78px; }
  .gallery__top { display: flex; align-items: end; justify-content: space-between; gap: 20px; }
  .gallery h2 { font-size: clamp(30px, 3.1vw, 44px); line-height: 1.1; letter-spacing: -.045em; margin: 17px 0 0; }
  .gallery__counter { color: var(--muted); font-size: 12px; white-space: nowrap; margin: 0 0 4px; }
  .filters { display: flex; flex-wrap: wrap; gap: 0; margin: 29px 0 20px; border-top: 1px solid #cdd6dc; border-bottom: 1px solid #cdd6dc; }
  .filter { background: transparent; border: 0; border-bottom: 2px solid transparent; color: #6b7d89; padding: 15px 22px 13px 0; margin-right: 18px; font: inherit; font-size: 12px; font-weight: 700; cursor: pointer; transition: color .2s, border-color .2s; }
  .filter:hover, .filter.is-active { color: var(--ink); border-bottom-color: var(--orange); }
  .filter:focus-visible, .gallery-card:focus-visible, .contact a:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
  .gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 17px; }
  .gallery-card { padding: 0; background: #fff; border: 1px solid #dde4e7; color: inherit; text-align: left; cursor: pointer; min-width: 0; font: inherit; }
  .gallery-card[hidden] { display: none !important; }
  .gallery-card__media { display: block; position: relative; overflow: hidden; aspect-ratio: 1.55; background: #17242c; }
  .gallery-card__media::after { content: ''; position: absolute; inset: 45% 0 0; background: linear-gradient(transparent,rgba(0,0,0,.23)); pointer-events: none; }
  .gallery-card img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .gallery-card:hover img { transform: scale(1.045); }
  .gallery-card__number { position: absolute; top: 14px; left: 15px; z-index: 1; color: var(--orange); font: 800 11px/1 'Manrope',sans-serif; }
  .gallery-card__arrow { position: absolute; z-index: 1; right: 15px; bottom: 14px; color: #fff; font-size: 24px; line-height: 1; transition: transform .2s; }
  .gallery-card:hover .gallery-card__arrow { transform: translate(3px,-3px); color: var(--orange); }
  .gallery-card__caption { display: flex; flex-direction: column; gap: 7px; padding: 16px 17px 19px; }
  .gallery-card__category { color: var(--orange); font-size: 10px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .gallery-card__title { color: var(--ink); font-size: 17px; line-height: 1.3; font-weight: 800; }
  .gallery__footnote { margin: 19px 0 0; color: var(--muted); font-size: 11px; line-height: 1.6; }
  .contact { background: #e5ecef; padding: 51px 0 58px; border-top: 1px solid #d7e0e5; }
  .contact__inner { display: grid; grid-template-columns: 1fr 270px; gap: 50px; align-items: center; }
  .contact h2 { font-size: clamp(29px,3vw,42px); margin: 15px 0 9px; line-height: 1.14; letter-spacing: -.045em; }
  .contact p:not(.eyebrow) { margin: 0; color: #617888; font-size: 13px; }
  .contact__actions { display: grid; gap: 13px; }
  .contact__button { display: flex; justify-content: space-between; padding: 15px 18px; text-decoration: none; color: #091925; background: var(--orange); font-size: 12px; font-weight: 800; }
  .contact__button:hover { background: #e65f00; }
  .contact__email { display: flex; justify-content: space-between; border-bottom: 1px solid #c4d0d7; padding-bottom: 10px; text-decoration: none; color: var(--ink); font-size: 12px; }
  .contact__email span { color: var(--orange); }
  @media (max-width: 900px) { .hero__inner { grid-template-columns: 1fr; gap: 18px; } .gallery-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .contact__inner { grid-template-columns: 1fr; gap: 25px; } .contact__actions { max-width: 340px; } }
  @media (max-width: 600px) { .wrap { width: calc(100% - 32px); } .hero { padding: 43px 0; } .hero h1 { font-size: clamp(36px,10vw,48px); } .gallery { padding: 45px 0 52px; } .gallery__counter { display: none; } .gallery-grid { grid-template-columns: 1fr; gap: 15px; } .filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: thin; } .filter { white-space: nowrap; flex: 0 0 auto; margin-right: 13px; padding-right: 8px; } .gallery-card__media { aspect-ratio: 1.6; } .contact { padding: 45px 0; } }
  @media (prefers-reduced-motion: reduce) { .gallery-card img, .gallery-card__arrow { transition: none; } }
</style>

<script>
  function initGallery() {
    const root = document.querySelector<HTMLElement>('.gallery-page');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const filters = [...root.querySelectorAll<HTMLButtonElement>('.filter')];
    const cards = [...root.querySelectorAll<HTMLButtonElement>('.gallery-card')];
    const counter = root.querySelector<HTMLElement>('#gallery-count');

    filters.forEach(button => button.addEventListener('click', () => {
      const selected = button.dataset.filter ?? 'all';
      filters.forEach(other => {
        const active = other === button;
        other.classList.toggle('is-active', active);
        other.setAttribute('aria-pressed', String(active));
      });
      let visible = 0;
      cards.forEach(card => {
        card.hidden = selected !== 'all' && card.dataset.category !== selected;
        if (!card.hidden) visible++;
      });
      if (counter) counter.textContent = `${visible} ${visible === 1 ? 'fotografija' : 'fotografija'}`;
    }));

    type LightboxData = { src: string; title: string; desc: string; category: string };
    const modalWindow = window as typeof window & { openModularLightbox?: (data: LightboxData) => void };
    cards.forEach(card => card.addEventListener('click', () => {
      const data = {
        src: card.dataset.src ?? '',
        title: card.dataset.title ?? '',
        desc: card.dataset.desc ?? '',
        category: card.dataset.categoryLabel ?? '',
      };
      if (modalWindow.openModularLightbox) modalWindow.openModularLightbox(data);
      else if (data.src) window.open(data.src, '_blank', 'noopener,noreferrer');
    }));
  }
  initGallery();
  document.addEventListener('astro:page-load', initGallery);
</script>
