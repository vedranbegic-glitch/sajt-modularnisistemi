---

import BaseLayout from '../layouts/BaseLayout.astro';

import { CONTACT } from '../data/siteData';

const phoneDisplay = CONTACT.phone || '+381 (0) 66 241 386';

const phoneHref = '+38166241386';

const generalEmail = CONTACT.generalEmail || 'kontakt@modularnisistemi.com';

const projectEmail = CONTACT.generalEmail || 'kontakt@modularnisistemi.com';

const areas = [

  { n: '01', title: 'Inox odvodnjavanje', detail: 'Geometrija, detalji i izrada na zahtev' },

  { n: '02', title: 'Modularne čelične podkonstrukcije', detail: 'Podesti, platforme i tehnički prostori' },

  { n: '03', title: 'Fire Pit Grill', detail: 'Proizvod, konstrukcija i izvedba' },

  { n: '04', title: 'Projektovanje i 3D modelovanje', detail: 'Modelovanje, mehanizmi i namenski sistemi' },

];

---

<BaseLayout title="Kontakt" description="Kontaktirajte Modularne Sisteme za inox odvodnjavanje, modularne čelične podkonstrukcije, Fire Pit Grill, projektovanje i 3D modelovanje." canonical="https://modularnisistemi.com/kontakt/">

  <div class="contact-page">

    <section class="hero">

      <div class="wrap hero-grid">

        <div class="hero-copy">

          <div class="eyebrow">MODULARNI SISTEMI / PREMIUM ENGINEERING</div>

          <h1>Imate zadatak.<br /><span>Razradimo rešenje.</span></h1>

          <p>Pošaljite nam ideju, crtež, skicu ili opis problema. Razgovaramo o funkciji, konstrukciji i mogućnostima realizacije.</p>

          <div class="hero-actions"><a class="button primary" href="#upit">Pošaljite upit <b>↗</b></a><a class="button secondary" href={`tel:${phoneHref}`}>Pozovite nas <b>↗</b></a></div>

          <div class="hero-foot"><span>OBLIK. FUNKCIJA. KONSTRUKCIJA.</span><span>MS / KONTAKT</span></div>

        </div>

        <div class="study" aria-label="Informacije o komunikaciji">

          <div class="study-top"><span>MS / CONTACT STUDY</span><span>01 — 04</span></div>

          <div class="study-middle"><small>PRVI KORAK / VAŠ ZAHTEV</small><strong>Od ideje do<br /><em>rešenja.</em></strong><div class="study-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div></div>

          <div class="study-bottom">RAZGOVOR / RAZRADA / REALIZACIJA <span>↗</span></div>

        </div>

      </div>

    </section>

    <section class="reach-section" id="upit">

      <div class="wrap">

        <div class="section-head"><div><div class="eyebrow">DIREKTNA KOMUNIKACIJA</div><h2>Jednostavan kontakt.<br /><span>Jasan početak.</span></h2></div><p>Za početak su dovoljni osnovni podaci. Detalje ćemo uskladiti kroz razgovor.</p></div>

        <div class="reach-grid">

          <aside class="reach-info">

            <div class="panel-top"><span>MODULARNI SISTEMI / KONTAKT</span><span>01 / 02</span></div>

            <div class="channel"><small>TELEFON</small><a href={`tel:${phoneHref}`}>{phoneDisplay} <span>↗</span></a></div>

            <div class="channel"><small>PROJEKTI I TEHNIČKI UPITI</small><a href={`mailto:${projectEmail}`}>{projectEmail} <span>↗</span></a></div>

            <div class="channel"><small>OPŠTE INFORMACIJE</small><a href={`mailto:${generalEmail}`}>{generalEmail} <span>↗</span></a></div>

            <p class="aside-note">Skicu ili tehnički crtež možete poslati direktno na adresu za projekte. Ne morate imati završenu dokumentaciju da bismo započeli razgovor.</p>

            <a class="inline-link" href={`mailto:${projectEmail}?subject=Tehni%C4%8Dki%20upit`}>Pošaljite dokumentaciju <span>↗</span></a>

          </aside>

          <div class="form-panel">

            <div class="panel-top light"><span>POŠALJITE UPIT</span><span>02 / 02</span></div>

            <h3>Recite nam šta želite da realizujete.</h3>

            <p class="form-intro">Odaberite oblast i napišite nekoliko rečenica o zahtevu. Polja označena zvezdicom su obavezna.</p>

            <form id="contact-form" name="kontakt" method="POST" action="/hvala/" data-netlify="true" netlify-honeypot="bot-field">

              <input type="hidden" name="form-name" value="kontakt" />

              <p class="honeypot"><label>Ostavite prazno <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

              <div class="form-row"><label>Ime i prezime *<input name="name" autocomplete="name" required placeholder="Ime i prezime" /></label><label>Kompanija / organizacija<input name="company" autocomplete="organization" placeholder="Opciono" /></label></div>

              <div class="form-row"><label>Email adresa *<input type="email" name="email" autocomplete="email" required placeholder="ime@kompanija.rs" /></label><label>Telefon<input type="tel" name="phone" autocomplete="tel" placeholder="+381 ..." /></label></div>

              <label>Oblast interesovanja *<select name="system" required><option value="" selected disabled>Izaberite oblast</option><option value="inox">Inox sistemi odvodnjavanja</option><option value="podkonstrukcije">Modularne čelične podkonstrukcije</option><option value="fire-pit">Fire Pit Grill</option><option value="projektovanje">Projektovanje i 3D modelovanje</option><option value="drugo">Drugo / namensko rešenje</option></select></label>

              <label>Opis zadatka *<textarea name="message" rows="5" required placeholder="Ukratko opišite primenu, željenu konstrukciju, geometriju ili problem koji rešavate..."></textarea></label>

              <p class="privacy">Podatke koristimo za obradu vašeg upita. Više informacija pronađite u <a href="/privatnost/">Politici privatnosti</a>.</p>

              <div class="submit-row"><span>Možete nam pisati i direktno putem emaila.</span><button type="submit" id="contact-submit">Pošaljite poruku <b>↗</b></button></div>

              <p id="contact-error" class="form-error" role="alert" hidden>Slanje nije uspelo. Pokušajte ponovo ili nam pišite direktno na <a href={`mailto:${projectEmail}`}>{projectEmail}</a>.</p>

            </form>

          </div>

        </div>

      </div>

    </section>

    <section class="areas-section"><div class="wrap"><div class="section-head"><div><div class="eyebrow">OBLASTI SARADNJE</div><h2>Različiti zadaci.<br /><span>Jedan pristup.</span></h2></div><p>Naša saradnja ne mora da se uklopi u unapred definisanu kategoriju proizvoda.</p></div><div class="area-list">{areas.map(area => <div class="area"><span class="number">{area.n}</span><strong>{area.title}</strong><p>{area.detail}</p><span class="area-arrow" aria-hidden="true">↗</span></div>)}</div></div></section>

    <section class="last-cta"><div class="wrap last-grid"><div><div class="eyebrow">VAŠ ZADATAK / NAŠA KONSTRUKCIJA</div><h2>Počinjemo od <span>vaše ideje.</span></h2><p>Fotografija, skica ili opis zadatka dovoljni su za početak.</p></div><a class="button primary" href="#upit">Pošaljite upit <b>↗</b></a></div></section>

  </div>

  <style>

    .contact-page{--n:#061b28;--n2:#092434;--orange:#ff6900;--ink:#0b2231;--muted:#69808e;--pale:#eef2f4;color:var(--ink);font-family:Manrope,Montserrat,Arial,sans-serif}

    .contact-page *{box-sizing:border-box}.wrap{width:min(1120px,calc(100% - 44px));margin:auto}.eyebrow{font-size:10px;letter-spacing:.14em;font-weight:800;color:var(--orange);display:flex;align-items:center;gap:11px}.eyebrow:before{content:'';width:21px;height:2px;background:var(--orange)}

    h1,h2,h3,p{margin:0}h1,h2{letter-spacing:-.05em}h1 span,h2 span{color:var(--orange)}

    .hero{background:linear-gradient(112deg,#061824,#081e2b);color:white}.hero-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:64px;padding:70px 0 62px}.hero h1{font-size:clamp(39px,4.6vw,62px);font-weight:800;line-height:1.06;margin:23px 0 15px}.hero-copy>p{font-size:13px;line-height:1.8;color:#acc0cb;max-width:435px}.hero-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.button{min-height:43px;display:inline-flex;align-items:center;justify-content:space-between;gap:25px;padding:0 17px;text-decoration:none;font-size:11px;font-weight:800;transition:background .2s}.button b{font-size:17px;font-weight:600}.primary{color:#081a26;background:var(--orange)}.primary:hover{background:#ff8831}.secondary{color:#fff;border:1px solid #49616f}.secondary:hover{border-color:var(--orange)}.hero-foot{display:flex;justify-content:space-between;max-width:440px;color:#6e8b99;font-size:9px;letter-spacing:.14em;margin-top:31px;padding-top:13px;border-top:1px solid #203b49}

    .study{min-height:270px;border:1px solid #284657;background:linear-gradient(145deg,#0c2a3b,#071c29);box-shadow:10px 10px 0 rgba(255,255,255,.025);display:flex;flex-direction:column}.study-top,.study-bottom,.panel-top{display:flex;justify-content:space-between;align-items:center;font-size:9px;letter-spacing:.12em;color:#83a4b4;padding:13px 16px}.study-top{border-bottom:1px solid #284657}.study-middle{position:relative;flex:1;display:flex;flex-direction:column;justify-content:center;padding:24px 27px;overflow:hidden}.study-middle small{font-size:10px;letter-spacing:.12em;color:var(--orange);font-weight:800}.study-middle strong{font-size:clamp(27px,3vw,37px);line-height:1.13;margin-top:13px;letter-spacing:-.05em;position:relative;z-index:1}.study-middle em{font-style:normal;color:var(--orange)}.study-lines{position:absolute;right:-10px;bottom:15px;display:grid;gap:14px;transform:rotate(-34deg)}.study-lines i{height:1px;width:190px;background:#284b5b}.study-bottom{border-top:1px solid #284657}.study-bottom span{color:var(--orange)}

    .reach-section{background:#f3f6f7;padding:66px 0 78px;scroll-margin-top:78px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:25px}.section-head h2{font-size:clamp(31px,3.1vw,42px);line-height:1.13;margin-top:13px;font-weight:800}.section-head>p{max-width:315px;font-size:12px;line-height:1.7;color:var(--muted)}.reach-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:14px}.reach-info{background:var(--n);color:white;padding:12px 25px 27px}.panel-top{padding:8px 0 16px;border-bottom:1px solid #2d4957}.channel{padding:23px 0;border-bottom:1px solid #294351}.channel small{display:block;color:#96afbd;letter-spacing:.12em;font-size:10px;margin-bottom:8px}.channel a{color:white;text-decoration:none;font-size:clamp(14px,1.3vw,18px);font-weight:700;overflow-wrap:anywhere;display:flex;justify-content:space-between;gap:8px}.channel a:hover,.channel a span{color:var(--orange)}.aside-note{color:#9ab1bf;line-height:1.8;font-size:12px;margin:28px 0 13px}.inline-link{display:inline-flex;gap:24px;color:white;border-bottom:1px solid var(--orange);font-size:12px;text-decoration:none;padding-bottom:9px;font-weight:700}.inline-link span{color:var(--orange)}

    .form-panel{background:#fff;border:1px solid #d7e0e5;padding:12px 27px 28px}.panel-top.light{color:#7c91a0;border-color:#dce4e8}.form-panel h3{font-size:25px;letter-spacing:-.04em;margin:21px 0 6px}.form-intro{font-size:12px;line-height:1.7;color:var(--muted)}form{display:grid;gap:17px;margin-top:21px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}form label{display:flex;flex-direction:column;gap:7px;font-size:11px;font-weight:800;color:var(--ink)}input,select,textarea{width:100%;max-width:100%;border:1px solid #d4dfe5;background:#f9fbfc;padding:12px;font:500 13px Manrope,Arial,sans-serif;color:var(--ink);border-radius:0}input:focus,select:focus,textarea:focus{outline:2px solid var(--orange);outline-offset:1px}textarea{resize:vertical;min-height:120px}.honeypot{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}.privacy,.submit-row>span{font-size:11px;color:var(--muted);line-height:1.65}.privacy a{color:var(--ink)}.submit-row{border-top:1px solid #dce4e8;padding-top:17px;display:flex;align-items:center;justify-content:space-between;gap:15px}.submit-row button{border:0;background:var(--orange);color:#071c29;padding:13px 18px;min-width:178px;display:flex;justify-content:space-between;align-items:center;gap:15px;cursor:pointer;font:800 11px Manrope,Arial,sans-serif}.submit-row button:hover{background:#ff8730}.submit-row button:disabled{opacity:.6;cursor:wait}.submit-row b{font-size:17px}.form-error{border-left:3px solid #d04a23;padding:12px;color:#842e18;background:#fff0ec;font-size:12px}.form-error[hidden]{display:none}

    .areas-section{background:#071c29;color:white;padding:67px 0}.areas-section .section-head>p{color:#9bb0bd}.area-list{border-top:1px solid #304857}.area{display:grid;grid-template-columns:42px 1fr 1.1fr 20px;align-items:center;gap:16px;border-bottom:1px solid #304857;padding:20px 0}.number,.area-arrow{color:var(--orange);font-size:12px;font-weight:800}.area strong{font-size:14px}.area p{font-size:12px;color:#9bb0bd;line-height:1.6}.last-cta{background:#f3f6f7;padding:53px 0}.last-grid{display:flex;align-items:center;justify-content:space-between;gap:30px}.last-cta h2{margin:16px 0 8px;font-size:clamp(28px,3vw,39px)}.last-cta p{font-size:12px;color:var(--muted)}.last-grid .button{min-width:208px}

    @media(max-width:820px){.hero-grid{gap:26px}.reach-grid{grid-template-columns:1fr}.area{grid-template-columns:32px 1fr 20px}.area p{grid-column:2;grid-row:2}.area-arrow{grid-column:3;grid-row:1}}

    @media(max-width:640px){.wrap{width:calc(100% - 32px)}.hero-grid{grid-template-columns:1fr;padding:45px 0;gap:30px}.hero h1{font-size:39px}.study{min-height:220px}.section-head{display:block}.section-head>p{margin-top:15px}.reach-section,.areas-section{padding:47px 0}.reach-info{padding:10px 18px 25px}.form-panel{padding:10px 18px 23px}.form-row{grid-template-columns:1fr}input,select,textarea{font-size:16px}.submit-row{align-items:stretch;flex-direction:column}.submit-row button{width:100%}.last-grid{flex-direction:column;align-items:stretch}.last-grid .button{width:100%}}

    @media(prefers-reduced-motion:reduce){.button{transition:none}}

  </style>

  <script>

    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;

    const contactError = document.getElementById('contact-error') as HTMLElement | null;

    const contactSubmit = document.getElementById('contact-submit') as HTMLButtonElement | null;

    if (contactForm && contactSubmit) {

      contactForm.addEventListener('submit', async (event: SubmitEvent) => {

        event.preventDefault();

        if (!contactForm.reportValidity()) return;

        contactSubmit.disabled = true;

        const previous = contactSubmit.innerHTML;

        contactSubmit.textContent = 'Slanje u toku...';

        if (contactError) contactError.hidden = true;

        try {

          const body = new URLSearchParams();

          new FormData(contactForm).forEach((value, key) => { if (typeof value === 'string') body.append(key, value); });

          const response = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body.toString() });

          if (!response.ok) throw new Error(`Slanje nije uspelo: ${response.status}`);

          window.location.assign('/hvala/');

        } catch {

          if (contactError) { contactError.hidden = false; contactError.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }

        } finally {

          contactSubmit.disabled = false;

          contactSubmit.innerHTML = previous;

        }

      });

    }

  </script>

</BaseLayout>
