---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, CONTACT } from '../data/siteData';

const breadcrumbItems = [
  { label: 'Kontakt' },
];
---

<BaseLayout
  title="Kontakt · Inženjerska podrška i upiti"
  description="Stupite u kontakt sa stručnim timom MODULARNI SISTEMI. Telefon: +381 66 241 386. Email: kontakt@modularnisistemi.com. Tehničke konsultacije za arhitekte i izvođače."
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Hero sekcija -->
  <section class="pt-14 pb-12 bg-navy bg-grid-pattern border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Direktna komunikacija"
        title="Kontaktirajte naš inženjerski tim"
        subtitle="Stojimo vam na raspolaganju za tehničke konsultacije, analizu padova i geometrije, kao i za izradu ponuda za vaše projekte."
        class="mb-0 lg:mb-0"
      />
    </div>
  </section>

  <!-- Kontakt sadržaj -->
  <section class="py-16 lg:py-24 bg-navy-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Zvanične kontakt informacije -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-navy border border-white/10 p-8 shadow-xl space-y-6">
            
            <div class="border-b border-white/10 pb-6">
              <span class="text-accent font-mono text-xs uppercase tracking-architectural font-bold block mb-1">
                Zvanični kontakt
              </span>
              <h2 class="text-2xl font-extrabold text-white tracking-tight">
                {SITE.name}
              </h2>
              <p class="text-xs font-mono uppercase tracking-architectural text-accent font-bold mt-2">
                "{SITE.tagline}"
              </p>
            </div>

            <!-- Kanali komunikacije -->
            <div class="space-y-5 font-mono text-xs">
              <div class="p-4 bg-navy-surface border border-white/10">
                <span class="block text-[10px] text-slate-surface uppercase tracking-architectural mb-1">
                  Telefon (Poziv / WhatsApp)
                </span>
                <a
                  href={`tel:${CONTACT.phoneFormatted}`}
                  class="text-base sm:text-lg font-bold text-white hover:text-accent transition-colors block"
                >
                  {CONTACT.phone}
                </a>
                <span class="text-[10px] text-slate-muted block mt-1">Direktna veza sa tehničkim timom</span>
              </div>

              <div class="p-4 bg-navy-surface border border-white/10">
                <span class="block text-[10px] text-slate-surface uppercase tracking-architectural mb-1">
                  Opšti upiti i informacije
                </span>
                <a
                  href={`mailto:${CONTACT.generalEmail}`}
                  class="text-sm font-bold text-white hover:text-accent transition-colors block break-all"
                >
                  {CONTACT.generalEmail}
                </a>
              </div>

              <div class="p-4 bg-navy-surface border border-white/10">
                <span class="block text-[10px] text-slate-surface uppercase tracking-architectural mb-1">
                  Dostava nacrta i projekata
                </span>
                <a
                  href={`mailto:${CONTACT.projectEmail}`}
                  class="text-sm font-bold text-accent hover:text-white transition-colors block break-all"
                >
                  {CONTACT.projectEmail}
                </a>
                <span class="text-[10px] text-slate-muted block mt-1">Za prijem DWG, PDF i BIM formata</span>
              </div>
            </div>

            <!-- Napomena za slanje tehničke dokumentacije -->
            <div class="pt-2 border-t border-white/10">
              <p class="text-xs text-slate-muted leading-relaxed">
                Imate gotove arhitektonske podloge? Koristite našu namensku formu za slanje fajlova radi brže izrade predmera.
              </p>
              <a
                href="/posaljite-projekat/"
                class="inline-flex items-center gap-2 text-xs uppercase tracking-architectural font-bold text-accent hover:text-white transition-colors mt-3"
              >
                <span>Pošaljite nacrt i specifikaciju</span>
                <span>&rarr;</span>
              </a>
            </div>

          </div>
        </div>

        <!-- Kontakt forma -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>