---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../data/siteData';

const canonicalURL = 'https://modularnisistemi.com/kontakt/';
const pageTitle = 'Kontakt · Tehnička podrška i upiti';
const pageDescription = 'Kontaktirajte tim MODULARNI SISTEMI: telefon +381 66 241 386, tehničke konsultacije za arhitekte, projektante i izvođače.';
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalURL}>
  <div class="kontakt-page">
    <!-- HERO SEKCIJA (BEZ SLIKA, AKCENAT NA TEKSTU) -->
    <section class="hero">
      <div class="hero__glow"></div>
      <div class="hero__grid"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            Direktna komunikacija · Tehnička podrška
          </div>

          <h1>
            Kontaktirajte<br />
            <em>naš tim.</em>
          </h1>

          <p class="hero__lead">
            Stojimo vam na raspolaganju za tehničke konsultacije, analizu padova i geometrije,
            kao i za brzu izradu predmera i ponuda za vaše projekte.
          </p>

          <div class="hero__actions">
            <a class="btn btn--orange" href="#forma">
              Pošaljite upit <b>↓</b>
            </a>
            <a class="btn btn--ghost" href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`}>
              Pozovite: {CONTACT.phone || '+381 66 241 386'} <b>↗</b>
            </a>
          </div>
        </div>

        <div class="hero__specs">
          <div>
            <strong>DIREKTNA VEZA</strong>
            <span>{CONTACT.phone || '+381 66 241 386'}</span>
          </div>
          <div>
            <strong>BRZ ODGOVOR</strong>
            <span>Procena u roku od 24h</span>
          </div>
          <div>
            <strong>CAD / BIM PRIJEM</strong>
            <span>DWG, PDF i IFC formati</span>
          </div>
          <div>
            <strong>KONSULTACIJE</strong>
            <span>Za arhitekte, izvođače i investitore</span>
          </div>
        </div>
      </div>
    </section>

    <!-- GLAVNI KONTAKT BLOK -->
    <section class="contact-main" id="forma">
      <div class="wrap contact-grid">

        <!-- LEVA KOLONA: ZVANIČNE INFORMACIJE -->
        <div class="info-col">
          <div class="info-card">

            <div class="info-card__head">
              <span class="info-badge">Zvanični kontakt</span>
              <h2>MODULARNI SISTEMI</h2>
              <p class="tagline">„JEDAN SISTEM. BEZBROJ MOGUĆNOSTI."</p>
            </div>

            <div class="channels">
              <!-- Telefon -->
              <div class="channel-item">
                <span class="channel-label">Telefon (poziv / WhatsApp)</span>
                <a href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`} class="channel-val channel-val--phone">
                  {CONTACT.phone || '+381 66 241 386'}
                </a>
                <span class="channel-sub">Direktna veza sa našim timom</span>
              </div>

              <!-- Opšti email -->
              <div class="channel-item">
                <span class="channel-label">Opšti upiti i informacije</span>
                <a href={`mailto:${CONTACT.generalEmail || 'kontakt@modularnisistemi.com'}`} class="channel-val">
                  {CONTACT.generalEmail || 'kontakt@modularnisistemi.com'}
                </a>
                <span class="channel-sub">Komercijala, saradnja i opšta pitanja</span>
              </div>

              <!-- Email za projekte -->
              <div class="channel-item channel-item--accent">
                <span class="channel-label">Dostava nacrta i projekata</span>
                <a href={`mailto:${CONTACT.projectEmail || 'projekti@modularnisistemi.com'}`} class="channel-val">
                  {CONTACT.projectEmail || 'projekti@modularnisistemi.com'}
                </a>
                <span class="channel-sub">Za prijem DWG, PDF i BIM formata</span>
              </div>
            </div>

            <!-- Prečica za namensku formu -->
            <div class="doc-notice">
              <p>
                Imate gotove arhitektonske podloge? Koristite našu namensku formu za bržu izradu proračuna i specifikacije.
              </p>
              <a href="/posaljite-upit/" class="doc-link">
                Pošaljite crtež ili skicu <b>→</b>
              </a>
            </div>

          </div>
        </div>

        <!-- DESNA KOLONA: FORMA -->
        <div class="form-col">
          <div class="form-card">
            <div class="form-card__head">
              <span class="form-badge">B2B i privatni upiti</span>
              <h3>Pošaljite nam svoj upit</h3>
              <p>
                Popunite osnovne podatke o objektu, a naš inženjer će vam se javiti sa tehničkom analizom i predlogom rešenja.
              </p>
            </div>

            <form
              id="contact-form"
              class="engineering-form"
              name="kontakt"
              method="POST"
              action="/hvala/"
              data-netlify="true"
              netlify-honeypot="bot-field"
            >
              <!-- Netlify Forms: obavezno polje sa imenom forme -->
              <input type="hidden" name="form-name" value="kontakt" />

              <!-- Honeypot protiv spam botova (korisnici ga ne vide) -->
              <p class="hp" aria-hidden="true">
                <label>Ne popunjavajte ovo polje: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
              </p>

              <div class="form-row">
                <div class="form-group">
                  <label for="name">Ime i prezime <span>*</span></label>
                  <input type="text" id="name" name="name" autocomplete="name" placeholder="npr. Marko Jovanović" required />
                </div>
                <div class="form-group">
                  <label for="company">Kompanija / Arhitektonski biro</label>
                  <input type="text" id="company" name="company" autocomplete="organization" placeholder="npr. Studio Arch d.o.o." />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="email">Email adresa <span>*</span></label>
                  <input type="email" id="email" name="email" autocomplete="email" placeholder="vas.email@domen.rs" required />
                </div>
                <div class="form-group">
                  <label for="phone">Broj telefona <span>*</span></label>
                  <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+381 6... ..." required />
                </div>
              </div>

              <div class="form-group">
                <label for="system">Sistem koji vas zanima <span>*</span></label>
                <select id="system" name="system" required>
                  <option value="" disabled selected>Izaberite kategoriju sistema</option>
                  <option value="inox">Inox sistemi odvodnjavanja (kanali, rešetke, bazeni)</option>
                  <option value="podovi">Modularni podni sistemi (monoblok 1x1m paneli)</option>
                  <option value="rasveta">Moderna rasveta (Z lampa / bandera 3m, 4m, 5m)</option>
                  <option value="fire-pit">Fire Pit Grill (ložište i roštilj)</option>
                  <option value="kombinovano">Kombinovano / kompletan arhitektonski projekat</option>
                </select>
              </div>

              <div class="form-group">
                <label for="message">Opis zahteva i specifikacija prostora <span>*</span></label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  placeholder="Opišite zahteve prostora, potrebne dužine kanala, dimenzije terase, željenu visinu rasvete ili rokove realizacije..."
                  required
                ></textarea>
              </div>

              <p class="form-privacy">
                Slanjem poruke pristajete da obradimo vaše podatke isključivo radi odgovora na upit, u skladu sa
                <a href="/privatnost/">Politikom privatnosti</a>.
              </p>

              <div class="form-footer">
                <p class="form-note">
                  Imate crtež ili skicu? <a href="/posaljite-upit/">Pošaljite ih ovde</a>.
                </p>
                <button type="submit" class="btn btn--orange" id="submit-btn">
                  Pošaljite poruku <b>→</b>
                </button>
              </div>

              <!-- Poruka greške -->
              <div id="form-error" class="form-status is-error" role="alert" style="display: none;">
                <strong>Slanje nije uspelo.</strong> Pokušajte ponovo, pozovite nas na
                <a href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`}>{CONTACT.phone || '+381 66 241 386'}</a>
                ili pošaljite email na
                <a href={`mailto:${CONTACT.generalEmail || 'kontakt@modularnisistemi.com'}`}>{CONTACT.generalEmail || 'kontakt@modularnisistemi.com'}</a>.
              </div>
            </form>
          </div>
        </div>

      </div>
    </section>

    <!-- DONJI BANER (CTA IZNAD FOOTERA, BEZ SLIKE) -->
    <section class="cta">
      <div class="cta__glow"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Tehnička podrška projektantima
          </div>
          <h2>Planirate projekat <em>specifične geometrije?</em></h2>
          <p>
            Dostavite DWG, skicu ili osnovu prostora. Razradićemo formu i predložiti rešenje koje tačno prati vaš projekat.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--orange" href="/posaljite-upit/">
            Pošaljite upit <b>→</b>
          </a>
          <a class="btn btn--ghost" href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`}>
            Pozovite: {CONTACT.phone || '+381 66 241 386'} <b>↗</b>
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #f6f7f9;
      color: #07111e;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .kontakt-page {
      --navy: #06131f;
      --navy2: #0b1d2b;
      --orange: #ff6900;
      --orange-hover: #e85e00;
      --line: #dce2e7;
      --muted: #64717c;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }

    .wrap {
      width: min(1280px, calc(100% - 40px));
      margin-inline: auto;
    }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      min-height: 540px;
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
      color: #fff;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }

    .hero__glow {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 70% at 85% 20%, rgba(255, 105, 0, 0.16), transparent 70%),
        radial-gradient(ellipse 50% 60% at 10% 100%, rgba(255, 255, 255, 0.05), transparent 70%);
      z-index: -2;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(90deg, black, transparent 80%);
      -webkit-mask-image: linear-gradient(90deg, black, transparent 80%);
      z-index: -1;
    }

    .hero__content {
      padding-top: 80px;
      padding-bottom: 56px;
      display: grid;
      grid-template-columns: minmax(0, 720px) 1fr;
      gap: 50px;
      align-items: end;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .eyebrow span {
      display: inline-block;
      width: 20px;
      height: 2px;
      background: var(--orange);
      flex-shrink: 0;
    }

    h1, h2, h3, p {
      margin: 0;
    }

    .hero h1 {
      margin-top: 18px;
      font-size: clamp(36px, 4.4vw, 56px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .hero h1 em,
    .cta h2 em {
      font-style: normal;
      color: var(--orange);
    }

    .hero__lead {
      margin-top: 18px;
      max-width: 600px;
      color: #d4dee4;
      font-size: 15px;
      line-height: 1.65;
    }

    .hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 28px;
    }

    .btn {
      min-height: 48px;
      padding: 0 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: all 0.25s ease;
      cursor: pointer;
      border: none;
    }

    .btn b {
      font-size: 15px;
      font-weight: 600;
    }

    .btn--orange {
      background: var(--orange);
      color: #fff;
      border: 1px solid var(--orange);
    }

    .btn--orange:hover {
      background: var(--orange-hover);
      border-color: var(--orange-hover);
      transform: translateY(-2px);
    }

    .btn--orange:disabled {
      opacity: 0.7;
      cursor: wait;
      transform: none;
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
      background: rgba(0, 0, 0, 0.15);
    }

    .btn--ghost:hover {
      background: #fff;
      color: var(--navy);
      border-color: #fff;
    }

    .hero__specs {
      border-left: 1px solid rgba(255, 255, 255, 0.2);
      padding-left: 28px;
      display: grid;
      gap: 18px;
    }

    .hero__specs strong {
      display: block;
      font-size: 14px;
      letter-spacing: 0.03em;
      font-weight: 700;
      color: #fff;
    }

    .hero__specs span {
      display: block;
      margin-top: 3px;
      color: #a9b6be;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    /* ========== CONTACT MAIN GRID ========== */
    .contact-main {
      padding: 70px 0 90px;
      background: #f6f7f9;
      border-bottom: 1px solid var(--line);
      scroll-margin-top: 80px;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: minmax(0, 4.5fr) minmax(0, 7.5fr);
      gap: 40px;
      align-items: stretch;
    }

    /* ========== LEVA KARTICA INFORMACIJA ========== */
    .info-card {
      background: var(--navy);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 2px;
      padding: 36px 32px;
      color: #fff;
      box-shadow: 0 16px 36px rgba(6, 19, 31, 0.1);
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    /* Obe kolone su iste visine: kartice se razvlače do dna */
    .info-col,
    .form-col {
      display: flex;
      flex-direction: column;
    }

    .form-card {
      flex: 1;
    }

    .info-badge {
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      display: block;
      margin-bottom: 6px;
    }

    .info-card__head h2 {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .tagline {
      margin-top: 6px;
      font-size: 11px;
      letter-spacing: 0.1em;
      color: var(--orange);
      font-weight: 700;
      text-transform: uppercase;
    }

    .channels {
      margin-top: 28px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      flex: 1;
    }

    .channel-item {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 2px;
      padding: 16px;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      transition: border-color 0.2s ease;
    }

    .channel-item:hover {
      border-color: rgba(255, 255, 255, 0.2);
    }

    .channel-item--accent {
      border-left: 3px solid var(--orange);
    }

    .channel-label {
      display: block;
      color: #8c9da8;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 4px;
    }

    .channel-val {
      display: block;
      color: #fff;
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
      overflow-wrap: anywhere;
      transition: color 0.2s;
    }

    .channel-val:hover {
      color: var(--orange);
    }

    .channel-val--phone {
      font-size: 20px;
      color: var(--orange);
    }

    .channel-sub {
      display: block;
      margin-top: 4px;
      font-size: 11px;
      color: #8c9da8;
    }

    .doc-notice {
      margin-top: 26px;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .doc-notice p {
      font-size: 12px;
      line-height: 1.55;
      color: #a9b6be;
    }

    .doc-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 700;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .doc-link:hover {
      text-decoration: underline;
    }

    /* ========== DESNA KARTICA SA FORMOM ========== */
    .form-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 40px;
      box-shadow: 0 4px 24px rgba(6, 19, 31, 0.04);
    }

    .form-badge {
      color: var(--orange);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      display: block;
      margin-bottom: 6px;
    }

    .form-card__head h3 {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #07111e;
    }

    .form-card__head p {
      margin-top: 8px;
      font-size: 13.5px;
      line-height: 1.6;
      color: var(--muted);
    }

    .engineering-form {
      margin-top: 28px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .hp {
      display: none;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #07111e;
    }

    .form-group label span {
      color: var(--orange);
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 14px;
      background: #fbfcfd;
      border: 1px solid var(--line);
      border-radius: 2px;
      font-family: inherit;
      font-size: 13.5px;
      color: #07111e;
      transition: all 0.2s ease;
      outline: none;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      background: #fff;
      border-color: var(--orange);
      box-shadow: 0 0 0 3px rgba(255, 105, 0, 0.12);
    }

    .form-privacy {
      font-size: 12px;
      line-height: 1.5;
      color: var(--muted);
    }

    .form-privacy a {
      color: #07111e;
      font-weight: 700;
      text-decoration: underline;
    }

    .form-privacy a:hover {
      color: var(--orange);
    }

    .form-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-top: 8px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }

    .form-note {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.4;
    }

    .form-note a {
      color: var(--orange);
      font-weight: 700;
      text-decoration: none;
    }

    .form-note a:hover {
      text-decoration: underline;
    }

    .form-status {
      padding: 14px 18px;
      border-radius: 2px;
      font-size: 13px;
      line-height: 1.5;
    }

    .form-status.is-success {
      background: #edfbf2;
      border: 1px solid #a3e6ba;
      color: #12632e;
    }

    .form-status.is-error {
      background: #fff1ee;
      border: 1px solid #f3b5a6;
      color: #9a2a10;
    }

    .form-status.is-error a {
      color: inherit;
      font-weight: 700;
      text-decoration: underline;
    }

    /* ========== CTA BANER ========== */
    .cta {
      position: relative;
      min-height: 300px;
      display: flex;
      align-items: center;
      color: #fff;
      overflow: hidden;
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
      isolation: isolate;
    }

    .cta__glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 50% 90% at 90% 50%, rgba(255, 105, 0, 0.14), transparent 70%);
      z-index: -1;
    }

    .cta__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 36px;
      padding: 56px 0;
    }

    .cta h2 {
      margin-top: 12px;
      font-size: clamp(26px, 3.3vw, 42px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .cta p {
      margin-top: 12px;
      max-width: 520px;
      color: #b5c2ca;
      font-size: 14px;
      line-height: 1.6;
    }

    .cta__actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex-shrink: 0;
    }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 1024px) {
      .contact-grid {
        grid-template-columns: 1fr;
        gap: 36px;
      }
    }

    @media (max-width: 980px) {
      .hero__content {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .hero__specs {
        display: none;
      }

      .cta__inner {
        flex-direction: column;
        align-items: flex-start;
      }

      .cta__actions {
        flex-direction: row;
        flex-wrap: wrap;
      }
    }

    @media (max-width: 640px) {
      .wrap {
        width: min(100% - 24px, 1280px);
      }

      .hero {
        min-height: 480px;
      }

      .hero__content {
        padding-top: 60px;
        padding-bottom: 40px;
      }

      .hero h1 {
        font-size: 32px;
      }

      .info-card,
      .form-card {
        padding: 24px 20px;
      }

      .form-row {
        grid-template-columns: 1fr;
        gap: 20px;
      }

      /* 16px sprečava automatski zoom na iPhone-u pri fokusu polja */
      .form-group input,
      .form-group select,
      .form-group textarea {
        font-size: 16px;
      }

      .form-footer {
        flex-direction: column;
        align-items: flex-start;
      }

      .form-footer .btn {
        width: 100%;
      }

      .cta__inner {
        padding: 40px 0;
      }

      .cta__actions {
        flex-direction: column;
        width: 100%;
      }

      .cta__actions .btn {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .btn,
      .channel-item,
      .channel-val,
      .form-group input,
      .form-group select,
      .form-group textarea {
        transition: none;
      }

      .btn--orange:hover {
        transform: none;
      }

      :global(html) {
        scroll-behavior: auto;
      }
    }
  </style>

  <script>
    // Slanje kontakt forme na Netlify Forms (AJAX) sa prikazom uspeha / greške
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const errorMsg = document.getElementById('form-error') as HTMLElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    if (form && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const originalLabel = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Slanje u toku...';
        if (errorMsg) errorMsg.style.display = 'none';

        try {
          const formData = new FormData(form);
          const body = new URLSearchParams(formData as unknown as Record<string, string>).toString();

          const response = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body,
          });

          if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
          }

          // Stranica zahvalnice se koristi i za merenje konverzija
          window.location.href = '/hvala/';
          return;
        } catch (err) {
          if (errorMsg) {
            errorMsg.style.display = 'block';
            errorMsg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalLabel;
        }
      });
    }
  </script>
</BaseLayout>
