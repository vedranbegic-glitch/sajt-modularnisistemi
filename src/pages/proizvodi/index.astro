---
import BaseLayout from '../../layouts/BaseLayout.astro';

const programs = [
  {
    id: '01',
    name: 'Inox sistemi odvodnjavanja',
    statement: 'Geometrija koja prati prostor.',
    summary: 'Ravne, lučne, kružne, elipsaste i S-forme. Konstrukcija i dimenzije na zahtev, uz pažnju posvećenu svakom detalju.',
    image: '/images/engineering/hero-inox-s-forma-premium.webp',
    alt: 'Inox S-forma kanalice u premium arhitektonskom studiju',
    href: '/inox-sistemi-odvodnjavanja/',
    tags: ['AISI 304 / 316', 'Lim 2 mm', 'Geometrija na zahtev'],
  },
  {
    id: '02',
    name: 'Modularne čelične podkonstrukcije',
    statement: 'Čelična osnova. Sloboda primene.',
    summary: 'Modularna osnova za podeste, platforme oko mašina, tehničke prostore i druge namene. Završna obloga bira se prema projektu.',
    image: '/images/podovi/modularni-pod-terasa-exterijer-moderna-4.webp',
    alt: 'Primer prostora sa podnom površinom i modularnom konstrukcijom',
    href: '/modularne-celicne-podkonstrukcije/',
    tags: ['Čelični moduli', 'Nivelacija', 'Različite primene'],
  },
  {
    id: '03',
    name: 'Fire Pit Grill',
    statement: 'Konstrukcija, vatra i funkcija.',
    summary: 'Čelični element za okupljanje i pripremu hrane na otvorenom. Proizvod u kojem materijal, oblik i funkcija čine celinu.',
    image: '/images/fire-pit/fire-pit-grill-terasa-vatra-sumrak.webp',
    alt: 'Fire Pit Grill u večernjem ambijentu terase',
    href: '/fire-pit-grill/',
    tags: ['Čelična konstrukcija', 'Spoljašnja primena', 'Funkcionalan dizajn'],
  },
];

const pageTitle = 'Proizvodni programi';
const pageDescription = 'Inox sistemi odvodnjavanja, modularne čelične podkonstrukcije i Fire Pit Grill. Precizna konstrukcija i rešenja prilagođena nameni prostora.';
const ogImage = '/images/engineering/hero-inox-s-forma-premium.webp';
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={ogImage}>
  <div class="programs-page">
    <section class="hero" aria-labelledby="programs-title">
      <div class="container hero__grid">
        <div class="hero__copy">
          <p class="eyebrow"><span></span> MODULARNI SISTEMI / PREMIUM ENGINEERING</p>
          <h1 id="programs-title">Proizvodi sa <em>razlogom.</em></h1>
          <p class="hero__lead">Različiti sistemi. Jedan princip: precizna konstrukcija, funkcionalni detalji i rešenja koja odgovaraju prostoru.</p>
          <a class="button button--orange" href="#programi">Istražite programe <span aria-hidden="true">↗</span></a>
          <p class="hero__note">OBLIK. FUNKCIJA. KONSTRUKCIJA.</p>
        </div>
        <a class="hero__visual" href={programs[0].href} aria-label="Istražite inox sisteme odvodnjavanja">
          <img src={programs[0].image} alt={programs[0].alt} width="1280" height="720" fetchpriority="high" />
          <span class="hero__visual-top">PROIZVOD U FOKUSU <strong>01 / 03</strong></span>
          <span class="hero__visual-bottom"><strong>Inox odvodnjavanje</strong><span aria-hidden="true">↗</span></span>
        </a>
      </div>
      <div class="container hero__strip" aria-label="Proizvodni programi">
        {programs.map((p) => <a href={`#program-${p.id}`}><small>{p.id}</small>{p.name}<span aria-hidden="true">↗</span></a>)}
      </div>
    </section>

    <section class="catalog" id="programi" aria-labelledby="catalog-title">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow"><span></span> PROIZVODNI PROGRAM</p><h2 id="catalog-title">Različiti sistemi.<br /><em>Jedan standard pristupa.</em></h2></div>
          <p>Upoznajte naše proizvode i konstrukciona rešenja. Detaljne informacije nalaze se na stranicama pojedinačnih programa.</p>
        </div>
        <div class="catalog__items">
          {programs.map((p) => (
            <article class="program" id={`program-${p.id}`}>
              <a class="program__image" href={p.href} aria-label={`Otvori: ${p.name}`}>
                <img src={p.image} alt={p.alt} loading="lazy" decoding="async" />
                <span>PROGRAM / {p.id}</span>
              </a>
              <div class="program__body">
                <span class="program__num">MODULARNI SISTEMI — {p.id}</span>
                <h3>{p.name}</h3>
                <p class="program__statement">{p.statement}</p>
                <p class="program__summary">{p.summary}</p>
                <div class="program__tags">{p.tags.map((tag) => <span>{tag}</span>)}</div>
                <a class="program__link" href={p.href}>Istražite program <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="principle" aria-labelledby="principle-title">
      <div class="container principle__grid">
        <div><p class="eyebrow"><span></span> NAŠ PRISTUP</p><h2 id="principle-title">Sistem se prilagođava <em>zadatku.</em></h2></div>
        <p>Od oblika inox kanalice do čelične podkonstrukcije, polazimo od funkcije, uslova upotrebe i konkretnih zahteva. Tehničku razradu i detalje usaglašavamo pre izrade kada je to potrebno.</p>
      </div>
    </section>

    <section class="contact" aria-labelledby="contact-title">
      <div class="container contact__grid">
        <div><p class="eyebrow"><span></span> VAŠA IDEJA JE DOBAR POČETAK</p><h2 id="contact-title">Imate zadatak?<br /><em>Pronađimo rešenje.</em></h2><p>Fotografija, skica, dimenzije ili kratak opis dovoljni su za prvi razgovor.</p></div>
        <div class="contact__actions">
          <a class="button button--orange" href="/posaljite-upit/">Pošaljite upit <span aria-hidden="true">↗</span></a>
          <a class="contact__email" href="mailto:kontakt@modularnisistemi.com">kontakt@modularnisistemi.com <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .programs-page{--navy:#071b29;--deep:#06131f;--ink:#122431;--accent:#ff6900;--muted:#6e7f89;background:#f1f4f5;color:var(--ink);font-family:Manrope,system-ui,sans-serif;overflow-x:clip}
  .programs-page *{box-sizing:border-box}.programs-page h1,.programs-page h2,.programs-page h3,.programs-page p{margin:0}.programs-page a{text-decoration:none}.programs-page em{font-style:normal;color:var(--accent)}
  .container{width:min(1200px,calc(100% - 64px));margin-inline:auto}.eyebrow{display:flex;align-items:center;gap:11px;font-size:10px;letter-spacing:.14em;font-weight:800;color:#d7580a}.eyebrow span{width:21px;height:2px;background:var(--accent);flex:none}
  .hero{background:var(--deep);color:white;padding-top:36px}.hero__grid{display:grid;grid-template-columns:43% minmax(0,1fr);gap:45px;align-items:center;min-height:395px}.hero__copy{padding:20px 0 35px}.hero .eyebrow{color:#ff9a50}.hero h1{font-size:clamp(41px,4.7vw,68px);letter-spacing:-.065em;line-height:1.04;max-width:510px;margin:28px 0 19px;font-weight:800}.hero__lead{color:#bfd0da;max-width:440px;line-height:1.7;font-size:14px;margin-bottom:25px!important}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;padding:14px 18px;font-size:12px;font-weight:800;min-height:47px;border:1px solid transparent}.button--orange{background:var(--accent);color:#091521}.button span,.program__link span,.contact__email span{font-size:19px}.hero__note{margin-top:24px!important;font-size:9px;letter-spacing:.16em;color:#869eab}
  .hero__visual{position:relative;display:block;height:340px;overflow:hidden;background:#111b21;border:1px solid #ffffff24}.hero__visual img{width:100%;height:100%;object-fit:cover;object-position:center;display:block}.hero__visual:after{content:'';position:absolute;inset:30% 0 0;background:linear-gradient(transparent,#06131fb8);pointer-events:none}.hero__visual-top,.hero__visual-bottom{position:absolute;z-index:1;left:20px;right:20px;display:flex;justify-content:space-between;align-items:center;color:white}.hero__visual-top{top:18px;font-size:9px;letter-spacing:.13em}.hero__visual-top strong{color:#ff9b55}.hero__visual-bottom{bottom:17px}.hero__visual-bottom strong{font-size:21px;letter-spacing:-.04em}.hero__visual-bottom>span{font-size:23px;color:#ff8535}
  .hero__strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid #ffffff31}.hero__strip a{display:flex;align-items:center;gap:10px;min-height:55px;padding:12px 15px;color:#d2dfe5;font-size:12px;border-right:1px solid #ffffff21}.hero__strip a:first-child{padding-left:0}.hero__strip a:last-child{border-right:0}.hero__strip small{color:#ff873d;font-size:10px}.hero__strip a>span{margin-left:auto;color:#ff873d;font-size:16px}
  .catalog{padding:65px 0 75px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:32px;margin-bottom:27px}.section-heading h2,.principle h2,.contact h2{font-size:clamp(32px,3.6vw,49px);line-height:1.07;letter-spacing:-.055em;font-weight:800;margin-top:15px}.section-heading h2 em{color:#83919a}.section-heading>p{max-width:335px;color:var(--muted);font-size:13px;line-height:1.75}
  .catalog__items{display:grid;gap:15px}.program{display:grid;grid-template-columns:47% 53%;min-height:270px;background:#fff;border:1px solid #dce3e7}.program__image{position:relative;min-height:270px;display:block;overflow:hidden;background:#15212a}.program__image img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;transition:transform .45s}.program:first-child .program__image img{object-position:center}.program__image:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#06131f66,transparent 40%)}.program__image>span{position:absolute;top:19px;left:22px;z-index:1;color:#fff;font-size:9px;letter-spacing:.15em;font-weight:700}.program__body{padding:25px 35px;display:flex;flex-direction:column;align-items:start}.program__num{font-size:9px;letter-spacing:.15em;color:#c35817;font-weight:800}.program h3{font-size:clamp(20px,2.1vw,28px);letter-spacing:-.04em;line-height:1.18;margin-top:11px}.program__statement{font-size:16px;color:#e2620e;font-weight:800;margin-top:7px!important}.program__summary{font-size:12px;line-height:1.7;color:#657480;margin-top:10px!important;max-width:520px}.program__tags{display:flex;flex-wrap:wrap;gap:6px;margin:13px 0}.program__tags span{font-size:10px;border:1px solid #d6dee3;padding:5px 8px;color:#435767}.program__link{display:flex;align-items:center;gap:18px;color:#132939;font-size:11px;font-weight:800;margin-top:auto;border-bottom:1px solid var(--accent);padding-bottom:5px}.program__link span{color:var(--accent)}
  .principle{background:#071b29;color:white;padding:53px 0}.principle__grid{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:60px}.principle h2{max-width:530px}.principle p:last-child{color:#b4c5ce;font-size:14px;line-height:1.85;max-width:460px}
  .contact{padding:58px 0;background:#e9eff1}.contact__grid{display:flex;justify-content:space-between;align-items:center;gap:40px}.contact h2{margin-top:12px}.contact h2 em{color:var(--accent)}.contact__grid>div>p:last-child{font-size:12px;color:#697b86;margin-top:10px!important}.contact__actions{display:flex;flex-direction:column;gap:11px;width:270px;flex:none}.contact__email{display:flex;justify-content:space-between;align-items:center;gap:12px;border-bottom:1px solid #bac7cf;padding:12px 0;color:#293e4d;font-size:12px}.contact__email span{color:#cf570d}
  @media(hover:hover){.program__image:hover img{transform:scale(1.035)}.button--orange:hover{background:#ff8a35}.program__link:hover{color:#df610f}.hero__strip a:hover{background:#ffffff0e}}
  @media(max-width:850px){.container{width:calc(100% - 40px)}.hero__grid{gap:24px;grid-template-columns:1fr 1fr}.hero__visual{height:300px}.program{grid-template-columns:44% 56%}.program__body{padding:22px}.principle__grid{gap:30px}}
  @media(max-width:650px){.container{width:calc(100% - 32px)}.hero{padding-top:20px}.hero__grid{grid-template-columns:1fr;gap:3px;min-height:0}.hero__copy{padding:17px 0 12px}.hero h1{font-size:clamp(39px,11vw,53px);margin:20px 0 13px}.hero__lead{margin-bottom:18px!important}.hero__note{display:none}.hero__visual{height:225px;margin-bottom:22px}.hero__strip{grid-template-columns:1fr}.hero__strip a{min-height:42px;border-right:0;border-bottom:1px solid #ffffff21;padding:9px 0!important}.hero__strip a:last-child{border-bottom:0}.catalog{padding:45px 0}.section-heading{display:block;margin-bottom:22px}.section-heading h2,.principle h2,.contact h2{font-size:34px}.section-heading>p{margin-top:16px!important}.catalog__items{gap:17px}.program{grid-template-columns:1fr}.program__image{min-height:210px}.program__body{padding:21px 19px}.program__summary{font-size:13px}.program__tags{margin-bottom:17px}.principle{padding:45px 0}.principle__grid{grid-template-columns:1fr;gap:17px}.contact{padding:44px 0}.contact__grid{display:block}.contact__actions{width:100%;margin-top:24px}}
  @media(prefers-reduced-motion:reduce){.program__image img{transition:none}}
</style>
