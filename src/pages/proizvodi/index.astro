---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Hero slajder sa sva 4 programa
const heroSlides = [
  {
    src: '/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp',
    alt: 'Modularni sistemi — lučni inox kanal u pejzažnom parteru',
    position: 'center',
  },
  {
    src: '/images/rasveta/z-lampa-moderna-led-rasveta-za-dvoriste-ulicna-rasveta.webp',
    alt: 'Z lampa — moderna LED rasveta za dvorište i ulicu',
    position: '70% center',
  },
  {
    src: '/images/podovi/modularni-pod-terasa-kamene-staze-basta-2.webp',
    alt: 'Modularni podni sistemi — fabrički sklopljeni paneli za terase i partere',
    position: 'center',
  },
  {
    src: '/images/fire-pit/fire-pit-grill-terasa-vatra-sumrak.webp',
    alt: 'Fire Pit Grill — čelično ložište i roštilj na terasi',
    position: 'center',
  },
];

// SVA 4 PROIZVODNA PROGRAMA (100% ČIST WEBM)
const categories = [
  {
    num: '01',
    title: 'Inox sistemi odvodnjavanja',
    headline: 'Precizno odvodnjavanje koje prati geometriju prostora.',
    description: 'Modularni inox sistemi sa integrisanim fabričkim padom i nivelirajućim stopama za ravne, lučne, kružne i S-forme partera bez kompromisa na terenu.',
    slug: '/inox-sistemi-odvodnjavanja/',
    image: '/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp',
    video: '/videos/inox-sistemi-odvodnjavanja.webm',
    alt: 'Modularni inox sistemi odvodnjavanja',
    highlights: [
      'Izrada formi po tačnoj geometriji (radijusi, krivine, S-linije)',
      'Sertifikovani inox lim debljine 2.0 mm (AISI 304 / 316)',
      'Fabrički integrisan unutrašnji pad (0.5% – 1%)',
      'Nivelirajuće stope za milimetarsko ravnanje pre betoniranja',
      'Sistemski prirubnički spoj sa trajnom hidroizolacijom',
    ],
  },
  {
    num: '02',
    title: 'Moderna rasveta',
    headline: 'Arhitektonska rasveta koja spaja funkciju i estetiku.',
    description: 'Arhitektonska Z-lampa u visinama od 3m, 4m i 5m sa IP65 zaštitom i podesivom LED snagom, namenjena za dvorišta, parkinge, poslovne zone i javne prostore.',
    slug: '/moderna-rasveta/',
    image: '/images/rasveta/z-lampa-dimenzije-visina-tehnicki-detalji.webp',
    video: '/videos/moderna-rasveta.webm',
    alt: 'Z lampa moderna arhitektonska LED rasveta',
    highlights: [
      'Dostupne tipske visine stuba: 3 m / 4 m / 5 m',
      'Podesiva LED snaga od 50 W do 100 W visoke efikasnosti',
      'Izbor temperature svetla: 3000 K / 4000 K / 6000 K',
      'Zaštita kućišta IP65 za sve ekstremne vremenske uslove',
      'Konstrukcija od čelika sa toplim pocinčavanjem i plastifikacijom',
    ],
  },
  {
    num: '03',
    title: 'Modularni podni sistemi',
    headline: 'Jedan sistem. Bezbroj mogućnosti. 4 završne obloge.',
    description: 'Čelični monoblok paneli 1x1m sa teleskopskim stopama za nivelaciju i suvom montažom. Izbor između veštačke trave, dekinga, keramike 20mm i industrijske rešetke.',
    slug: '/modularni-podni-sistemi/',
    image: '/images/podovi/gres-premium-monoblok-keramika-1.webp',
    video: '/videos/modularni-podovi.webm',
    alt: 'Modularni čelični monoblok podni paneli',
    highlights: [
      'Fabrički sklopljeni paneli 1x1m koji se bočno spajaju bez šrafova',
      'Teleskopske zglobne stope za nivelisanje neravnina od 4 do 12 cm',
      '100% suva montaža bez betona, lepkova, prašine i majstora',
      '4 tipologije: trava (Eco-Green), deking (WPC), keramika (Gres), rešetka (Heavy-Duty)',
      'Integrisana trenutna drenaža vode i stalna ventilacija podloge',
    ],
  },
  {
    num: '04',
    title: 'Fire Pit Grill',
    headline: 'Centralno mesto okupljanja na otvorenom.',
    description: 'Masivna čelična vatrišta i profesionalni roštilji u jednom elementu. Dizajnirani za pripremu hrane na plancha ploči i stvaranje tople atmosfere na terasama i u dvorištima.',
    slug: '/fire-pit-grill/',
    image: '/images/fire-pit/fire-pit-grill-terasa-vatra-sumrak.webp',
    video: '/videos/fire-pit-grill.webm',
    alt: 'Fire Pit Grill čelično ložište i roštilj',
    highlights: [
      '2-u-1 funkcija: ambijentalno ložište i profesionalni roštilj',
      'Masivna čelična konstrukcija visoke otpornosti na toplotu',
      'Gornja plancha ring ploča sa više temperaturnih zona',
      'Unikatni laserski sečeni ornamenti kroz koje sija žar',
      'Celogodišnja upotreba na otvorenom pod svim vremenskim uslovima',
    ],
  },
];
---

<BaseLayout
  title="Proizvodi i sistemi | Modularni Sistemi"
  description="Pregled modularnih sistema za savremenu arhitekturu: Inox sistemi odvodnjavanja, moderna rasveta, modularni podni sistemi i Fire Pit vatrišta."
>
  <div class="proizvodi-page">

    <!-- HERO SEKCIJA (PUN EKRAN BEZ SIVE TRAKE) -->
    <section class="hero">
      <div class="hero__slides">
        {heroSlides.map((slide, i) => (
          <img
            class={`hero__slide ${i === 0 ? 'is-active' : ''}`}
            src={slide.src}
            alt={slide.alt}
            style={`object-position: ${slide.position};`}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            loading="eager"
            decoding="async"
          />
        ))}
      </div>
      <div class="hero__shade"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            Proizvodni program · Modularni sistemi
          </div>

          <h1>
            Modularni sistemi za<br />
            <em>savremenu arhitekturu.</em>
          </h1>

          <p class="hero__lead">
            Strukturisani portfolio od četiri specijalizovana proizvodna pravca razvijena sa
            fokusom na preciznu geometriju, industrijsku otpornost materijala i jednostavnu ugradnju na objektu.
          </p>

          <div class="hero__actions">
            <a class="btn btn--orange" href="/posaljite-projekat/">
              Pošaljite upit <b>→</b>
            </a>
            <a class="btn btn--ghost" href="tel:+38166241386">
              Pozovite: 066 241 386 <b>↗</b>
            </a>
          </div>
        </div>

        <div class="hero__specs">
          <div>
            <strong>4 PROGRAMA</strong>
            <span>Odvodnjavanje · Rasveta · Podovi · Vatrišta</span>
          </div>
          <div>
            <strong>AISI 304 / 316 & ČELIK</strong>
            <span>Vrhunske industrijske legure</span>
          </div>
          <div>
            <strong>B2B TEHNIČKA PODRŠKA</strong>
            <span>DWG preseci, proračuni i predmeri</span>
          </div>
          <div>
            <strong>100% PREFABRIKACIJA</strong>
            <span>Spremno za brzu montažu na terenu</span>
          </div>
        </div>
      </div>

      <!-- Tačkice slajdera -->
      <div class="hero__dots" role="tablist" aria-label="Izbor slike">
        {heroSlides.map((_, i) => (
          <button
            type="button"
            class={`hero__dot ${i === 0 ? 'is-active' : ''}`}
            aria-label={`Slika ${i + 1}`}
            data-index={i}
          ></button>
        ))}
      </div>
    </section>

    <!-- KATALOG KATEGORIJA (CIK-CAK SA WEBM VIDEIMA) -->
    <section class="catalog-section">
      <div class="wrap catalog-wrap">
        {categories.map((cat, idx) => (
          <article class={`cat-card ${idx % 2 === 1 ? 'cat-card--reverse' : ''}`}>
            
            <!-- Tekstualni blok -->
            <div class="cat-card__content">
              <div class="cat-card__meta">
                <span class="cat-badge">Program {cat.num}</span>
                <span class="cat-type">Modularni sistemi</span>
              </div>

              <h2>{cat.title}</h2>
              <p class="cat-card__headline">"{cat.headline}"</p>
              <p class="cat-card__desc">{cat.description}</p>

              <div class="cat-card__highlights">
                <span class="highlights-title">Karakteristike sistema:</span>
                <ul>
                  {cat.highlights.map((h) => (
                    <li>
                      <span class="bullet"></span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="cat-card__actions">
                <a href={cat.slug} class="btn btn--orange">
                  Kompletna specifikacija <b>→</b>
                </a>
                <a href="/posaljite-projekat/" class="btn btn--ghost-dark">
                  Zatražite ponudu <b>↗</b>
                </a>
              </div>
            </div>

            <!-- Vizuelni prikaz (ČIST WEBM VIDEO) -->
            <div class="cat-card__visual">
              <div class="cat-card__img-box">
                {cat.video ? (
                  <video
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="auto"
                    poster={cat.image}
                    class="cat-card__video"
                  >
                    <source src={cat.video} type="video/webm" />
                    <img src={cat.image} alt={cat.alt} loading="lazy" />
                  </video>
                ) : (
                  <img src={cat.image} alt={cat.alt} loading="lazy" />
                )}
                
                <div class="cat-card__img-shade"></div>
                <div class="cat-card__img-badge">
                  <span>{cat.title}</span>
                  <strong>{cat.num}</strong>
                </div>
              </div>
            </div>

          </article>
        ))}
      </div>
    </section>

    <!-- CTA BANER IZNAD FOOTERA -->
    <section class="cta">
      <img
        src="/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp"
        alt="Prilagođavanje geometrije prostora"
        loading="lazy"
      />
      <div class="cta__shade"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Prilagođavanje geometriji i specifikacija
          </div>
          <h2>Potrebno vam je rešenje <em>po meri objekta?</em></h2>
          <p>
            Dostavite arhitektonske podloge i dimenzije. Naš inženjerski tim priprema kompletnu 
            specifikaciju sistema u skladu sa zadatim rasporedom padova i kota.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--orange" href="/posaljite-projekat/">
            Pošaljite upit <b>→</b>
          </a>
          <a class="btn btn--ghost" href="tel:+38166241386">
            Pozovite: 066 241 386 <b>↗</b>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f6f7f9;
    color: #07111e;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .proizvodi-page {
    --navy: #06131f;
    --navy2: #0b1d2b;
    --orange: #ff6900;
    --orange-hover: #e85e00;
    --line: #dce2e7;
    --muted: #64717c;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .wrap {
    width: min(1280px, calc(100% - 40px));
    margin-inline: auto;
  }

  /* ========== HERO (PUN EKRAN BEZ SIVE TRAKE) ========== */
  .hero {
    position: relative;
    min-height: 700px;
    background: var(--navy);
    color: #fff;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
  }

  .hero__slides {
    position: absolute;
    inset: 0;
    z-index: -3;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  /* ČISTIJI, BISTRIJI PRELIV */
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(95deg, rgba(6, 19, 31, 0.72) 0%, rgba(6, 19, 31, 0.45) 35%, rgba(6, 19, 31, 0.1) 65%, transparent 100%),
      linear-gradient(0deg, rgba(6, 19, 31, 0.55) 0%, transparent 35%);
    z-index: -2;
  }

  .hero h1,
  .hero__lead {
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
  }

  .hero__content {
    padding-top: 130px;
    padding-bottom: 64px;
    display: grid;
    grid-template-columns: minmax(0, 720px) 1fr;
    gap: 50px;
    align-items: end;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow span {
    display: inline-block;
    width: 20px;
    height: 2px;
    background: var(--orange);
    flex-shrink: 0;
  }

  h1, h2, h3, p {
    margin: 0;
  }

  .hero h1 {
    margin-top: 18px;
    max-width: 860px;
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: #fff;
  }

  .hero h1 em,
  .cta h2 em {
    font-style: normal;
    color: var(--orange);
  }

  .hero__lead {
    margin-top: 20px;
    max-width: 620px;
    color: #d4dee4;
    font-size: 15px;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .hero__dots {
    position: absolute;
    right: max(20px, calc((100% - 1280px) / 2));
    bottom: 24px;
    display: flex;
    gap: 8px;
    z-index: 3;
  }

  .hero__dot {
    width: 28px;
    height: 4px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    transition: background 0.3s ease, width 0.3s ease;
  }

  .hero__dot:hover {
    background: rgba(255, 255, 255, 0.7);
  }

  .hero__dot.is-active {
    width: 44px;
    background: var(--orange);
  }

  .hero__dot:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide { transition: none; }
  }

  .btn {
    min-height: 48px;
    padding: 0 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .btn b {
    font-size: 15px;
    font-weight: 600;
  }

  .btn--orange {
    background: var(--orange);
    color: #fff;
    border: 1px solid var(--orange);
  }

  .btn--orange:hover {
    background: var(--orange-hover);
    border-color: var(--orange-hover);
    transform: translateY(-2px);
  }

  .btn--ghost {
    border: 1px solid rgba(255, 255, 255, 0.45);
    color: #fff;
    background: rgba(0, 0, 0, 0.15);
  }

  .btn--ghost:hover {
    background: #fff;
    color: var(--navy);
    border-color: #fff;
  }

  .btn--ghost-dark {
    border: 1px solid var(--line);
    color: #07111e;
    background: #fff;
  }

  .btn--ghost-dark:hover {
    border-color: var(--navy);
    background: #f0f4f7;
  }

  .hero__specs {
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    padding-left: 28px;
    display: grid;
    gap: 20px;
  }

  .hero__specs div {
    display: flex;
    flex-direction: column;
  }

  .hero__specs strong {
    font-size: 14px;
    letter-spacing: 0.03em;
    font-weight: 700;
    color: #fff;
  }

  .hero__specs span {
    margin-top: 4px;
    color: #94a3ad;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  /* ========== KATALOG SEKCIJA ========== */
  .catalog-section {
    padding: 80px 0;
    background: #f6f7f9;
  }

  .catalog-wrap {
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  .cat-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 44px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
    box-shadow: 0 4px 20px rgba(6, 19, 31, 0.04);
    transition: all 0.3s ease;
  }

  .cat-card:hover {
    border-color: var(--orange);
    box-shadow: 0 16px 40px rgba(6, 19, 31, 0.08);
  }

  .cat-card--reverse {
    grid-template-columns: 1fr 1fr;
  }

  .cat-card--reverse .cat-card__content {
    order: 2;
  }

  .cat-card--reverse .cat-card__visual {
    order: 1;
  }

  .cat-card__content {
    display: flex;
    flex-direction: column;
  }

  .cat-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .cat-badge {
    color: var(--orange);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cat-type {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cat-card h2 {
    font-size: clamp(26px, 2.5vw, 36px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #07111e;
    text-transform: uppercase;
  }

  .cat-card__headline {
    margin-top: 10px;
    color: var(--orange);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .cat-card__desc {
    margin-top: 14px;
    color: #55636e;
    font-size: 14px;
    line-height: 1.65;
  }

  .cat-card__highlights {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .highlights-title {
    display: block;
    color: #07111e;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .cat-card__highlights ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cat-card__highlights li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #3d4a55;
    font-size: 12.5px;
    line-height: 1.45;
  }

  .bullet {
    width: 6px;
    height: 6px;
    background: var(--orange);
    border-radius: 1px;
    margin-top: 6px;
    flex-shrink: 0;
  }

  .cat-card__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px;
  }

  .cat-card__visual {
    width: 100%;
  }

  .cat-card__img-box {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 3px;
    background: #06131f;
    border: 1px solid var(--line);
  }

  .cat-card__img-box img,
  .cat-card__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cat-card:hover .cat-card__img-box img,
  .cat-card:hover .cat-card__video {
    transform: scale(1.04);
  }

  .cat-card__img-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(6, 19, 31, 0.85) 100%);
    pointer-events: none;
  }

  .cat-card__img-badge {
    position: absolute;
    bottom: 0;
    inset-x: 0;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    z-index: 2;
  }

  .cat-card__img-badge strong {
    color: var(--orange);
    font-size: 14px;
  }

  /* ========== CTA BANER ========== */
  .cta {
    position: relative;
    min-height: 340px;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
    background: var(--navy);
  }

  .cta > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cta__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(6, 19, 31, 0.95) 0%, rgba(6, 19, 31, 0.75) 55%, rgba(6, 19, 31, 0.45) 100%);
  }

  .cta__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    padding: 56px 0;
  }

  .cta h2 {
    margin-top: 12px;
