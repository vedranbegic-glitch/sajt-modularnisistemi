---

import BaseLayout from "../layouts/BaseLayout.astro";

/**

 * MODULARNI SISTEMI / PREMIUM ENGINEERING V3

 * Jedna lista programa pokreće hero i galeriju.

 * Za novi program dodati jednu stavku; bez fiksnog „01/04“ i bez nepostojećih specifikacija.

 * Slike: postojeće putanje iz projekta. Nisu potrebni novi fajlovi slika.

 */

const programs = [

  {

    name: "Inox odvodnjavanje",

    subtitle: "Geometrija koja prati prostor.",

    family: "Konstrukcija / odvodnjavanje",

    href: "/inox-sistemi-odvodnjavanja/",

    hero: "/images/inox/lucni-skriveni-inox-kanal-zalazak-sunca.webp",

    preview: "/images/inox/skriveni-modularni-inox-kanal-s-forma-bazen-suva-plaza.webp",

    heroAlt: "Lučna inox kanalica u ambijentu pri zalasku sunca",

    previewAlt: "S-forma inox kanalica u ambijentu bazena i suve plaže",

    studio: false,

    position: "center",

  },

  {

    name: "Modularne podkonstrukcije",

    subtitle: "Čelični moduli za podeste i tehničke platforme.",

    family: "Čelik / modularna konstrukcija",

    href: "/modularne-celicne-podkonstrukcije/",

    hero: "/images/podovi/modularni-pod-terasa-kamene-staze-basta-2.webp",

    preview: "/images/podovi/modularni-pod-terasa-kisa-noc-1.webp",

    heroAlt: "Prikaz prostora za primenu modularne čelične podkonstrukcije",

    previewAlt: "Primer modularnog poda na terasi tokom kišne noći",

    studio: false,

    position: "center",

  },

  {

    name: "Fire Pit Grill",

    subtitle: "Funkcija koja okuplja.",

    family: "Čelik / otvoreni prostor",

    href: "/fire-pit-grill/",

    hero: "/images/fire-pit/fire-pit-grill-celicna-vatra-rostilj.webp",

    preview: "/images/fire-pit/fire-pit-grill-terasa-vatra-sumrak.webp",

    heroAlt: "Fire Pit Grill čelično ložište i roštiljska ploča sa vatrom",

    previewAlt: "Fire Pit Grill u toplom večernjem ambijentu",

    studio: false,

    position: "center",

  },

];

const engineeringDetails = [

  {

    name: "Završetak kanala",

    category: "Presek / završetak",

    image: "/images/engineering/zavrsetak-kanala-premium.webp",

    alt: "Originalni prikaz završetka kanala, poprečnog preseka i nivelirajuće stope",

  },

  {

    name: "Spoj segmenata",

    category: "Spajanje / detalj",

    image: "/images/engineering/spoj-segmenata-premium.webp",

    alt: "Spoj inox segmenata sa vijcima i nivelirajućim stopama",

  },

  {

    name: "Nivelirajuća stopa",

    category: "Nosač / podešavanje",

    image: "/images/engineering/nivelirajuca-stopa-premium.webp",

    alt: "Nivelirajuća stopa sa L nosačem i navojnim vijkom",

  },

];

const number = (i: number) => String(i + 1).padStart(2, "0");

---

<BaseLayout

  title="Modularni Sistemi | Precizno oblikovana rešenja"

  description="Modularni Sistemi — inox odvodnjavanje, modularne čelične podkonstrukcije i Fire Pit Grill. Precizna konstrukcija i rešenja po meri prostora."

  ogImage={programs[0].hero}

>

  <main id="engineering-home" class="eng">

    <!-- 01 / HERO — veliki proizvodni kadar, ne fotografija u uskoj koloni -->

    <section class="eng-hero" aria-labelledby="eng-main-title" aria-roledescription="karusel">

      <div class="eng-hero__composition eng-container">

        <div class="eng-hero__copy">

          <p class="eng-overline eng-overline--light"><span></span> MODULARNI SISTEMI / ENGINEERING & DESIGN</p>

          <h1 id="eng-main-title">Jedan sistem.<br /><em>Bezbroj mogućnosti.</em></h1>

          <p class="eng-hero__text">Precizno oblikovani proizvodi. Rešenja koja prate vaš prostor.</p>

          <div class="eng-actions">

            <a class="eng-button eng-button--primary" href="#programi">Istražite programe <span aria-hidden="true">↗</span></a>

            <a class="eng-button eng-button--secondary" href="/posaljite-upit/">Pošaljite upit <span aria-hidden="true">↗</span></a>

          </div>

          <div class="eng-hero__side-note"><span></span> Oblik. Funkcija. Konstrukcija.</div>

        </div>

        <div class="eng-hero__stage" aria-label="Prikaz izabranog programa">

          <div class="eng-hero__pictures" aria-hidden="true">

            {programs.map((p, i) => (

              <div data-hero-picture class:list={["eng-hero__picture", { "is-active": i === 0, "is-studio": p.studio }] }>

                {p.studio && <img class="eng-hero__backdrop" src={p.hero} alt="" aria-hidden="true" loading="lazy" decoding="async" /> }

                <img class="eng-hero__main" src={p.hero} alt={p.heroAlt} loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} decoding="async" width={p.studio ? 1086 : 1600} height={p.studio ? 1448 : 900} style={`object-position:${p.position}`} />

              </div>

            ))}

          </div>

          <div class="eng-hero__stage-frame" aria-hidden="true"><span class="corner-a"></span><span class="corner-b"></span></div>

          <div class="eng-hero__stage-caption">

            <span class="eng-hero__caption-kicker">ODABRANI PROGRAM</span>

            <div class="eng-hero__caption-bottom">

              <span class="eng-hero__stage-number" data-hero-number>01</span>

              <a href={programs[0].href} data-hero-link><span data-hero-name>{programs[0].name}</span><span aria-hidden="true">↗</span></a>

            </div>

          </div>

          <span class="eng-hero__photo-mark" aria-hidden="true">MS / PRODUCT STUDY</span>

        </div>

      </div>

      <div class="eng-container eng-hero__navigation">

        <div class="eng-hero__nav-head">

          <span>PROIZVODNI PROGRAMI</span>

          <button type="button" class="eng-hero__toggle" data-slider-pause aria-pressed="false" aria-label="Pauziraj automatsku promenu">

            <span data-slider-symbol aria-hidden="true">Ⅱ</span><span data-slider-label>Pauziraj</span>

          </button>

        </div>

        <div class="eng-hero__tabs" role="group" aria-label="Odaberite proizvodni program">

          {programs.map((p, i) => (

            <button type="button" class:list={["eng-hero__tab", { "is-active": i === 0 }]} data-hero-tab={i} data-name={p.name} data-href={p.href} aria-pressed={i === 0 ? "true" : "false"} aria-label={`Prikaži: ${p.name}`}>

              <span class="eng-hero__tab-index">{number(i)}</span>

              <span class="eng-hero__tab-name">{p.name}</span>

              <span class="eng-hero__tab-arrow" aria-hidden="true">↗</span>

              <span class="eng-hero__progress" aria-hidden="true"><span></span></span>

            </button>

          ))}

        </div>

      </div>

    </section>

    <!-- 02 / PREGLED PROGRAMA — broj programa određuje sadržaj liste -->

    <section class="eng-programs" id="programi" aria-labelledby="eng-programs-title">

      <div class="eng-container">

        <div class="eng-section-header">

          <div>

            <p class="eng-overline"><span></span> PROIZVODNI PROGRAM</p>

            <h2 id="eng-programs-title">Proizvodi u fokusu.<br /><span>Detalji u svakom sistemu.</span></h2>

          </div>

          <a href="/proizvodi/" class="eng-inline-link">Svi proizvodi <span aria-hidden="true">↗</span></a>

        </div>

        <div class="eng-explorer">

          <div class="eng-explorer__visual">

            <div class="eng-explorer__gallery" aria-hidden="true">

              {programs.map((p, i) => (

                <div class:list={["eng-explorer__image", { "is-active": i === 0, "is-studio": p.studio }]} data-explorer-image>

                  <img src={p.preview} alt={p.previewAlt} width="1500" height="1050" loading="lazy" decoding="async" />

                </div>

              ))}

            </div>

            <span class="eng-explorer__tag">MODULARNI SISTEMI / PRODUKT</span>

            <div class="eng-explorer__caption">

              <div><span data-explorer-number>01</span><strong data-explorer-title>{programs[0].name}</strong></div>

              <a data-explorer-link href={programs[0].href} aria-label={`Otkrijte: ${programs[0].name}`}>Pogledaj program <span aria-hidden="true">↗</span></a>

            </div>

          </div>

          <div class="eng-explorer__index" aria-label="Svi proizvodni programi">

            {programs.map((p, i) => (

              <a class:list={["eng-explorer__item", { "is-active": i === 0 }]} href={p.href} data-explorer-item={i} data-explorer-href={p.href} data-explorer-name={p.name}>

                <span class="eng-explorer__item-number">{number(i)}</span>

                <span class="eng-explorer__item-copy"><strong>{p.name}</strong><small>{p.subtitle}</small></span>

                <span class="eng-explorer__item-arrow" aria-hidden="true">↗</span>

                <img src={p.preview} alt="" width="90" height="80" loading="lazy" decoding="async" aria-hidden="true" />

              </a>

            ))}

            <div class="eng-explorer__index-footer"><span>RAZLIČITI SISTEMI / JEDAN PRISTUP</span><span aria-hidden="true">+</span></div>

          </div>

        </div>

      </div>

    </section>

    <!-- 03 / CONSTRUCTION — detalji su u velikom formatu, bez izmišljenih specifikacija -->

    <section class="eng-details" aria-labelledby="eng-details-title">

      <div class="eng-container">

        <div class="eng-details__top">

          <div>

            <p class="eng-overline eng-overline--light"><span></span> PRECIZNOST U DETALJU</p>

            <h2 id="eng-details-title">Konstrukcija koja<br /><em>govori za sebe.</em></h2>

          </div>

          <div class="eng-details__aside"><p>Originalni elementi. Pažnja posvećena svakom spoju i detalju.</p><a href="/inox-sistemi-odvodnjavanja/">Istražite inox sisteme <span aria-hidden="true">↗</span></a></div>

        </div>

        <div class="eng-details__gallery">

          {engineeringDetails.map((d, i) => (

            <figure class="eng-detail">

              <div class="eng-detail__photo"><img src={d.image} alt={d.alt} width="1254" height="1254" loading="lazy" decoding="async" /></div>

              <figcaption><span class="eng-detail__number">{number(i)} / {d.category}</span><strong>{d.name}</strong></figcaption>

            </figure>

          ))}

        </div>

      </div>

    </section>

    <!-- 04 / CONTACT -->

    <section class="eng-contact" aria-labelledby="eng-contact-title">

      <div class="eng-container eng-contact__grid">

        <div>

          <p class="eng-overline"><span></span> VAŠA IDEJA JE DOBAR POČETAK</p>

          <h2 id="eng-contact-title">Imate ideju?<br /><em>Počnimo od nje.</em></h2>

          <p>Fotografija, skica ili dimenzije? Dovoljno je za početak.</p>

        </div>

        <div class="eng-contact__right">

          <a class="eng-button eng-button--primary" href="/posaljite-upit/">Pošaljite upit <span aria-hidden="true">↗</span></a>

          <a class="eng-contact__email" href="mailto:kontakt@modularnisistemi.com">kontakt@modularnisistemi.com <span aria-hidden="true">↗</span></a>

        </div>

      </div>

    </section>

  </main>

</BaseLayout>

<style>

  .eng { --navy:#071722; --ink:#172936; --orange:#ff7417; --paper:#eff2f1; --rule:#dce2e3; font-family:Manrope,Inter,system-ui,-apple-system,"Segoe UI",sans-serif; color:var(--ink); background:var(--paper); isolation:isolate; overflow:clip; }

  .eng *, .eng *::before, .eng *::after { box-sizing:border-box; }

  .eng :is(h1,h2,h3,p,figure) { margin:0; }

  .eng a { text-decoration:none; }

  .eng button { font:inherit; cursor:pointer; }

  .eng img { display:block; max-width:100%; }

  .eng :is(a,button):focus-visible { outline:3px solid #ffac76; outline-offset:3px; }

  .eng-container { width:min(1310px,calc(100% - 100px)); margin-inline:auto; }

  .eng-overline { display:flex; gap:12px; align-items:center; font-weight:800; font-size:10px; line-height:1.5; color:#a44611; letter-spacing:.14em; text-transform:uppercase; }

  .eng-overline > span { width:20px; height:2px; flex:none; background:var(--orange); }

  .eng-overline--light { color:#ffac7c; }

  .eng em { font-style:normal; color:var(--orange); }

  .eng h2 { font-size:clamp(32px,3.2vw,48px); line-height:1.09; letter-spacing:-.054em; font-weight:800; }

  .eng h2 > span { color:#839199; }

  .eng-button { min-height:52px; display:inline-flex; align-items:center; justify-content:space-between; gap:28px; padding:12px 19px; font-size:12px; font-weight:800; border:1px solid transparent; border-radius:2px; transition:background .22s,border-color .22s,transform .22s; }

  .eng-button > span, .eng-inline-link > span { font-size:21px; line-height:1; }

  .eng-button--primary { color:#14202a; background:var(--orange); }

  .eng-button--secondary { color:#fff; border-color:#ffffff70; background:#06152155; }

  .eng-actions { display:flex; flex-wrap:wrap; gap:10px; }

  .eng-inline-link { display:inline-flex; align-items:center; gap:20px; color:var(--ink); font-size:12px; font-weight:800; white-space:nowrap; }

  .eng-inline-link > span { color:#b34e13; }

  /* HERO: pravi horizontalni product stage sa velikim proizvodom */

  .eng-hero { background:#081925; color:white; position:relative; }

  .eng-hero::before { content:""; position:absolute; inset:0; opacity:.16; pointer-events:none; background:linear-gradient(90deg,transparent 49.96%,#ffffff28 50%,transparent 50.04%),repeating-linear-gradient(0deg,transparent 0 71px,#ffffff17 72px); mask-image:linear-gradient(90deg,black,transparent 77%); }

  .eng-hero__composition { position:relative; z-index:1; display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); gap:34px; min-height:520px; padding-top:30px; padding-bottom:20px; }

  .eng-hero__copy { display:flex; flex-direction:column; justify-content:center; padding:20px 0 25px; min-width:0; }

  .eng-hero h1 { margin-top:25px; font-size:clamp(45px,4.5vw,72px); font-weight:800; line-height:1.055; letter-spacing:-.071em; }

  .eng-hero h1 em { display:inline-block; }

  .eng-hero__text { max-width:380px; margin-top:22px!important; font-size:15px; line-height:1.7; color:#c3d1db; }

  .eng-hero .eng-actions { margin-top:26px; }

  .eng-hero__side-note { display:flex; align-items:center; gap:11px; margin-top:44px; font-size:10px; letter-spacing:.13em; text-transform:uppercase; color:#93a9b7; }

  .eng-hero__side-note span { height:1px; width:38px; background:var(--orange); }

  .eng-hero__stage { min-width:0; position:relative; height:485px; overflow:hidden; background:#252526; box-shadow:0 18px 65px #0005; }

  .eng-hero__pictures, .eng-hero__picture { position:absolute; inset:0; }

  .eng-hero__picture { opacity:0; visibility:hidden; transition:opacity .8s ease,visibility 0s .8s; }

  .eng-hero__picture.is-active { opacity:1; visibility:visible; transition:opacity .8s ease,visibility 0s; }

  .eng-hero__picture img.eng-hero__main { width:100%; height:100%; object-fit:cover; }

  .eng-hero__picture.is-studio img.eng-hero__main { position:relative; object-fit:contain; object-position:center; }

  .eng-hero__backdrop { position:absolute; inset:-20%; width:140%; height:140%; object-fit:cover; filter:blur(32px) brightness(.56); }

  .eng-hero__stage::after { content:""; position:absolute; pointer-events:none; inset:45% 0 0; background:linear-gradient(0deg,#06131fea,transparent 75%); }

  .eng-hero__stage-frame { position:absolute; inset:14px; pointer-events:none; z-index:1; border:1px solid #ffffff19; }

  .eng-hero__stage-frame .corner-a,.eng-hero__stage-frame .corner-b { position:absolute; width:29px; height:29px; border-color:var(--orange); }

  .eng-hero__stage-frame .corner-a { top:-1px; left:-1px; border-top:2px solid var(--orange); border-left:2px solid var(--orange); }

  .eng-hero__stage-frame .corner-b { bottom:-1px; right:-1px; border-bottom:2px solid var(--orange); border-right:2px solid var(--orange); }

  .eng-hero__stage-caption { position:absolute; z-index:2; bottom:30px; left:33px; right:33px; }

  .eng-hero__caption-kicker { font-size:9px; letter-spacing:.18em; font-weight:800; color:#ffc298; }

  .eng-hero__caption-bottom { display:flex; align-items:center; gap:17px; margin-top:7px; }

  .eng-hero__stage-number { font-size:38px; letter-spacing:-.06em; font-weight:800; line-height:1; }

  .eng-hero__stage-caption a { display:flex; align-items:center; justify-content:space-between; min-height:40px; gap:20px; color:white; border-bottom:1px solid #ffffff88; font-size:14px; font-weight:750; flex:1; }

  .eng-hero__stage-caption a > span:last-child { color:#ffa166; font-size:23px; }

  .eng-hero__photo-mark { position:absolute; z-index:1; top:32px; right:32px; font-size:9px; letter-spacing:.17em; color:#ffffffbb; writing-mode:vertical-rl; }

  .eng-hero__navigation { position:relative; z-index:2; }

  .eng-hero__nav-head { min-height:37px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #ffffff3a; gap:12px; }

  .eng-hero__nav-head > span { font-size:10px; letter-spacing:.14em; font-weight:700; color:#c4d0d7; }

  .eng-hero__toggle { min-height:36px; display:inline-flex; align-items:center; gap:9px; padding:4px 0 4px 8px; border:0; background:none; color:white; font-size:11px; }

  .eng-hero__toggle[hidden] { display:none; }

  .eng-hero__toggle > span:first-child { display:grid; place-items:center; width:24px; height:24px; border:1px solid #ffffff70; border-radius:50%; font-size:12px; }

  .eng-hero__tabs { display:flex; overflow-x:auto; scrollbar-width:thin; overscroll-behavior-inline:contain; }

  .eng-hero__tab { position:relative; display:flex; align-items:center; gap:12px; min-width:185px; flex:1 0 0; min-height:65px; padding:15px 14px; border:0; border-right:1px solid #ffffff25; background:transparent; color:#c3cfd6; text-align:left; font-size:12px; }

  .eng-hero__tab:first-child { padding-left:0; }

  .eng-hero__tab:last-child { border-right:0; }

  .eng-hero__tab.is-active { color:#fff; }

  .eng-hero__tab-index { color:#ffa46a; font-size:10px; flex:none; }

  .eng-hero__tab-name { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }

  .eng-hero__tab-arrow { margin-left:auto; color:#ffa46a; font-size:17px; }

  .eng-hero__progress { height:3px; position:absolute; inset:0 0 auto; overflow:hidden; }

  .eng-hero__progress span { display:block; width:100%; height:100%; background:var(--orange); transform:scaleX(0); transform-origin:left; }

  .eng-hero__tab.is-active .eng-hero__progress span { transform:scaleX(var(--eng-progress,0)); }

  /* PRODUCT INDEX: jedna velika scena + vertikalni precizni indeks */

  .eng-programs { padding-block:66px 75px; scroll-margin-top:84px; }

  .eng-section-header { display:flex; justify-content:space-between; align-items:end; gap:25px; margin-bottom:26px; }

  .eng-section-header h2 { margin-top:12px; }

  .eng-explorer { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(300px,.75fr); min-height:420px; border:1px solid #cbd6d9; background:#fff; }

  .eng-explorer__visual { min-width:0; position:relative; background:#222b31; overflow:hidden; }

  .eng-explorer__gallery,.eng-explorer__image { position:absolute; inset:0; }

  .eng-explorer__image { opacity:0; visibility:hidden; transition:opacity .38s,visibility 0s .38s; }

  .eng-explorer__image.is-active { opacity:1; visibility:visible; transition:opacity .38s,visibility 0s; }

  .eng-explorer__image img { width:100%; height:100%; object-fit:cover; }

  .eng-explorer__image.is-studio img { object-fit:contain; background:#292b2e; }

  .eng-explorer__visual::after { content:""; position:absolute; inset:40% 0 0; background:linear-gradient(0deg,#071724ef,transparent); pointer-events:none; }

  .eng-explorer__tag { position:absolute; z-index:1; top:20px; left:24px; color:white; font-size:9px; letter-spacing:.16em; font-weight:800; }

  .eng-explorer__caption { position:absolute; z-index:2; bottom:24px; left:24px; right:24px; display:flex; justify-content:space-between; align-items:end; gap:20px; color:white; }

  .eng-explorer__caption > div { display:flex; align-items:baseline; gap:15px; }

  .eng-explorer__caption > div > span { color:#ffa971; font-size:14px; }

  .eng-explorer__caption strong { font-size:clamp(24px,2.5vw,36px); letter-spacing:-.055em; line-height:1.1; }

  .eng-explorer__caption a { display:inline-flex; gap:14px; align-items:center; padding-bottom:6px; border-bottom:1px solid #f8b58e; color:white; font-size:11px; font-weight:700; white-space:nowrap; }

  .eng-explorer__caption a span { color:#ffab73; font-size:20px; }

  .eng-explorer__index { display:flex; flex-direction:column; min-width:0; }

  .eng-explorer__item { position:relative; isolation:isolate; flex:1; display:flex; align-items:center; gap:17px; min-height:88px; padding:14px 20px; border-bottom:1px solid #e0e6e8; color:var(--ink); transition:background .25s; overflow:hidden; }

  .eng-explorer__item.is-active { background:#f1f4f4; }

  .eng-explorer__item.is-active::before { content:""; position:absolute; inset:0 auto 0 0; width:3px; background:var(--orange); }

  .eng-explorer__item-number { color:#ad511d; font-size:12px; font-weight:800; flex:none; }

  .eng-explorer__item-copy { display:flex; flex-direction:column; gap:7px; min-width:0; flex:1; }

  .eng-explorer__item-copy strong { font-size:17px; line-height:1.2; font-weight:800; letter-spacing:-.035em; }

  .eng-explorer__item-copy small { font-size:11px; color:#617480; line-height:1.35; }

  .eng-explorer__item-arrow { color:#a94b12; font-size:20px; }

  .eng-explorer__item img { display:none; }

  .eng-explorer__index-footer { display:flex; justify-content:space-between; align-items:center; padding:13px 20px; font-size:9px; letter-spacing:.11em; color:#82939d; background:#f7f9f8; }

  .eng-explorer__index-footer > span:last-child { font-size:18px; color:#ff7417; }

  /* CONSTRUCTION: velika, čitljiva galerija autentičnih fotografija */

  .eng-details { padding-block:66px 75px; background:#071823; color:white; }

  .eng-details__top { display:flex; align-items:end; justify-content:space-between; gap:30px; margin-bottom:27px; }

  .eng-details h2 { margin-top:11px; }

  .eng-details__aside { max-width:300px; }

  .eng-details__aside p { color:#b5c4cd; font-size:13px; line-height:1.6; }

