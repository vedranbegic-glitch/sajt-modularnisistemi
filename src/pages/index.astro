  .ms-film-choice {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 62px;
    padding: 14px 18px;
    border: 0;
    border-right: 1px solid #ffffff25;
    background: #101f2b;
    color: #d2dce3;
    text-align: left;
    font-size: 12px !important;
    transition:
      background 0.25s,
      color 0.25s;
  }
  .ms-film-choice:last-child {
