---
import BaseLayout from '../layouts/BaseLayout.astro';
import LightboxModal from '../components/LightboxModal.astro';

// Hero slajder
const heroSlides = [
  {
    src: '/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp',
    alt: 'Modularni sistemi — lučni inox kanal u pejzažnom parteru',
    position: 'center',
  },
  {
    src: '/images/rasveta/z-lampa-moderna-led-rasveta-za-dvoriste-ulicna-rasveta.webp',
    alt: 'Z lampa — moderna LED rasveta za dvorište i ulicu',
    position: '70% center',
  },
  {
    src: '/images/podovi/modularni-pod-terasa-kamene-staze-basta-2.webp',
    alt: 'Modularni podni sistemi — fabrički sklopljeni paneli za terase i partere',
    position: 'center',
  },
  {
    src: '/images/fire-pit/fire-pit-grill-terasa-vatra-sumrak.webp',
    alt: 'Fire Pit Grill — čelično ložište i roštilj na terasi',
    position: 'center',
  },
];

// 4 KATEGORIJE - 100% CIST WEBM (Inox pozicija ažurirana na inox-sistemi-odvodnjavanja.webm)
const categories = [
  {
    title: 'Inox sistemi odvodnjavanja',
    headline: 'Precizno odvodnjavanje koje prati geometriju prostora.',
    description: 'Modularni inox sistemi sa integrisanim fabričkim padom i nivelacionim stopama za ravne, lučne, kružne i S-oblikovane forme u parternom uređenju.',
    slug: '/inox-sistemi-odvodnjavanja/',
    heroImage: '/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp',
    video: '/videos/inox-sistemi-odvodnjavanja.webm',
    artEyebrow: 'PROJEKTOVANO PREMA VAŠOJ GEOMETRIJI',
    artTitle: 'Bez geometrijskih <em>ograničenja.</em>',
    linkText: 'Pregled sistema',
  },
  {
    title: 'Moderna rasveta',
    headline: 'Arhitektonska rasveta koja spaja funkciju i estetiku.',
    description: 'Arhitektonska Z-lampa u visinama od 3m, 4m i 5m, sa IP65 zaštitom i podesivom snagom, namenjena za dvorišta, parkinge, poslovne zone i javne površine.',
    slug: '/moderna-rasveta/',
    heroImage: '/images/rasveta/z-lampa-dimenzije-visina-tehnicki-detalji.webp',
    video: '/videos/moderna-rasveta.webm',
    artEyebrow: 'DIZAJNIRANA DA OSTAVI UTISAK',
    artTitle: 'Moderan dizajn, <em>za svaki prostor.</em>',
    linkText: 'Pregled sistema',
  },
  {
    title: 'Modularni podni sistemi',
    headline: 'Fleksibilna podna rešenja za različite prostore i namene.',
    description: 'Modularne podne obloge sa sistemom brzog sklapanja, namenjene za izradu stabilnih i provetrenih podnih površina koje se lako održavaju.',
    slug: '/modularni-podni-sistemi/',
    heroImage: '/images/podovi/gres-premium-monoblok-keramika-1.webp',
    video: '/videos/modularni-podovi.webm',
    artEyebrow: 'LUXUZ NA OTVORENOM',
    artTitle: 'Montaža bez alata <em>i troškova.</em>',
    linkText: 'Pregled sistema',
  },
  {
    title: 'Fire Pit Grill',
    headline: 'Centralno mesto okupljanja na otvorenom.',
    description: 'Masivna čelična vatrišta i profesionalni roštilji u jednom elementu. Dizajnirani da unesu toplinu, autentičnu vatru i nezaboravnu atmosferu na terase i dvorišta.',
    slug: '/fire-pit-grill/',
    heroImage: '/images/fire-pit/fire-pit-grill-terasa-vatra-sumrak.webp',
    video: '/videos/fire-pit-grill.webm',
    artEyebrow: 'TOPLINA I AMBIJENT NA OTVORENOM',
    artTitle: 'Ložište i roštilj <em>u jednom.</em>',
    linkText: 'Pregled proizvoda',
  },
];

// KORACI
const steps = [
  {
    number: '01',
    title: 'Pregled prostora i podloge',
    description: 'Pregledamo nacrte, dimenzije, visinske kote, padove i prostorna ograničenja kako bismo razumeli uslove projekta.',
  },
  {
    number: '02',
    title: 'Izbor odgovarajućeg sistema',
    description: 'Na osnovu namene prostora i zahteva projekta predlažemo odgovarajuću kategoriju i konfiguraciju sistema.',
  },
  {
    number: '03',
    title: 'Izrada elemenata',
    description: 'Izrađujemo elemente prema usaglašenom rešenju, uz proveru dimenzija i pripremu za isporuku.',
  },
  {
    number: '04',
    title: 'Podrška pri ugradnji',
    description: 'Obeleženi elementi i prateće informacije pomažu izvođačkom timu da sistem ugradi prema dogovorenom rasporedu.',
  },
];

// GALERIJA
const featuredGallery = [
  {
    categoryLabel: 'Inox odvodnjavanje',
    title: 'S-forma bazen i parter',
    image: '/images/inox/skriveni-modularni-inox-kanal-s-forma-bazen-suva-plaza.webp',
  },
  {
    categoryLabel: 'Inox odvodnjavanje',
    title: 'Lučni kanal sa rešetkom',
    image: '/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp',
  },
  {
    categoryLabel: 'Moderna rasveta',
    title: 'Arhitektonska Z-lampa',
    image: '/images/rasveta/z-lampa-moderna-led-rasveta-za-dvoriste-ulicna-rasveta.webp',
  },
  {
    categoryLabel: 'Modularni podovi',
    title: 'Premium granitna keramika',
    image: '/images/podovi/gres-premium-monoblok-keramika-1.webp',
  },
];
---

<BaseLayout
  title="Početna"
  description="Modularna rešenja za odvodnjavanje, rasvetu, podne sisteme i vanjska vatrišta — projektovana za savremenu arhitekturu. Jedan sistem. Bezbroj mogućnosti."
>
  <div class="home-page">

    <!-- HERO SEKCIJA -->
    <section class="hero">
      <div class="hero__slides">
        {heroSlides.map((slide, i) => (
          <img
            class={`hero__slide ${i === 0 ? 'is-active' : ''}`}
            src={slide.src}
            alt={slide.alt}
            style={`object-position: ${slide.position};`}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            loading="eager"
            decoding="async"
          />
        ))}
      </div>
      <div class="hero__shade"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            Modularni sistemi · Rešenja za savremenu arhitekturu
          </div>

          <h1>
            Jedan sistem.<br />
            <em>Bezbroj mogućnosti.</em>
          </h1>

          <p class="hero__lead">
            Modularna rešenja za odvodnjavanje, rasvetu, podne sisteme i vanjska vatrišta — 
            projektovana za savremenu arhitekturu i konkretan prostor.
          </p>

          <div class="hero__metrics">
            <div>
              <strong>100%</strong>
              <span>Po meri objekta</span>
            </div>
            <div>
              <strong>RAZLIČITE PRIMENE</strong>
              <span>Privatni · poslovni · javni prostori</span>
            </div>
            <div>
              <strong>CAD / BIM</strong>
              <span>Tehnička podrška</span>
            </div>
          </div>

          <div class="hero__actions">
            <a class="btn btn--orange" href="/proizvodi/">
              Pogledajte proizvode <b>→</b>
            </a>
            <a class="btn btn--ghost" href="/posaljite-projekat/">
              Pošaljite upit <b>↗</b>
            </a>
          </div>
        </div>
      </div>

      <div class="hero__dots" role="tablist" aria-label="Izbor slike">
        {heroSlides.map((_, i) => (
          <button
            type="button"
            class={`hero__dot ${i === 0 ? 'is-active' : ''}`}
            aria-label={`Slika ${i + 1}`}
            data-index={i}
          ></button>
        ))}
      </div>
    </section>

    <!-- 4 KARTICE PROIZVODA (100% WEBM) -->
    <section class="categories">
      <div class="categories__wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Naša rešenja
            </div>
            <h2>Naši proizvodi. <em>Jedan usklađen pristup.</em></h2>
          </div>
          <p>
            Od prvog crteža do izbora odgovarajuće konfiguracije, pomažemo da detalji sistema budu usklađeni sa prostorom, namenom i projektnom dokumentacijom.
          </p>
        </div>

        <div class="categories__grid">
          {categories.map((cat, i) => (
            <a href={cat.slug} class="cat-card">
              <div class="cat-card__image">
                {cat.video ? (
                  <video
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="auto"
                    poster={cat.heroImage}
                    class="cat-card__video"
                  >
                    <source src={cat.video} type="video/webm" />
                    <img src={cat.heroImage} alt={cat.title} loading="lazy" />
                  </video>
                ) : (
                  <img src={cat.heroImage} alt={cat.title} loading="lazy" />
                )}

                <span>0{i + 1}</span>

                <div class="cat-card__art">
                  <div class="cat-card__art-content">
                    <span class="cat-card__art-eyebrow">— {cat.artEyebrow}</span>
                    <strong class="cat-card__art-title" set:html={cat.artTitle}></strong>
                    <div class="cat-card__art-divider"></div>
                  </div>
                </div>
              </div>

              <div class="cat-card__body">
                <div class="cat-card__tag">{cat.headline}</div>
                <h3>{cat.title}</h3>
                <p>{cat.description}</p>
                <span class="cat-card__link">{cat.linkText} <b>→</b></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- NAŠ PRISTUP -->
    <section class="philosophy">
      <div class="wrap">
        <div class="philosophy__head">
          <div class="eyebrow eyebrow--dark">
            <span></span>
            Naš pristup
          </div>
          <h2>
            Ne prodajemo samo proizvod.<br />
            <em>Projektujemo rešenje prema prostoru.</em>
          </h2>
          <p>
            Standardna serijska rešenja često zahtevaju naknadna sečenja i kompromise na terenu. Mi polazimo od geometrije vašeg crteža: najpre razrađujemo rešenje kroz crtež i 3D model, a zatim izrađujemo gotove kanale, rasvetu, podne module i vatrišta tako da se uklope u zadate dimenzije i linije prostora.
          </p>
        </div>

        <div class="philosophy__grid">
          <div>
            <strong>Preciznost</strong>
            <span>Proizvod izrađujemo prema usaglašenom crtežu i merama.</span>
          </div>
          <div>
            <strong>Materijali</strong>
            <span>Nerđajući čelik AISI 304/316 i toplo pocinkovani čelik.</span>
          </div>
          <div>
            <strong>Modularnost</strong>
            <span>Standardizovani spojevi za brzu i suvu montažu.</span>
          </div>
          <div>
            <strong>B2B CAD</strong>
            <span>Tehnička podrška projektantima kroz 2D/3D crteže i predmere.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- GALERIJA -->
    <section class="gallery">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Galerija
            </div>
            <h2>Pogledajte sisteme <em>u primeni.</em></h2>
          </div>
          <a class="section-link" href="/galerija/">
            Pogledajte celu arhivu <b>→</b>
          </a>
        </div>

        <div class="gallery__grid">
          {featuredGallery.map((item) => (
            <figure
              class="gallery-card"
              onclick={`window.openModularLightbox && window.openModularLightbox({ src: '${item.image}', title: '${item.title}', desc: '', category: '${item.categoryLabel}' })`}
              tabindex="0"
              role="button"
              aria-label={`Uvećaj: ${item.title}`}
            >
              <div class="gallery-card__image">
                <img src={item.image} alt={item.title} loading="lazy" />
              </div>
              <figcaption>
                <span>{item.categoryLabel}</span>
                <strong>{item.title}</strong>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- NAŠ PROCES -->
    <section class="process">
      <div class="wrap">
        <div class="process__head">
          <div class="eyebrow eyebrow--dark">
            <span></span>
            Naš proces
          </div>
          <h2>Od ideje <em>do gotovog rešenja.</em></h2>
        </div>

        <div class="steps">
          {steps.map((step) => (
            <article>
              <span class="step-num">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA BANER -->
    <section class="cta">
      <img
        src="/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp"
        alt="Pošaljite nam projekat"
        loading="lazy"
      />
      <div class="cta__shade"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            REŠENJA PO MERI PROSTORA
          </div>
          <h2>Imate prostor <em>specifične geometrije?</em></h2>
          <p>
            Pošaljite nam skicu, nacrt ili osnovu prostora. Razradićemo oblik 
            i predložiti rešenje prilagođeno vašem projektu.
          </p>
        </div>
        <a class="btn btn--orange" href="/posaljite-projekat/">
          Pošaljite upit <b>→</b>
        </a>
      </div>
    </section>

  </div>

  <LightboxModal />

  <style>
    :global(html) { scroll-behavior: smooth; }
    :global(body) {
      margin: 0;
      background: #f6f7f9;
      color: #07111e;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .home-page {
      --navy: #06131f;
      --orange: #ff6900;
      --orange-hover: #e85e00;
      --line: #dce2e7;
      --muted: #64717c;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }

    .wrap {
      width: min(1280px, calc(100% - 40px));
      margin-inline: auto;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--orange);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }
    .eyebrow span {
      display: inline-block;
      width: 20px;
      height: 1.5px;
      background: var(--orange);
      flex-shrink: 0;
    }
    .eyebrow--dark { color: var(--orange); }

    h1, h2, h3, p { margin: 0; }
    h1 em, h2 em { font-style: normal; color: var(--orange); }

    .btn {
      min-height: 48px;
      padding: 0 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: all 0.25s ease;
    }
    .btn b { font-size: 15px; font-weight: 600; }
    .btn--orange { background: var(--orange); color: #fff; }
    .btn--orange:hover { background: var(--orange-hover); transform: translateY(-2px); }
    .btn--ghost {
      border: 1px solid rgba(255,255,255,0.45);
      color: #fff;
      background: rgba(0,0,0,0.12);
    }
    .btn--ghost:hover { background: #fff; color: var(--navy); border-color: #fff; }

    /* ========== HERO (ČIST PRELIV BEZ MREŽICE) ========== */
    .hero {
      position: relative;
      min-height: 680px;
      background: var(--navy);
      color: #fff;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
    }
    .hero__slides {
      position: absolute;
      inset: 0;
      z-index: -3;
    }
    .hero__slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      z-index: 0;
      transition: opacity 1s ease;
    }
    .hero__slide.is-prev {
      opacity: 1;
      z-index: 1;
      transition: none;
    }
    .hero__slide.is-active {
      opacity: 1;
      z-index: 2;
    }

    /* ČISTIJI, BISTRIJI PRELIV */
    .hero__shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(95deg, rgba(6, 19, 31, 0.72) 0%, rgba(6, 19, 31, 0.45) 35%, rgba(6, 19, 31, 0.1) 65%, transparent 100%),
        linear-gradient(0deg, rgba(6, 19, 31, 0.55) 0%, transparent 35%);
      z-index: -2;
    }

    .hero h1,
    .hero__lead {
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
    }

    .hero__content {
      padding-top: 130px;
      padding-bottom: 64px;
    }
    .hero h1 {
      margin-top: 20px;
      font-size: clamp(38px, 5vw, 64px);
      line-height: 1.02;
      letter-spacing: -0.045em;
      font-weight: 800;
      color: #fff;
    }
    .hero__lead {
      margin-top: 20px;
      max-width: 560px;
      color: #d4dee4;
      font-size: 15px;
      line-height: 1.65;
    }
    .hero__metrics {
      display: grid;
      grid-template-columns: repeat(3, auto);
      gap: 28px;
      margin-top: 28px;
      padding-top: 24px;
      border-top: 1px solid rgba(255,255,255,0.15);
      max-width: 520px;
    }
    .hero__metrics strong {
      display: block;
      font-size: 16px;
      font-weight: 700;
    }
    .hero__metrics span {
      display: block;
      margin-top: 4px;
      color: #94a3ad;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 28px;
    }

    .hero__dots {
      position: absolute;
      right: max(20px, calc((100% - 1280px) / 2));
      bottom: 28px;
      display: flex;
      gap: 8px;
      z-index: 3;
    }
    .hero__dot {
      width: 28px;
      height: 4px;
      padding: 0;
      border: 0;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.35);
      cursor: pointer;
      transition: background 0.3s ease, width 0.3s ease;
    }
    .hero__dot:hover { background: rgba(255, 255, 255, 0.7); }
    .hero__dot.is-active { width: 44px; background: var(--orange); }

    /* ========== CATEGORIES (4 KARTICE U NIZU / 2x2) ========== */
    .categories {
      background: #eef1f4;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 72px 0 80px;
    }
    .categories__wrap {
      width: min(1440px, calc(100% - 40px));
      margin-inline: auto;
    }
    .categories__grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
      align-items: stretch;
    }
    .cat-card {
      background: #fff;
      color: var(--navy);
      text-decoration: none;
      border: 1px solid #dce2e7;
      border-radius: 3px;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      height: 100%;
      box-shadow: 0 4px 16px rgba(6,19,31,0.04);
    }
    .cat-card:hover {
      transform: translateY(-6px);
      border-color: var(--orange);
      box-shadow: 0 20px 42px rgba(6,19,31,0.12);
    }
    .cat-card__image {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: #0a131c;
    }
    .cat-card__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      display: block;
    }
    .cat-card__video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cat-card:hover .cat-card__video,
    .cat-card:hover img { 
      transform: scale(1.05); 
    }
    .cat-card__image > span {
      position: absolute;
      left: 14px;
      top: 14px;
      color: #fff;
      background: var(--orange);
      font-size: 11px;
      font-weight: 800;
      padding: 4px 9px;
      border-radius: 2px;
      letter-spacing: 0.06em;
      box-shadow: 0 2px 8px rgba(0,0,0,0.25);
      z-index: 4;
    }

    .cat-card__art {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 16px 18px;
      background: linear-gradient(
        0deg,
        rgba(4, 14, 23, 0.95) 0%,
        rgba(4, 14, 23, 0.65) 40%,
        rgba(4, 14, 23, 0.02) 75%
      );
    }

    .cat-card__art-content {
      position: relative;
      z-index: 3;
    }
    .cat-card__art-eyebrow {
      display: block;
      color: var(--orange);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .cat-card__art-title {
      display: block;
      color: #fff;
      font-size: 15px;
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }
    .cat-card__art-title em {
      color: var(--orange);
      font-style: normal;
    }
    .cat-card__art-divider {
      width: 100%;
