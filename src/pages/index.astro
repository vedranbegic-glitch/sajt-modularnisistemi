---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LightboxModal from '../components/LightboxModal.astro';
import { SITE, CONTACT, ENGINEERING_STEPS } from '../data/siteData';
import { PRODUCT_CATEGORIES_LIST, CATEGORIES_DATA } from '../data/products';
import { GALLERY_ITEMS } from '../data/gallery';

// Prikazujemo samo 4 reprezentativna primera na početnoj (ostalo je na /galerija/)
const featuredGallery = GALLERY_ITEMS.slice(0, 4);
---

<BaseLayout
  title="Početna"
  description="Modularna rešenja za odvodnjavanje, rasvetu i podne sisteme — projektovana za savremenu arhitekturu i konkretan prostor. Jedan sistem. Bezbroj mogućnosti."
>

  <!-- 1. HERO SEKCIJA -->
  <section class="relative pt-12 pb-16 lg:pt-20 lg:pb-24 bg-navy bg-grid-pattern border-b border-white/10 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-navy-surface border border-accent/40 text-accent font-mono text-[11px] uppercase tracking-architectural font-bold">
            <span class="w-2 h-2 bg-accent inline-block" aria-hidden="true"></span>
            <span>{SITE.heroEyebrow}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.1]">
            Jedan sistem.<br />
            <span class="text-accent">Bezbroj mogućnosti.</span>
          </h1>

          <p class="text-sm sm:text-base text-slate-muted max-w-2xl leading-relaxed">
            {SITE.heroSubtitle}
          </p>

          <!-- B2B metrike -->
          <div class="grid grid-cols-3 gap-3 pt-4 border-t border-white/10 font-mono text-xs max-w-xl">
            <div class="border-l-2 border-accent pl-2.5">
              <span class="text-white font-bold block text-base sm:text-lg">100%</span>
              <span class="text-slate-muted text-[10px] uppercase tracking-wider">Po meri objekta</span>
            </div>
            <div class="border-l-2 border-accent pl-2.5">
              <span class="text-white font-bold block text-base sm:text-lg">AISI INOX</span>
              <span class="text-slate-muted text-[10px] uppercase tracking-wider">Legure 304 / 316</span>
            </div>
            <div class="border-l-2 border-accent pl-2.5">
              <span class="text-white font-bold block text-base sm:text-lg">CAD / BIM</span>
              <span class="text-slate-muted text-[10px] uppercase tracking-wider">Tehnička podrška</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 pt-3">
            <a
              href="/proizvodi/"
              class="inline-flex items-center justify-center px-7 py-3.5 bg-accent hover:bg-accent-hover text-white text-xs uppercase tracking-architectural font-bold transition-all border border-accent shadow-md text-center"
            >
              {SITE.primaryCtaText}
            </a>
            <a
              href="/posaljite-projekat/"
              class="inline-flex items-center justify-center px-7 py-3.5 bg-navy-surface hover:bg-white/10 text-white text-xs uppercase tracking-architectural font-bold border border-white/20 transition-all text-center"
            >
              {SITE.secondaryCtaText}
            </a>
          </div>
        </div>

        <!-- Hero vizuelni prikaz -->
        <div class="lg:col-span-5">
          <div class="relative bg-navy-dark border border-white/15 p-2 shadow-xl">
            <div class="relative aspect-[16/10] overflow-hidden bg-navy-surface flex items-center justify-center border border-white/10">
              <img
                src="/images/inox/inox-odvodnjavanje-glavna.jpg"
                alt="Inox drenažni sistem ugrađen uz geometriju bazena"
                class="w-full h-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
              />
              <div class="hidden absolute inset-0 bg-navy-surface p-5 flex flex-col justify-between" aria-hidden="true">
                <span class="px-2 py-0.5 bg-navy text-[9px] font-mono text-accent uppercase tracking-architectural border border-accent/40 self-start">
                  SISTEMSKI PROFIL
                </span>
                <div>
                  <span class="text-xs font-mono font-bold text-white block">Inox linijsko odvodnjavanje po meri</span>
                  <span class="text-[10px] font-mono text-slate-muted block mt-1">/images/inox/inox-odvodnjavanje-glavna.jpg</span>
                </div>
                <div class="border-t border-white/10 pt-2 flex justify-between items-center text-[9px] font-mono text-slate-muted">
                  <span>MODULARNI SISTEMI</span>
                  <span class="text-accent">AISI 304 / 316</span>
                </div>
              </div>
            </div>

            <div class="p-3 bg-navy-surface border-t border-white/10 flex items-center justify-between text-xs font-mono">
              <span class="text-slate-surface text-[11px] font-bold">RAD POLJA: GEOMETRIJA</span>
              <span class="text-accent uppercase tracking-architectural text-[10px]">PREFABRIKACIJA</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. TRI KATEGORIJE PROIZVODA -->
  <section class="py-14 lg:py-20 bg-navy-dark border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Portfolio"
        title="Tri primarna inženjerska pravca"
        subtitle="Specijalizovane linije projektovane za precizno uklapanje u savremene objekte."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {PRODUCT_CATEGORIES_LIST.map((category, index) => (
          <article class="bg-navy border border-white/10 hover:border-accent/50 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="relative aspect-[16/10] overflow-hidden bg-navy-surface border-b border-white/10 flex items-center justify-center">
                <img
                  src={category.heroImage}
                  alt={category.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                />
                <div class="hidden absolute inset-0 bg-navy-surface p-4 flex flex-col justify-between" aria-hidden="true">
                  <span class="px-2 py-0.5 bg-navy border border-accent/30 text-accent font-mono text-[9px] uppercase self-start">
                    KAT 0{index + 1}
                  </span>
                  <p class="text-xs font-mono font-bold text-white">{category.title}</p>
                  <span class="text-[9px] font-mono text-slate-muted">{category.heroImage}</span>
                </div>
                <div class="absolute top-2.5 left-2.5 pointer-events-none">
                  <span class="px-2 py-0.5 bg-navy/90 border border-white/15 text-[9px] font-mono uppercase tracking-architectural text-accent font-bold">
                    0{index + 1}
                  </span>
                </div>
              </div>

              <div class="p-5 space-y-3">
                <h3 class="text-lg font-bold text-white group-hover:text-accent transition-colors leading-tight">
                  {category.title}
                </h3>
                
                <p class="text-xs font-semibold text-accent font-mono uppercase tracking-wider">
                  "{category.headline}"
                </p>

                <p class="text-xs text-slate-muted leading-relaxed line-clamp-2">
                  {category.description}
                </p>
              </div>
            </div>

            <div class="p-5 pt-0">
              <a
                href={category.slug}
                class="inline-flex items-center justify-between w-full px-4 py-2.5 bg-navy-surface hover:bg-accent text-white text-xs uppercase tracking-architectural font-bold border border-white/15 hover:border-accent transition-all"
              >
                <span>Pregled sistema</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. FILOZOFIJA BRENDA I ISTAKNUTO REŠENJE (KOMPAKTNO SPOJENO) -->
  <section class="py-14 lg:py-20 bg-navy bg-grid-pattern border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mb-12">
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 text-accent font-mono text-xs uppercase tracking-architectural font-bold">
            <span class="w-2 h-2 bg-accent inline-block"></span>
            <span>Inženjerski manifest</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight">
            Ne prodajemo samo proizvod. Projektujemo rešenje prema prostoru.
          </h2>
          <p class="text-xs sm:text-sm text-slate-muted leading-relaxed">
            Standardna serijska rešenja nameću nepotrebne rezove i rizične kompromise na terenu. Pristup brenda <strong class="text-white">MODULARNI SISTEMI</strong> polazi od geometrije vašeg crteža — kanale, radijuse i prelaze proizvodimo tako da se besprekorno uklope u zadate linije.
          </p>
        </div>

        <div class="lg:col-span-5 grid grid-cols-2 gap-3 text-xs font-mono">
          <div class="p-4 bg-navy-surface border border-white/10">
            <span class="text-accent font-bold block mb-1">PRECIZNOST</span>
            <p class="text-slate-muted text-[11px]">Nema sečenja na terenu. Izrada po tačnoj meri crteža.</p>
          </div>
          <div class="p-4 bg-navy-surface border border-white/10">
            <span class="text-accent font-bold block mb-1">MATERIJALI</span>
            <p class="text-slate-muted text-[11px]">Nerđajući čelici AISI 304 i kiselootporni AISI 316.</p>
          </div>
          <div class="p-4 bg-navy-surface border border-white/10">
            <span class="text-accent font-bold block mb-1">MODULARNOST</span>
            <p class="text-slate-muted text-[11px]">Standardizovani prirubnički spojevi za brzu montažu.</p>
          </div>
          <div class="p-4 bg-navy-surface border border-white/10">
            <span class="text-accent font-bold block mb-1">B2B CAD</span>
            <p class="text-slate-muted text-[11px]">Podrška projektantima kroz 2D/3D preseke i predmere.</p>
          </div>
        </div>
      </div>

      <!-- Izdvojeni radijalni kanal -->
      <div class="bg-navy-surface border border-accent/40 p-6 sm:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <div class="lg:col-span-8 space-y-2">
            <span class="text-accent font-mono text-[10px] uppercase tracking-architectural font-bold block">
              Istaknuta tehnologija
            </span>
            <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Ne mora svaka kanalica da bude prava.
            </h3>
            <p class="text-xs text-slate-muted leading-relaxed">
              Izaberite formu prema geometriji prostora. Izrađujemo radijalne inox kanale po tačnom radijusu (R) bazena ili zaobljene terase bez nepravilnih lomova i bez improvizacija.
            </p>
          </div>
          <div class="lg:col-span-4 flex lg:justify-end">
            <a
              href="/inox-sistemi-odvodnjavanja/"
              class="px-6 py-3 bg-accent hover:bg-accent-hover text-white text-xs uppercase tracking-architectural font-bold transition-all border border-accent text-center w-full lg:w-auto"
            >
              Radijalni sistemi &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 4. FOKUSIRANA GALERIJA (SAMO 4 REPREZENTATIVNE STAVKE) -->
  <section class="py-14 lg:py-20 bg-navy-dark border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <SectionHeading
            eyebrow="Galerija"
            title="Karakteristična rešenja i detalji"
            subtitle="Izdvojeni primeri ugradnje iz našeg inženjerskog portfolija."
            class="mb-0 lg:mb-0"
          />
        </div>
        <a
          href="/galerija/"
          class="inline-flex items-center gap-1.5 text-xs uppercase tracking-architectural font-bold text-accent hover:text-white transition-colors"
        >
          <span>Pogledajte celu arhivu</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- 4 kompaktne kartice -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {featuredGallery.map((item) => (
          <div
            class="group bg-navy border border-white/10 hover:border-accent/60 transition-all duration-300 flex flex-col justify-between overflow-hidden cursor-pointer"
            onclick={`window.openModularLightbox && window.openModularLightbox({ src: '${item.image}', title: '${item.title}', desc: '${item.description}', category: '${item.categoryLabel}' })`}
            tabindex="0"
            role="button"
            aria-label={`Uvećaj: ${item.title}`}
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-navy-surface flex items-center justify-center border-b border-white/10">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
              />
              <div class="hidden absolute inset-0 bg-navy-surface p-3 flex flex-col justify-between" aria-hidden="true">
                <span class="text-[9px] font-mono text-accent uppercase">MS DETALJ</span>
                <p class="text-[11px] font-mono text-white font-bold">{item.title}</p>
                <span class="text-[9px] font-mono text-slate-muted">{item.categoryLabel}</span>
              </div>
              <div class="absolute inset-0 bg-navy/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="px-2.5 py-1 bg-navy/90 text-accent font-mono text-[9px] uppercase tracking-architectural border border-accent">
                  Uvećaj
                </span>
              </div>
            </div>

            <div class="p-4 space-y-1">
              <span class="text-[9px] font-mono text-accent uppercase tracking-architectural block font-bold">
                {item.categoryLabel}
              </span>
              <h4 class="text-xs font-bold text-white group-hover:text-accent transition-colors leading-snug">
                {item.title}
              </h4>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 5. KAKO RADIMO (KOMPAKTAN HORIZONTALNI RED) -->
  <section class="py-14 lg:py-18 bg-navy border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-2xl mb-8">
        <span class="text-accent font-mono text-xs uppercase tracking-architectural font-bold block mb-1">
          Metodologija
        </span>
        <h2 class="text-2xl font-extrabold text-white tracking-tight">
          Strukturisan proces od crteža do gradilišta
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {ENGINEERING_STEPS.map((step) => (
          <div class="p-5 bg-navy-surface border border-white/10 flex flex-col justify-between space-y-3">
            <div>
              <span class="text-2xl font-extrabold text-accent/60 font-mono block">
                {step.number}
              </span>
              <h3 class="text-xs font-bold text-white uppercase tracking-wider mt-1 mb-1.5">
                {step.title}
              </h3>
              <p class="text-[11px] text-slate-muted leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Lightbox Modal instance -->
  <LightboxModal />

</BaseLayout>