      .hero { min-height: 560px; }
      .hero__content { padding-top: 110px; padding-bottom: 40px; }
      .hero h1 { font-size: 32px; }
      .hero__lead { font-size: 14px; }
      .hero__metrics { grid-template-columns: 1fr; gap: 14px; }
      .hero__dots { right: 12px; bottom: 16px; }
      .categories, .gallery, .process { padding: 48px 0; }
      .philosophy { padding: 56px 0; }
      .philosophy__grid { grid-template-columns: 1fr; }
      .gallery__grid { grid-template-columns: 1fr; }
      .steps { grid-template-columns: 1fr; }
      .cta { min-height: 340px; }
      .cta__inner { padding: 40px 0; }
    }
  </style>

  <script>
    const slides = document.querySelectorAll<HTMLElement>('.hero__slide');
    const dots = document.querySelectorAll<HTMLButtonElement>('.hero__dot');

    if (slides.length > 1) {
      let current = 0;
      let timer: ReturnType<typeof setInterval> | undefined;

      const show = (index: number) => {
        const next = (index + slides.length) % slides.length;
        if (next === current) return;

        slides.forEach((s, i) => {
          s.classList.remove('is-prev');
          if (i === current) s.classList.add('is-prev');
          s.classList.toggle('is-active', i === next);
        });
        dots.forEach((d, i) => d.classList.toggle('is-active', i === next));

        current = next;
      };

      const stop = () => {
        if (timer) clearInterval(timer);
      };

      const start = () => {
        stop();
        timer = setInterval(() => show(current + 1), 3000);
      };

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = dot.dataset.index;
          if (idx !== undefined) {
            show(Number(idx));
            start();
          }
        });
      });

      start();
    }
  </script>
</BaseLayout>