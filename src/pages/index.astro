    .cta h2 {
      margin-top: 12px;
      font-size: clamp(26px, 3.3vw, 42px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }
    .cta p {
      margin-top: 12px;
      max-width: 520px;
      color: #b5c2ca;
      font-size: 14px;
      line-height: 1.6;
    }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 1200px) {
      .categories__grid {
