---
import BaseLayout from "../layouts/BaseLayout.astro";
import LightboxModal from "../components/LightboxModal.astro";

const programs = [
  {
    name: "Inox odvodnjavanje",
    full: "Inox sistemi odvodnjavanja",
    label: "Linija koja prati prostor.",
    description:
      "Ravne i zakrivljene forme za odvodnjavanje, prilagođene obliku vašeg prostora.",
    use: "Bazeni · terase · parteri",
    href: "/inox-sistemi-odvodnjavanja/",
    image:
      "/images/inox/skriveni-modularni-inox-kanal-s-forma-bazen-suva-plaza.webp",
    hero: "/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp",
    alt: "Lučni inox kanal prati ivicu zelenila u uređenom parteru",
    position: "65% center",
  },
  {
    name: "Moderna rasveta",
    full: "Moderna rasveta",
    label: "Prostor u novom svetlu.",
    description:
      "Prepoznatljiv dizajn Z-lampe za osvetljenje dvorišta, prilaza i poslovnih prostora.",
    use: "Dvorišta · prilazi · poslovni prostori",
    href: "/moderna-rasveta/",
    image:
      "/images/rasveta/z-lampa-moderna-led-rasveta-za-dvoriste-ulicna-rasveta.webp",
    hero: "/images/rasveta/z-lampa-moderna-led-rasveta-za-dvoriste-ulicna-rasveta.webp",
    alt: "Z-lampe osvetljavaju stazu uz savremeni objekat",
    position: "70% center",
  },
  {
    name: "Modularni podovi",
    full: "Modularni podni sistemi",
    label: "Dobra osnova za vaše ideje.",
    description:
      "Podni moduli i izbor završnih obloga za uređenje terasa, dvorišta i drugih površina.",
    use: "Terase · dvorišta · radne površine",
    href: "/modularni-podni-sistemi/",
    image: "/images/podovi/modularni-pod-terasa-kamene-staze-basta-2.webp",
    hero: "/images/podovi/modularni-pod-terasa-kamene-staze-basta-2.webp",
    alt: "Modularne podne površine i kamena staza u vrtu",
    position: "center",
  },
  {
    name: "Fire Pit Grill",
    full: "Fire Pit Grill",
    label: "Mesto za dobre trenutke.",
    description:
      "Čelično ložište i roštilj u jednom — za toplinu, pripremu hrane i okupljanje na otvorenom.",
    use: "Dvorišta · terase · druženje",
    href: "/fire-pit-grill/",
    image: "/images/fire-pit/fire-pit-grill-terasa-vatra-sumrak.webp",
    hero: "/images/fire-pit/fire-pit-grill-terasa-vatra-sumrak.webp",
    alt: "Fire Pit Grill sa vatrom na terasi u sumrak",
    position: "center",
  },
];
// Original product renders, ordered consistently with the shape selector.
const models = [
  {
    name: "Ravna",
    image:
      "/images/inox/ravni-modularni-inox-kanal-odvodnjavanje-drenaza-siva.webp",
    alt: "3D prikaz ravne inox kanalice i detalja konstrukcije",
  },
  {
    name: "Lučna",
    image: "/images/inox/lucni-inox-kanal-linijsko-odvodnjavanje-siva.webp",
    alt: "3D prikaz lučne inox kanalice",
  },
  {
    name: "Kružna",
    image: "/images/inox/kruzni-prohromski-kanal-za-odvodnjavanje-siva.webp",
    alt: "3D prikaz kružne inox kanalice",
  },
  {
    name: "Elipsasta",
    image: "/images/inox/elipsasti-inox-kanal-za-odvodnjavanje-siva.webp",
    alt: "3D prikaz elipsaste inox kanalice",
  },
  {
    name: "S-forma",
    image: "/images/inox/s-forma-lucni-inox-kanal-odvodnjavanje-siva.webp",
    alt: "3D prikaz inox kanalice u S-formi sa nivelacionim stopama",
  },
];

// URLs are assigned to the single player only after an explicit play request.
const videos = [
  {
    name: programs[0].name,
    poster: programs[0].hero,
    webm: "/videos/inox-sistemi-odvodnjavanja.webm",
    mp4: "/videos/inox-sistemi-odvodnjavanja.mp4",
  },
  {
    name: programs[1].name,
    poster: programs[1].hero,
    webm: "/videos/moderna-rasveta.webm",
    mp4: "/videos/moderna-rasveta.mp4",
  },
  {
    name: programs[2].name,
    poster: programs[2].hero,
    webm: "/videos/modularni-podovi.webm",
    mp4: "/videos/modularni-podovi.mp4",
  },
  {
    name: programs[3].name,
    poster: programs[3].hero,
    webm: "/videos/fire-pit-grill.webm",
    mp4: "/videos/Fire Pit grill.mp4",
  },
];
const gallery = [
  {
    image: "/images/podovi/modularni-pod-terasa-kisa-noc-1.webp",
    title: "Terasa. U drugačijem svetlu.",
    category: "Modularni podovi",
    alt: "Osvetljena terasa sa modularnim podom posle kiše",
  },
  {
    image: "/images/inox/lucni-skriveni-inox-kanal-zalazak-sunca.webp",
    title: "Detalj koji prati liniju.",
    category: "Inox odvodnjavanje",
    alt: "Lučni skriveni inox kanal uz šetalište pri zalasku sunca",
  },
  {
    image: "/images/rasveta/z-profil-led-lampa-detalj-konstrukcij-1.webp",
    title: "Prepoznatljiv iz svakog ugla.",
    category: "Moderna rasveta",
    alt: "Detalj konstrukcije i Z-profila lampe",
  },
  {
    image: "/images/fire-pit/fire-pit-grill-celicna-vatra-rostilj.webp",
    title: "Veče oko vatre.",
    category: "Fire Pit Grill",
    alt: "Čelični Fire Pit Grill sa vatrom i dekorativnim otvorima",
  },
];
const steps = [
  {
    title: "Pokažite nam prostor",
    text: "Pošaljite fotografiju, skicu ili nacrt i opišite šta vam je potrebno.",
  },
  {
    title: "Razrađujemo rešenje",
    text: "Usklađujemo izbor sistema, mere i oblik kroz crtež i 3D prikaz.",
  },
  {
    title: "Dogovaramo detalje",
    text: "Zajedno definišemo rešenje i detalje potrebne za izradu.",
  },
  {
    title: "Od crteža do proizvoda",
    text: "Izrada prema dogovoru, uz informacije i podršku pri ugradnji.",
  },
];
---

<BaseLayout
  title="Odvodnjavanje, rasveta, podovi i Fire Pit Grill"
  description="Modularni sistemi za vaš dom, dvorište i poslovni prostor. Inox odvodnjavanje, moderna rasveta, modularni podovi i Fire Pit Grill. Prvo crtež, pa onda proizvod."
  ogImage={programs[0].hero}
>
  <div class="ms-home" id="ms-home">
    <section
      class="ms-hero"
      aria-labelledby="ms-title"
      aria-roledescription="karusel"
    >
      <div class="ms-hero__images">
        {programs.map((program, i) => (
          <img
            class:list={["ms-hero__image", { "is-active": i === 0 }]}
            src={program.hero}
            alt={program.alt}
            width={i === 0 ? 1280 : i === 1 ? 2688 : 1536}
            height={i === 0 ? 720 : i === 1 ? 1152 : 1024}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
            decoding="async"
            style={`object-position:${program.position}`}
            aria-hidden={i !== 0 ? "true" : "false"}
          />
        ))}
      </div>
      <div class="ms-hero__shade"></div>
      <div class="ms-container ms-hero__content">
        <div class="ms-kicker ms-kicker--light">
          <span></span> Oblik. Funkcija. Vaš prostor.
        </div>
        <h1 id="ms-title">
          Jedan sistem.
          <br />
          <em>
            Bezbroj
            <br class="ms-mobile-break" /> mogućnosti.
          </em>
        </h1>
        <p class="ms-hero__lead">
          Odvodnjavanje, rasveta, podovi i Fire Pit Grill.
          <br />
          Pažljivo osmišljeni za vaš dom, dvorište i poslovni prostor.
        </p>
        <div class="ms-actions">
          <a class="ms-button ms-button--orange" href="/proizvodi/">
            Pogledajte proizvode <span aria-hidden="true">↗</span>
          </a>
          <a class="ms-button ms-button--outline" href="/posaljite-projekat/">
            Pošaljite upit <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="ms-hero__note">
          <span aria-hidden="true">⌁</span> Od prve skice do rešenja za vaš
          prostor.
        </div>
      </div>
      <div class="ms-hero__bottom ms-container">
        <div class="ms-hero__controls">
          <span>Četiri programa. Jedan pristup.</span>
          <button
            type="button"
            id="ms-autoplay"
            aria-pressed="false"
            aria-label="Pokreni automatsku smenu slika"
          >
            Pokreni smenu <span aria-hidden="true">▷</span>
          </button>
        </div>
        <div
          class="ms-program-nav"
          aria-label="Izaberite prikaz proizvodnog programa"
        >
          {programs.map((program, i) => (
            <button
              type="button"
              class:list={["ms-program-choice", { "is-active": i === 0 }]}
              data-slide={i}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              <span class="ms-number">0{i + 1}</span>
              <span>{program.name}</span>
              <span class="ms-choice-arrow" aria-hidden="true">
                ↗
              </span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section
      class="ms-programs ms-section"
      id="ms-programs"
      aria-labelledby="ms-programs-title"
    >
      <div class="ms-container">
        <div class="ms-section-head ms-reveal">
          <div>
            <div class="ms-kicker">
              <span></span> Naša rešenja / 01—04
            </div>
            <h2 id="ms-programs-title">
              Vaš prostor.
              <br />
              <span class="ms-muted">Mnogo mogućnosti.</span>
            </h2>
          </div>
          <p>
            Od jednog detalja do uređenja celog prostora. Pronađite program koji
            odgovara vašoj ideji — mi smo tu da pomognemo oko izbora.
          </p>
        </div>
        <div class="ms-product-grid">
          {programs.map((program, i) => (
            <article class="ms-product ms-reveal">
              <a
                href={program.href}
                class="ms-product__visual"
                aria-label={`Pogledajte: ${program.full}`}
              >
                <img
                  src={program.image}
                  alt={program.alt}
                  loading="lazy"
                  decoding="async"
                  width="1440"
                  height="1080"
                />
                <span class="ms-product__index">
                  0{i + 1} <span>/ MODULARNI SISTEMI</span>
                </span>
                <div class="ms-product__overlay">
                  <span>{program.use}</span>
                  <h3>{program.label}</h3>
                </div>
                <span class="ms-product__arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
              <div class="ms-product__body">
                <div>
                  <h4>
                    <a href={program.href}>{program.full}</a>
                  </h4>
                  <p>{program.description}</p>
                </div>
                <a class="ms-text-link" href={program.href}>
                  Istražite program <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ms-design ms-section" aria-labelledby="ms-design-title">
      <div class="ms-container">
        <div class="ms-design__top">
          <div class="ms-kicker ms-kicker--light">
            <span></span> Preciznost počinje idejom
          </div>
          <span class="ms-design__caption">
            3D PROJEKTOVANJE / TEHNIČKA RAZRADA
          </span>
        </div>
        <div class="ms-design__grid">
          <div class="ms-design__copy ms-reveal">
            <h2 id="ms-design-title">
              Prvo crtež,
              <br />
              pa onda <em>proizvod.</em>
            </h2>
            <p class="ms-design__lead">Dobar rezultat počinje jasnom slikom.</p>
            <p>
              Pre izrade razrađujemo oblik, mere i uklapanje u prostor. Kroz
              tehnički crtež i 3D prikaz lakše sagledavamo detalje i zajedno
              dolazimo do odgovarajućeg rešenja.
            </p>
            <div class="ms-design__details">
              <div>
                <span>01</span>
                <p>Razumemo vaš prostor</p>
              </div>
              <div>
                <span>02</span>
                <p>Usklađujemo oblik i mere</p>
              </div>
              <div>
                <span>03</span>
                <p>Razrađujemo detalje izrade</p>
              </div>
            </div>
            <a class="ms-button ms-button--orange" href="/posaljite-projekat/">
              Razgovarajmo o vašoj ideji <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="ms-model ms-reveal">
            <div class="ms-model__head">
              <span>
                <i></i> DETALJ SISTEMA
              </span>
              <span>INOX / 3D PRIKAZ</span>
            </div>
            <div class="ms-model__stage">
              {models.map((model, i) => (
                <img
                  src={model.image}
                  alt={model.alt}
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  class:list={["ms-model__image", { "is-active": i === 0 }]}
                  aria-hidden={i !== 0 ? "true" : "false"}
                />
              ))}
            </div>
            <div
              class="ms-model__choices"
              aria-label="Izaberite formu 3D prikaza"
            >
              {models.map((model, i) => (
                <button
                  type="button"
                  data-model={i}
                  aria-pressed={i === 0 ? "true" : "false"}
                  class:list={{ "is-active": i === 0 }}
                >
                  {model.name}
                  <span aria-hidden="true">↗</span>
                </button>
              ))}
            </div>
            <div class="ms-model__foot">
              <span>Oblik prati prostor.</span>
              <a href="/inox-sistemi-odvodnjavanja/">
                Upoznajte sistem <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
        <div class="ms-film ms-reveal">
          <div>
            <span class="ms-kicker ms-kicker--light">Sistemi u pokretu</span>
            <p>Pogledajte video izabranog proizvodnog programa.</p>
          </div>
          <button
            type="button"
            class="ms-button ms-button--outline"
            id="ms-film-toggle"
            aria-controls="ms-film-panel"
            aria-expanded="false"
          >
            <span aria-hidden="true">▷</span> Pogledajte video
          </button>
        </div>
        <div
          class="ms-film-choices"
          role="group"
          aria-label="Izaberite proizvodni program za video"
        >
          {videos.map((video, i) => (
            <button
              type="button"
              class:list={["ms-film-choice", { "is-active": i === 0 }]}
              data-video-index={i}
              data-video-name={video.name}
              data-video-poster={video.poster}
              data-video-webm={video.webm}
              data-video-mp4={video.mp4}
              aria-pressed={i === 0 ? "true" : "false"}
              aria-controls="ms-film-panel"
            >
              <span class="ms-film-choice__number">0{i + 1}</span>
              <span>{video.name}</span>
            </button>
          ))}
        </div>
        <div class="ms-film-preview">
          <img
            id="ms-film-poster"
            src={videos[0].poster}
            alt={`Video: ${videos[0].name}`}
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
          />
          <div>
            <span>IZABRANI PROGRAM</span>
            <p id="ms-film-selection" aria-live="polite">
              {videos[0].name}
            </p>
          </div>
        </div>
        <div id="ms-film-panel" class="ms-film-panel" hidden>
          <video
            id="ms-film-video"
            controls
            playsinline
            preload="none"
            poster={videos[0].poster}
            aria-label={`Video: ${videos[0].name}`}
          >
            Vaš pregledač ne podržava video.{" "}
            <a id="ms-film-download" href={videos[0].mp4}>
              Preuzmite video.
            </a>
          </video>
          <p id="ms-film-error" class="ms-film-error" role="status" hidden>
            Video nije moguće reprodukovati.{" "}
            <a id="ms-film-error-link" href={videos[0].mp4}>
              Otvorite MP4 snimak.
            </a>
          </p>
        </div>
      </div>
    </section>

    <section class="ms-gallery ms-section" aria-labelledby="ms-gallery-title">
      <div class="ms-container">
        <div class="ms-section-head ms-reveal">
          <div>
            <div class="ms-kicker">
              <span></span> Proizvodi i primena
            </div>
            <h2 id="ms-gallery-title">
              Detalji stvaraju
              <br />
              <span class="ms-muted">celinu.</span>
            </h2>
          </div>
          <div class="ms-section-aside">
            <p>
              Oblik, materijal i atmosfera. Pogledajte kako se naši sistemi
              uklapaju u različite prostore.
            </p>
            <a class="ms-text-link" href="/galerija/">
              Pogledajte celu galeriju <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="ms-gallery__grid">
          {gallery.map((item, i) => (
            <button
              type="button"
              class:list={[
                "ms-gallery-card",
                "ms-reveal",
                { "ms-gallery-card--wide": i === 0 || i === 3 },
              ]}
              data-gallery-src={item.image}
              data-gallery-title={item.title}
              data-gallery-category={item.category}
              aria-label={`Uvećajte prikaz: ${item.title}`}
            >
              <img
                src={item.image}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                width="1536"
                height="1024"
              />
              <div class="ms-gallery-card__caption">
                <span>{item.category}</span>
                <strong>{item.title}</strong>
              </div>
              <span class="ms-gallery-card__plus" aria-hidden="true">
                +
              </span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="ms-process ms-section" aria-labelledby="ms-process-title">
      <div class="ms-container">
        <div class="ms-section-head ms-reveal">
          <div>
            <div class="ms-kicker">
              <span></span> Jednostavno, korak po korak
            </div>
            <h2 id="ms-process-title">
              Od vaše ideje
              <br />
              do <span class="ms-muted">gotovog rešenja.</span>
            </h2>
          </div>
          <p>
            Za prvi razgovor dovoljno je da nam kažete šta želite. Zajedno ćemo
            razraditi sledeći korak.
          </p>
        </div>
        <ol class="ms-steps">
          {steps.map((step, i) => (
            <li class="ms-reveal">
              <span class="ms-step-number">0{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="ms-contact" aria-labelledby="ms-contact-title">
      <div class="ms-container ms-contact__inner">
        <div class="ms-reveal">
          <div class="ms-kicker ms-kicker--light">
            <span></span> Vaša ideja je dobar početak
          </div>
          <h2 id="ms-contact-title">
            Šta želite
            <br />
            da <em>stvorimo?</em>
          </h2>
          <p>
            Uređujete dvorište, terasu, bazen ili poslovni prostor?
            <br />
            Pošaljite nam pitanje, fotografiju ili skicu.
          </p>
        </div>
        <div class="ms-contact__actions ms-reveal">
          <a class="ms-button ms-button--orange" href="/posaljite-projekat/">
            Pošaljite upit <span aria-hidden="true">↗</span>
          </a>
          <a class="ms-contact__link" href="/kontakt/">
            Kontakt i dodatne informacije <span aria-hidden="true">→</span>
          </a>
          <span class="ms-contact__note">
            Za privatne kupce i profesionalce.
          </span>
        </div>
      </div>
      <div class="ms-container ms-contact__signature">
        <span>MODULARNI SISTEMI</span>
        <span>Jedan sistem. Bezbroj mogućnosti.</span>
      </div>
    </section>
  </div>
  <LightboxModal />
</BaseLayout>

<style>
  .ms-home {
    --ms-navy: #06131f;
    --ms-ink: #102332;
    --ms-orange: #ff6900;
    --ms-paper: #f3f5f5;
    --ms-line: #d8dfe1;
    --ms-muted: #5c6b75;
    color: var(--ms-ink);
    background: var(--ms-paper);
    font-family:
      Manrope,
      system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
    isolation: isolate;
    overflow: clip;
  }
  .ms-home * {
    box-sizing: border-box;
  }
  .ms-home h1,
  .ms-home h2,
  .ms-home h3,
  .ms-home h4,
  .ms-home p {
    margin: 0;
  }
  .ms-home button {
    font: inherit;
    cursor: pointer;
  }
  .ms-home a {
    text-decoration: none;
  }
  .ms-home button:focus-visible,
  .ms-home a:focus-visible {
    outline: 3px solid var(--ms-orange);
    outline-offset: 6px;
  }
  .ms-container {
    width: min(1320px, calc(100% - 96px));
    margin-inline: auto;
  }
  .ms-section {
    padding-block: 108px;
  }
  .ms-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    line-height: 1.6;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #9b4000;
  }
  .ms-kicker > span:first-child {
    width: 24px;
    height: 2px;
    background: var(--ms-orange);
  }
  .ms-kicker--light {
    color: #ff9c55;
  }
  .ms-home h2 {
    font-size: clamp(34px, 4.1vw, 58px);
    line-height: 1.08;
    letter-spacing: -0.055em;
