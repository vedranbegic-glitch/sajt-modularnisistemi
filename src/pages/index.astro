    .eng-hero__photo-mark { font-size:8px; top:20px; right:19px; }

    /* Mobilni izbor programa: sve tri opcije su vidljive, bez sečenja teksta. */

    .eng-hero__navigation { width:calc(100% - 36px); margin-inline:auto; }

    .eng-hero__nav-head { flex-wrap:wrap; gap:6px 12px; }

    .eng-hero__toggle { flex-shrink:0; font-size:11px; white-space:nowrap; }

    .eng-hero__tabs { display:grid; grid-template-columns:1fr; overflow:visible; scroll-snap-type:none; }

    .eng-hero__tab,

    .eng-hero__tab:first-child { width:100%; min-width:0; min-height:49px; padding:10px 12px; border-right:0; border-bottom:1px solid #ffffff25; gap:12px; }

