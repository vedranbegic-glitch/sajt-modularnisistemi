</style>

<script>
  // Hero: simple 3-second rotation, independent of OS animation preference.
  const root = document.getElementById("ms-home");
  if (root) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const slides = Array.from(root.querySelectorAll<HTMLImageElement>(".ms-hero__image"));
    const choices = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-slide]"));
    const autoplay = root.querySelector<HTMLButtonElement>("#ms-autoplay");
    const navigation = root.querySelector<HTMLElement>(".ms-program-nav");
    const SLIDE_DURATION = 3000;
    let current = 0;
    let playing = true;
    let timer: ReturnType<typeof setInterval> | undefined;
    let progressFrame: number | undefined;
    let progressStart = performance.now();

    const stopClock = () => {
      if (timer !== undefined) clearInterval(timer);
      timer = undefined;
      if (progressFrame !== undefined) cancelAnimationFrame(progressFrame);
      progressFrame = undefined;
    };

    const showSlide = (index: number) => {
      if (!slides.length) return;
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === current);
        slide.setAttribute("aria-hidden", String(i !== current));
      });
      choices.forEach((choice, i) => {
        choice.classList.toggle("is-active", i === current);
        choice.setAttribute("aria-pressed", String(i === current));
      });
      progressStart = performance.now();
      navigation?.style.setProperty("--ms-progress", "0");
    };

    const updateProgress = () => {
      if (!playing || document.hidden) return;
      const elapsed = performance.now() - progressStart;
      navigation?.style.setProperty("--ms-progress", String(Math.min(elapsed / SLIDE_DURATION, 1)));
      progressFrame = requestAnimationFrame(updateProgress);
    };

    const syncClock = () => {
      stopClock();
      if (!playing || document.hidden || slides.length < 2) {
        navigation?.style.setProperty("--ms-progress", "1");
        return;
      }
      progressStart = performance.now();
      progressFrame = requestAnimationFrame(updateProgress);
      timer = setInterval(() => showSlide(current + 1), SLIDE_DURATION);
    };

    const setPlaying = (value: boolean) => {
      playing = value;
      if (autoplay) {
        autoplay.hidden = false;
        autoplay.disabled = false;
        autoplay.setAttribute("aria-pressed", String(value));
        autoplay.setAttribute("aria-label", value ? "Pauziraj automatsku smenu slika" : "Pokreni automatsku smenu slika");
        autoplay.textContent = value ? "Pauziraj smenu  Ⅱ" : "Pokreni smenu  ▷";
      }
      syncClock();
    };

    choices.forEach((choice, index) => {
      choice.addEventListener("click", () => {
        showSlide(index);
        syncClock();
      });
    });
    autoplay?.addEventListener("click", () => setPlaying(!playing));
    document.addEventListener("visibilitychange", syncClock);
    reducedMotion.addEventListener("change", () => {
      if (reducedMotion.matches) {
        root.querySelectorAll(".ms-awaiting").forEach((el) => el.classList.remove("ms-awaiting"));
      }
    });
    setPlaying(true);
    const modelImages = Array.from(
      root.querySelectorAll<HTMLImageElement>(".ms-model__image"),
    );
    const modelChoices = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-model]"),
    );
    modelChoices.forEach((button, index) =>
      button.addEventListener("click", () => {
        modelImages.forEach((img, i) => {
          img.classList.toggle("is-active", i === index);
          img.setAttribute("aria-hidden", String(i !== index));
        });
        modelChoices.forEach((choice, i) => {
          choice.classList.toggle("is-active", i === index);
          choice.setAttribute("aria-pressed", String(i === index));
        });
      }),
    );
    // One video element for all programs. Selection alone never fetches a video.
    const filmButton = root.querySelector<HTMLButtonElement>("#ms-film-toggle");
    const filmPanel = root.querySelector<HTMLElement>("#ms-film-panel");
    const film = root.querySelector<HTMLVideoElement>("#ms-film-video");
    const filmPoster = root.querySelector<HTMLImageElement>("#ms-film-poster");
    const filmSelection = root.querySelector<HTMLElement>("#ms-film-selection");
    const filmDownload =
      root.querySelector<HTMLAnchorElement>("#ms-film-download");
    const filmError = root.querySelector<HTMLElement>("#ms-film-error");
    const filmErrorLink = root.querySelector<HTMLAnchorElement>(
      "#ms-film-error-link",
    );
    const videoChoices = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-video-index]"),
    );
    let selectedVideo = 0;
    let videoRequest = 0;

    const closeVideo = () => {
      videoRequest += 1;
      if (film) {
        film.pause();
        // Removing sources and resetting cancels the current media resource.
        film.querySelectorAll("source").forEach((source) => source.remove());
        film.removeAttribute("src");
        film.load();
      }
      if (filmPanel) filmPanel.hidden = true;
      if (filmError) filmError.hidden = true;
      filmButton?.setAttribute("aria-expanded", "false");
      if (filmButton) filmButton.textContent = "▷ Pogledajte video";
    };

    videoChoices.forEach((choice, index) =>
      choice.addEventListener("click", () => {
        if (index === selectedVideo) return;
        closeVideo();
        selectedVideo = index;
        videoChoices.forEach((button, i) => {
          button.classList.toggle("is-active", i === index);
          button.setAttribute("aria-pressed", String(i === index));
        });
        const name = choice.dataset.videoName ?? "";
        const poster = choice.dataset.videoPoster ?? "";
        const mp4 = choice.dataset.videoMp4 ?? "";
        if (filmPoster) {
          filmPoster.src = poster;
          filmPoster.alt = `Video: ${name}`;
        }
        if (filmSelection) filmSelection.textContent = name;
        if (film) {
          film.poster = poster;
          film.setAttribute("aria-label", `Video: ${name}`);
        }
        if (filmDownload) filmDownload.href = mp4;
        if (filmErrorLink) filmErrorLink.href = mp4;
      }),
    );

    filmButton?.addEventListener("click", () => {
      if (!filmPanel || !film) return;
      if (!filmPanel.hidden) {
        closeVideo();
        return;
      }
      const choice = videoChoices[selectedVideo];
      if (!choice) return;
      const request = ++videoRequest;
      filmPanel.hidden = false;
      if (filmError) filmError.hidden = true;
      filmButton.setAttribute("aria-expanded", "true");
      filmButton.textContent = "Zatvorite video ×";
      const sources = [
        { src: choice.dataset.videoWebm, type: "video/webm" },
        { src: choice.dataset.videoMp4, type: "video/mp4" },
      ];
      sources.forEach(({ src, type }) => {
        if (!src) return;
        const source = document.createElement("source");
        source.src = src;
        source.type = type;
        film.append(source);
      });
      film.load();
      void film.play().catch(() => {
        // Ignore interrupted requests; native controls handle autoplay restrictions.
        if (request === videoRequest && film.error && filmError)
          filmError.hidden = false;
      });
    });
    film?.addEventListener("error", () => {
      if (filmPanel && !filmPanel.hidden && filmError) filmError.hidden = false;
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) film?.pause();
    });
    window.addEventListener("pagehide", () => film?.pause());
    // Keep the existing LightboxModal and its public API; add page-local focus management.
    let galleryOpener: HTMLButtonElement | null = null;
    root
      .querySelectorAll<HTMLButtonElement>("[data-gallery-src]")
      .forEach((button) =>
        button.addEventListener("click", () => {
          const openLightbox = (
            window as Window & {
              openModularLightbox?: (data: {
                src: string;
                title: string;
                desc: string;
                category: string;
              }) => void;
            }
          ).openModularLightbox;
          if (openLightbox) {
            galleryOpener = button;
            openLightbox({
              src: button.dataset.gallerySrc ?? "",
              title: button.dataset.galleryTitle ?? "",
              desc: "",
              category: button.dataset.galleryCategory ?? "",
            });
          }
        }),
      );
    const dialog = document.getElementById("lightbox-dialog");
    if (dialog) {
      dialog.addEventListener("keydown", (event) => {
        if (
          event.key !== "Tab" ||
          dialog.getAttribute("aria-hidden") === "true"
        )
          return;
        const focusable = Array.from(
          dialog.querySelectorAll<HTMLElement>(
            'button:not([disabled]), a[href], [tabindex="0"]',
          ),
        ).filter((el) => el.getClientRects().length > 0);
        const first = focusable[0],
          last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      });
      new MutationObserver(() => {
        if (dialog.getAttribute("aria-hidden") === "true" && galleryOpener) {
          galleryOpener.focus({ preventScroll: true });
          galleryOpener = null;
        }
      }).observe(dialog, {
        attributes: true,
        attributeFilter: ["aria-hidden"],
      });
    }
    // Content stays visible without JavaScript and with reduced motion.
    if ("IntersectionObserver" in window && !reducedMotion.matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.remove("ms-awaiting");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08 },
      );
      root.querySelectorAll<HTMLElement>(".ms-reveal").forEach((el) => {
        if (el.getBoundingClientRect().top > window.innerHeight) {
          el.classList.add("ms-awaiting");
          observer.observe(el);
        }
      });
    }

  }
</script>
