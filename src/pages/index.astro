    .eng-explorer__item { min-height:80px; padding:12px 12px; gap:10px; }

    .eng-explorer__item img { display:block; width:64px; height:53px; flex:none; object-fit:cover; order:-1; }

    .eng-explorer__item-number { display:none; }

    .eng-explorer__item-copy strong { font-size:14px; }

    .eng-explorer__item-copy small { font-size:11px; }

