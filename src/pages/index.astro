    .eng-hero__copy { padding-bottom:24px; }

    .eng-hero h1 { font-size:clamp(34px,9.4vw,49px); line-height:1.065; }

    .eng-hero__text { font-size:13px; }

    .eng-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); }

    .eng-button { gap:8px; padding:12px; font-size:11px; min-height:48px; }

    .eng-hero__stage { height:315px; }

    .eng-hero__stage-caption { left:24px; bottom:20px; right:24px; }

