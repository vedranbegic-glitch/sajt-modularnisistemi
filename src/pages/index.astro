  @media (prefers-reduced-motion:reduce) {

    .eng *, .eng *::before, .eng *::after { animation-duration:.01ms!important; transition-duration:.01ms!important; scroll-behavior:auto!important; }

    /* Korisnik može eksplicitno da uključi smenu čak i uz sistemsku opciju smanjenog kretanja. */

    .eng.eng-motion-opt-in .eng-hero__picture { transition-duration:.8s, 0s!important; }

  }

</style>

<script>

  const initEngineeringV3 = () => {

    const root = document.querySelector<HTMLElement>("#engineering-home");

    if (!root || root.dataset.engInitialized === "true") return;

    root.dataset.engInitialized = "true";

    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-hero-picture]"));

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-hero-tab]"));

    const nav = root.querySelector<HTMLElement>(".eng-hero__tabs");

    const pause = root.querySelector<HTMLButtonElement>("[data-slider-pause]");

    const pauseLabel = root.querySelector<HTMLElement>("[data-slider-label]");

    const pauseSymbol = root.querySelector<HTMLElement>("[data-slider-symbol]");

    const stageNumber = root.querySelector<HTMLElement>("[data-hero-number]");

    const stageName = root.querySelector<HTMLElement>("[data-hero-name]");

    const stageLink = root.querySelector<HTMLAnchorElement>("[data-hero-link]");

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    const interval = 3000;

    let current = 0;

    let elapsed = 0;

    let previous: number | null = null;

    let raf = 0;

    let manual = false;

    // U režimu smanjenog kretanja korisnik sam odlučuje da li želi automatsku smenu.

    let motionOptIn = false;

    let hovering = false;

    let focused = false;

    const canPlay = () =>

      slides.length > 1 && (!reduce.matches || motionOptIn) &&

      !manual && !hovering && !focused && !document.hidden;

    const paint = () => {

      nav?.style.setProperty("--eng-progress", String(Math.min(1, elapsed / interval)));

    };

    const choose = (i: number) => {

      if (!slides.length) return;

      current = ((i % slides.length) + slides.length) % slides.length;

      slides.forEach((slide, j) => slide.classList.toggle("is-active", j === current));

      tabs.forEach((tab, j) => {

        tab.classList.toggle("is-active", j === current);

        tab.setAttribute("aria-pressed", String(j === current));

      });

      const tab = tabs[current];

      if (tab) {

        if (stageName) stageName.textContent = tab.dataset.name ?? "Program";

        if (stageNumber) stageNumber.textContent = String(current + 1).padStart(2, "0");

        if (stageLink) {

          stageLink.href = tab.dataset.href ?? "/proizvodi/";

          stageLink.setAttribute("aria-label", `Otvori program: ${tab.dataset.name ?? "Program"}`);

        }

      }

      elapsed = 0;

      previous = null;

      paint();

    };

    const tick = (t: number) => {

      raf = 0;

      if (!canPlay()) return;

      if (previous !== null) elapsed += Math.max(0, t - previous);

      previous = t;

      if (elapsed >= interval) choose(current + 1);

      paint();

      raf = requestAnimationFrame(tick);

    };

    const sync = () => {

      if (raf) cancelAnimationFrame(raf);

      raf = 0;

      previous = null;

      if (canPlay()) raf = requestAnimationFrame(tick);

      paint();

    };

    const updatePause = () => {

      if (!pause) return;

      const needsOptIn = reduce.matches && !motionOptIn;

      const stopped = needsOptIn || manual;

      pause.disabled = slides.length < 2;

      pause.setAttribute("aria-pressed", String(!stopped));

      pause.setAttribute("aria-label", stopped ? "Pokreni automatsku smenu fotografija" : "Pauziraj automatsku smenu fotografija");

      if (pauseLabel) pauseLabel.textContent = stopped ? "Pokreni smenu" : "Pauziraj";

      if (pauseSymbol) pauseSymbol.textContent = stopped ? "▷" : "Ⅱ";

      root.classList.toggle("eng-motion-opt-in", motionOptIn);

    };

    tabs.forEach((tab, i) => {

      tab.addEventListener("click", () => { choose(i); sync(); });

      // Fokus dobijen mišem ne sme trajno blokirati smenu posle klika.

      tab.addEventListener("focus", () => {

        focused = tab.matches(":focus-visible");

        if (focused) sync();

      });

      tab.addEventListener("blur", () => {

        focused = false;

        sync();

      });

    });

    pause?.addEventListener("click", () => {

      if (reduce.matches && !motionOptIn) {

        motionOptIn = true;

        manual = false;

      } else {

        manual = !manual;

      }

      updatePause();

      sync();

    });

    nav?.addEventListener("pointerenter", (e: PointerEvent) => {

      if (e.pointerType === "mouse" || e.pointerType === "pen") {

        hovering = true;

        sync();

      }

    });

    nav?.addEventListener("pointerleave", () => { hovering = false; sync(); });

    reduce.addEventListener("change", () => {

      motionOptIn = false;

      manual = false;

      updatePause();

      sync();

    });

    document.addEventListener("visibilitychange", sync);

    updatePause();

    sync();

    window.addEventListener("pagehide", () => { if (raf) cancelAnimationFrame(raf); }, { once: true });

    // Indeks programa: prelaskom miša ili fokusom menja se prikaz, klik otvara detaljnu stranicu.

    const items=Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-explorer-item]"));

    const previews=Array.from(root.querySelectorAll<HTMLElement>("[data-explorer-image]"));

    const previewTitle=root.querySelector<HTMLElement>("[data-explorer-title]");

    const previewNum=root.querySelector<HTMLElement>("[data-explorer-number]");

    const previewLink=root.querySelector<HTMLAnchorElement>("[data-explorer-link]");

    const showProgram=(i:number)=>{

      items.forEach((item,j)=>item.classList.toggle("is-active",i===j));

      previews.forEach((p,j)=>p.classList.toggle("is-active",i===j));

      const item=items[i]; if(!item)return;

      const name=item.dataset.explorerName??"Program";

      if(previewTitle)previewTitle.textContent=name;

      if(previewNum)previewNum.textContent=String(i+1).padStart(2,"0");

      if(previewLink){previewLink.href=item.dataset.explorerHref??"/proizvodi/";previewLink.setAttribute("aria-label",`Otvori program: ${name}`);}

    };

    items.forEach((item,i)=>{

      item.addEventListener("pointerenter",(e)=>{if(e.pointerType==="mouse"||e.pointerType==="pen")showProgram(i);});

      item.addEventListener("focus",()=>showProgram(i));

    });

  };

  initEngineeringV3();

  document.addEventListener("astro:page-load",initEngineeringV3);

</script>
