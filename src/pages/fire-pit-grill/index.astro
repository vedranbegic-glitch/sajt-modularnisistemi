---

import BaseLayout from '../../layouts/BaseLayout.astro';



const title = 'Fire Pit Grill — Vatra koja okuplja';

const description = 'Fire Pit Grill spaja otvoreno ložište i površinu za pripremu hrane u jedinstvenom čeličnom proizvodu za dvorišta, terase i prostore za okupljanje.';

const primaryImage = '/images/fire-pit/fire-pit-grill-terasa-vatra-sumrak.webp';

const detailImage = '/images/fire-pit/fire-pit-grill-celicna-vatra-rostilj.webp';

const inquiryURL = '/posaljite-projekat/';



const gallery = [

  { image: primaryImage, alt: 'Fire Pit Grill na savremenoj terasi u sumrak', kicker: '01 / AMBIJENT', title: 'Vatra kao centar prostora.' },

  { image: detailImage, alt: 'Čelično ložište Fire Pit Grill sa vatrom i ukrasnim otvorima', kicker: '02 / DETALJ', title: 'Čelik. Plamen. Karakter.' },

];



const principles = [

  { number: '01', title: 'Otvoreno ložište', text: 'Plamen i atmosfera okupljanja u središtu proizvoda.' },

  { number: '02', title: 'Površina za pripremu hrane', text: 'Roštiljska ploča raspoređena oko centralnog ložišta.' },

  { number: '03', title: 'Čelična konstrukcija', text: 'Konstrukcija, oblici i detalji koji čine prepoznatljivu celinu.' },

];



const applications = [

  { number: '01', title: 'Privatna dvorišta', text: 'Mesto za okupljanje porodice i prijatelja na otvorenom.' },

  { number: '02', title: 'Terase i vikendice', text: 'Vatra i priprema hrane u jednom prostornom elementu.' },

  { number: '03', title: 'Ugostiteljski prostori', text: 'Vizuelni fokus terasa i otvorenih zona za goste.' },

];



const schema = {

  '@context': 'https://schema.org',

  '@type': 'Product',

  name: 'Fire Pit Grill',

  description,

  image: `https://modularnisistemi.com${primaryImage}`,

  brand: { '@type': 'Brand', name: 'Modularni Sistemi' },

  category: 'Vatrišta i roštilji za otvoreni prostor',

};

---



<BaseLayout title={title} description={description} ogImage={primaryImage}>

  <Fragment slot="head">

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  </Fragment>



  <div class="firepit">

    <section class="hero" aria-labelledby="firepit-title">

      <div class="wrap hero__grid">

        <div class="hero__copy">

          <p class="eyebrow">MODULARNI SISTEMI / PREMIUM ENGINEERING</p>

          <h1 id="firepit-title">Fire Pit Grill.<br /><span>Vatra koja okuplja.</span></h1>

          <p class="hero__lead">Otvoreno ložište i roštilj u jednom čeličnom proizvodu. Prostor za vatru, pripremu hrane i zajedničke trenutke.</p>

          <div class="actions">

            <a class="button button--primary" href={inquiryURL}>Pošaljite upit <span aria-hidden="true">↗</span></a>

            <a class="button button--secondary" href="#proizvod">Istražite proizvod <span aria-hidden="true">↗</span></a>

          </div>

          <p class="microline">OBLIK. FUNKCIJA. KONSTRUKCIJA.</p>

        </div>

        <a class="hero__visual" href="#proizvod" aria-label="Istražite Fire Pit Grill">

          <img src={detailImage} alt="Fire Pit Grill — čelično ložište sa vatrom" width="1200" height="800" fetchpriority="high" />

          <span class="visual__top">MS / PRODUCT STUDY <span>FPG / 01</span></span>

          <span class="visual__bottom"><span><small>PROIZVOD U FOKUSU</small><strong>Fire Pit Grill</strong></span><span aria-hidden="true">↗</span></span>

        </a>

      </div>

      <div class="wrap hero__rail"><span>ČELIČNA KONSTRUKCIJA</span><span>OTVORENO LOŽIŠTE</span><span>ROŠTILJSKA PLOČA</span></div>

    </section>



    <section class="intro section--light" id="proizvod" aria-labelledby="intro-title">

      <div class="wrap">

        <div class="section-header">

          <div><p class="eyebrow eyebrow--orange">PROIZVOD / KONCEPT</p><h2 id="intro-title">Jedan proizvod.<br /><span>Više razloga za okupljanje.</span></h2></div>

          <p>Fire Pit Grill povezuje funkciju otvorenog ložišta sa pripremom hrane. Konstrukcija i izgled čine ga prepoznatljivim elementom dvorišta, terase ili drugog prostora na otvorenom.</p>

        </div>

        <div class="intro__layout">

          <div class="intro__image"><img src={primaryImage} alt="Fire Pit Grill u ambijentu savremene terase" loading="lazy" width="1200" height="800" /><span>MS / FIRE PIT GRILL</span></div>

          <div class="intro__list">

            <p class="list-heading">FUNKCIJA / KONSTRUKCIJA</p>

            {principles.map((item) => (

              <div class="feature"><span class="num">{item.number}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></div>

            ))}

            <a class="text-link" href={inquiryURL}>Razgovarajmo o vašem prostoru <span aria-hidden="true">↗</span></a>

          </div>

        </div>

      </div>

    </section>



    <section class="details section--dark" aria-labelledby="detail-title">

      <div class="wrap">

        <div class="section-header">

          <div><p class="eyebrow eyebrow--orange">PRECIZNOST U DETALJU</p><h2 id="detail-title">Konstrukcija koja<br /><span>govori za sebe.</span></h2></div>

          <p>Materijal, oblik i vidljivi detalji. Upoznajte proizvod kroz postojeće fotografije, od njegovog čeličnog tela do otvorenog plamena.</p>

        </div>

        <div class="photo-grid">

          {gallery.map((item) => (

            <figure class="photo-card"><div class="photo-card__image"><img src={item.image} alt={item.alt} loading="lazy" width="1200" height="800" /></div><figcaption><small>{item.kicker}</small><strong>{item.title}</strong></figcaption></figure>

          ))}

        </div>

      </div>

    </section>



    <section class="uses section--light" aria-labelledby="uses-title">

      <div class="wrap">

        <div class="section-header">

          <div><p class="eyebrow eyebrow--orange">PROSTOR / PRIMENA</p><h2 id="uses-title">Vatra koja <span>povezuje prostor.</span></h2></div>

          <p>Od privatnog dvorišta do otvorene terase — isti princip: zajednički prostor dobija svoje prirodno središte.</p>

        </div>

        <div class="uses__grid">{applications.map((item) => <article class="use"><small>{item.number} / PRIMENA</small><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>

      </div>

    </section>



    <section class="contact-band" aria-labelledby="contact-title">

      <div class="wrap contact-band__inner">

        <div><p class="eyebrow eyebrow--orange">VAŠA IDEJA JE DOBAR POČETAK</p><h2 id="contact-title">Imate prostor?<br /><span>Razradimo rešenje.</span></h2><p>Pošaljite fotografiju, skicu ili kratak opis onoga što želite.</p></div>

        <div class="contact-band__links"><a class="button button--primary" href={inquiryURL}>Pošaljite upit <span aria-hidden="true">↗</span></a><a class="email-link" href="mailto:kontakt@modularnisistemi.com">kontakt@modularnisistemi.com <span aria-hidden="true">↗</span></a></div>

      </div>

    </section>

  </div>

</BaseLayout>



<style>

  .firepit{--navy:#061b29;--navy-dark:#041521;--orange:#ff6900;--light:#f0f4f5;--ink:#0a2030;color:var(--ink);font-family:'Manrope',sans-serif;overflow:hidden}

  .wrap{width:min(1160px,calc(100% - 48px));margin-inline:auto}

  .firepit :is(h1,h2,h3,p,figure){margin:0}

  .eyebrow{font-size:10px;letter-spacing:.16em;font-weight:800;line-height:1.6;color:#ff9148}

  .eyebrow::before{content:'';display:inline-block;width:20px;height:2px;margin-right:12px;background:var(--orange);vertical-align:middle}

  .eyebrow--orange{color:#e65e00}

  .hero{background:radial-gradient(ellipse at 70% 18%,#12303d 0%,transparent 48%),var(--navy-dark);color:white;padding-top:26px}

  .hero .wrap{width:min(1280px,calc(100% - 48px))}

  .hero__grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);align-items:center;gap:34px;min-height:520px}

  .hero__copy{padding:25px 0 48px}

  .hero h1{font-size:clamp(38px,4.1vw,64px);letter-spacing:-.052em;line-height:1.08;font-weight:800;margin-top:24px}

  .hero h1 span,.section-header h2 span,.contact-band h2 span{color:var(--orange)}

  .hero__lead{font-size:14px;line-height:1.8;color:#b8c8d4;max-width:445px;margin-top:22px!important}

  .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}

  .button{display:inline-flex;align-items:center;justify-content:space-between;gap:22px;min-height:45px;padding:0 16px;text-decoration:none;font-size:12px;font-weight:800;border:1px solid transparent;transition:background .2s,border-color .2s}

  .button--primary{background:var(--orange);color:#07131d;border-color:var(--orange)}

  .button--primary:hover{background:#ff8535}

  .button--secondary{color:white;border-color:#526775;background:transparent}

  .button--secondary:hover{background:#18313e}

  .button span{font-size:16px}

  .microline{display:flex;align-items:center;gap:12px;color:#68849a;font-size:9px;letter-spacing:.14em;margin-top:38px!important}

  .microline::before{content:'';width:25px;height:1px;background:var(--orange)}

  .hero__visual{position:relative;display:block;height:485px;min-width:0;background:#152431;overflow:hidden;border:1px solid #294354;text-decoration:none;color:white}

  .hero__visual::before,.hero__visual::after{content:'';position:absolute;width:17px;height:17px;z-index:2;pointer-events:none}

  .hero__visual::before{top:10px;left:10px;border-top:1px solid var(--orange);border-left:1px solid var(--orange)}

  .hero__visual::after{bottom:10px;right:10px;border-bottom:1px solid var(--orange);border-right:1px solid var(--orange)}

  .hero__visual img{display:block;width:100%;height:100%;object-fit:cover}

  .hero__visual:focus-visible{outline:2px solid var(--orange);outline-offset:4px}

  .hero__visual .visual__top{position:absolute;top:20px;left:20px;right:20px;display:flex;justify-content:space-between;gap:12px;color:#f0f3f4;font-size:9px;font-weight:700;letter-spacing:.13em;text-shadow:0 1px 5px #000}

  .hero__visual .visual__bottom{position:absolute;inset:auto 0 0;display:flex;align-items:flex-end;justify-content:space-between;padding:52px 25px 22px;background:linear-gradient(0deg,rgba(2,14,24,.9),transparent)}

  .visual__bottom>span:first-child{display:grid;gap:4px}

  .visual__bottom small{font-size:9px;letter-spacing:.13em;color:#ffbd85;font-weight:700}

  .visual__bottom strong{font-size:24px;font-weight:800}

  .visual__bottom>span:last-child{color:var(--orange);font-size:21px}

  .hero__rail{display:grid;grid-template-columns:repeat(3,1fr);margin-top:28px;border-top:1px solid #2b414e}

  .hero__rail span{padding:17px 15px;border-right:1px solid #243b49;color:#a6b9c6;font-weight:700;letter-spacing:.12em;font-size:9px}

  .hero__rail span:first-child{padding-left:0}.hero__rail span:last-child{border-right:0}

  .section--light{background:var(--light);padding:68px 0 76px}

  .section--dark{background:var(--navy-dark);color:white;padding:70px 0 78px}

  .section-header{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.7fr);gap:70px;align-items:end;margin-bottom:30px}

  .section-header h2,.contact-band h2{font-size:clamp(30px,3vw,46px);font-weight:800;line-height:1.15;letter-spacing:-.047em;margin-top:12px}

  .section-header>p{font-size:13px;line-height:1.8;color:#677c89;max-width:380px;justify-self:end}

  .section--dark .section-header>p{color:#a6bfcb}

  .intro__layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);min-height:385px;border:1px solid #d6e0e5}

  .intro__image{position:relative;min-height:350px;overflow:hidden;background:#172a35}

  .intro__image img{display:block;width:100%;height:100%;object-fit:cover;position:absolute;inset:0}

  .intro__image span{position:absolute;bottom:16px;left:20px;font-size:9px;color:#fff;letter-spacing:.16em;font-weight:700;text-shadow:0 1px 5px #000}

  .intro__list{background:#fff;padding:26px 30px 20px;display:flex;flex-direction:column}

  .list-heading{font-size:10px;font-weight:800;letter-spacing:.14em;color:#577487;padding-bottom:17px;border-bottom:1px solid #dfe6e9}

  .feature{display:grid;grid-template-columns:34px 1fr;gap:8px;padding:20px 0;border-bottom:1px solid #e1e7ea}

  .num{font-size:11px;color:#df5700;font-weight:800}

  .feature h3{font-size:15px;font-weight:800;line-height:1.4}

  .feature p{font-size:12px;color:#708592;line-height:1.6;margin-top:5px}

  .text-link{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:17px;color:#092032;text-decoration:none;font-size:12px;font-weight:800;margin-top:auto}

  .text-link span{color:#e65e00}

  .photo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}

  .photo-card{background:#0b2a3a;border:1px solid #234253}

  .photo-card__image{aspect-ratio:1.65;overflow:hidden}

  .photo-card img{display:block;width:100%;height:100%;object-fit:cover}

  .photo-card figcaption{display:flex;flex-direction:column;gap:6px;padding:15px 19px 19px}

  .photo-card small,.use small{color:#ff8837;font-weight:800;font-size:10px;letter-spacing:.12em}

  .photo-card strong{font-size:15px;color:#fff}

  .uses__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}

  .use{background:#fff;border:1px solid #dbe4e7;padding:27px 25px;min-height:172px}

  .use h3{font-size:16px;margin-top:20px;font-weight:800}

  .use p{font-size:12px;line-height:1.7;color:#708592;margin-top:8px}

  .contact-band{background:#071e2b;color:white;padding:50px 0}

  .contact-band__inner{display:grid;grid-template-columns:1fr 245px;gap:40px;align-items:center}

  .contact-band h2{font-size:clamp(30px,3vw,44px)}

  .contact-band__inner>div:first-child>p:last-child{font-size:13px;color:#a9bfcc;line-height:1.7;margin-top:11px}

  .contact-band__links{display:grid;gap:14px}

  .email-link{display:flex;justify-content:space-between;gap:8px;border-bottom:1px solid #466273;padding:4px 0 10px;color:#bacdd7;text-decoration:none;font-size:11px;overflow-wrap:anywhere}

  @media(max-width:900px){.hero__grid{gap:25px;min-height:485px}.hero__visual{height:445px}.hero h1{font-size:clamp(34px,4.3vw,50px)}.section-header{gap:25px}.intro__list{padding:20px}}

  @media(max-width:700px){.wrap,.hero .wrap{width:calc(100% - 28px)}.hero{padding-top:25px}.hero__grid,.section-header,.intro__layout,.photo-grid,.uses__grid,.contact-band__inner{grid-template-columns:1fr}.hero__grid{gap:0;min-height:0}.hero__copy{padding:10px 0 24px}.hero h1{font-size:clamp(34px,9vw,44px);margin-top:17px}.hero__lead{font-size:13px;margin-top:15px!important}.microline{margin-top:24px!important}.hero__visual{height:auto;aspect-ratio:1.15}.hero__rail{grid-template-columns:1fr;margin-top:20px}.hero__rail span{padding:10px 0;border-right:0;border-bottom:1px solid #243b49}.hero__rail span:last-child{border-bottom:0}.section--light,.section--dark{padding:48px 0 56px}.section-header{gap:14px;margin-bottom:22px}.section-header h2{font-size:clamp(28px,8vw,35px)}.section-header>p{justify-self:start}.intro__image{min-height:270px}.intro__list{padding:22px}.photo-card__image{aspect-ratio:1.4}.use{min-height:0}.contact-band{padding:48px 0}.contact-band__inner{gap:26px}.contact-band__links{max-width:none}}

  @media(max-width:370px){.actions .button{flex:1;gap:8px;font-size:10px;padding-inline:10px}.hero__visual{height:auto;aspect-ratio:1.05}}

  @media(prefers-reduced-motion:reduce){.button{transition:none}}

</style>
