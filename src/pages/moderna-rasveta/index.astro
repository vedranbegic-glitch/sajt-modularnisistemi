---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Proizvodi', href: '/proizvodi/' },
  { label: 'Moderna rasveta' },
];

const canonicalURL = 'https://modularnisistemi.com/moderna-rasveta/';
const pageTitle = 'Z Lampa / Bandera – Moderna LED Rasveta | Modularni Sistemi';
const pageDescription = 'Elegantna i funkcionalna Z lampa / bandera sa usmerenom LED rasvetom u visinama 3 m, 4 m i 5 m. Za urbane, poslovne i privatne prostore.';

const img = '/images/rasveta/';

const visine = [
  { m: '3 m', opis: 'Idealna za manje prostore i privatne dvorišne površine.' },
  { m: '4 m', opis: 'Najčešći izbor za parkinge, poslovne objekte i pešačke zone.' },
  { m: '5 m', opis: 'Za veće površine, javne zone i industrijske objekte.' },
];

const karakteristike = [
  { naziv: 'Materijal', opis: 'Kvalitetan čelik (pocinčavanje / farbanje po izboru)', ikona: 'layers' },
  { naziv: 'LED rasveta', opis: 'Od 50 W do 100 W (uz mogućnost podešavanja)', ikona: 'bulb' },
  { naziv: 'Temperatura boje', opis: '3000 K / 4000 K / 6000 K', ikona: 'sun' },
  { naziv: 'IP zaštita', opis: 'IP65 (otpornost na vremenske uslove)', ikona: 'shield' },
  { naziv: 'Montaža', opis: 'Tip: na ploču / ankerisanje', ikona: 'wrench' },
];

const detalji = [
  { slika: `${img}z-profil-led-lampa-detalj-konstrukcij-1.webp`, naslov: 'LED modul', opis: 'Visoka efikasnost i dug radni vek.' },
  { slika: `${img}z-profil-led-lampa-detalj-konstrukcij-2.webp`, naslov: 'Z profil', opis: 'Čiste linije i moderan izgled.' },
  { slika: `${img}z-profil-led-lampa-detalj-konstrukcij-3.webp`, naslov: 'Baza', opis: 'Stabilnost i sigurnost u svim uslovima.' },
];

const primena = [
  { naziv: 'Parking', ikona: 'car' },
  { naziv: 'Poslovne objekte', ikona: 'building' },
  { naziv: 'Javne površine', ikona: 'park' },
  { naziv: 'Dvorišta', ikona: 'home' },
];

const prednosti = ['LED tehnologija', 'Niska potrošnja', 'Robusna konstrukcija', 'Jednostavna montaža'];

const icons: Record<string, string> = {
  layers: '<path d="m12 2 10 6-10 6L2 8z"/><path d="m2 14 10 6 10-6"/><path d="m2 11 10 6 10-6"/>',
  bulb: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5A6 6 0 1 0 7.5 11.5c.8.8 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z"/>',
  car: '<path d="M5 17h14M3 13l2-6h14l2 6v4H3z"/><circle cx="7.5" cy="15" r="1"/><circle cx="16.5" cy="15" r="1"/>',
  building: '<path d="M4 21V5l9-2v18M13 8h7v13M3 21h18M7 8h2M7 12h2M7 16h2M16 12h1M16 16h1"/>',
  park: '<path d="M12 22v-8"/><circle cx="12" cy="8" r="6"/>',
  home: '<path d="m3 11 9-8 9 8"/><path d="M5 10v11h14V10M10 21v-6h4v6"/>',
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`https://modularnisistemi.com${img}z-lampa-moderna-led-rasveta-za-dvoriste-ulicna-rasveta.webp`} />
  </Fragment>

  <div class="rasveta-page">
    <div class="wrap breadcrumbs-container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- HERO SEKCIJA -->
    <section class="hero">
      <img
        class="hero__image"
        src={`${img}z-lampa-moderna-led-rasveta-za-dvoriste-ulicna-rasveta.webp`}
        alt="Z lampa moderna LED rasveta za dvorište i uličnu rasvetu"
        fetchpriority="high"
      />
      <div class="hero__shade"></div>
      <div class="hero__grid"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            Moderan rasvetni sistem
          </div>

          <h1>
            Z lampa / bandera.<br />
            <em>Moderan dizajn</em><br />
            za svaki prostor.
          </h1>

          <p class="hero__lead">
            Elegantna i funkcionalna Z lampa / bandera sa LED rasvetom, idealna za moderne urbane i privatne prostore.
          </p>

          <ul class="hero__badges">
            {prednosti.map((p) => (
              <li>
                <span class="badge-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </span>
                <span>{p}</span>
              </li>
            ))}
          </ul>

          <div class="hero__actions">
            <a class="btn btn--orange" href="/posaljite-projekat/">
              Zatražite ponudu <b>→</b>
            </a>
            <a class="btn btn--ghost" href="tel:+38166241386">
              Pozovite: +381 (0) 66 241 386 <b>↗</b>
            </a>
          </div>
        </div>

        <div class="hero__specs">
          <div>
            <strong>3 m / 4 m / 5 m</strong>
            <span>Dostupne visine</span>
          </div>
          <div>
            <strong>50 – 100 W</strong>
            <span>LED snaga</span>
          </div>
          <div>
            <strong>3000 – 6000 K</strong>
            <span>Temperatura boje</span>
          </div>
          <div>
            <strong>IP65 ZAŠTITA</strong>
            <span>Otpornost na vreme</span>
          </div>
        </div>
      </div>
    </section>

    <!-- INTRO + SPECIFIKACIJE (DVE KOLONE) -->
    <section class="specs-section">
      <div class="wrap specs-grid">
        
        <!-- LEVA KOLONA -->
        <div class="specs-left">
          <div class="eyebrow eyebrow--dark">
            <span></span>
            Dostupne visine
          </div>
          <h2>3 m / 4 m / 5 m</h2>
          <p class="section-lead">
            Tri opcije visine za savršeno uklapanje u svaki prostor.
          </p>

          <div class="heights-grid">
            {visine.map((v) => (
              <div class="height-card">
                <div class="height-card__badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                    <path d="M12 3v18M8 7l4-4 4 4M8 17l4 4 4-4" />
                  </svg>
                </div>
                <strong>{v.m}</strong>
                <p>{v.opis}</p>
              </div>
            ))}
          </div>

          <div class="features-block">
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Tehničke karakteristike
            </div>
            <ul class="features-list">
              {karakteristike.map((k) => (
                <li>
                  <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[k.ikona]} />
                  </div>
                  <div class="feature-text">
                    <strong>{k.naziv}</strong>
                    <span>{k.opis}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- DESNA KOLONA -->
        <div class="specs-right">
          
          <!-- Velika kartica sa lampama -->
          <article class="feature-card">
            <div class="feature-card__img-wrap">
              <img
                src={`${img}z-lampa-dimenzije-visina-tehnicki-detalji.webp`}
                alt="Z lampa tehnički detalji i dimenzije"
                loading="lazy"
              />
              <div class="feature-card__shade"></div>
            </div>

            <div class="feature-card__content">
              <div class="eyebrow">
                <span></span>
                Tehnički detalji
              </div>
              <h2>Tri visine, <em>jedan dizajn.</em></h2>
              <p>
                Ista Z linija u svakoj visini: od dvorišne staze do velikog parkinga, uz LED snagu i temperaturu boje prilagođene prostoru.
              </p>

              <div class="feature-card__facts">
                <div>
                  <strong>3 / 4 / 5 m</strong>
                  <span>visine stuba</span>
                </div>
                <div>
                  <strong>50–100 W</strong>
                  <span>LED snaga</span>
                </div>
                <div>
                  <strong>3000–6000 K</strong>
                  <span>temperatura boje</span>
                </div>
                <div>
                  <strong>IP65</strong>
                  <span>zaštita od vremena</span>
                </div>
              </div>

              <a class="feature-card__link" href="/posaljite-projekat/">
                Zatražite ponudu <b>→</b>
              </a>
            </div>
          </article>

          <!-- Detalji koji prave razliku (3 kartice) -->
          <div class="details-box">
            <div class="details-box__head">
              <div class="eyebrow">
                <span></span>
                Detalji koji prave razliku
              </div>
            </div>
            <div class="details-grid">
              {detalji.map((d) => (
                <figure class="detail-card">
                  <div class="detail-card__img">
                    <img src={d.slika} alt={d.naslov} loading="lazy" />
                  </div>
                  <figcaption>
                    <strong>{d.naslov}</strong>
                    <p>{d.opis}</p>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- PRIMENA -->
    <section class="applications">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Primena
            </div>
            <h2>Idealno rešenje za <em>različite prostore.</em></h2>
          </div>
          <p>
            Moderan izgled, pouzdana rasveta i dug vek trajanja.
          </p>
        </div>

        <div class="applications__grid">
          {primena.map((p) => (
            <div class="application-card">
              <div class="application-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.ikona]} />
              </div>
              <strong>{p.naziv}</strong>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA BANER IZNAD FOOTERA -->
    <section class="cta">
      <img
        src={`${img}led-rasveta-za-setalista-i-parkove.webp`}
        alt="LED rasveta za šetališta i parkove"
        loading="lazy"
      />
      <div class="cta__shade"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Kvalitet, dizajn, funkcionalnost
          </div>
          <h2>U jednom.</h2>
          <p>
            Sveobuhvatno arhitektonsko rešenje LED rasvete prilagođeno vašem eksterijeru.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--orange" href="/posaljite-projekat/">
            Kontaktirajte nas <b>→</b>
          </a>
          <a class="btn btn--ghost" href="tel:+38166241386">
            Pozovite: 066 241 386 <b>↗</b>
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #f6f7f9;
      color: #07111e;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .rasveta-page {
      --navy: #06131f;
      --navy2: #0b1d2b;
      --orange: #ff6900;
      --orange-hover: #e85e00;
      --line: #dce2e7;
      --muted: #64717c;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }

    .wrap {
      width: min(1280px, calc(100% - 40px));
      margin-inline: auto;
    }

    .breadcrumbs-container {
      padding-top: 14px;
      padding-bottom: 14px;
    }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      min-height: 680px;
      background: var(--navy);
      color: #fff;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
    }

    .hero__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 75% center;
      z-index: -3;
    }

    .hero__shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(105deg, rgba(6, 19, 31, 0.95) 0%, rgba(6, 19, 31, 0.85) 38%, rgba(6, 19, 31, 0.35) 68%, rgba(6, 19, 31, 0.08) 100%),
        linear-gradient(0deg, rgba(6, 19, 31, 0.75) 0%, transparent 48%);
      z-index: -2;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(90deg, black, transparent 68%);
      z-index: -1;
    }

    .hero__content {
      padding-top: 100px;
      padding-bottom: 56px;
      display: grid;
      grid-template-columns: minmax(0, 720px) 1fr;
      gap: 50px;
      align-items: end;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .eyebrow span {
      display: inline-block;
      width: 20px;
      height: 2px;
      background: var(--orange);
      flex-shrink: 0;
    }

    .eyebrow--dark {
      color: var(--orange);
    }

    h1, h2, h3, p {
      margin: 0;
    }

    .hero h1 {
      margin-top: 18px;
      max-width: 860px;
      font-size: clamp(36px, 4.4vw, 58px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .hero h1 em,
    .specs-left h2 em,
    .section-head h2 em,
    .feature-card h2 em {
      font-style: normal;
      color: var(--orange);
    }

    .hero__lead {
      margin-top: 20px;
      max-width: 620px;
      color: #d4dee4;
      font-size: 15px;
      line-height: 1.65;
    }

    .hero__badges {
      list-style: none;
      padding: 0;
      margin: 26px 0 0;
      display: flex;
      flex-wrap: wrap;
      gap: 12px 24px;
    }

    .hero__badges li {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: #e2e8f0;
      font-weight: 600;
    }

    .badge-icon {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1.5px solid var(--orange);
      color: var(--orange);
      background: rgba(6, 19, 31, 0.6);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .badge-icon svg {
      width: 12px;
      height: 12px;
    }

    .hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 32px;
    }

    .btn {
      min-height: 48px;
      padding: 0 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: all 0.25s ease;
    }

    .btn b {
      font-size: 15px;
      font-weight: 600;
    }

    .btn--orange {
      background: var(--orange);
      color: #fff;
      border: 1px solid var(--orange);
    }

    .btn--orange:hover {
      background: var(--orange-hover);
      border-color: var(--orange-hover);
      transform: translateY(-2px);
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
      background: rgba(0, 0, 0, 0.15);
    }

    .btn--ghost:hover {
      background: #fff;
      color: var(--navy);
      border-color: #fff;
    }

    .hero__specs {
      border-left: 1px solid rgba(255, 255, 255, 0.2);
      padding-left: 28px;
      display: grid;
      gap: 22px;
    }

    .hero__specs div {
      display: flex;
      flex-direction: column;
    }

    .hero__specs strong {
      font-size: 15px;
      letter-spacing: 0.03em;
      font-weight: 700;
      color: #fff;
    }

    .hero__specs span {
      margin-top: 4px;
      color: #94a3ad;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }

    /* ========== SPECS SECTION ========== */
    .specs-section {
      padding: 70px 0;
      background: #f6f7f9;
      border-bottom: 1px solid var(--line);
    }

    .specs-grid {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 48px;
      align-items: start;
    }

    .specs-left h2 {
      margin-top: 10px;
      font-size: clamp(34px, 3.8vw, 48px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: var(--orange);
    }

    .section-lead {
      margin-top: 10px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.6;
    }

    .heights-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 26px;
    }

    .height-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 16px 14px;
      transition: all 0.25s ease;
    }

    .height-card:hover {
      border-color: var(--orange);
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(6, 19, 31, 0.06);
    }

    .height-card__badge {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--orange);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
    }

    .height-card__badge svg {
      width: 16px;
      height: 16px;
    }

    .height-card strong {
      display: block;
      font-size: 20px;
      font-weight: 800;
      color: #07111e;
    }

    .height-card p {
      margin-top: 6px;
      font-size: 11px;
      line-height: 1.45;
      color: #5c6a74;
    }

    .features-block {
      margin-top: 40px;
      padding-top: 32px;
      border-top: 1px solid var(--line);
    }

    .features-list {
      list-style: none;
      padding: 0;
      margin: 18px 0 0;
      display: flex;
      flex-direction: column;
    }

    .features-list li {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
    }

    .features-list li:last-child {
      border-bottom: 0;
    }

    .feature-icon {
      width: 38px;
      height: 38px;
      border-radius: 2px;
      background: #eef2f5;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #07111e;
      flex-shrink: 0;
    }

    .feature-icon svg {
      width: 20px;
      height: 20px;
    }

    .feature-text strong {
      display: block;
      font-size: 14px;
      font-weight: 700;
      color: #07111e;
    }

    .feature-text span {
      display: block;
      margin-top: 2px;
      font-size: 13px;
      color: #4b5863;
      font-weight: 500;
    }

    /* ========== SPECS RIGHT ========== */
    .specs-right {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .feature-card {
      position: relative;
      background: #06131f;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 2px;
      overflow: hidden;
      color: #fff;
      box-shadow: 0 16px 36px rgba(6, 19, 31, 0.12);
    }

    .feature-card__img-wrap {
      position: relative;
      width: 100%;
      background: #06131f;
      overflow: hidden;
    }

    .feature-card__img-wrap img {
      width: 100%;
      height: auto;
      display: block;
    }

    .feature-card__shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 40%, rgba(6, 19, 31, 0.85) 75%, #06131f 100%);
      pointer-events: none;
    }

    .feature-card__content {
      padding: 0 32px 32px;
      position: relative;
      z-index: 2;
      background: #06131f;
      margin-top: -30px;
    }

    .feature-card__content h2 {
      margin-top: 10px;
      font-size: clamp(26px, 2.7vw, 36px);
      line-height: 1.05;
      letter-spacing: -0.04em;
