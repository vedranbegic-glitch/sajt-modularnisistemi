.study-stage .study-video.active{opacity:1;visibility:visible}

.study-option.active{border-left:3px solid #ff6900;padding-left:9px}

.study-video-status:not([hidden]){position:absolute;z-index:3;top:50%;left:50%;transform:translate(-50%,-50%);padding:10px 14px;background:#061b28;color:#fff;font-size:12px;text-align:center;max-width:85%}

</style>
