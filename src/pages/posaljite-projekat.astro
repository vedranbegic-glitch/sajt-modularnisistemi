---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { CONTACT } from '../data/siteData';

const breadcrumbItems = [
  { label: 'Pošaljite upit' },
];

const canonicalURL = 'https://modularnisistemi.com/posaljite-projekat/';
const pageTitle = 'Pošaljite upit i projekat · Inženjerska analiza i predmer | Modularni Sistemi';
const pageDescription = 'Imate projekat? Pošaljite nam upit i nacrt u PDF, DWG ili ZIP formatu. Inženjerski tim MODULARNI SISTEMI radi predmer i specifikaciju elemenata po meri.';

// Hero slajder sa 3 slike koje se rotiraju na svake 3 sekunde
const heroSlides = [
  {
    src: '/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp',
    alt: 'Modularni sistemi — lučni inox kanal u pejzažnom parteru',
    position: 'center',
  },
  {
    src: '/images/rasveta/z-lampa-moderna-led-rasveta-za-dvoriste-ulicna-rasveta.webp',
    alt: 'Z lampa — moderna LED rasveta za dvorište i ulicu',
    position: '70% center',
  },
  {
    src: '/images/podovi/modularni-pod-terasa-kamene-staze-basta-2.webp',
    alt: 'Modularni podni sistemi — fabrički sklopljeni paneli za terase i partere',
    position: 'center',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
  </Fragment>

  <div class="projekat-page">
    <div class="wrap breadcrumbs-container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- HERO SEKCIJA (AUTOMATSKI SLAJDER SA 3 SLIKE) -->
    <section class="hero">
      <div class="hero__slides">
        {heroSlides.map((slide, i) => (
          <img
            class={`hero__slide ${i === 0 ? 'is-active' : ''}`}
            src={slide.src}
            alt={slide.alt}
            style={`object-position: ${slide.position};`}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))}
      </div>
      <div class="hero__shade"></div>
      <div class="hero__grid"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            Inženjerski prijem tehničke dokumentacije
          </div>

          <h1>
            Imate projekat?<br />
            <em>Pošaljite nam upit i nacrt.</em>
          </h1>

          <p class="hero__lead">
            Pošaljite nam osnove, preseke, skice ili situacione planove. Naš inženjerski tim analizira geometriju, 
            visinske kote i padove, pripremajući preciznu specifikaciju modularnih elemenata i zvaničan predmer.
          </p>

          <div class="hero__actions">
            <a class="btn btn--orange" href="#forma">
              Popunite formu za upit <b>↓</b>
            </a>
            <a class="btn btn--ghost" href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`}>
              Pozovite: {CONTACT.phone || '+381 66 241 386'} <b>↗</b>
            </a>
          </div>
        </div>

        <div class="hero__specs">
          <div>
            <strong>FORMATI DOKUMENTACIJE</strong>
            <span>PDF · DWG · DXF · STEP · ZIP</span>
          </div>
          <div>
            <strong>ROK ZA ODGOVOR</strong>
            <span>Inženjerska procena za 24h–48h</span>
          </div>
          <div>
            <strong>ANALIZA GEOMETRIJE</strong>
            <span>Proračun radijusa, nagiba i padova</span>
          </div>
          <div>
            <strong>BESPLATAN PREDMER</strong>
            <span>Kompletna specifikacija elemenata</span>
          </div>
        </div>
      </div>

      <!-- Tačkice slajdera -->
      <div class="hero__dots" role="tablist" aria-label="Izbor slike">
        {heroSlides.map((_, i) => (
          <button
            type="button"
            class={`hero__dot ${i === 0 ? 'is-active' : ''}`}
            aria-label={`Slika ${i + 1}`}
            data-index={i}
          ></button>
        ))}
      </div>
    </section>

    <!-- OPERATIVNI BAR -->
    <section class="quick-contact">
      <div class="wrap">
        <div class="contact-bar">
          <div class="contact-bar__col">
            <span class="bar-label">Email za nacrte i projekte</span>
            <a href={`mailto:${CONTACT.projectEmail || 'projekti@modularnisistemi.com'}`} class="bar-val">
              {CONTACT.projectEmail || 'projekti@modularnisistemi.com'}
            </a>
            <span class="bar-sub">Direktan prijem DWG i PDF fajlova</span>
          </div>
          <div class="contact-bar__sep"></div>
          <div class="contact-bar__col">
            <span class="bar-label">Telefon za tehničke konsultacije</span>
            <a href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`} class="bar-val bar-val--phone">
              {CONTACT.phone || '+381 66 241 386'}
            </a>
            <span class="bar-sub">Radnim danima: 08:00 – 17:00h</span>
          </div>
          <div class="contact-bar__sep"></div>
          <div class="contact-bar__col">
            <span class="bar-label">Podržani formati priloga</span>
            <span class="bar-val bar-val--formats">PDF · DWG · DXF · ZIP</span>
            <span class="bar-sub">Maksimalna veličina priloga: do 25 MB</span>
          </div>
        </div>
      </div>
    </section>

    <!-- GLAVNI BLOK SA FORMOM I SMERNICAMA -->
    <section class="main-form-section" id="forma">
      <div class="wrap form-container">
        
        <!-- FORMA ZA SLANJE UPITA -->
        <div class="form-card">
          <div class="form-card__head">
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Forma za tehnički zahtev
            </div>
            <h2>Pošaljite upit i specifikaciju</h2>
            <p>
              Ispunite polja u nastavku i priložite tehničku dokumentaciju (DWG, PDF ili skicu). Naš tim će razraditi predlog konfiguracije.
            </p>
          </div>

          <form id="project-form" class="engineering-form">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Ime i prezime <span>*</span></label>
                <input type="text" id="name" name="name" placeholder="npr. Marko Jovanović" required />
              </div>
              <div class="form-group">
                <label for="company">Kompanija / Arhitektonski biro</label>
                <input type="text" id="company" name="company" placeholder="npr. Studio Arch d.o.o." />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email">Email adresa <span>*</span></label>
                <input type="email" id="email" name="email" placeholder="vas.email@domen.rs" required />
              </div>
              <div class="form-group">
                <label for="phone">Broj telefona <span>*</span></label>
                <input type="tel" id="phone" name="phone" placeholder="+381 6... ..." required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="system">Sistem od interesa <span>*</span></label>
                <select id="system" name="system" required>
                  <option value="" disabled selected>Izaberite primarni sistem</option>
                  <option value="inox">Inox sistemi odvodnjavanja (linijski, radijalni, bazeni)</option>
                  <option value="podovi">Modularni podni sistemi (monoblok 1x1m paneli)</option>
                  <option value="rasveta">Moderna rasveta (Z lampa / bandera 3m, 4m, 5m)</option>
                  <option value="kombinovano">Kombinovano / Kompletan eksterijerni projekat</option>
                </select>
              </div>
              <div class="form-group">
                <label for="quantity">Okvirna dužina ili kvadratura</label>
                <input type="text" id="quantity" name="quantity" placeholder="npr. 35 m kanala ili 120 m² poda" />
              </div>
            </div>

            <div class="form-group">
              <label for="message">Opis projekta i tehnički zahtevi <span>*</span></label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Navedite specifičnosti prostora: zadate padove, visinske kote, zahteve nosivosti (pešački prolaz ili vozila), radijuse krivina ili posebne rokove..."
                required
              ></textarea>
            </div>

            <!-- Upload fajla -->
            <div class="form-group file-upload-group">
              <label for="project-file">Prilog / Tehnički crtež (DWG, PDF, ZIP ili slika)</label>
              <div class="file-dropzone">
                <input type="file" id="project-file" name="project-file" accept=".pdf,.dwg,.dxf,.zip,.rar,.png,.jpg,.jpeg" />
                <div class="dropzone-text">
                  <span class="upload-icon">📎</span>
                  <strong>Izaberite fajl ili ga prevucite ovde</strong>
                  <span class="upload-hint">Podržano: PDF, DWG, DXF, ZIP, RAR, JPG (do 25 MB)</span>
                </div>
              </div>
            </div>

            <div class="form-footer">
              <p class="form-note">
                Vaši podaci se koriste isključivo za potrebe inženjerske analize i izrade ponude.
              </p>
              <button type="submit" class="btn btn--orange" id="submit-btn">
                Pošaljite upit <b>→</b>
              </button>
            </div>

            <!-- Obaveštenje o uspešnom slanju -->
            <div id="form-success" class="form-status is-success" style="display: none;">
              ✓ <strong>Upit je uspešno poslat!</strong> Naš inženjerski tim će pregledati priložene podatke i javiti se sa analizom u najkraćem roku.
            </div>
          </form>
        </div>

        <!-- SMERNICE ZA PRIPREMU PRILOGA -->
        <div class="guidelines-card">
          <div class="guidelines-card__head">
            <span class="bullet"></span>
            <h3>Preporuke za bržu izradu preciznog predmera</h3>
          </div>

          <div class="guidelines-grid">
            <div class="guide-item">
              <strong>1. Geometrija i pravci padova</strong>
              <p>
                Ukoliko šaljete drenažni projekat, označite pozicije revizionih slivnika, pravce padova i planiranu završnu visinu podloge.
              </p>
            </div>

            <div class="guide-item">
              <strong>2. Radijusi kod krivina (R)</strong>
              <p>
                Za bazenske prostore i kružne platoe navedite poluprečnik zakrivljenja kako bismo predvideli tačan radijalni segment.
              </p>
            </div>

            <div class="guide-item">
              <strong>3. Klasa opterećenja i saobraćaj</strong>
              <p>
                Navedite tip eksploatacije: isključivo pešački prolaz, bazensko sunčalište ili saobraćaj putničkih i dostavnih vozila.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- DONJI BANER (CTA IZNAD FOOTERA) -->
    <section class="cta">
      <img
        src="/images/inox/cta-parter-zardinjera.webp"
        alt="Inženjerska podrška za vaš projekat"
        loading="lazy"
      />
      <div class="cta__shade"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Direktne konsultacije
          </div>
          <h2>Želite da popričate sa <em>našim inženjerom?</em></h2>
          <p>
            Za hitne projekte ili specifična tehnička pitanja pozovite nas direktno. 
            Razmotrićemo vašu situaciju i predložiti optimalno rešenje.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--orange" href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`}>
            Pozovite: {CONTACT.phone || '066 241 386'} <b>↗</b>
          </a>
          <a class="btn btn--ghost" href={`mailto:${CONTACT.projectEmail || 'projekti@modularnisistemi.com'}`}>
            Pošaljite email <b>→</b>
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #f6f7f9;
      color: #07111e;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .projekat-page {
      --navy: #06131f;
      --navy2: #0b1d2b;
      --orange: #ff6900;
      --orange-hover: #e85e00;
      --line: #dce2e7;
      --muted: #64717c;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }

    .wrap {
      width: min(1280px, calc(100% - 40px));
      margin-inline: auto;
    }

    .breadcrumbs-container {
      padding-top: 14px;
      padding-bottom: 14px;
    }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      min-height: 640px;
      background: var(--navy);
      color: #fff;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
    }

    .hero__slides {
      position: absolute;
      inset: 0;
      z-index: -3;
    }

    .hero__slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 1s ease;
    }

    .hero__slide.is-active {
      opacity: 1;
    }

    .hero__shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(105deg, rgba(6, 19, 31, 0.96) 0%, rgba(6, 19, 31, 0.88) 38%, rgba(6, 19, 31, 0.45) 68%, rgba(6, 19, 31, 0.1) 100%),
        linear-gradient(0deg, rgba(6, 19, 31, 0.75) 0%, transparent 48%);
      z-index: -2;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(90deg, black, transparent 68%);
      z-index: -1;
    }

    .hero__content {
      padding-top: 100px;
      padding-bottom: 56px;
      display: grid;
      grid-template-columns: minmax(0, 720px) 1fr;
      gap: 50px;
      align-items: end;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .eyebrow span {
      display: inline-block;
      width: 20px;
      height: 2px;
      background: var(--orange);
      flex-shrink: 0;
    }

    .eyebrow--dark {
      color: var(--orange);
    }

    h1, h2, h3, p {
      margin: 0;
    }

    .hero h1 {
      margin-top: 18px;
      max-width: 860px;
      font-size: clamp(36px, 4.4vw, 56px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .hero h1 em,
    .form-card__head h2 em,
    .cta h2 em {
      font-style: normal;
      color: var(--orange);
    }

    .hero__lead {
      margin-top: 20px;
      max-width: 620px;
      color: #d4dee4;
      font-size: 15px;
      line-height: 1.65;
    }

    .hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 32px;
    }

    /* Tačkice slajdera */
    .hero__dots {
      position: absolute;
      right: max(20px, calc((100% - 1280px) / 2));
      bottom: 24px;
      display: flex;
      gap: 8px;
      z-index: 3;
    }

    .hero__dot {
      width: 28px;
      height: 4px;
      padding: 0;
      border: 0;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.35);
      cursor: pointer;
      transition: background 0.3s ease, width 0.3s ease;
    }

    .hero__dot:hover {
      background: rgba(255, 255, 255, 0.7);
    }

    .hero__dot.is-active {
      width: 44px;
      background: var(--orange);
    }

    .hero__dot:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__slide { transition: none; }
    }

    .btn {
      min-height: 48px;
      padding: 0 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: all 0.25s ease;
      cursor: pointer;
      border: none;
    }

    .btn b {
      font-size: 15px;
      font-weight: 600;
    }

    .btn--orange {
      background: var(--orange);
      color: #fff;
      border: 1px solid var(--orange);
    }

    .btn--orange:hover {
      background: var(--orange-hover);
      border-color: var(--orange-hover);
      transform: translateY(-2px);
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
      background: rgba(0, 0, 0, 0.15);
    }

    .btn--ghost:hover {
      background: #fff;
      color: var(--navy);
      border-color: #fff;
    }

    .hero__specs {
      border-left: 1px solid rgba(255, 255, 255, 0.2);
      padding-left: 28px;
      display: grid;
      gap: 20px;
    }

    .hero__specs strong {
      font-size: 14px;
      letter-spacing: 0.03em;
      font-weight: 700;
      color: #fff;
    }

    .hero__specs span {
      margin-top: 4px;
      color: #94a3ad;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }

    /* ========== OPERATIVNI BAR ========== */
    .quick-contact {
      background: #eef1f4;
      padding: 24px 0;
      border-bottom: 1px solid var(--line);
    }

    .contact-bar {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 24px 32px;
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: center;
      gap: 24px;
      box-shadow: 0 4px 16px rgba(6, 19, 31, 0.04);
    }

    .contact-bar__sep {
      width: 1px;
      height: 48px;
      background: var(--line);
    }

    .contact-bar__col {
      display: flex;
      flex-direction: column;
    }

    .bar-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 4px;
    }

    .bar-val {
      font-size: 15px;
      font-weight: 800;
      color: #07111e;
      text-decoration: none;
      transition: color 0.2s;
    }

    .bar-val:hover {
      color: var(--orange);
    }

    .bar-val--phone {
      color: var(--orange);
      font-size: 17px;
    }

    .bar-val--formats {
      letter-spacing: 0.04em;
    }

    .bar-sub {
      margin-top: 3px;
      font-size: 11px;
      color: #8c9da8;
    }

    /* ========== MAIN FORM SECTION ========== */
    .main-form-section {
      padding: 80px 0;
      background: #f6f7f9;
      border-bottom: 1px solid var(--line);
    }

    .form-container {
      max-width: 960px;
      display: flex;
      flex-direction: column;
      gap: 36px;
    }

    .form-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 44px;
      box-shadow: 0 4px 24px rgba(6, 19, 31, 0.04);
    }

    .form-card__head h2 {
      margin-top: 10px;
      font-size: clamp(26px, 2.6vw, 36px);
      font-weight: 800;
      color: #07111e;
      letter-spacing: -0.03em;
    }

    .form-card__head p {
      margin-top: 8px;
      font-size: 14px;
      line-height: 1.6;
      color: var(--muted);
    }

    .engineering-form {
      margin-top: 32px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #07111e;
    }

    .form-group label span {
      color: var(--orange);
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 14px;
      background: #fbfcfd;
      border: 1px solid var(--line);
      border-radius: 2px;
      font-family: inherit;
      font-size: 13.5px;
      color: #07111e;
      transition: all 0.2s ease;
      outline: none;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      background: #fff;
      border-color: var(--orange);
      box-shadow: 0 0 0 3px rgba(255, 105, 0, 0.12);
    }

    /* File dropzone */
    .file-dropzone {
      position: relative;
      border: 2px dashed var(--line);
      border-radius: 2px;
      padding: 24px;
      text-align: center;
      background: #fbfcfd;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .file-dropzone:hover {
      border-color: var(--orange);
      background: #fff;
    }

    .file-dropzone input[type="file"] {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }

    .dropzone-text {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      pointer-events: none;
    }

    .upload-icon {
      font-size: 22px;
    }

    .dropzone-text strong {
      font-size: 13px;
      font-weight: 700;
      color: #07111e;
    }

    .upload-hint {
      font-size: 11px;
      color: var(--muted);
    }

    .form-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-top: 10px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }

    .form-note {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.4;
      max-width: 480px;
    }

    .form-status {
      padding: 14px 18px;
      border-radius: 2px;
      font-size: 13px;
      line-height: 1.4;
    }

    .form-status.is-success {
      background: #edfbf2;
      border: 1px solid #a3e6ba;
      color: #12632e;
    }

    /* Guidelines card */
    .guidelines-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 32px 36px;
    }

    .guidelines-card__head {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }

    .bullet {
      width: 8px;
      height: 8px;
      background: var(--orange);
      border-radius: 1px;
      flex-shrink: 0;
    }

    .guidelines-card__head h3 {
      font-size: 15px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #07111e;
    }

    .guidelines-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .guide-item strong {
      display: block;
      font-size: 13px;
      font-weight: 700;
      color: #07111e;
      margin-bottom: 6px;
    }

    .guide-item p {
      font-size: 12.5px;
      line-height: 1.55;
      color: #55636e;
    }

    /* ========== CTA BANER ========== */
    .cta {
      position: relative;
      min-height: 340px;
      display: flex;
      align-items: center;
      color: #fff;
      overflow: hidden;
      background: var(--navy);
    }

    .cta > img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .cta__shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(100deg, rgba(6, 19, 31, 0.95) 0%, rgba(6, 19, 31, 0.75) 55%, rgba(6, 19, 31, 0.45) 100%);
    }

    .cta__inner {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 36px;
      padding: 56px 0;
    }

    .cta h2 {
      margin-top: 12px;
      font-size: clamp(26px, 3.3vw, 42px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .cta p {
      margin-top: 12px;
      max-width: 520px;
      color: #b5c2ca;
      font-size: 14px;
      line-height: 1.6;
    }

    .cta__actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex-shrink: 0;
    }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 1024px) {
      .contact-bar {
        grid-template-columns: 1fr;
        gap: 18px;
      }
      .contact-bar__sep {
        display: none;
      }
      .guidelines-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }
    }

    @media (max-width: 980px) {
      .hero__content {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .hero__specs {
        display: none;
      }

      .cta__inner {
        flex-direction: column;
        align-items: flex-start;
      }

      .cta__actions {
        flex-direction: row;
      }
    }

    @media (max-width: 640px) {
      .wrap {
        width: min(100% - 24px, 1280px);
      }

      .hero {
        min-height: 520px;
      }

      .hero__content {
        padding-top: 70px;
        padding-bottom: 40px;
      }

      .hero h1 {
        font-size: 32px;
      }

      .form-card {
        padding: 24px 18px;
      }

      .form-row {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .form-footer {
        flex-direction: column;
        align-items: flex-start;
      }

      .form-footer .btn {
        width: 100%;
      }

      .cta {
        min-height: 340px;
      }

      .cta__inner {
        padding: 40px 0;
      }

      .cta__actions {
        flex-direction: column;
        width: 100%;
      }

      .cta__actions .btn {
        width: 100%;
      }
    }
  </style>

  <script>
    // Hero slajder: automatska rotacija sve 3 slike na svake 3 sekunde
    const slides = document.querySelectorAll<HTMLElement>('.hero__slide');
    const dots = document.querySelectorAll<HTMLButtonElement>('.hero__dot');

    if (slides.length > 1) {
      let current = 0;
      let timer: number | undefined;

      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((s, i) => s.classList.toggle('is-active', i === current));
        dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
      };

      const stop = () => {
        if (timer) window.clearInterval(timer);
      };
      const start = () => {
        stop();
        timer = window.setInterval(() => show(current + 1), 3000);
      };

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          show(Number(dot.dataset.index));
          start();
        });
      });

      start();
    }

    // Rukovanje formom i fajlovima
    const projectForm = document.getElementById('project-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('form-success') as HTMLElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const fileInput = document.getElementById('project-file') as HTMLInputElement | null;
    const dropzoneText = document.querySelector('.dropzone-text strong') as HTMLElement | null;

    if (fileInput && dropzoneText) {
      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files.length > 0) {
          dropzoneText.textContent = `Izabran fajl: ${fileInput.files[0].name}`;
        }
      });
    }

    if (projectForm) {
      projectForm.addEventListener('submit', (e) => {
        e.preventDefault();

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = 'Slanje upita u toku...';
        }

        setTimeout(() => {
          projectForm.reset();
          if (dropzoneText) {
            dropzoneText.textContent = 'Izaberite fajl ili ga prevucite ovde';
          }
          if (successMsg) {
            successMsg.style.display = 'block';
            successMsg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = 'Pošaljite upit <b>→</b>';
          }
        }, 700);
      });
    }
  </script>
</BaseLayout>