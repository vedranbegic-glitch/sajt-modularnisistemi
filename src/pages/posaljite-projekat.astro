  </style>

  <script>
    // Slanje upita na Netlify Forms (AJAX, sa prilogom) i preusmeravanje na /hvala/
    const MAX_FILE_BYTES = 8 * 1024 * 1024; // Netlify Forms: ukupno do 8 MB po slanju

    const projectForm = document.getElementById('project-form') as HTMLFormElement | null;
    const errorMsg = document.getElementById('form-error') as HTMLElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const fileInput = document.getElementById('project-file') as HTMLInputElement | null;
    const dropzoneText = document.querySelector('.dropzone-text strong') as HTMLElement | null;
    const defaultDropzoneLabel = dropzoneText ? dropzoneText.textContent : '';

    const showError = (html: string) => {
      if (!errorMsg) return;
      errorMsg.innerHTML = html;
      errorMsg.style.display = 'block';
      errorMsg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    const hideError = () => {
      if (errorMsg) errorMsg.style.display = 'none';
    };

    if (fileInput && dropzoneText) {
      fileInput.addEventListener('change', () => {
        hideError();
        const file = fileInput.files && fileInput.files[0];

        if (!file) {
          dropzoneText.textContent = defaultDropzoneLabel;
          return;
        }

        if (file.size > MAX_FILE_BYTES) {
          fileInput.value = '';
          dropzoneText.textContent = defaultDropzoneLabel;
          showError(
            '<strong>Fajl je prevelik.</strong> Preko forme možete poslati do 8 MB. Za veće fajlove nalepite link u polje ispod ili ih pošaljite emailom.'
          );
          return;
        }

        dropzoneText.textContent = `Izabran fajl: ${file.name}`;
      });
    }

    if (projectForm && submitBtn) {
      projectForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();

        const originalLabel = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Slanje upita u toku...';

        try {
          // FormData sa prilogom; Content-Type (multipart) postavlja pregledač
          const response = await fetch('/', {
            method: 'POST',
            body: new FormData(projectForm),
          });

          if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
          }

          // Stranica zahvalnice se koristi i za merenje konverzija
          window.location.href = '/hvala/';
          return;
        } catch (err) {
          showError(
            '<strong>Slanje nije uspelo.</strong> Pokušajte ponovo ili nas pozovite na <a href="tel:+38166241386">+381 66 241 386</a>, odnosno pošaljite upit na <a href="mailto:projekti@modularnisistemi.com">projekti@modularnisistemi.com</a>.'
          );
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalLabel;
        }
      });
    }
  </script>
</BaseLayout>
