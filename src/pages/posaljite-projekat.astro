---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../data/siteData';

const canonicalURL = 'https://modularnisistemi.com/posaljite-upit/';
const pageTitle = 'Pošaljite upit · Predmer i ponuda';
const pageDescription = 'Pošaljite crtež, skicu ili samo opis prostora. Pripremamo predmer i ponudu za inox odvodnjavanje, modernu rasvetu, modularne podove i Fire Pit Grill.';
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalURL}>
  <div class="projekat-page">
    <!-- HERO SEKCIJA (BEZ SLIKA, AKCENAT NA TEKSTU) -->
    <section class="hero">
      <div class="hero__glow"></div>
      <div class="hero__grid"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            Upit i ponuda
          </div>

          <h1>
            Imate crtež ili skicu?<br />
            <em>Pošaljite nam upit.</em>
          </h1>

          <p class="hero__lead">
            Pošaljite crtež, skicu, fotografiju prostora ili samo opis. Pregledamo geometriju,
            visinske kote i padove, a zatim pripremamo specifikaciju elemenata i predmer.
          </p>

          <div class="hero__actions">
            <a class="btn btn--orange" href="#forma">
              Popunite formu za upit <b>↓</b>
            </a>
            <a class="btn btn--ghost" href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`}>
              Pozovite: {CONTACT.phone || '+381 66 241 386'} <b>↗</b>
            </a>
          </div>
        </div>

        <div class="hero__specs">
          <div>
            <strong>FORMATI DOKUMENTACIJE</strong>
            <span>PDF · DWG · DXF · ZIP · JPG</span>
          </div>
          <div>
            <strong>ROK ZA ODGOVOR</strong>
            <span>Procena u roku od 24h</span>
          </div>
          <div>
            <strong>ANALIZA GEOMETRIJE</strong>
            <span>Radijusi, nagibi i padovi</span>
          </div>
          <div>
            <strong>BESPLATAN PREDMER</strong>
            <span>Kompletna specifikacija elemenata</span>
          </div>
        </div>
      </div>
    </section>

    <!-- OPERATIVNI BAR -->
    <section class="quick-contact">
      <div class="wrap">
        <div class="contact-bar">
          <div class="contact-bar__col">
            <span class="bar-label">Email za crteže i projekte</span>
            <a href={`mailto:${CONTACT.projectEmail || 'projekti@modularnisistemi.com'}`} class="bar-val">
              {CONTACT.projectEmail || 'projekti@modularnisistemi.com'}
            </a>
            <span class="bar-sub">Za veće fajlove i potpunu dokumentaciju</span>
          </div>
          <div class="contact-bar__sep"></div>
          <div class="contact-bar__col">
            <span class="bar-label">Telefon za konsultacije</span>
            <a href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`} class="bar-val bar-val--phone">
              {CONTACT.phone || '+381 66 241 386'}
            </a>
            <span class="bar-sub">Radnim danima: 08:00 – 17:00h</span>
          </div>
          <div class="contact-bar__sep"></div>
          <div class="contact-bar__col">
            <span class="bar-label">Podržani formati priloga</span>
            <span class="bar-val bar-val--formats">PDF · DWG · DXF · ZIP</span>
            <span class="bar-sub">Prilog preko forme: do 8 MB</span>
          </div>
        </div>
      </div>
    </section>

    <!-- GLAVNI BLOK SA FORMOM I SMERNICAMA -->
    <section class="main-form-section" id="forma">
      <div class="wrap form-container">

        <!-- FORMA ZA SLANJE UPITA -->
        <div class="form-card">
          <div class="form-card__head">
            <div class="eyebrow">
              <span></span>
              Forma za upit
            </div>
            <h2>Pošaljite upit i crtež</h2>
            <p>
              Popunite polja u nastavku i, ako imate, priložite crtež ili skicu. Prilog nije obavezan, dovoljan je i kratak opis prostora.
            </p>
          </div>

          <form
            id="project-form"
            class="engineering-form"
            name="upit"
            method="POST"
            action="/hvala/"
            enctype="multipart/form-data"
            data-netlify="true"
            netlify-honeypot="bot-field"
          >
            <!-- Netlify Forms: obavezno polje sa imenom forme -->
            <input type="hidden" name="form-name" value="upit" />

            <!-- Honeypot protiv spam botova (korisnici ga ne vide) -->
            <p class="hp" aria-hidden="true">
              <label>Ne popunjavajte ovo polje: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            <div class="form-row">
              <div class="form-group">
                <label for="name">Ime i prezime <span>*</span></label>
                <input type="text" id="name" name="name" autocomplete="name" placeholder="npr. Marko Jovanović" required />
              </div>
              <div class="form-group">
                <label for="company">Kompanija / Arhitektonski biro</label>
                <input type="text" id="company" name="company" autocomplete="organization" placeholder="npr. Studio Arch d.o.o." />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email">Email adresa <span>*</span></label>
                <input type="email" id="email" name="email" autocomplete="email" placeholder="vas.email@domen.rs" required />
              </div>
              <div class="form-group">
                <label for="phone">Broj telefona <span>*</span></label>
                <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+381 6... ..." required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="system">Sistem koji vas zanima <span>*</span></label>
                <select id="system" name="system" required>
                  <option value="" disabled selected>Izaberite primarni sistem</option>
                  <option value="inox">Inox sistemi odvodnjavanja (linijski, radijalni, bazeni)</option>
                  <option value="podovi">Modularni podni sistemi (monoblok 1x1m paneli)</option>
                  <option value="rasveta">Moderna rasveta (Z lampa / bandera 3m, 4m, 5m)</option>
                  <option value="fire-pit">Fire Pit Grill (ložište i roštilj)</option>
                  <option value="kombinovano">Kombinovano / kompletan eksterijerni projekat</option>
                </select>
              </div>
              <div class="form-group">
                <label for="quantity">Okvirna dužina ili kvadratura</label>
                <input type="text" id="quantity" name="quantity" placeholder="npr. 35 m kanala ili 120 m² poda" />
              </div>
            </div>

            <div class="form-group">
              <label for="message">Opis prostora i zahteva <span>*</span></label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Opišite prostor i šta vam treba: oblik i dimenzije, padove i visinske kote, da li je površina pešačka ili po njoj voze vozila, željene rokove..."
                required
              ></textarea>
            </div>

            <!-- Upload fajla -->
            <div class="form-group file-upload-group">
              <label for="project-file">Crtež, skica ili fotografija (neobavezno)</label>
              <div class="file-dropzone">
                <input type="file" id="project-file" name="project-file" accept=".pdf,.dwg,.dxf,.zip,.rar,.png,.jpg,.jpeg" />
                <div class="dropzone-text">
                  <span class="upload-icon" aria-hidden="true">📎</span>
                  <strong>Izaberite fajl ili ga prevucite ovde</strong>
                  <span class="upload-hint">PDF, DWG, DXF, ZIP, RAR, JPG, PNG · do 8 MB</span>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label for="link">Link do većih fajlova (neobavezno)</label>
              <input type="url" id="link" name="link" placeholder="Google Drive, WeTransfer, Dropbox..." />
            </div>

            <div class="form-footer">
              <p class="form-note">
                Vaše podatke koristimo isključivo za izradu ponude, u skladu sa
                <a href="/privatnost/">Politikom privatnosti</a>.
              </p>
              <button type="submit" class="btn btn--orange" id="submit-btn">
                Pošaljite upit <b>→</b>
              </button>
            </div>

            <!-- Poruka greške -->
            <div id="form-error" class="form-status is-error" role="alert" style="display: none;"></div>
          </form>
        </div>

        <!-- SMERNICE ZA PRIPREMU PRILOGA -->
        <div class="guidelines-card">
          <div class="guidelines-card__head">
            <span class="bullet"></span>
            <h3>Šta nam je korisno da znamo</h3>
          </div>

          <div class="guidelines-grid">
            <div class="guide-item">
              <strong>1. Oblik i mere prostora</strong>
              <p>
                Dovoljna je skica sa približnim merama. Ako šaljete projekat odvodnjavanja, označite pozicije slivnika, pravce padova i planiranu završnu visinu podloge.
              </p>
            </div>

            <div class="guide-item">
              <strong>2. Krivine i radijusi (R)</strong>
              <p>
                Za bazene i kružne platoe navedite poluprečnik zakrivljenja, ako ga znate, kako bismo predvideli tačan radijalni segment.
              </p>
            </div>

            <div class="guide-item">
              <strong>3. Kako će se površina koristiti</strong>
              <p>
                Navedite da li je samo pešačka površina, bazensko sunčalište ili se po njoj kreću putnička i dostavna vozila.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- DONJI BANER (CTA IZNAD FOOTERA, BEZ SLIKE) -->
    <section class="cta">
      <div class="cta__glow"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Direktne konsultacije
          </div>
          <h2>Želite prvo da <em>popričamo?</em></h2>
          <p>
            Za hitne projekte ili specifična tehnička pitanja pozovite nas direktno.
            Razmotrićemo vašu situaciju i predložiti optimalno rešenje.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--orange" href={`tel:${CONTACT.phoneFormatted || '+38166241386'}`}>
            Pozovite: {CONTACT.phone || '+381 66 241 386'} <b>↗</b>
          </a>
          <a class="btn btn--ghost" href={`mailto:${CONTACT.projectEmail || 'projekti@modularnisistemi.com'}`}>
            Pošaljite email <b>→</b>
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #f6f7f9;
      color: #07111e;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .projekat-page {
      --navy: #06131f;
      --navy2: #0b1d2b;
      --orange: #ff6900;
      --orange-hover: #e85e00;
      --line: #dce2e7;
      --muted: #64717c;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }

    .wrap {
      width: min(1280px, calc(100% - 40px));
      margin-inline: auto;
    }

    h1, h2, h3, p {
      margin: 0;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .eyebrow span {
      display: inline-block;
      width: 20px;
      height: 2px;
      background: var(--orange);
      flex-shrink: 0;
    }

    em {
      font-style: normal;
      color: var(--orange);
    }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      min-height: 560px;
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
      color: #fff;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }

    .hero__glow {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 70% at 85% 20%, rgba(255, 105, 0, 0.16), transparent 70%),
        radial-gradient(ellipse 50% 60% at 10% 100%, rgba(255, 255, 255, 0.05), transparent 70%);
      z-index: -2;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(90deg, black, transparent 80%);
      -webkit-mask-image: linear-gradient(90deg, black, transparent 80%);
      z-index: -1;
    }

    .hero__content {
      padding-top: 120px;
      padding-bottom: 64px;
      display: grid;
      grid-template-columns: minmax(0, 720px) 1fr;
      gap: 50px;
      align-items: end;
    }

    .hero h1 {
      margin-top: 18px;
      max-width: 860px;
      font-size: clamp(36px, 4.4vw, 56px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .hero__lead {
      margin-top: 20px;
      max-width: 620px;
      color: #d4dee4;
      font-size: 15px;
      line-height: 1.65;
    }

    .hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 32px;
    }

    .btn {
      min-height: 48px;
      padding: 0 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: all 0.25s ease;
      cursor: pointer;
      border: none;
    }

    .btn b {
      font-size: 15px;
      font-weight: 600;
    }

    .btn--orange {
      background: var(--orange);
      color: #fff;
      border: 1px solid var(--orange);
    }

    .btn--orange:hover {
      background: var(--orange-hover);
      border-color: var(--orange-hover);
      transform: translateY(-2px);
    }

    .btn--orange:disabled {
      opacity: 0.7;
      cursor: wait;
      transform: none;
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
      background: rgba(0, 0, 0, 0.15);
    }

    .btn--ghost:hover {
      background: #fff;
      color: var(--navy);
      border-color: #fff;
    }

    .hero__specs {
      border-left: 1px solid rgba(255, 255, 255, 0.2);
      padding-left: 28px;
      display: grid;
      gap: 20px;
    }

    .hero__specs strong {
      display: block;
      font-size: 14px;
      letter-spacing: 0.03em;
      font-weight: 700;
      color: #fff;
    }

    .hero__specs span {
      display: block;
      margin-top: 4px;
      color: #a9b6be;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }

    /* ========== OPERATIVNI BAR ========== */
    .quick-contact {
      background: #eef1f4;
      padding: 24px 0;
      border-bottom: 1px solid var(--line);
    }

    .contact-bar {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 24px 32px;
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: center;
      gap: 24px;
      box-shadow: 0 4px 16px rgba(6, 19, 31, 0.04);
    }

    .contact-bar__sep {
      width: 1px;
      height: 48px;
      background: var(--line);
    }

    .contact-bar__col {
      display: flex;
      flex-direction: column;
    }

    .bar-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 4px;
    }

    .bar-val {
      font-size: 15px;
      font-weight: 800;
      color: #07111e;
      text-decoration: none;
      overflow-wrap: anywhere;
      transition: color 0.2s;
    }

    a.bar-val:hover {
      color: var(--orange);
    }

    .bar-val--phone {
      color: var(--orange);
      font-size: 17px;
    }

    .bar-val--formats {
      letter-spacing: 0.04em;
    }

    .bar-sub {
      margin-top: 3px;
      font-size: 11px;
      color: #6d7d89;
    }

    /* ========== MAIN FORM SECTION ========== */
    .main-form-section {
      padding: 80px 0;
      background: #f6f7f9;
      border-bottom: 1px solid var(--line);
      scroll-margin-top: 80px;
    }

    .form-container {
      max-width: 960px;
      display: flex;
      flex-direction: column;
      gap: 36px;
    }

    .form-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 44px;
      box-shadow: 0 4px 24px rgba(6, 19, 31, 0.04);
    }

    .form-card__head h2 {
      margin-top: 10px;
      font-size: clamp(26px, 2.6vw, 36px);
      font-weight: 800;
      color: #07111e;
      letter-spacing: -0.03em;
    }

    .form-card__head p {
      margin-top: 8px;
      font-size: 14px;
      line-height: 1.6;
      color: var(--muted);
    }

    .engineering-form {
      margin-top: 32px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .hp {
      display: none;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #07111e;
    }

    .form-group label span {
      color: var(--orange);
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 14px;
      background: #fbfcfd;
      border: 1px solid var(--line);
      border-radius: 2px;
      font-family: inherit;
      font-size: 13.5px;
      color: #07111e;
      transition: all 0.2s ease;
      outline: none;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      background: #fff;
      border-color: var(--orange);
      box-shadow: 0 0 0 3px rgba(255, 105, 0, 0.12);
    }

    /* File dropzone */
    .file-dropzone {
      position: relative;
      border: 2px dashed var(--line);
      border-radius: 2px;
      padding: 24px;
      text-align: center;
      background: #fbfcfd;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .file-dropzone:hover,
    .file-dropzone:focus-within {
      border-color: var(--orange);
      background: #fff;
    }

    .form-group .file-dropzone input[type="file"] {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      padding: 0;
      opacity: 0;
      cursor: pointer;
    }

    .dropzone-text {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      pointer-events: none;
    }

    .upload-icon {
      font-size: 22px;
    }

    .dropzone-text strong {
      font-size: 13px;
      font-weight: 700;
      color: #07111e;
      overflow-wrap: anywhere;
    }

    .upload-hint {
      font-size: 11px;
      color: var(--muted);
    }

    .form-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-top: 10px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }

    .form-note {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.5;
      max-width: 480px;
    }

    .form-note a {
      color: #07111e;
      font-weight: 700;
      text-decoration: underline;
    }

    .form-note a:hover {
      color: var(--orange);
    }

    .form-status {
      padding: 14px 18px;
      border-radius: 2px;
      font-size: 13px;
      line-height: 1.5;
    }

    .form-status.is-error {
      background: #fff1ee;
      border: 1px solid #f3b5a6;
      color: #9a2a10;
    }

    .form-status.is-error a {
      color: inherit;
      font-weight: 700;
      text-decoration: underline;
    }

    /* Guidelines card */
    .guidelines-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 32px 36px;
    }

    .guidelines-card__head {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }

    .bullet {
      width: 8px;
      height: 8px;
      background: var(--orange);
      border-radius: 1px;
      flex-shrink: 0;
    }

    .guidelines-card__head h3 {
      font-size: 15px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #07111e;
    }

    .guidelines-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .guide-item strong {
      display: block;
      font-size: 13px;
      font-weight: 700;
      color: #07111e;
      margin-bottom: 6px;
    }

    .guide-item p {
      font-size: 12.5px;
      line-height: 1.55;
      color: #55636e;
    }

    /* ========== CTA BANER ========== */
    .cta {
      position: relative;
      min-height: 300px;
      display: flex;
      align-items: center;
      color: #fff;
      overflow: hidden;
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
      isolation: isolate;
    }

    .cta__glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 50% 90% at 90% 50%, rgba(255, 105, 0, 0.14), transparent 70%);
      z-index: -1;
    }

    .cta__inner {
      display: flex;
      align-items: center;
