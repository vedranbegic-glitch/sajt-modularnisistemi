---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProductCard from '../../components/ProductCard.astro';
import { CATEGORIES_DATA } from '../../data/products';
import { CONTACT } from '../../data/siteData';

const podniSistemi = CATEGORIES_DATA.podniSistemi;

const breadcrumbItems = [
  { label: 'Proizvodi', href: '/proizvodi/' },
  { label: 'Modularni podni sistemi' },
];

const podnePrednosti = [
  {
    title: 'Suva montaža bez lepkova',
    description: 'Ploče se spajaju robusnim sistemom jezičaka (click sistem) direktno na pripremljenu podlogu, bez hemikalija, maltera ili bušenja.',
  },
  {
    title: 'Otpornost na ulja i hemikalije',
    description: 'Materijal ploča neutralan je na motorna ulja, kočione tečnosti, baze, kiseline i uobičajena sredstva za industrijsko pranje.',
  },
  {
    title: 'Nosivost za vozila i opremu',
    description: 'Konstruisano za visoka statička i dinamička tačkasta opterećenja: prolaz putničkih i dostavnih vozila, dizalice i servisna kolica.',
  },
  {
    title: 'Integrisana drenaža i provetravanje',
    description: 'Perforisana struktura omogućava trenutno oticanje vode ispod gaznog nivoa, sprečavajući klizanje i zadržavanje vlage na površini.',
  },
];
---

<BaseLayout
  title="Modularni podni sistemi · Fleksibilna podna rešenja"
  description="Fleksibilna podna rešenja za različite prostore i namene. Modularne podne ploče visoke nosivosti sa drenažom za servise, radionice i terase. MODULARNI SISTEMI."
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Hero sekcija -->
  <section class="pt-14 pb-20 bg-navy bg-grid-pattern border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-navy-surface border border-accent/40 text-accent font-mono text-[11px] uppercase tracking-architectural font-bold">
            <span class="w-2 h-2 bg-accent inline-block" aria-hidden="true"></span>
            <span>MODULARNI PODNI SISTEMI</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Fleksibilna podna rešenja za različite prostore i namene.
          </h1>

          <p class="text-base sm:text-lg font-mono text-accent font-bold">
            "Brza montaža, drenažna svojstva i jednostavno prepakivanje prostora."
          </p>

          <p class="text-sm sm:text-base text-slate-surface font-medium leading-relaxed">
            {podniSistemi.description}
          </p>

          <p class="text-xs sm:text-sm text-slate-muted leading-relaxed">
            Idealno rešenje za objekte gde su brza realizacija, laka zamena segmenata i efikasno odvođenje površinskih tečnosti ključni zahtevi eksploatacije.
          </p>

          <div class="pt-4 flex flex-col sm:flex-row gap-4">
            <a
              href="/posaljite-projekat/"
              class="inline-flex items-center justify-center px-8 py-4 bg-accent hover:bg-accent-hover text-white text-xs uppercase tracking-architectural font-bold transition-all border border-accent shadow-md text-center"
            >
              Zatražite proračun za kvadraturu
            </a>
            <a
              href={`tel:${CONTACT.phoneFormatted}`}
              class="inline-flex items-center justify-center px-8 py-4 bg-navy-surface hover:bg-white/10 text-white text-xs uppercase tracking-architectural font-bold border border-white/20 transition-all font-mono text-center"
            >
              {CONTACT.phone}
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative bg-navy-dark border border-white/15 p-2 shadow-2xl">
            <div class="relative aspect-[4/3] bg-navy-surface border border-white/10 overflow-hidden flex items-center justify-center">
              <img
                src={podniSistemi.heroImage}
                alt="Modularni podni sistemi postavljeni na radnoj površini"
                class="w-full h-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
              />
              <div class="hidden absolute inset-0 bg-navy-surface p-6 flex flex-col justify-between" aria-hidden="true">
                <span class="text-accent font-mono text-[10px] tracking-architectural uppercase">MODULARNI PODOVI</span>
                <p class="text-xs font-mono text-white font-bold leading-tight">Drenažne i pune podne ploče</p>
                <span class="text-[10px] font-mono text-slate-muted">{podniSistemi.heroImage}</span>
              </div>
            </div>
            <div class="p-3 bg-navy-surface border-t border-white/10 flex justify-between items-center font-mono text-[11px]">
              <span class="text-slate-muted">Primena: Servisi, terase, radionice</span>
              <span class="text-accent uppercase font-bold">CLICK SISTEM</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Tipologije podnih ploča iz baze podataka -->
  <section class="py-16 lg:py-24 bg-navy-dark border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Sistemski modeli"
        title="Tipologije modularnih ploča"
        subtitle="Izbor između otvorene drenažne strukture i zatvorenih profila prema radnom režimu objekta."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {podniSistemi.subtypes.map((sub) => (
          <ProductCard
            title={sub.name}
            summary={sub.summary}
            image={sub.image}
            application={sub.application}
            badge="PODNI SISTEM"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Inženjerske prednosti podnih sistema -->
  <section class="py-16 lg:py-24 bg-navy border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Prednosti eksploatacije"
        title="Zašto izabrati modularne podne ploče?"
        subtitle="U poređenju sa epoksidnim premazima i betonskim glazurama, modularni pod nudi neuporedivu fleksibilnost."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {podnePrednosti.map((prednost, index) => (
          <div class="p-6 bg-navy-surface border border-white/10 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <span class="text-accent font-mono text-xs font-bold block">
                PREDNOST 0{index + 1}
              </span>
              <h3 class="text-base font-bold text-white tracking-tight">
                {prednost.title}
              </h3>
              <p class="text-xs text-slate-muted leading-relaxed">
                {prednost.description}
              </p>
            </div>
            <div class="pt-3 border-t border-white/10 text-[10px] font-mono text-slate-surface/60 uppercase">
              MODULARNI PODOVI
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Područja primene podnih sistema -->
  <section class="py-16 lg:py-24 bg-navy-dark border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Namena prostora"
        title="Karakteristična područja primene"
        subtitle="Ploče projektovane za suva i mokra okruženja visoke frekvencije."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {podniSistemi.applications.map((app, index) => (
          <div class="p-6 bg-navy border border-white/10 space-y-2">
            <span class="text-accent font-mono text-xs font-bold block">NAMENA 0{index + 1}</span>
            <h3 class="text-base font-bold text-white">{app}</h3>
            <p class="text-xs text-slate-muted leading-relaxed">
              Brzo postavljanje bez zaustavljanja rada prostora, uz mogućnost izbora boja za definisanje radnih zona i staza za kretanje.
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-navy bg-grid-pattern">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-navy-surface border border-accent text-accent font-mono text-xs uppercase tracking-architectural font-bold">
        <span>PRORAČUN KVADRATURE</span>
      </div>

      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        Izračunajte potreban broj modularnih podnih ploča
      </h2>

      <p class="text-xs sm:text-sm text-slate-muted max-w-xl mx-auto leading-relaxed">
        Dostavite dimenzije vašeg prostora (dužina x širina) i željenu namenu. Pripremamo tačan proračun potrebnih ploča, ugaonih elemenata i završnih rampi.
      </p>

      <div class="pt-3 flex flex-col sm:flex-row justify-center items-center gap-4">
        <a
          href="/posaljite-projekat/"
          class="px-8 py-3.5 bg-accent hover:bg-accent-hover text-white text-xs uppercase tracking-architectural font-bold transition-all border border-accent shadow-md"
        >
          Zatražite specifikaciju poda
        </a>
        <a
          href={`tel:${CONTACT.phoneFormatted}`}
          class="px-8 py-3.5 bg-navy-surface hover:bg-white/10 text-white text-xs uppercase tracking-architectural font-bold border border-white/20 transition-all font-mono"
        >
          {CONTACT.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>