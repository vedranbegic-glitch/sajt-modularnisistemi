---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Proizvodi', href: '/proizvodi/' },
  { label: 'Modularni podni sistemi' },
];

const canonicalURL = 'https://modularnisistemi.com/modularni-podni-sistemi/';
const pageTitle = 'Modularni Podni Sistemi — Jedan Sistem. Bezbroj Mogućnosti.';
const pageDescription = 'Čelični monoblok podni paneli 1x1m sa teleskopskim stopama za nivelaciju. Četiri vrste završnih obloga: trava, deking, keramika i industrijska rešetka.';

// 4 ključna monoblok sistema
const podniModeli = [
  {
    number: '01',
    name: 'ECO-GREEN MONOBLOK',
    short: 'Dvorišta, krovne terase, kafići',
    desc: 'Prirodan izgled trave, uvek zelen i čist — bez blata, košenja, zalivanja i održavanja.',
    image: '/images/podovi/eco-green-monoblok-vestacka-trava-1.webp',
    alt: 'Eco-Green monoblok modularni pod sa veštačkom travom',
    href: '/modularni-podni-sistemi/eco-green-monoblok/',
  },
  {
    number: '02',
    name: 'WPC-COMPOUND MONOBLOK',
    short: 'Terase, bašte restorana, bazeni',
    desc: 'Toplina i izgled prirodnog drveta, ali bez truljenja, lakiranja, iverja i vlage.',
    image: '/images/podovi/wpc-deking-monoblok-drvo-kompozit-1.webp',
    alt: 'WPC-Compound monoblok modularni deking pod',
    href: '/modularni-podni-sistemi/wpc-compound-monoblok/',
  },
  {
    number: '03',
    name: 'GRES-PREMIUM MONOBLOK',
    short: 'Moderne terase, vile, lokali',
    desc: 'Vrhunska estetika keramike 20mm fabrički montirane na čelik — bez lepkova i fuga koje pucaju.',
    image: '/images/podovi/gres-premium-monoblok-keramika-1.webp',
    alt: 'Gres-Premium monoblok modularni pod sa granitnom keramikom',
    href: '/modularni-podni-sistemi/gres-premium-monoblok/',
  },
  {
    number: '04',
    name: 'HEAVY-DUTY MONOBLOK',
    short: 'Radionice, servisi, industrija',
    desc: 'Ekstremna nosivost za teška vozila, 100% protivklizno, propušta sve tečnosti direktno ispod poda.',
    image: '/images/podovi/heavy-duty-monoblok-industrijska-resetka-1.webp',
    alt: 'Heavy-Duty monoblok industrijska rešetka visoke nosivosti',
    href: '/modularni-podni-sistemi/heavy-duty-monoblok/',
  },
];

// Zašto modularni sistem
const prednosti = [
  {
    num: '01',
    title: 'Nema majstora i nereda',
    desc: 'Zaboravite na mešanje cementa, lepkove, prašinu i majstore koji kasne nedeljama.',
  },
  {
    num: '02',
    title: 'Trenutna drenaža i ventilacija',
    desc: 'Pod je podignut od tla — kiša i voda otiču ispod panela, nema bara, vlage i neprijatnih mirisa.',
  },
  {
    num: '03',
    title: 'Prenosivo rešenje',
    desc: 'Selite se ili menjate raspored? Rasklopite pod za 15 minuta i ponesite ga sa sobom.',
  },
  {
    num: '04',
    title: 'Za sve vrste terena',
    desc: 'Podesive teleskopske zglobne stope rešavaju padove, neravnine i nagibe bez betoniranja podloge.',
  },
];

// Koraci montaže
const montaza = [
  ['01', 'Postavite panele', 'Položite fabrički sklopljene panele 1x1m na bilo koju podlogu (beton, zemlja, šljunak, travnjak).'],
  ['02', 'Klik-spojite', 'Segmenti se bočno uklapaju jedan u drugi u savršenu čvrstu celinu bez ijednog šrafa na licu mesta.'],
  ['03', 'Nivelišite u milimetar', 'Teleskopske zglobne stope sa kontra-maticom nivelšu neravnine terena od 4 do 12 cm u milimetar.'],
  ['04', 'Spreman za upotrebu', 'Podloga je odmah spremna za hodanje, teret i nameštaj — bez čekanja da se bilo šta suši.'],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://modularnisistemi.com/images/podovi/modularni-pod-terasa-kamene-staze-basta-2.webp" />
  </Fragment>

  <div class="podovi-page">
    <div class="podovi-breadcrumbs">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- HERO SEKCIJA -->
    <section class="hero">
      <img
        class="hero__image"
        src="/images/podovi/modularni-pod-terasa-kamene-staze-basta-2.webp"
        alt="Modularni podni sistemi postavljeni na terasi i u bašti"
        fetchpriority="high"
      />
      <div class="hero__shade"></div>
      <div class="hero__grid"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            Modularni podni sistemi · Fabrički prefabricirani paneli
          </div>

          <h1>
            Jedan sistem.<br />
            <em>Bezbroj mogućnosti.</em><br />
            Savršen pod za 1 dan.
          </h1>

          <p class="hero__lead">
            Čelični monoblok paneli dimenzija 1×1m koji se bočno spajaju bez ijednog šrafa. 
            Teleskopske zglobne stope nivelšu pod u milimetar na svakom terenu, uz izbor 
            između trave, dekinga, keramike i industrijske rešetke.
          </p>

          <div class="hero__actions">
            <a class="btn btn--orange" href="/posaljite-projekat/">
              Izračunaj cenu za 30 sekundi <b>→</b>
            </a>
            <a class="btn btn--ghost" href="tel:+38166241386">
              Pozovite: +381 (0) 66 241 386 <b>↗</b>
            </a>
          </div>
        </div>

        <div class="hero__specs">
          <div>
            <strong>1 × 1 m MONOBLOK</strong>
            <span>Fabrički sklopljeni paneli</span>
          </div>
          <div>
            <strong>ČELIČNA ŠASIJA</strong>
            <span>Visoka čvrstoća bez ugibanja</span>
          </div>
          <div>
            <strong>4 – 12 cm NIVELACIJA</strong>
            <span>Teleskopske zglobne stope</span>
          </div>
          <div>
            <strong>SUVA MONTAŽA</strong>
            <span>Bez betona, lepkova i fuga</span>
          </div>
        </div>
      </div>
    </section>

    <!-- INTRO SEKCIJA -->
    <section class="intro wrap">
      <div class="intro__heading">
        <div class="eyebrow eyebrow--dark">
          <span></span>
          Jedna matrica — sve moguće završne obloge
        </div>
        <h2>
          Izaberite završnu obradu.<br />
          <em>Sistem ostaje isti.</em>
        </h2>
      </div>

      <div class="intro__text">
        <p>
          Bilo da uređujete privatnu vilu, krovnu terasu kafića, restoran pored bazena ili industrijski servis, 
          osnova sistema je uvek ista: nepokolebljivo stabilna čelična konstrukcija koja se postavlja direktno na zemlju, 
          šljunak, travu ili neravan beton.
        </p>

        <div class="intro__metrics">
          <div>
            <strong>100%</strong>
            <span>Prefabrikovano u fabrici</span>
          </div>
          <div>
            <strong>0 šrafova</strong>
            <span>Brzi bočni klik-spoj</span>
          </div>
          <div>
            <strong>± mm</strong>
            <span>Precizno podešavanje visine</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 MODELA: IZBOR STRUKTURE PREMA NAMENI OBJEKTA -->
    <section class="forms-section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Izbor strukture prema nameni objekta
            </div>
            <h2>Četiri tipologije <em>monoblok panela.</em></h2>
          </div>
          <p>
            Isti sistem povezivanja, potpuno prilagođen funkciji i estetici vašeg prostora.
          </p>
        </div>

        <div class="forms-grid">
          {podniModeli.map((item) => (
            <div class="form-card">
              <div class="form-card__image">
                <img src={item.image} alt={item.alt} loading="lazy" />
                <span>{item.number}</span>
              </div>
              <div class="form-card__body">
                <div class="form-card__tag">{item.short}</div>
                <h3>{item.name}</h3>
                <p class="form-card__desc">{item.desc}</p>
                <a href={item.href} class="form-card__btn">
                  Više o proizvodu <b>→</b>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FEATURE DUO: DVE VELIKE TEHNIČKE KARTICE -->
    <section class="feature-duo">
      <div class="wrap feature-duo__grid">
        
        <!-- LEVA KARTICA: HEAVY-DUTY -->
        <article class="feature-card feature-card--technical">
          <img
            src="/images/podovi/heavy-duty-monoblok-industrijska-resetka-1.webp"
            alt="Heavy-Duty monoblok industrijska rešetka"
            loading="lazy"
          />
          <div class="feature-card__shade"></div>
          <div class="feature-card__content">
            <div class="eyebrow">
              <span></span>
              Industrijska snaga i servis
            </div>
            <h2>Otpornost na hemikalije i <em>teška vozila.</em></h2>
            <p>
              Konstruisan za prostore gde obični podovi brzo propadaju: radionice, servise, perionice i magacine. 
              Rešetkasta struktura omogućava trenutni prolaz tečnosti i ulja, ostavljajući gaznu površinu uvek suvom i bezbednom.
            </p>
            <div class="feature-card__facts">
              <span><b>Ekstremna nosivost</b> za dizalice i teret</span>
              <span><b>100% protivklizna</b> rešetkasta površina</span>
              <span><b>Otporan na hemikalije</b> motorna ulja i baze</span>
              <span><b>Lako održavanje</b> pranje pod pritiskom</span>
            </div>
            <a class="feature-card__link" href="/posaljite-projekat/">
              Zatražite tehničku specifikaciju <b>→</b>
            </a>
          </div>
        </article>

        <!-- DESNA KARTICA: GRES-PREMIUM (KOCKE UMESTO ELIPSE) -->
        <article class="feature-card feature-card--geometry">
          <img
            src="/images/podovi/gres-premium-monoblok-keramika-1.webp"
            alt="Gres-Premium monoblok keramički pod"
            loading="lazy"
          />
          <div class="feature-card__shade"></div>
          <!-- Dve narandžaste kocke -->
          <div class="feature-card__squares"></div>
          <div class="feature-card__content">
            <div class="eyebrow">
              <span></span>
              Luksuz na otvorenom
            </div>
            <h2>Montaža bez alata i <em>dodatnih troškova.</em></h2>
            <p>
              Granitna keramika debljine 20mm fabrički je montirana na modularnu čeličnu konstrukciju. 
              Vrhunski izgled enterijera na otvorenom prostoru — bez lepkova, bez fuga koje pucaju i nereda.
            </p>
            <div class="feature-card__facts">
              <span>Granitna keramika 20mm</span>
              <span>Otporno na mraz i so</span>
              <span>Savršeno ravna površina</span>
              <span>Zamena pojedinačne ploče</span>
            </div>
            <a class="btn btn--orange" href="/posaljite-projekat/">
              Zatražite ponudu <b>→</b>
            </a>
          </div>
        </article>

      </div>
    </section>

    <!-- ZAŠTO MODULARNI SISTEM (PREDNOSTI) -->
    <section class="applications">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Prednosti eksploatacije
            </div>
            <h2>Zašto modularni sistem, a <em>ne klasična gradnja?</em></h2>
          </div>
          <p>
            Eliminišite višenedeljne betonske radove, vlagu i majstore uz prenosivo rešenje napravljeno da traje decenijama.
          </p>
        </div>

        <div class="benefits__grid">
          {prednosti.map((item) => (
            <div class="benefit-card">
              <span class="benefit-card__num">{item.num}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- KAKO FUNKCIONIŠE MONTAŽA (KORACI) -->
    <section class="process">
      <div class="wrap">
        <div class="process__head">
          <div class="eyebrow eyebrow--dark">
            <span></span>
            Jednostavna ugradnja
          </div>
          <h2>Kako funkcioniše <em>montaža na terenu?</em></h2>
        </div>

        <div class="steps">
          {montaza.map(([num, title, text]) => (
            <article>
              <span class="step-num">{num}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- DONJI BANER (CTA IZNAD FOOTERA) -->
    <section class="cta">
      <img
        src="/images/podovi/modularni-pod-terasa-exterijer-moderna-4.webp"
        alt="Savremena terasa sa modularnim podnim sistemom"
        loading="lazy"
      />
      <div class="cta__shade"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Dostava na paleti · Montaža za jedno popodne
          </div>
          <h2>Transformišite svoj prostor <em>već ovog vikenda.</em></h2>
          <p>
            Izračunajte okvirnu cenu za vašu površinu ili nas kontaktirajte za ponudu po meri. 
            Svi paneli stižu 100% fabrički sklopljeni i pripremljeni za postavljanje.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--orange" href="/posaljite-projekat/">
            Izračunaj cenu za 30 sekundi <b>→</b>
          </a>
          <a class="btn btn--ghost" href="tel:+38166241386">
            Pozovite: 066 241 386 <b>↗</b>
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #f6f7f9;
      color: #07111e;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .podovi-page {
      --navy: #06131f;
      --navy2: #0b1d2b;
      --orange: #ff6900;
      --orange-hover: #e85e00;
      --line: #dce2e7;
      --muted: #64717c;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }

    .wrap {
      width: min(1280px, calc(100% - 40px));
      margin-inline: auto;
    }

    .podovi-breadcrumbs {
      position: absolute;
      z-index: 5;
      top: 0;
      left: 0;
      right: 0;
      opacity: 0.5;
      font-size: 10px;
      color: #fff;
    }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      min-height: 680px;
      background: var(--navy);
      color: #fff;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
    }

    .hero__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      z-index: -3;
    }

    .hero__shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(105deg, rgba(2, 12, 20, 0.93) 0%, rgba(2, 14, 22, 0.78) 32%, rgba(2, 14, 22, 0.32) 62%, rgba(2, 14, 22, 0.06) 100%),
        linear-gradient(0deg, rgba(2, 12, 20, 0.72) 0%, transparent 48%);
      z-index: -2;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(90deg, black, transparent 68%);
      z-index: -1;
    }

    .hero__content {
      padding-top: 130px;
      padding-bottom: 56px;
      display: grid;
      grid-template-columns: minmax(0, 720px) 1fr;
      gap: 50px;
      align-items: end;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--orange);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .eyebrow span {
      display: inline-block;
      width: 20px;
      height: 1.5px;
      background: var(--orange);
      flex-shrink: 0;
    }

    .eyebrow--dark {
      color: var(--orange);
    }

    h1, h2, h3, p {
      margin: 0;
    }

    .hero h1 {
      margin-top: 20px;
      max-width: 860px;
      font-size: clamp(36px, 4.4vw, 58px);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #fff;
    }

    .hero h1 em,
    .intro h2 em,
    .section-head h2 em,
    .feature-card h2 em,
    .process h2 em,
    .cta h2 em {
      font-style: normal;
      color: var(--orange);
    }

    .hero__lead {
      margin-top: 20px;
      max-width: 620px;
      color: #d4dee4;
      font-size: 15px;
      line-height: 1.65;
    }

    .hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 28px;
    }

    .btn {
      min-height: 48px;
      padding: 0 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: all 0.25s ease;
    }

    .btn b {
      font-size: 15px;
      font-weight: 600;
    }

    .btn--orange {
      background: var(--orange);
      color: #fff;
      border: 1px solid var(--orange);
    }

    .btn--orange:hover {
      background: var(--orange-hover);
      border-color: var(--orange-hover);
      transform: translateY(-2px);
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
      background: rgba(0, 0, 0, 0.12);
    }

    .btn--ghost:hover {
      background: #fff;
      color: var(--navy);
      border-color: #fff;
    }

    .hero__specs {
      border-left: 1px solid rgba(255, 255, 255, 0.18);
      padding-left: 26px;
      display: grid;
      gap: 20px;
    }

    .hero__specs div {
      display: flex;
      flex-direction: column;
    }

    .hero__specs strong {
      font-size: 14px;
      letter-spacing: 0.03em;
      font-weight: 700;
    }

    .hero__specs span {
      margin-top: 4px;
      color: #94a3ad;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }

    /* ========== INTRO ========== */
    .intro {
      padding: 60px 0;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 50px;
      align-items: start;
    }

    .intro h2,
    .section-head h2,
    .process h2 {
      margin-top: 12px;
      font-size: clamp(30px, 3.4vw, 46px);
      line-height: 1.02;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #07111e;
    }

    .intro__text {
      padding-top: 12px;
    }

    .intro__text > p,
    .section-head > p {
      color: var(--muted);
      font-size: 15px;
      line-height: 1.65;
    }

    .intro__metrics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin-top: 28px;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .intro__metrics div {
      padding: 16px 14px 16px 0;
      border-right: 1px solid var(--line);
    }

    .intro__metrics div + div {
      padding-left: 14px;
    }

    .intro__metrics div:last-child {
      border-right: 0;
    }

    .intro__metrics strong {
      display: block;
      color: var(--orange);
      font-size: 20px;
      font-weight: 800;
    }

    .intro__metrics span {
      display: block;
      margin-top: 4px;
      color: #3d4a55;
      font-size: 12px;
      line-height: 1.4;
    }

    /* ========== 4 MODELA (FORMS-SECTION) ========== */
    .forms-section {
      background: #eef1f4;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 60px 0;
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 36px;
      margin-bottom: 28px;
    }

    .section-head > div {
      max-width: 680px;
    }

    .section-head > p {
      max-width: 360px;
      padding-bottom: 4px;
    }

    .forms-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }

    .form-card {
      background: #fff;
      color: var(--navy);
      border: 1px solid #e2e7eb;
      border-radius: 2px;
      transition: all 0.3s ease;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .form-card:hover {
      transform: translateY(-5px);
      border-color: var(--orange);
