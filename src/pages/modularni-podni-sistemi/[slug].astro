---
// Jedna ruta pravi sve 4 stranice "Više o proizvodu":
//   /modularni-podni-sistemi/<slug>/
// Sadržaj dolazi iz src/data/podniModeli.ts, izgled iz src/components/PodniProductPage.astro
import PodniProductPage from '../../components/PodniProductPage.astro';
import { podniModeli } from '../../data/podniModeli';

export function getStaticPaths() {
  return podniModeli.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<PodniProductPage product={product} />
