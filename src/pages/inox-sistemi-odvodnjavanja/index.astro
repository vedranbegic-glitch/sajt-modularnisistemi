---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Proizvodi', href: '/proizvodi/' },
  { label: 'Inox sistemi odvodnjavanja' },
];

const canonicalURL = 'https://modularnisistemi.com/inox-sistemi-odvodnjavanja/';
const pageTitle = 'Inox sistemi odvodnjavanja | Modularni Sistemi';
const pageDescription = 'Inox sistemi odvodnjavanja za savremenu arhitekturu — ravne, lučne, kružne, elipsaste i S-forme prema geometriji prostora.';

const forms = [
  { number: '01', name: 'Ravna kanalica', short: 'Čista linija', image: '/images/inox/ravni-modularni-inox-kanal-odvodnjavanje-drenaza.webp', alt: 'Ravni modularni inox kanal za odvodnjavanje', href: '/inox-sistemi-odvodnjavanja/ravni-modularni-inox-kanal/' },
  { number: '02', name: 'Lučna kanalica', short: 'Kontinualni radijus', image: '/images/inox/lucni-inox-kanal-linijsko-odvodnjavanje.webp', alt: 'Lučni inox kanal za linijsko odvodnjavanje', href: '/inox-sistemi-odvodnjavanja/lucni-inox-kanal/' },
  { number: '03', name: 'Kružna kanalica', short: 'Zatvorena geometrija', image: '/images/inox/kruzni-prohromski-kanal-za-odvodnjavanje.webp', alt: 'Kružni prohromski kanal za odvodnjavanje', href: '/inox-sistemi-odvodnjavanja/kruzni-prohromski-kanal/' },
  { number: '04', name: 'Elipsasta kanalica', short: 'Fluidna forma', image: '/images/inox/elipsasti-inox-kanal-za-odvodnjavanje.webp', alt: 'Elipsasti inox kanal za odvodnjavanje', href: '/inox-sistemi-odvodnjavanja/elipsasti-inox-kanal/' },
  { number: '05', name: 'S-forma kanalica', short: 'Slobodna geometrija', image: '/images/inox/s-forma-lucni-inox-kanal-odvodnjavanje.webp', alt: 'S-forma inox kanalica za odvodnjavanje', href: '/inox-sistemi-odvodnjavanja/s-forma-kanalica/' },
];

const applications = [
  { image: '/images/inox/skriveni-modularni-inox-kanal-s-forma-bazen-suva-plaza.webp', title: 'Bazen i suva plaža', meta: 'S-forma / bazen' },
  { image: '/images/inox/lucni-skriveni-inox-kanal-zalazak-sunca.webp', title: 'Lučni parter', meta: 'Lučna geometrija' },
  { image: '/images/inox/kruzni-skriveni-inox-kanal-oko-zardinjere.webp', title: 'Kružna žardinjera', meta: 'Kružna geometrija' },
  { image: '/images/inox/elipsasti-skriveni-inox-kanal-poslovni-centar.webp', title: 'Savremeni objekat', meta: 'Elipsasta geometrija' },
];

const steps = [
  ['01', 'Pošaljite nacrt', 'Osnovu, DWG, skicu ili dimenzije prostora.'],
  ['02', 'Definišemo formu', 'Geometriju pretvaramo u jasne modularne segmente.'],
  ['03', 'Određujemo pad i odvod', 'Usklađujemo pad, završnu kotu i poziciju odvoda.'],
  ['04', 'Izrađujemo sistem', 'Precizna izrada inox segmenata prema dogovorenom rešenju.'],
  ['05', 'Spremno za ugradnju', 'Komponente stižu pripremljene za montažu na objektu.'],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://modularnisistemi.com/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp" />
  </Fragment>

  <div class="inox-page">
    <div class="inox-breadcrumbs">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- HERO -->
    <section class="hero">
      <img
        class="hero__image"
        src="/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp"
        alt="Lučni inox kanal koji prati oblik savremenog partera"
        fetchpriority="high"
      />
      <div class="hero__shade"></div>
      <div class="hero__grid"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            Modularni sistemi · Premium inox linijska drenaža
          </div>

          <h1>
            Odvodnjavanje koje prati<br />
            <em>oblik prostora</em><br />
            bez geometrijskog ograničenja.
          </h1>

          <p class="hero__lead">
            Modularni inox sistemi sa integrisanim fabričkim padom i nivelirajućim stopama.
            Ravne, lučne, kružne, elipsaste i S-forme projektujemo prema stvarnoj geometriji prostora.
          </p>

          <div class="hero__actions">
            <a class="btn btn--orange" href="#specifikacije">
              Pogledajte specifikacije <b>→</b>
            </a>
            <a class="btn btn--ghost" href="/posaljite-projekat/">
              Pošaljite nam nacrt <b>↗</b>
            </a>
          </div>
        </div>

        <div class="hero__specs">
          <div>
            <strong>AISI 304 / 316</strong>
            <span>Nerđajući čelik</span>
          </div>
          <div>
            <strong>0.5% – 1%</strong>
            <span>Integrisani pad</span>
          </div>
          <div>
            <strong>2.0 mm</strong>
            <span>Debljina lima</span>
          </div>
          <div>
            <strong>± mm</strong>
            <span>Precizno nivelisanje</span>
          </div>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro wrap" id="specifikacije">
      <div class="intro__heading">
        <div class="eyebrow eyebrow--dark">
          <span></span>
          Ne mora svaka kanalica da bude prava
        </div>
        <h2>
          Forma prostora<br />
          <em>postaje deo rešenja.</em>
        </h2>
      </div>

      <div class="intro__text">
        <p>
          Kada odvodnjavanje prati liniju terase, bazena, partera ili druge arhitektonske površine,
          tehnički element postaje deo ukupne kompozicije. Vi zadajete geometriju — mi je pretvaramo
          u funkcionalan i precizan sistem.
        </p>

        <div class="intro__metrics">
          <div>
            <strong>01</strong>
            <span>Geometrija prema projektu</span>
          </div>
          <div>
            <strong>02</strong>
            <span>Precizno nivelisanje</span>
          </div>
          <div>
            <strong>03</strong>
            <span>Diskretna završna obrada</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FORMS -->
    <section class="forms-section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Izbor forme prema geometriji partera
            </div>
            <h2>Izaberite formu prema <em>geometriji prostora.</em></h2>
          </div>
          <p>
            Ravna, lučna, kružna, elipsasta ili S-forma — sistem prati arhitektonsku liniju
            umesto da je ograničava.
          </p>
        </div>

        <div class="forms-grid">
          {forms.map((item) => (
            <a href={item.href} class="form-card">
              <div class="form-card__image">
                <img src={item.image} alt={item.alt} loading="lazy" />
                <span>{item.number}</span>
              </div>
              <div class="form-card__body">
                <div class="form-card__tag">{item.short}</div>
                <h3>{item.name}</h3>
                <span class="form-card__link">Više o proizvodu <b>→</b></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FEATURE DUO -->
    <section class="feature-duo">
      <div class="wrap feature-duo__grid">
        <article class="feature-card feature-card--technical">
          <img
            src="/images/inox/ravni-modularni-inox-kanal-odvodnjavanje-drenaza.webp"
            alt="Detalj ravnog modularnog inox kanala"
            loading="lazy"
          />
          <div class="feature-card__shade"></div>
          <div class="feature-card__content">
            <div class="eyebrow">
              <span></span>
              Tehnički detalji
            </div>
            <h2>Kvalitet u svakom <em>detalju.</em></h2>
            <p>
              Ravni inox kanal prikazuje osnovu sistema: precizna izrada, saten-brušena završna obrada,
              nivelisanje i detalji koji omogućavaju pouzdanu ugradnju.
            </p>
            <div class="feature-card__facts">
              <span><b>2.0 mm</b> inox lim</span>
              <span><b>0.5–1%</b> integrisani pad</span>
              <span><b>AISI 304 / 316</b> nerđajući čelik</span>
              <span><b>± mm</b> precizno nivelisanje</span>
            </div>
            <a class="feature-card__link" href="#specifikacije">
              Pogledajte tehničke detalje <b>→</b>
            </a>
          </div>
        </article>

        <article class="feature-card feature-card--geometry">
          <img
            src="/images/inox/elipsasti-inox-kanal-za-odvodnjavanje.webp"
            alt="Elipsasti inox kanal prema geometriji prostora"
            loading="lazy"
          />
          <div class="feature-card__shade"></div>
          <div class="feature-card__ring"></div>
          <div class="feature-card__content">
            <div class="eyebrow">
              <span></span>
              Projektovano prema vašoj geometriji
            </div>
            <h2>Bez geometrijskih <em>ograničenja.</em></h2>
            <p>
              Elipsasta forma pokazuje ono što standardne kanalice ne mogu: sistem prati arhitektonsku
              liniju prostora, a ne obrnuto.
            </p>
            <div class="feature-card__facts">
              <span>Vanstandardne dubine</span>
              <span>Prilagođene širine</span>
              <span>Posebni radijusi</span>
              <span>Kompleksne forme</span>
            </div>
            <a class="btn btn--orange" href="/posaljite-projekat/">
              Projektujte sa nama <b>→</b>
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- APPLICATIONS -->
    <section class="applications">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Primena u praksi
            </div>
            <h2>Od terase do <em>javnog prostora.</em></h2>
          </div>
          <p>
            Rešenja za savremene eksterijere u kojima funkcija i arhitektonska linija moraju da rade zajedno.
          </p>
        </div>

        <div class="applications__grid">
          {applications.map((item) => (
            <figure>
              <div class="application__image">
                <img src={item.image} alt={item.title} loading="lazy" />
              </div>
              <figcaption>
                <strong>{item.title}</strong>
                <span>{item.meta}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="process">
      <div class="wrap">
        <div class="process__head">
          <div class="eyebrow eyebrow--dark">
            <span></span>
            Od ideje do ugradnje
          </div>
          <h2>Pet koraka do <em>gotovog rešenja.</em></h2>
        </div>

        <div class="steps">
          {steps.map(([num, title, text]) => (
            <article>
              <span class="step-num">{num}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <img
        src="/images/inox/lucni-inox-kanal-sa-perforiranom-resetkom-gradski-trg.webp"
        alt="Lučni inox kanal sa perforiranom rešetkom na gradskom trgu"
        loading="lazy"
      />
      <div class="cta__shade"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Za arhitekte, projektante i izvođače
          </div>
          <h2>Projektujete prostor <em>specifične geometrije?</em></h2>
          <p>
            Pošaljite nam DWG, skicu ili osnovu prostora. Razradićemo formu i predložiti rešenje
            koje prati vaš projekat.
          </p>
        </div>
        <a class="btn btn--orange" href="/posaljite-projekat/">
          Pošaljite nam projekat <b>→</b>
        </a>
      </div>
    </section>
  </div>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #f6f7f9;
      color: #07111e;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .inox-page {
      --navy: #06131f;
      --navy2: #0b1d2b;
      --orange: #ff6900;
      --orange-hover: #e85e00;
      --line: #dce2e7;
      --muted: #64717c;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }

    .wrap {
      width: min(1280px, calc(100% - 40px));
      margin-inline: auto;
    }

    .inox-breadcrumbs {
      position: absolute;
      z-index: 5;
      top: 0;
      left: 0;
      right: 0;
      opacity: 0.5;
      font-size: 10px;
      color: #fff;
    }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      min-height: 680px;
      background: var(--navy);
      color: #fff;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
    }

    .hero__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      z-index: -3;
    }

    .hero__shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(105deg, rgba(2, 12, 20, 0.93) 0%, rgba(2, 14, 22, 0.78) 32%, rgba(2, 14, 22, 0.32) 62%, rgba(2, 14, 22, 0.06) 100%),
        linear-gradient(0deg, rgba(2, 12, 20, 0.72) 0%, transparent 48%);
      z-index: -2;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(90deg, black, transparent 68%);
      z-index: -1;
    }

    .hero__content {
      padding-top: 130px;
      padding-bottom: 56px;
      display: grid;
      grid-template-columns: minmax(0, 700px) 1fr;
      gap: 50px;
      align-items: end;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--orange);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .eyebrow span {
      display: inline-block;
      width: 20px;
      height: 1.5px;
      background: var(--orange);
      flex-shrink: 0;
    }

    .eyebrow--dark {
      color: var(--orange);
    }

    h1, h2, h3, p {
      margin: 0;
    }

    .hero h1 {
      margin-top: 20px;
      max-width: 860px;
      font-size: clamp(38px, 4.6vw, 62px);
      line-height: 1.02;
      letter-spacing: -0.045em;
      font-weight: 800;
      color: #fff;
    }

    .hero h1 em,
    .intro h2 em,
    .section-head h2 em,
    .feature-card h2 em,
    .applications h2 em,
    .process h2 em,
    .cta h2 em {
      font-style: normal;
      color: var(--orange);
    }

    .hero__lead {
      margin-top: 20px;
      max-width: 620px;
      color: #d4dee4;
      font-size: 15px;
      line-height: 1.65;
    }

    .hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 28px;
    }

    .btn {
      min-height: 48px;
      padding: 0 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: all 0.25s ease;
    }

    .btn b {
      font-size: 15px;
      font-weight: 600;
    }

    .btn--orange {
      background: var(--orange);
      color: #fff;
    }

    .btn--orange:hover {
      background: var(--orange-hover);
      transform: translateY(-2px);
    }

    .btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
      background: rgba(0, 0, 0, 0.12);
    }

    .btn--ghost:hover {
      background: #fff;
      color: var(--navy);
      border-color: #fff;
    }

    .hero__specs {
      border-left: 1px solid rgba(255, 255, 255, 0.18);
      padding-left: 26px;
      display: grid;
      gap: 20px;
    }

    .hero__specs div {
      display: flex;
      flex-direction: column;
    }

    .hero__specs strong {
      font-size: 14px;
      letter-spacing: 0.03em;
      font-weight: 700;
    }

    .hero__specs span {
      margin-top: 4px;
      color: #94a3ad;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }

    /* ========== INTRO ========== */
    .intro {
      padding: 60px 0;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 50px;
      align-items: start;
    }

    .intro h2,
    .section-head h2,
    .applications h2,
    .process h2 {
      margin-top: 12px;
      font-size: clamp(30px, 3.4vw, 46px);
      line-height: 1.02;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #07111e;
    }

    .intro__text {
      padding-top: 12px;
    }

    .intro__text > p,
    .section-head > p {
      color: var(--muted);
      font-size: 15px;
      line-height: 1.65;
    }

    .intro__metrics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin-top: 28px;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .intro__metrics div {
      padding: 16px 14px 16px 0;
      border-right: 1px solid var(--line);
    }

    .intro__metrics div + div {
      padding-left: 14px;
    }

    .intro__metrics div:last-child {
      border-right: 0;
    }

    .intro__metrics strong {
      display: block;
      color: var(--orange);
      font-size: 20px;
      font-weight: 800;
    }

    .intro__metrics span {
      display: block;
      margin-top: 4px;
      color: #3d4a55;
      font-size: 12px;
      line-height: 1.4;
    }

    /* ========== FORMS ========== */
    .forms-section {
      background: #eef1f4;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 60px 0;
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 36px;
      margin-bottom: 28px;
    }

    .section-head > div {
      max-width: 680px;
    }

    .section-head > p {
      max-width: 340px;
      padding-bottom: 4px;
    }

    .forms-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
    }

    .form-card {
      background: #fff;
      color: var(--navy);
      text-decoration: none;
      border: 1px solid #e2e7eb;
      border-radius: 2px;
      transition: all 0.3s ease;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .form-card:hover {
      transform: translateY(-5px);
      border-color: var(--orange);
      box-shadow: 0 16px 36px rgba(6, 19, 31, 0.1);
    }

    .form-card__image {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: #0d1216;
      flex-shrink: 0;
    }

    .form-card__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.55s ease;
      display: block;
    }

    .form-card:hover img {
      transform: scale(1.05);
    }

    .form-card__image span {
      position: absolute;
      left: 10px;
      top: 10px;
      color: #fff;
      background: var(--orange);
      font-size: 10px;
      font-weight: 800;
      padding: 4px 7px;
      letter-spacing: 0.04em;
      z-index: 2;
    }

    .form-card__body {
      padding: 14px 12px 16px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .form-card__tag {
      color: var(--orange);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .form-card h3 {
      margin-top: 6px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: -0.01em;
      text-transform: uppercase;
    }

    .form-card__link {
      display: block;
      margin-top: auto;
      padding-top: 14px;
      color: #5c6a74;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .form-card__link b {
      color: var(--orange);
      margin-left: 4px;
    }

    /* ========== FEATURE DUO ========== */
    .feature-duo {
      background: var(--navy);
      padding: 60px 0;
    }

    .feature-duo__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .feature-card {
      position: relative;
      min-height: 520px;
      overflow: hidden;
      background: #0a1620;
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 2px;
    }

