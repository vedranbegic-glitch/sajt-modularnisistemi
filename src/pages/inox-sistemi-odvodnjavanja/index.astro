---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { inoxProducts } from '../../data/inoxProducts';

const canonicalURL = 'https://modularnisistemi.com/inox-sistemi-odvodnjavanja/';
// BaseLayout sam dodaje " · Modularni Sistemi" na kraj naslova, pa ovde ide samo kratak naslov
const pageTitle = 'Inox sistemi odvodnjavanja';
const ogImage = '/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp';
const pageDescription = 'Inox sistemi odvodnjavanja za savremenu arhitekturu — ravne, lučne, kružne, elipsaste i S-forme prema geometriji prostora.';

// Pet kartica proizvoda dolazi iz zajedničkog fajla (isti podaci pokreću i stranice "Više o proizvodu")
const forms = inoxProducts.map((p) => ({
  number: p.number,
  name: p.name,
  short: p.short,
  image: p.image,
  alt: p.alt,
  href: `/inox-sistemi-odvodnjavanja/${p.slug}/`,
}));

const applications = [
  { image: '/images/inox/skriveni-modularni-inox-kanal-s-forma-bazen-suva-plaza.webp', title: 'Bazen i suva plaža', meta: 'S-forma / bazen' },
  { image: '/images/inox/lucni-skriveni-inox-kanal-zalazak-sunca.webp', title: 'Lučni parter', meta: 'Lučna geometrija' },
  { image: '/images/inox/kruzni-skriveni-inox-kanal-oko-zardinjere.webp', title: 'Kružna žardinjera', meta: 'Kružna geometrija' },
  { image: '/images/inox/elipsasti-skriveni-inox-kanal-poslovni-centar.webp', title: 'Savremeni objekat', meta: 'Elipsasta geometrija' },
];

const steps = [
  ['01', 'Pošaljite nacrt', 'Osnovu, DWG, skicu ili dimenzije prostora.'],
  ['02', 'Definišemo formu', 'Geometriju pretvaramo u jasne modularne segmente.'],
  ['03', 'Određujemo pad i odvod', 'Usklađujemo pad, završnu kotu i poziciju odvoda.'],
  ['04', 'Izrađujemo sistem', 'Precizna izrada inox segmenata prema dogovorenom rešenju.'],
  ['05', 'Spremno za ugradnju', 'Komponente stižu pripremljene za montažu na objektu.'],
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalURL} ogImage={ogImage}>
  <div class="inox-page">

    <!-- HERO SEKCIJA SA WEBM VIDEOM -->
    <section class="hero">
      <div class="hero__video-box">
        <video
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          poster="/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp"
          class="hero__video"
        >
          <source src="/videos/inox-sistemi-odvodnjavanja.webm" type="video/webm" />
          <source src="/videos/inox-sistemi-odvodnjavanja.mp4" type="video/mp4" />
          <img src="/images/inox/pejzazni-lucni-inox-kanal-perforirana-resetka-parter.webp" alt="Inox linijsko odvodnjavanje" />
        </video>
      </div>
      <div class="hero__shade"></div>

      <div class="hero__content wrap">
        <div class="hero__copy">
          <div class="eyebrow">
            <span></span>
            Modularni sistemi · Premium inox linijska drenaža
          </div>

          <h1>
            Odvodnjavanje koje prati<br />
            <em>oblik prostora</em><br />
            bez geometrijskog ograničenja.
          </h1>

          <p class="hero__lead">
            Modularni inox sistemi sa integrisanim fabričkim padom i nivelirajućim stopama.
            Ravne, lučne, kružne, elipsaste i S-forme projektujemo prema stvarnoj geometriji prostora.
          </p>

          <div class="hero__actions">
            <a class="btn btn--orange" href="#specifikacije">
              Pogledajte specifikacije <b>→</b>
            </a>
            <a class="btn btn--ghost" href="/posaljite-projekat/">
              Pošaljite nam nacrt <b>↗</b>
            </a>
          </div>
        </div>

        <div class="hero__specs">
          <div>
            <strong>AISI 304 / 316</strong>
            <span>Nerđajući čelik</span>
          </div>
          <div>
            <strong>0.5% – 1%</strong>
            <span>Integrisani pad</span>
          </div>
          <div>
            <strong>2.0 mm</strong>
            <span>Debljina lima</span>
          </div>
          <div>
            <strong>Podesive stope</strong>
            <span>Precizno nivelisanje</span>
          </div>
        </div>
      </div>
    </section>

    <!-- INTRO (PORAVNATO NA ISTU 1440px OSU) -->
    <section class="intro wrap" id="specifikacije">
      <div class="intro__heading">
        <div class="eyebrow eyebrow--dark">
          <span></span>
          Ne mora svaka kanalica da bude prava
        </div>
        <h2>
          Forma prostora<br />
          <em>postaje deo rešenja.</em>
        </h2>
      </div>

      <div class="intro__text">
        <p>
          Kada odvodnjavanje prati liniju terase, bazena, partera ili druge arhitektonske površine,
          tehnički element postaje deo ukupne kompozicije. Vi zadajete geometriju — mi je pretvaramo
          u funkcionalan i precizan sistem.
        </p>

        <div class="intro__metrics">
          <div>
            <strong>01</strong>
            <span>Geometrija prema projektu</span>
          </div>
          <div>
            <strong>02</strong>
            <span>Precizno nivelisanje</span>
          </div>
          <div>
            <strong>03</strong>
            <span>Diskretna završna obrada</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FORMS (PORAVNATO NA ISTU 1440px OSU) -->
    <section class="forms-section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Izbor forme prema geometriji partera
            </div>
            <h2>Izaberite formu prema <em>geometriji prostora.</em></h2>
          </div>
          <p>
            Ravna, lučna, kružna, elipsasta ili S-forma — sistem prati arhitektonsku liniju
            umesto da je ograničava.
          </p>
        </div>

        <div class="forms-grid">
          {forms.map((item) => (
            <a href={item.href} class="form-card">
              <div class="form-card__image">
                <img src={item.image} alt={item.alt} loading="lazy" />
                <span>{item.number}</span>
              </div>
              <div class="form-card__body">
                <div class="form-card__tag">{item.short}</div>
                <h3>{item.name}</h3>
                <span class="form-card__link">Više o proizvodu <b>→</b></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FEATURE DUO (PORAVNATO NA ISTU 1440px OSU KAO I FORME) -->
    <section class="feature-duo">
      <div class="wrap feature-duo__grid">
        <article class="feature-card feature-card--technical">
          <img
            src="/images/inox/ravni-modularni-inox-kanal-odvodnjavanje-drenaza-siva.webp"
            alt="Detalj ravnog modularnog inox kanala"
            loading="lazy"
          />
          <div class="feature-card__shade"></div>
          <div class="feature-card__content">
            <div class="eyebrow">
              <span></span>
              Tehnički detalji
            </div>
            <h2>Kvalitet u svakom <em>detalju.</em></h2>
            <p>
              Ravni inox kanal prikazuje osnovu sistema: precizna izrada, saten-brušena završna obrada,
              nivelisanje i detalji koji omogućavaju pouzdanu ugradnju.
            </p>
            <div class="feature-card__facts">
              <span><b>2.0 mm</b> inox lim</span>
              <span><b>0.5–1%</b> integrisani pad</span>
              <span><b>AISI 304 / 316</b> nerđajući čelik</span>
              <span><b>Podesive stope</b> precizno nivelisanje</span>
            </div>
            <a class="feature-card__link" href="/inox-sistemi-odvodnjavanja/ravni-modularni-inox-kanal/#specifikacija">
              Pogledajte tehničke detalje <b>→</b>
            </a>
          </div>
        </article>

        <article class="feature-card feature-card--geometry">
          <img
            src="/images/inox/elipsasti-inox-kanal-za-odvodnjavanje-siva.webp"
            alt="Elipsasti inox kanal prema geometriji prostora"
            loading="lazy"
          />
          <div class="feature-card__shade"></div>
          <div class="feature-card__content">
            <div class="eyebrow">
              <span></span>
              Projektovano prema vašoj geometriji
            </div>
            <h2>Bez geometrijskih <em>ograničenja.</em></h2>
            <p>
              Elipsasta forma pokazuje ono što standardne kanalice ne mogu: sistem prati arhitektonsku
              liniju prostora, a ne obrnuto.
            </p>
            <div class="feature-card__facts">
              <span>Vanstandardne dubine</span>
              <span>Prilagođene širine</span>
              <span>Posebni radijusi</span>
              <span>Kompleksne forme</span>
            </div>
            <a class="btn btn--orange" href="/posaljite-projekat/">
              Projektujte sa nama <b>→</b>
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- APPLICATIONS (PORAVNATO NA ISTU 1440px OSU) -->
    <section class="applications">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow eyebrow--dark">
              <span></span>
              Primena u praksi
            </div>
            <h2>Od terase do <em>javnog prostora.</em></h2>
          </div>
          <p>
            Rešenja za savremene eksterijere u kojima funkcija i arhitektonska linija moraju da rade zajedno.
          </p>
        </div>

        <div class="applications__grid">
          {applications.map((item) => (
            <figure>
              <div class="application__image">
                <img src={item.image} alt={item.title} loading="lazy" />
              </div>
              <figcaption>
                <strong>{item.title}</strong>
                <span>{item.meta}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS (PORAVNATO NA ISTU 1440px OSU) -->
    <section class="process">
      <div class="wrap">
        <div class="process__head">
          <div class="eyebrow eyebrow--dark">
            <span></span>
            Od ideje do ugradnje
          </div>
          <h2>Pet koraka do <em>gotovog rešenja.</em></h2>
        </div>

        <div class="steps">
          {steps.map(([num, title, text]) => (
            <article>
              <span class="step-num">{num}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA BANER (PORAVNATO NA ISTU 1440px OSU) -->
    <section class="cta">
      <img
        src="/images/inox/lucni-inox-kanal-sa-perforiranom-resetkom-gradski-trg.webp"
        alt="Lučni inox kanal sa perforiranom rešetkom na gradskom trgu"
        loading="lazy"
      />
      <div class="cta__shade"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Za arhitekte, projektante i izvođače
          </div>
          <h2>Projektujete prostor <em>specifične geometrije?</em></h2>
          <p>
            Pošaljite nam DWG, skicu ili osnovu prostora. Razradićemo formu i predložiti rešenje
            koje prati vaš projekat.
          </p>
        </div>
        <a class="btn btn--orange" href="/posaljite-projekat/">
          Pošaljite nam projekat <b>→</b>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f6f7f9;
    color: #07111e;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .inox-page {
    --navy: #06131f;
    --navy2: #0b1d2b;
    --orange: #ff6900;
    --orange-hover: #e85e00;
    --line: #dce2e7;
    --muted: #64717c;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  /* ========== JEDINSTVENA ŠIRINA (1440px) ZA SAVRŠENO PORAVNANJE ========== */
  .wrap {
    width: min(1440px, calc(100% - 48px));
    margin-inline: auto;
  }

  /* ========== HERO (PUN EKRAN BEZ SIVE TRAKE) ========== */
  .hero {
    position: relative;
    min-height: 700px;
    background: var(--navy);
    color: #fff;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
  }

  .hero__video-box {
    position: absolute;
    inset: 0;
    z-index: -3;
    overflow: hidden;
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(95deg, rgba(6, 19, 31, 0.72) 0%, rgba(6, 19, 31, 0.45) 35%, rgba(6, 19, 31, 0.1) 65%, transparent 100%),
      linear-gradient(0deg, rgba(6, 19, 31, 0.55) 0%, transparent 35%);
    z-index: -2;
  }

  .hero h1,
  .hero__lead {
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
  }

  .hero__content {
    padding-top: 130px;
    padding-bottom: 64px;
    display: grid;
    grid-template-columns: minmax(0, 720px) 1fr;
    gap: 50px;
    align-items: end;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--orange);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow span {
    display: inline-block;
    width: 20px;
    height: 1.5px;
    background: var(--orange);
    flex-shrink: 0;
  }

  .eyebrow--dark {
    color: var(--orange);
  }

  h1, h2, h3, p {
    margin: 0;
  }

  .hero h1 {
    margin-top: 20px;
    max-width: 860px;
    font-size: clamp(38px, 4.6vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 800;
    color: #fff;
  }

  .hero h1 em,
  .intro h2 em,
  .section-head h2 em,
  .feature-card h2 em,
  .applications h2 em,
  .process h2 em,
  .cta h2 em {
    font-style: normal;
    color: var(--orange);
  }

  .hero__lead {
    margin-top: 20px;
    max-width: 620px;
    color: #d4dee4;
    font-size: 15px;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .btn {
    min-height: 48px;
    padding: 0 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: all 0.25s ease;
  }

  .btn b {
    font-size: 15px;
    font-weight: 600;
  }

  .btn--orange {
    background: var(--orange);
    color: #fff;
  }

  .btn--orange:hover {
    background: var(--orange-hover);
    transform: translateY(-2px);
  }

  .btn--ghost {
    border: 1px solid rgba(255, 255, 255, 0.45);
    color: #fff;
    background: rgba(0, 0, 0, 0.12);
  }

  .btn--ghost:hover {
    background: #fff;
    color: var(--navy);
    border-color: #fff;
  }

  .hero__specs {
    border-left: 1px solid rgba(255, 255, 255, 0.18);
    padding-left: 26px;
    display: grid;
    gap: 20px;
  }

  .hero__specs div {
    display: flex;
    flex-direction: column;
  }

  .hero__specs strong {
    font-size: 14px;
    letter-spacing: 0.03em;
    font-weight: 700;
  }

  .hero__specs span {
    margin-top: 4px;
    color: #94a3ad;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  /* ========== INTRO (KOMPAKTNO I PORAVNATO) ========== */
  .intro {
    padding: 40px 0 32px;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 48px;
    align-items: start;
  }

  .intro h2 {
    margin-top: 8px;
    font-size: clamp(26px, 2.8vw, 38px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: #07111e;
  }

  .intro__text {
    padding-top: 6px;
  }

  .intro__text > p {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
  }

  .intro__metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 20px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .intro__metrics div {
    padding: 12px 14px 12px 0;
    border-right: 1px solid var(--line);
  }

  .intro__metrics div + div {
    padding-left: 14px;
  }

  .intro__metrics div:last-child {
    border-right: 0;
  }

  .intro__metrics strong {
    display: block;
    color: var(--orange);
    font-size: 19px;
    font-weight: 800;
  }

  .intro__metrics span {
    display: block;
    margin-top: 2px;
    color: #3d4a55;
    font-size: 11.5px;
    line-height: 1.35;
  }

  /* ========== FORMS SEKCIJA (PORAVNATO NA 1440px) ========== */
  .forms-section {
    background: #eef1f4;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 68px 0 80px;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 36px;
    margin-bottom: 32px;
  }

  .section-head h2 {
    margin-top: 8px;
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: #07111e;
  }

  .section-head > p {
    max-width: 380px;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
    padding-bottom: 4px;
  }

  .forms-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  .form-card {
    background: #fff;
    color: var(--navy);
    text-decoration: none;
    border: 1px solid #dce2e7;
    border-radius: 4px;
    transition: all 0.3s ease;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(6, 19, 31, 0.04);
  }

  .form-card:hover {
    transform: translateY(-6px);
    border-color: var(--orange);
    box-shadow: 0 20px 40px rgba(6, 19, 31, 0.12);
  }

  .form-card__image {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    border-bottom: 1px solid #edf1f5;
  }

  .form-card__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }

  .form-card:hover img {
    transform: scale(1.08);
  }

  .form-card__image span {
    position: absolute;
    left: 12px;
    top: 12px;
    color: #fff;
    background: var(--orange);
    font-size: 10.5px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 2px;
    letter-spacing: 0.04em;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(255, 105, 0, 0.35);
  }

  .form-card__body {
    padding: 18px 16px 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .form-card__tag {
    color: var(--orange);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .form-card h3 {
    margin-top: 6px;
    font-size: 14.5px;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #07111e;
  }

  .form-card__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
    padding-top: 16px;
    color: #55636e;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color 0.2s;
  }

  .form-card__link b {
    color: var(--orange);
    transition: transform 0.2s ease;
  }

  .form-card:hover .form-card__link {
    color: var(--orange);
  }

  .form-card:hover .form-card__link b {
    transform: translateX(4px);
  }

  /* ========== FEATURE DUO (SAVRŠENO U PORAVNANJU SA FORMAMA IZNAD) ========== */
  .feature-duo {
    background: var(--navy);
    padding: 70px 0;
  }

  .feature-duo__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .feature-card {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    background: #0a1620;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
  }

  .feature-card > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .feature-card:hover > img {
    transform: scale(1.03);
  }

