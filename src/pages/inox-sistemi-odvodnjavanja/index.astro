---

import BaseLayout from '../../layouts/BaseLayout.astro';

import { inoxProducts } from '../../data/inoxProducts';

const canonicalURL = 'https://modularnisistemi.com/inox-sistemi-odvodnjavanja/';

// Fotografije iz public/images/engineering/ — bez promene postojećih slugova.

const premiumImages: Record<string, string> = {

  'ravni-modularni-inox-kanal': '/images/engineering/hero-inox-ravna-premium.webp',

  'lucni-inox-kanal': '/images/engineering/hero-inox-lucna-premium.webp',

  'kruzni-inox-kanal': '/images/engineering/hero-inox-kruzna-premium.webp',

  'elipsasti-inox-kanal': '/images/engineering/hero-inox-elipsasta-premium.webp',

  's-forma-kanalica': '/images/engineering/hero-inox-s-forma-premium.webp',

};

const forms = inoxProducts.map((p) => ({

  number: p.number,

  name: p.name,

  short: p.short,

  image: premiumImages[p.slug] ?? p.image,

  alt: `${p.name} — premium fotografija inox kanalice u arhitektonskom studiju`,

  href: `/inox-sistemi-odvodnjavanja/${p.slug}/`,

}));

const details = [

  {

    number: '01',

    name: 'Završetak kanala',

    description: 'Završni profil i spojni detalji.',

    image: '/images/engineering/zavrsetak-kanala-premium.webp',

  },

  {

    number: '02',

    name: 'Spoj segmenata',

    description: 'Konstrukcioni spoj modularnih elemenata.',

    image: '/images/engineering/spoj-segmenata-premium.webp',

  },

  {

    number: '03',

    name: 'Nivelirajuća stopa',

    description: 'Podešavanje položaja tokom ugradnje.',

    image: '/images/engineering/nivelirajuca-stopa-premium.webp',

  },

];

---

<BaseLayout

  title="Inox sistemi odvodnjavanja"

  description="Inox kanalice po meri: ravna, lučna, kružna, elipsasta i S-forma. Precizna geometrija, inox AISI 304/316 i modularna konstrukcija."

  canonical={canonicalURL}

  ogImage="/images/engineering/hero-inox-s-forma-premium.webp"

>

  <div class="inox-engineering">

    <section class="hero" aria-labelledby="inox-title">

      <div class="container hero-grid">

        <div class="hero-copy">

          <div class="eyebrow"><span></span> MODULARNI SISTEMI / PREMIUM ENGINEERING</div>

          <h1 id="inox-title">Geometrija koja<br /><em>prati prostor.</em></h1>

          <p class="hero-lead">Precizno oblikovani inox sistemi odvodnjavanja. Od ravne linije do složene S-forme — konstrukcija i dimenzije na zahtev.</p>

          <div class="actions">

            <a class="button button-main" href="#forme">Istražite forme <span aria-hidden="true">↗</span></a>

            <a class="button button-outline" href="/posaljite-upit/">Pošaljite upit <span aria-hidden="true">↗</span></a>

          </div>

          <p class="hero-caption">OBLIK. FUNKCIJA. KONSTRUKCIJA.</p>

        </div>

        <div class="hero-visual">

          <img src="/images/engineering/hero-inox-s-forma-premium.webp" alt="S-forma inox kanalice na nivelirajućim stopama u arhitektonskom studiju" fetchpriority="high" decoding="async" />

          <button class="inox-hero-video-trigger" type="button" data-open-inox-video aria-haspopup="dialog" aria-label="Pogledajte promotivni video inox odvodnjavanja">
            <span class="inox-hero-video-icon" aria-hidden="true">▶</span>
            <span class="inox-hero-video-copy"><strong>Pogledajte video</strong><small>INOX / VIDEO PREZENTACIJA</small></span>
          </button>

          <div class="visual-top"><span>PROIZVOD U FOKUSU</span><span>INOX / 05</span></div>

          <div class="visual-bottom"><span>05</span><strong>S-forma</strong><a href="#forme" aria-label="Pogledajte inox forme">↗</a></div>

        </div>

      </div>

      <div class="container hero-foot">

        <span>INOX ODVODNJAVANJE / PRILAGODLJIVA GEOMETRIJA</span>

        <a href="#forme">Pogledajte sve forme <span aria-hidden="true">↓</span></a>

      </div>

    </section>

    <section class="forms" id="forme" aria-labelledby="forms-heading">

      <div class="container">

        <div class="section-heading">

          <div><div class="eyebrow"><span></span> GEOMETRIJA / PO MERI</div><h2 id="forms-heading">Bez geometrijskih<br /><em>ograničenja.</em></h2></div>

          <p>Od jednostavne linije do složenih krivina. Pet prikazanih formi, sa geometrijom i dimenzijama na zahtev.</p>

        </div>

        <div class="geometry-showcase" data-geometry-showcase>

          <a class="geometry-feature" href={forms[4]?.href ?? forms[0]?.href} data-geometry-feature aria-label="Pogledajte izabranu geometriju">

            <div class="geometry-feature-media">

              <img src={forms[4]?.image ?? forms[0]?.image} alt={forms[4]?.alt ?? forms[0]?.alt} data-geometry-image loading="lazy" decoding="async" />

              <span class="geometry-kicker">INOX / GEOMETRIJA <span data-geometry-count>05</span></span>

              <div class="geometry-feature-caption"><div><small>ODABRANA FORMA</small><h3 data-geometry-name>{forms[4]?.name ?? forms[0]?.name}</h3><p data-geometry-description>{forms[4]?.short ?? forms[0]?.short}</p></div><span aria-hidden="true">↗</span></div>

            </div>

          </a>

          <div class="geometry-panel">

            <div class="geometry-panel-head"><span>INOX SISTEMI ODVODNJAVANJA</span><strong>Različite forme.<br />Jedan princip.</strong></div>

            <div class="geometry-options" role="group" aria-label="Izbor geometrije kanalice">

              {forms.map((form, index) => (

                <a href={form.href} class:list={['geometry-option', {'is-active': index === 4}]} data-geometry-index={index} aria-label={`Otvorite ${form.name}`} >

                  <span class="geometry-option-num">{form.number}</span><span class="geometry-option-label"><strong>{form.name}</strong><small>{form.short}</small></span><span class="geometry-option-action"><span>Više o proizvodu</span><span class="geometry-option-arrow" aria-hidden="true">↗</span></span>

                </a>

              ))}

            </div>

            <a class="geometry-panel-link" href={forms[4]?.href ?? forms[0]?.href} data-geometry-link>Upoznajte izabranu formu <span aria-hidden="true">↗</span></a>

          </div>

        </div>

        <div class="geometry-footnote"><span>FORMA / FUNKCIJA / PRECIZNOST</span><p>Geometrija koja prati prostor. Detalji konstrukcije se usaglašavaju prema konkretnoj nameni.</p></div>

      </div>

    </section>

    <section class="engineering" aria-labelledby="engineering-heading">

      <div class="container">

        <div class="section-heading dark-head">

          <div><div class="eyebrow"><span></span> PRECIZNOST U DETALJU</div><h2 id="engineering-heading">Konstrukcija koja<br /><em>govori za sebe.</em></h2></div>

          <div class="engineering-intro"><p>Originalni elementi sistema. Pažnja je posvećena spojevima, završecima i podešavanju položaja tokom ugradnje.</p><a class="inline-link" href="/posaljite-upit/">Razgovarajmo o vašem projektu ↗</a></div>

        </div>

        <div class="detail-grid">

          {details.map((detail) => (

            <article class="detail-card">

              <div class="detail-image"><img src={detail.image} alt={detail.name} loading="lazy" decoding="async" /></div>

              <div class="detail-text"><small>{detail.number} / KONSTRUKCIJA</small><h3>{detail.name}</h3><p>{detail.description}</p></div>

            </article>

          ))}

        </div>

      </div>

    </section>

    <section class="specs" aria-labelledby="specs-heading">

      <div class="container specs-layout">

        <div><div class="eyebrow"><span></span> TEHNIČKA OSNOVA</div><h2 id="specs-heading">Precizan materijal.<br /><em>Forma na zahtev.</em></h2></div>

        <div class="spec-table">

          <div><span>01 / MATERIJAL</span><strong>Inox AISI 304 / 316</strong></div>

          <div><span>02 / DEBLJINA LIMA</span><strong>2 mm</strong></div>

          <div><span>03 / GEOMETRIJA I DIMENZIJE</span><strong>Na zahtev</strong></div>

          <div><span>04 / KONSTRUKCIONI DETALJI</span><strong>Prema usaglašenom rešenju</strong></div>

        </div>

      </div>

    </section>

    <section class="contact" aria-labelledby="contact-heading">

      <div class="container contact-layout">

        <div><div class="eyebrow"><span></span> VAŠA IDEJA JE DOBAR POČETAK</div><h2 id="contact-heading">Imate geometriju?<br /><em>Razradimo rešenje.</em></h2><p>Dovoljni su fotografija, skica, dimenzije ili kratak opis zadatka.</p></div>

        <div class="contact-actions"><a class="button button-main" href="/posaljite-upit/">Pošaljite upit <span aria-hidden="true">↗</span></a><a class="email" href="mailto:kontakt@modularnisistemi.com">kontakt@modularnisistemi.com <span aria-hidden="true">↗</span></a></div>

      </div>

    </section>

    <dialog class="inox-video-dialog" data-inox-video-dialog aria-label="Promotivni video inox odvodnjavanja">
      <div class="inox-video-bar">
        <strong>MODULARNI SISTEMI / INOX ODVODNJAVANJE</strong>
        <button type="button" data-close-inox-video aria-label="Zatvori video">Zatvori <span aria-hidden="true">×</span></button>
      </div>
      <video
        data-inox-video
        poster="/images/engineering/hero-inox-s-forma-premium.webp"
        preload="none"
        muted
        playsinline
        loop
        aria-label="Promotivni video inox sistema odvodnjavanja"
      >
        <source src="/videos/modularni-sistemi-inox-drenaza-promo.webm" type="video/webm" />
        <source src="/videos/modularni-sistemi-inox-drenaza-promo.mp4" type="video/mp4" />
        Vaš pregledač ne podržava reprodukciju ovog videa.
      </video>
      <div class="inox-video-controls">
        <span>INOX SISTEMI ODVODNJAVANJA</span>
        <button type="button" data-toggle-inox-video>Pauziraj video</button>
      </div>
    </dialog>
  </div>

</BaseLayout>

<style>

  .inox-engineering{--dark:#061823;--deep:#03111d;--orange:#ff6900;--pale:#eef2f3;--ink:#102431;--muted:#71818d;font-family:Manrope,Montserrat,system-ui,sans-serif;color:var(--ink);overflow:hidden}

  .container{width:min(1240px,calc(100% - 48px));margin-inline:auto}

  .eyebrow{display:flex;align-items:center;gap:11px;font-size:10px;font-weight:800;letter-spacing:.15em;color:var(--orange)}

  .eyebrow span{display:block;width:21px;height:2px;background:var(--orange);flex:none}

  h1,h2,h3,p{margin:0} h1,h2{font-weight:800;letter-spacing:-.053em;line-height:1.08} h1 em,h2 em{font-style:normal;color:var(--orange)}

  .hero{background:radial-gradient(ellipse at 75% 25%,#142b35 0%,var(--deep) 62%);color:#fff}

  .hero-grid{display:grid;grid-template-columns:.89fr 1.11fr;align-items:center;gap:clamp(28px,5vw,75px);padding-block:54px 32px}

  .hero-copy h1{font-size:clamp(43px,4.3vw,69px);margin-top:28px}.hero-lead{max-width:455px;margin-top:23px;font-size:15px;line-height:1.7;color:#b7c6ce}

  .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:27px}.button{min-height:46px;display:inline-flex;align-items:center;justify-content:space-between;gap:26px;padding:0 20px;text-decoration:none;font-size:12px;font-weight:800;transition:background .2s,border-color .2s}.button-main{background:var(--orange);color:#07111e}.button-main:hover{background:#ff842e}.button-outline{border:1px solid #53616a;color:#fff}.button-outline:hover{border-color:#fff}.button span{font-size:17px}.hero-caption{margin-top:40px;padding-top:13px;border-top:1px solid #34424a;max-width:300px;font-size:9px;letter-spacing:.14em;color:#8296a2}

  .hero-visual{height:clamp(285px,31vw,420px);position:relative;overflow:hidden;background:#252626;border:1px solid #32444c}.hero-visual img{width:100%;height:100%;display:block;object-fit:cover;object-position:center}.hero-visual:after{content:'';position:absolute;inset:42% 0 0;background:linear-gradient(0deg,rgba(3,13,21,.8),transparent);pointer-events:none}.visual-top,.visual-bottom{position:absolute;z-index:1;left:22px;right:22px;display:flex;align-items:center;justify-content:space-between}.visual-top{top:17px;font-size:9px;letter-spacing:.13em;font-weight:800;color:#eee}.visual-top span:last-child{color:#ffad68}.visual-bottom{bottom:18px;justify-content:flex-start;gap:14px}.visual-bottom>span{color:var(--orange);font-size:22px;font-weight:800}.visual-bottom strong{font-size:18px}.visual-bottom a{margin-left:auto;color:var(--orange);font-size:25px;text-decoration:none}

  .hero-foot{display:flex;justify-content:space-between;gap:20px;padding:15px 0 18px;border-top:1px solid #35454d;font-size:10px;letter-spacing:.11em;color:#9db1bb}.hero-foot a{color:#fff;text-decoration:none;white-space:nowrap}.hero-foot a span{color:var(--orange)}

  .forms{background:#eff3f4;padding:64px 0 72px;scroll-margin-top:90px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:28px}.section-heading h2,.specs h2,.contact h2{font-size:clamp(31px,3.2vw,46px);margin-top:14px}.section-heading>p,.engineering-intro{max-width:390px;color:#687985;font-size:14px;line-height:1.65}

  .geometry-showcase{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(310px,.88fr);gap:0;border:1px solid #2c4755;background:#071e2c;min-height:420px}

  .geometry-feature{min-width:0;color:white;text-decoration:none}.geometry-feature-media{height:100%;min-height:420px;position:relative;overflow:hidden;background:#22272b}.geometry-feature-media>img{display:block;width:100%;height:100%;position:absolute;inset:0;object-fit:cover;object-position:center;background:#2d3032}.geometry-feature-media:after{content:'';position:absolute;inset:30% 0 0;background:linear-gradient(0deg,rgba(2,13,22,.9),transparent);pointer-events:none}.geometry-kicker{position:absolute;top:18px;left:22px;z-index:1;font-size:10px;font-weight:800;letter-spacing:.12em;color:#e5edf1}.geometry-kicker>span{color:var(--orange)}.geometry-feature-caption{position:absolute;bottom:23px;left:24px;right:23px;z-index:1;display:flex;justify-content:space-between;align-items:end;gap:20px}.geometry-feature-caption small{font-size:9px;color:#ff9a52;letter-spacing:.13em;font-weight:800}.geometry-feature-caption h3{margin-top:7px;font-size:clamp(24px,3vw,36px);letter-spacing:-.045em;line-height:1.05}.geometry-feature-caption p{font-size:12px;margin-top:7px;color:#c2d0d7}.geometry-feature-caption>span{font-size:26px;color:var(--orange)}

  .geometry-panel{display:flex;flex-direction:column;min-width:0;background:#091f2d;color:white;border-left:1px solid #2c4755}.geometry-panel-head{padding:24px 25px 19px;border-bottom:1px solid #2c4755}.geometry-panel-head>span{font-size:9px;letter-spacing:.14em;color:#8ba6b5;font-weight:800}.geometry-panel-head strong{display:block;margin-top:8px;font-size:23px;line-height:1.2;letter-spacing:-.03em}.geometry-options{display:grid;flex:1;grid-template-rows:repeat(5,minmax(54px,1fr))}.geometry-option{font:inherit;text-align:left;border:0;border-bottom:1px solid #2c4755;color:#fff;background:transparent;display:grid;grid-template-columns:35px minmax(0,1fr) auto;align-items:center;gap:10px;padding:11px 16px 11px 23px;cursor:pointer;transition:background .2s}.geometry-option:hover,.geometry-option:focus-visible{background:#173342}.geometry-option.is-active{background:#183644;box-shadow:inset 3px 0 0 var(--orange)}.geometry-option-num{font-size:11px;font-weight:800;color:var(--orange)}.geometry-option-label strong{display:block;font-size:15px;line-height:1.25}.geometry-option-label small{display:block;margin-top:3px;font-size:11px;color:#91a9b7}.geometry-option-action{display:flex;align-items:center;gap:9px;white-space:nowrap;color:#ffab72;font-size:10px;font-weight:750}.geometry-option-arrow{font-size:18px;color:var(--orange);text-align:right}
  .geometry-panel-link{display:flex;justify-content:space-between;gap:12px;text-decoration:none;color:white;font-size:12px;font-weight:800;padding:16px 23px}.geometry-panel-link span{color:var(--orange);font-size:17px}.geometry-footnote{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-top:16px;padding-top:15px;border-top:1px solid #d6e0e5}.geometry-footnote span{font-size:9px;font-weight:800;letter-spacing:.1em;color:#8799a4;white-space:nowrap}.geometry-footnote p{font-size:12px;color:#687985;line-height:1.5}

  .engineering{background:var(--dark);padding:70px 0;color:white}.dark-head>p,.engineering-intro{color:#a8b9c3}.engineering-intro p{margin-bottom:18px}.inline-link{display:inline-block;color:white;border-bottom:1px solid var(--orange);padding-bottom:7px;font-size:12px;font-weight:800;text-decoration:none}.detail-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.detail-card{min-width:0;border:1px solid #24404f;background:#0b2635}.detail-image{aspect-ratio:1.6;overflow:hidden;background:#2d3134}.detail-image img{display:block;width:100%;height:100%;object-fit:cover}.detail-text{padding:16px 18px 18px}.detail-text h3{font-size:16px;margin-top:7px}.detail-text p{color:#95aeba;font-size:12px;line-height:1.55;margin-top:6px}

  .specs{background:#eaf0f2;padding:58px 0}.specs-layout{display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;align-items:center}.spec-table{border-top:1px solid #cdd8dd}.spec-table>div{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:17px 0;border-bottom:1px solid #cdd8dd}.spec-table span{color:#6d818e;font-size:10px;font-weight:800;letter-spacing:.08em}.spec-table strong{text-align:right;font-size:15px}

  .contact{background:#f7f8f8;padding:60px 0}.contact-layout{display:flex;justify-content:space-between;align-items:center;gap:40px}.contact h2{margin-top:12px}.contact p{color:#71818b;font-size:13px;margin-top:13px}.contact-actions{width:min(315px,100%);display:grid;gap:10px}.contact-actions .button{width:100%}.email{display:flex;justify-content:space-between;gap:12px;text-decoration:none;color:#233d4c;border-bottom:1px solid #ced8dd;padding:13px 2px;font-size:12px;font-weight:700}.email span{color:var(--orange)}

  @media(max-width:1050px){.geometry-showcase{grid-template-columns:1fr}.geometry-panel{border-left:0;border-top:1px solid #2c4755}.geometry-options{grid-template-columns:repeat(5,minmax(0,1fr));grid-template-rows:1fr}.geometry-option{grid-template-columns:1fr;gap:6px;padding:13px 10px}.geometry-option-action>span:first-child{display:none}.geometry-option-arrow{display:none}.geometry-option-label small{display:none}.hero-grid{gap:22px}.hero-copy h1{font-size:48px}}

  @media(max-width:740px){.container{width:calc(100% - 32px)}.hero-grid{grid-template-columns:1fr;padding-top:38px}.hero-copy h1{font-size:clamp(38px,10vw,54px);margin-top:19px}.hero-lead{margin-top:16px}.hero-caption{display:none}.hero-visual{height:auto;aspect-ratio:1.45}.hero-foot{font-size:9px;letter-spacing:.04em}.section-heading{display:block}.section-heading>p,.engineering-intro{margin-top:18px}.forms,.engineering{padding:48px 0}.geometry-feature-media{min-height:330px}.geometry-showcase{min-height:0}.geometry-options{grid-template-columns:repeat(5,minmax(0,1fr))}.geometry-option-label strong{font-size:12px}.geometry-panel-head{padding:19px}.geometry-footnote{align-items:start;flex-direction:column;gap:7px}.detail-grid{grid-template-columns:1fr;gap:12px}.detail-image{aspect-ratio:2.1}.specs-layout{grid-template-columns:1fr;gap:25px}.contact-layout{align-items:stretch;flex-direction:column;gap:24px}}

  @media(max-width:470px){.geometry-options{grid-template-columns:repeat(5,minmax(0,1fr))}.geometry-option{padding:12px 4px;justify-items:center;text-align:center}.geometry-option-num{font-size:10px}.geometry-option-label strong{font-size:10px;overflow-wrap:anywhere}.geometry-feature-media{min-height:290px}.hero-foot>span{max-width:190px}.visual-bottom strong{font-size:16px}.spec-table>div{align-items:flex-start;flex-direction:column;gap:7px}.spec-table strong{text-align:left}.contact-actions{width:100%}}

  @media(prefers-reduced-motion:reduce){.geometry-option,.button{transition:none}}


  /* Vidljiv poziv za video preko postojeće HERO fotografije. */
  .inox-hero-video-trigger{position:absolute;z-index:3;top:50%;left:50%;transform:translate(-50%,-50%);display:flex;align-items:center;gap:14px;min-width:225px;max-width:calc(100% - 36px);padding:13px 20px 13px 13px;border:1px solid #ffffff85;border-radius:4px;background:rgba(4,20,30,.88);box-shadow:0 12px 36px #0009;color:#fff;text-align:left;cursor:pointer;backdrop-filter:blur(8px);transition:background .2s,border-color .2s}
  .inox-hero-video-trigger:hover{background:rgba(8,34,49,.98);border-color:#ff8b3a}
  .inox-hero-video-trigger:focus-visible,.inox-video-dialog button:focus-visible{outline:3px solid #ff9b59;outline-offset:4px}
  .inox-hero-video-icon{flex:none;width:58px;height:58px;display:grid;place-items:center;border-radius:50%;background:var(--orange);color:#081925;font-size:22px;padding-left:3px}
  .inox-hero-video-copy{display:flex;flex-direction:column;gap:5px}
  .inox-hero-video-copy strong{font-size:16px;line-height:1.2;white-space:nowrap}
  .inox-hero-video-copy small{font-size:9px;letter-spacing:.12em;color:#bdced8;white-space:nowrap}
  @media(max-width:470px){.inox-hero-video-trigger{padding:9px 12px 9px 9px;min-width:0;gap:10px}.inox-hero-video-icon{width:46px;height:46px;font-size:18px}.inox-hero-video-copy strong{font-size:13px}.inox-hero-video-copy small{font-size:8px}}
  .inox-video-dialog{position:fixed;inset:0;margin:auto;width:min(1000px,calc(100vw - 32px));max-width:none;max-height:calc(100vh - 32px);padding:0;border:1px solid #385260;background:#071b28;color:#fff;box-shadow:0 30px 100px #000b;overflow:auto}
  .inox-video-dialog::backdrop{background:rgba(0,9,16,.82)}
  .inox-video-bar,.inox-video-controls{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:13px 18px;font-size:11px;letter-spacing:.08em}
  .inox-video-bar button,.inox-video-controls button{background:transparent;color:white;border:1px solid #536e7b;padding:8px 12px;font:inherit;font-size:12px;cursor:pointer}
  .inox-video-bar button span{color:#ff7417;font-size:19px;margin-left:7px}
  .inox-video-dialog video{display:block;width:100%;aspect-ratio:16/9;height:auto;background:#07111e}
  .inox-video-controls{color:#afc3cd}
  @media(max-width:520px){.inox-video-bar strong{font-size:9px;letter-spacing:.02em}.inox-video-bar,.inox-video-controls{padding:10px}.inox-video-controls>span{font-size:9px}}

</style>

<script define:vars={{ geometryForms: forms }}>

  function initGeometryShowcase() {

    const root = document.querySelector('[data-geometry-showcase]');

    if (!root || root.dataset.ready === 'true') return;

    root.dataset.ready = 'true';

    const image = root.querySelector('[data-geometry-image]');

    const feature = root.querySelector('[data-geometry-feature]');

    const name = root.querySelector('[data-geometry-name]');

    const description = root.querySelector('[data-geometry-description]');

    const counter = root.querySelector('[data-geometry-count]');

    const link = root.querySelector('[data-geometry-link]');

    const buttons = [...root.querySelectorAll('[data-geometry-index]')];

    function selectGeometry(button) {

      const index = Number(button.dataset.geometryIndex);

      const form = geometryForms[index];

      if (!form) return;

      if (image.getAttribute('src') !== form.image) {

        image.src = form.image;

        image.alt = form.alt;

      }

      feature.href = form.href;

      name.textContent = form.name;

      description.textContent = form.short;

      counter.textContent = form.number;

      link.href = form.href;

      buttons.forEach((item) => {

        const selected = item === button;

        item.classList.toggle('is-active', selected);

        if (selected) item.setAttribute('aria-current','true'); else item.removeAttribute('aria-current');

      });

    }

    buttons.forEach((button) => {

      // Desktop: samo pređi mišem preko forme, bez klika.

      button.addEventListener('pointerenter', (event) => {

        if (event.pointerType === 'mouse' || event.pointerType === 'pen') {

          selectGeometry(button);

        }

      });

      // Tastatura: fokus daje isti pregled.

      button.addEventListener('focus', () => selectGeometry(button));

      // Klik bilo gde na redu otvara stranicu proizvoda.

    });

  }

  initGeometryShowcase();

  document.addEventListener('astro:page-load', initGeometryShowcase);

</script>

<script>
  function initInoxVideoDialog() {
    const trigger = document.querySelector('[data-open-inox-video]');
    const dialog = document.querySelector('[data-inox-video-dialog]');
    const video = document.querySelector('[data-inox-video]');
    const close = document.querySelector('[data-close-inox-video]');
    const toggle = document.querySelector('[data-toggle-inox-video]');
    if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement) || !(video instanceof HTMLVideoElement) || !(close instanceof HTMLButtonElement) || !(toggle instanceof HTMLButtonElement)) return;
    if (dialog.dataset.ready === 'true') return;
    dialog.dataset.ready = 'true';
    const update = () => { toggle.textContent = video.paused ? 'Pokreni video' : 'Pauziraj video'; };
    trigger.addEventListener('click', () => {
      if (dialog.open) return;
      dialog.showModal();
      video.muted = true;
      video.volume = 0;
      video.play().catch(update);
      update();
    });
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { video.pause(); video.currentTime = 0; update(); });
    toggle.addEventListener('click', () => {
      video.muted = true;
      video.volume = 0;
      if (video.paused) video.play().catch(update);
      else video.pause();
      update();
    });
    video.addEventListener('play', update);
    video.addEventListener('pause', update);
  }
  initInoxVideoDialog();
  document.addEventListener('astro:page-load', initInoxVideoDialog);
</script>
