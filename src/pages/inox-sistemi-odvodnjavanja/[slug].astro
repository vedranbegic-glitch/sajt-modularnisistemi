---
// Jedna ruta pravi svih 5 stranica "Više o proizvodu":
//   /inox-sistemi-odvodnjavanja/<slug>/
// Sadržaj dolazi iz src/data/inoxProducts.ts, izgled iz src/components/InoxProductPage.astro
import InoxProductPage from '../../components/InoxProductPage.astro';
import { inoxProducts } from '../../data/inoxProducts';

export function getStaticPaths() {
  return inoxProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<InoxProductPage product={product} />
