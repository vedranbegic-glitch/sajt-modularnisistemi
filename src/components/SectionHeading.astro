---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'left',
  class: className = '',
} = Astro.props;

const alignmentClass = align === 'center' ? 'text-center mx-auto items-center' : 'text-left items-start';
---

<div class={`flex flex-col max-w-3xl mb-10 lg:mb-14 ${alignmentClass} ${className}`}>
  {eyebrow && (
    <div class="inline-flex items-center gap-2 text-accent font-mono text-xs uppercase tracking-architectural font-bold mb-3">
      <span class="w-2 h-2 bg-accent inline-block flex-shrink-0" aria-hidden="true"></span>
      <span>{eyebrow}</span>
    </div>
  )}

  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight">
    {title}
  </h2>

  {subtitle && (
    <p class="mt-3 text-sm sm:text-base text-slate-muted leading-relaxed">
      {subtitle}
    </p>
  )}
</div>