---
import { CONTACT } from '../data/siteData';
---

<div class="bg-navy-surface border border-white/10 p-6 sm:p-10 shadow-2xl">
  
  <div class="border-b border-white/10 pb-6 mb-8">
    <div class="flex items-center gap-2 text-accent font-mono text-xs uppercase tracking-architectural font-bold mb-2">
      <span class="w-2 h-2 bg-accent inline-block" aria-hidden="true"></span>
      <span>Inženjerski prijem nacrta</span>
    </div>
    <h2 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
      Dostavite parametre i nacrt projekta
    </h2>
    <p class="text-xs sm:text-sm text-slate-muted mt-2 leading-relaxed">
      Učitajte vaše arhitektonske osnove ili specifikacije. Inženjerski tim analizira zahteve i priprema predmer. Za direktno slanje dokumentacije koristite zvanični imejl: 
      <a href={`mailto:${CONTACT.projectEmail}`} class="text-white hover:text-accent font-mono font-semibold underline transition-colors">
        {CONTACT.projectEmail}
      </a>.
    </p>
  </div>

  <form id="project-submission-form" class="space-y-6" onsubmit="event.preventDefault(); window.submitProjectSpecification();">
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Ime i prezime -->
      <div>
        <label for="lead-fullname" class="block text-xs uppercase tracking-architectural font-semibold text-slate-surface mb-2">
          Ime i prezime *
        </label>
        <input
          type="text"
          id="lead-fullname"
          name="fullName"
          required
          class="w-full bg-navy border border-white/15 px-4 py-3 text-xs sm:text-sm text-white focus:border-accent focus:outline-none transition-colors"
          placeholder="npr. Petar Petrović"
        />
      </div>

      <!-- Kompanija -->
      <div>
        <label for="lead-company" class="block text-xs uppercase tracking-architectural font-semibold text-slate-surface mb-2">
          Kompanija / Arhitektonski biro
        </label>
        <input
          type="text"
          id="lead-company"
          name="company"
          class="w-full bg-navy border border-white/15 px-4 py-3 text-xs sm:text-sm text-white focus:border-accent focus:outline-none transition-colors"
          placeholder="npr. Biro Arhitektura d.o.o."
        />
      </div>

      <!-- Email -->
      <div>
        <label for="lead-email" class="block text-xs uppercase tracking-architectural font-semibold text-slate-surface mb-2">
          Email adresa *
        </label>
        <input
          type="email"
          id="lead-email"
          name="email"
          required
          class="w-full bg-navy border border-white/15 px-4 py-3 text-xs sm:text-sm text-white focus:border-accent focus:outline-none transition-colors font-mono"
          placeholder="petar@studio.rs"
        />
      </div>

      <!-- Telefon -->
      <div>
        <label for="lead-phone" class="block text-xs uppercase tracking-architectural font-semibold text-slate-surface mb-2">
          Broj telefona *
        </label>
        <input
          type="tel"
          id="lead-phone"
          name="phone"
          required
          class="w-full bg-navy border border-white/15 px-4 py-3 text-xs sm:text-sm text-white focus:border-accent focus:outline-none transition-colors font-mono"
          placeholder="+381 66..."
        />
      </div>

      <!-- Tip projekta -->
      <div>
        <label for="lead-project-type" class="block text-xs uppercase tracking-architectural font-semibold text-slate-surface mb-2">
          Tip objekta / projekta *
        </label>
        <select
          id="lead-project-type"
          name="projectType"
          required
          class="w-full bg-navy border border-white/15 px-4 py-3 text-xs sm:text-sm text-white focus:border-accent focus:outline-none transition-colors"
        >
          <option value="" disabled selected>Izaberite tip objekta</option>
          <option value="bazen-wellness">Bazeni i wellness zone</option>
          <option value="stambeni">Stambeni objekti / terase / lođe</option>
          <option value="poslovni">Poslovni i komercijalni objekti</option>
          <option value="javni-prostor">Javni platoi / trgovi / parkovi</option>
          <option value="industrija">Industrijski pogoni i servisi</option>
          <option value="ostalo">Ostale namene</option>
        </select>
      </div>

      <!-- Proizvod / sistem -->
      <div>
        <label for="lead-system" class="block text-xs uppercase tracking-architectural font-semibold text-slate-surface mb-2">
          Proizvod / Sistem *
        </label>
        <select
          id="lead-system"
          name="system"
          required
          class="w-full bg-navy border border-white/15 px-4 py-3 text-xs sm:text-sm text-white focus:border-accent focus:outline-none transition-colors"
        >
          <option value="" disabled selected>Izaberite traženi sistem</option>
          <option value="inox-odvodnjavanje">Inox sistemi odvodnjavanja</option>
          <option value="moderna-rasveta">Moderna rasveta</option>
          <option value="modularni-podni-sistemi">Modularni podni sistemi</option>
          <option value="kombinovano">Više sistema u kombinaciji</option>
        </select>
      </div>

    </div>

    <!-- Poruka / Tehnički zahtevi -->
    <div>
      <label for="lead-message" class="block text-xs uppercase tracking-architectural font-semibold text-slate-surface mb-2">
        Tehnički opis zadatka i zahtevi geometrije *
      </label>
      <textarea
        id="lead-message"
        name="message"
        rows="4"
        required
        class="w-full bg-navy border border-white/15 px-4 py-3 text-xs sm:text-sm text-white focus:border-accent focus:outline-none transition-colors"
        placeholder="Unesite dimenzije, dužine kanala, zadate radijuse, visinska ograničenja ili specifične uslove ugradnje..."
      ></textarea>
    </div>

    <!-- File Upload Section -->
    <div class="border border-dashed border-white/20 p-6 bg-navy/60 text-center">
      <div class="mx-auto w-10 h-10 mb-3 text-accent flex items-center justify-center border border-accent/40 font-mono text-xs font-bold">
        CAD
      </div>
      <label for="lead-attachment" class="block text-xs font-semibold text-white uppercase tracking-architectural cursor-pointer hover:text-accent transition-colors">
        Izaberite projektnu datoteku (PDF, DWG, DXF, JPG, PNG, ZIP)
      </label>
      <input
        type="file"
        id="lead-attachment"
        name="projectAttachment"
        accept=".pdf,.dwg,.dxf,.zip,.rar,.jpg,.jpeg,.png"
        class="mt-3 text-xs text-slate-muted file:mr-4 file:py-2 file:px-4 file:border-0 file:text-xs file:font-semibold file:bg-navy-dark file:text-accent hover:file:bg-white/10"
      />
      <p class="text-[11px] text-slate-muted mt-2 font-mono">
        Maksimalna veličina: 25MB. Za veće fajlove možete navesti link ka preuzimanju u polju za poruku ili poslati na <span class="text-white font-semibold">projekti@modularnisistemi.com</span>.
      </p>
    </div>

    <!-- Status Feedback -->
    <div id="project-form-feedback" class="hidden p-4 border text-xs font-mono"></div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-white/10">
      <span class="text-xs text-slate-muted">
        * Nacrti i prilozi se koriste isključivo za potrebe izrade ponude i predmera.
      </span>
      <button
        type="submit"
        class="w-full sm:w-auto px-8 py-4 bg-accent hover:bg-accent-hover text-white text-xs uppercase tracking-architectural font-bold transition-all border border-accent shadow-lg"
      >
        Pošaljite nacrt na analizu
      </button>
    </div>

  </form>

</div>

<script is:inline>
  window.submitProjectSpecification = function () {
    const feedback = document.getElementById('project-form-feedback');
    const name = document.getElementById('lead-fullname').value;
    const email = document.getElementById('lead-email').value;

    if (feedback) {
      feedback.classList.remove('hidden');
      feedback.classList.add('bg-navy', 'border-accent', 'text-slate-surface');
      feedback.innerHTML = `
        <div class="space-y-2">
          <p class="text-accent font-bold uppercase tracking-wider">Nacrt je pripremljen za slanje: ${name}</p>
          <p class="text-xs">
            Formular je uspešno proveren na klijentu. Za automatsko procesiranje prijava bez sopstvenog backend servera, dodajte atribut <code>data-netlify="true"</code> u &lt;form&gt; element pri postavljanju na Netlify platformu.
          </p>
          <p class="text-xs text-slate-muted">
            Direktna dostava fajlova inženjerskom timu: <a href="mailto:projekti@modularnisistemi.com" class="text-white underline">projekti@modularnisistemi.com</a> (Tel: <a href="tel:+38166241386" class="text-white underline">+381 66 241 386</a>).
          </p>
        </div>
      `;
    }
  };
</script>