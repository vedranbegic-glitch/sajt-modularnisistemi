---
---

<div
  id="lightbox-dialog"
  class="fixed inset-0 z-50 bg-navy-dark/95 backdrop-blur-md hidden items-center justify-center p-4 sm:p-6 lg:p-10"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lightbox-title-text"
  aria-hidden="true"
>
  <div class="relative w-full max-w-5xl bg-navy border border-white/15 p-4 sm:p-6 shadow-2xl flex flex-col max-h-[92vh]">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/10">
      <div>
        <span id="lightbox-category-badge" class="text-accent font-mono text-[10px] uppercase tracking-architectural font-bold block mb-1">
          KATEGORIJA
        </span>
        <h3 id="lightbox-title-text" class="text-sm sm:text-base font-bold text-white tracking-tight">
          Naslov stavke
        </h3>
      </div>
      
      <button
        type="button"
        id="lightbox-close-btn"
        class="p-2 text-slate-muted hover:text-white hover:bg-white/10 border border-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-accent"
        aria-label="Zatvori prozor"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Image Area -->
    <div class="relative flex-grow flex items-center justify-center bg-navy-dark border border-white/10 overflow-hidden min-h-[280px]">
      <img
        id="lightbox-image-target"
        src=""
        alt=""
        class="max-h-[65vh] w-auto max-w-full object-contain select-none"
      />
      <div id="lightbox-fallback-box" class="hidden absolute inset-0 bg-navy-surface p-6 flex flex-col justify-between" aria-hidden="true">
        <span class="text-accent font-mono text-[10px] tracking-architectural uppercase">MS · DETALJ PRIKAZA</span>
        <p id="lightbox-fallback-text" class="text-xs font-mono text-white"></p>
        <span class="text-[9px] font-mono text-slate-muted">MODULARNI SISTEMI ARHIVA</span>
      </div>
    </div>

    <!-- Modal Footer Caption -->
    <div class="pt-4 mt-2 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-t border-white/10">
      <p id="lightbox-desc-text" class="text-xs text-slate-muted leading-relaxed max-w-3xl">
        Opis elementa
      </p>
      <span class="text-[10px] font-mono text-slate-surface/60 uppercase tracking-architectural self-end sm:self-auto">
        ESC za zatvaranje
      </span>
    </div>

  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('lightbox-dialog');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const imgTarget = document.getElementById('lightbox-image-target');
    const titleTarget = document.getElementById('lightbox-title-text');
    const descTarget = document.getElementById('lightbox-desc-text');
    const categoryTarget = document.getElementById('lightbox-category-badge');
    const fallbackBox = document.getElementById('lightbox-fallback-box');
    const fallbackText = document.getElementById('lightbox-fallback-text');

    function openModal(data) {
      if (!dialog || !imgTarget) return;

      imgTarget.src = data.src || '';
      imgTarget.alt = data.title || '';
      if (titleTarget) titleTarget.textContent = data.title || 'Vizuelni prikaz';
      if (descTarget) descTarget.textContent = data.desc || '';
      if (categoryTarget) categoryTarget.textContent = data.category ? data.category.toUpperCase() : 'SISTEM';

      if (fallbackBox && fallbackText) {
        fallbackBox.classList.add('hidden');
        fallbackText.textContent = data.title || '';
      }

      imgTarget.onerror = () => {
        imgTarget.style.display = 'none';
        if (fallbackBox) fallbackBox.classList.remove('hidden');
      };
      imgTarget.onload = () => {
        imgTarget.style.display = 'block';
        if (fallbackBox) fallbackBox.classList.add('hidden');
      };

      dialog.classList.remove('hidden');
      dialog.classList.add('flex');
      dialog.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeModal() {
      if (!dialog) return;
      dialog.classList.add('hidden');
      dialog.classList.remove('flex');
      dialog.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (imgTarget) imgTarget.src = '';
    }

    window.openModularLightbox = openModal;

    closeBtn?.addEventListener('click', closeModal);

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) {
        closeModal();
      }
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dialog && !dialog.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>