---
// Modularni Sistemi — Premium Engineering Header
const pathname = Astro.url.pathname;

const productItems = [
  { label: 'Inox Sistemi Odvodnjavanja', href: '/inox-sistemi-odvodnjavanja/', desc: 'Pet geometrija, dimenzije na zahtev' },
  { label: 'Modularne čelične podkonstrukcije', href: '/modularne-celicne-podkonstrukcije/', desc: 'Podesti, platforme i tehnički prostori' },
  { label: 'Fire Pit Grill', href: '/fire-pit-grill/', desc: 'Čelična vatrišta i roštilji' },
];
const navItems = [
  { label: 'Galerija', href: '/galerija/' },
  { label: 'O nama', href: '/o-nama/' },
  { label: 'Partneri', href: '/partneri/' },
  { label: 'Kontakt', href: '/kontakt/' },
];
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const productsActive = ['/proizvodi', ...productItems.map(item => item.href)].some(href => pathname.startsWith(href));
const engineeringHref = '/projektovanje-i-3d-modelovanje/';
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <a class="logo" href="/" aria-label="Modularni Sistemi — početna">
      <img src="/images/brand/logo.svg" alt="Modularni Sistemi" width="160" height="48" />
    </a>

    <nav class="nav-desktop" aria-label="Glavna navigacija">
      <a class:list={['nav-link', { 'is-active': isActive('/') }]} href="/" aria-current={isActive('/') ? 'page' : undefined}>Početna</a>
      <div class="nav-dropdown">
        <a class:list={['nav-link', 'nav-link--dropdown', { 'is-active': productsActive }]} href="/proizvodi/" aria-haspopup="true" aria-expanded="false" data-products-trigger>
          Proizvodi
          <svg aria-hidden="true" viewBox="0 0 10 6" width="10" height="6"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
        </a>
        <div class="dropdown-menu" data-products-menu>
          <div class="dropdown-heading">Proizvodni programi</div>
          {productItems.map(item => (
            <a class:list={['dropdown-item', { 'is-active': isActive(item.href) }]} href={item.href}>
              <span class="dropdown-title">{item.label}</span>
              <span class="dropdown-desc">{item.desc}</span>
            </a>
          ))}
          <a class="dropdown-all" href="/proizvodi/">Pregled svih proizvoda (Katalog) <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <a class:list={['nav-link', { 'is-active': isActive(engineeringHref) }]} href={engineeringHref} aria-current={isActive(engineeringHref) ? 'page' : undefined}>Projektovanje i 3D modelovanje</a>
      {navItems.map(item => <a class:list={['nav-link', { 'is-active': isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>

    <a class="header-cta" href="/posaljite-upit/">Pošaljite upit <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-label="Otvori meni" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobilna navigacija" hidden>
    <a class:list={['mobile-link', { 'is-active': isActive('/') }]} href="/">Početna</a>
    <div class="mobile-products">
      <a class:list={['mobile-group-title', { 'is-active': productsActive }]} href="/proizvodi/">Proizvodi — pregled</a>
      {productItems.map(item => <a class:list={['mobile-sublink', { 'is-active': isActive(item.href) }]} href={item.href}>{item.label}</a>)}
    </div>
    <a class:list={['mobile-link', { 'is-active': isActive(engineeringHref) }]} href={engineeringHref}>Projektovanje i 3D modelovanje</a>
    {navItems.map(item => <a class:list={['mobile-link', { 'is-active': isActive(item.href) }]} href={item.href}>{item.label}</a>)}
    <a class="mobile-cta" href="/posaljite-upit/">Pošaljite upit <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: rgba(7,17,30,.96); border-bottom: 1px solid rgba(255,255,255,.09); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .header-inner { max-width: 1440px; height: 76px; padding: 0 30px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 22px; }
  .logo { display: inline-flex; flex: 0 0 auto; align-items: center; }
  .logo img { display: block; width: auto; height: 39px; object-fit: contain; }
  .nav-desktop { display: flex; gap: clamp(13px, 1.65vw, 30px); align-items: center; justify-content: center; min-width: 0; }
  .nav-link { position: relative; display: inline-flex; gap: 6px; align-items: center; padding: 15px 1px; color: #98a8b9; font-size: 10px; font-weight: 750; letter-spacing: .065em; text-transform: uppercase; text-decoration: none; white-space: nowrap; transition: color .2s; }
  .nav-link:hover, .nav-link:focus-visible { color: #fff; }
  .nav-link.is-active { color: #ff6900; }
  .nav-link.is-active::after { content: ''; position: absolute; bottom: 3px; left: 0; right: 0; height: 2px; background: #ff6900; }
  .nav-dropdown { position: relative; display: flex; align-items: center; align-self: stretch; }
  .nav-link--dropdown svg { transition: transform .2s; }
  .nav-dropdown:hover svg, .nav-dropdown:focus-within svg, .nav-dropdown.is-open svg { transform: rotate(180deg); }
  .dropdown-menu { position: absolute; top: calc(100% - 1px); left: 50%; width: 322px; padding: 12px; background: #071724; border: 1px solid rgba(255,255,255,.12); box-shadow: 0 22px 48px rgba(0,0,0,.45); transform: translate(-50%, 9px); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .18s, transform .18s, visibility .18s; }
  .nav-dropdown:hover .dropdown-menu, .nav-dropdown:focus-within .dropdown-menu, .nav-dropdown.is-open .dropdown-menu { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(-50%, 0); }
  .dropdown-heading { margin: 0 5px 7px; padding: 8px 6px 12px; color: #7d90a4; border-bottom: 1px solid rgba(255,255,255,.1); font-size: 10px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .dropdown-item { display: flex; flex-direction: column; gap: 3px; padding: 11px; text-decoration: none; transition: background .18s; }
  .dropdown-item:hover, .dropdown-item:focus-visible { background: rgba(255,255,255,.06); }
  .dropdown-title { color: #fff; font-size: 12px; font-weight: 700; line-height: 1.35; }
  .dropdown-item.is-active .dropdown-title { color: #ff6900; }
  .dropdown-desc { color: #8295a8; font-size: 11px; line-height: 1.45; }
  .dropdown-all { display: flex; justify-content: space-between; gap: 8px; margin: 7px 4px 0; padding: 13px 7px 5px; border-top: 1px solid rgba(255,255,255,.1); color: #ff6900; text-decoration: none; font-size: 11px; font-weight: 750; }
  .header-cta { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 12px; justify-content: center; min-height: 37px; padding: 0 17px; background: #ff6900; color: #fff; font-size: 10px; font-weight: 800; letter-spacing: .045em; text-transform: uppercase; text-decoration: none; transition: background .2s; }
  .header-cta:hover { background: #ea6000; }
  .menu-toggle { display: none; flex: 0 0 auto; width: 40px; height: 40px; align-items: center; justify-content: center; flex-direction: column; gap: 5px; padding: 6px; background: transparent; border: 0; cursor: pointer; }
  .menu-toggle span { width: 23px; height: 2px; background: #fff; transition: transform .2s, opacity .2s; }
  .menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-7px) rotate(-45deg); }
  .mobile-menu { display: none; padding: 12px 24px 24px; background: #071724; border-top: 1px solid rgba(255,255,255,.08); max-height: calc(100dvh - 76px); overflow-y: auto; }
  .mobile-menu[hidden] { display: none !important; }
  .mobile-link, .mobile-group-title { display: block; padding: 14px 2px; border-bottom: 1px solid rgba(255,255,255,.08); color: #9fafbe; font-size: 12px; font-weight: 750; letter-spacing: .05em; text-decoration: none; text-transform: uppercase; }
  .mobile-link.is-active, .mobile-group-title.is-active, .mobile-link:hover, .mobile-group-title:hover { color: #ff6900; }
  .mobile-products { padding-bottom: 9px; border-bottom: 1px solid rgba(255,255,255,.08); }
  .mobile-group-title { border-bottom: 0; color: #fff; }
  .mobile-sublink { display: block; margin-left: 9px; padding: 9px 14px; border-left: 2px solid rgba(255,105,0,.45); color: #9bafc0; font-size: 12px; text-decoration: none; }
  .mobile-sublink.is-active, .mobile-sublink:hover { color: #ff6900; }
  .mobile-cta { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; padding: 15px 17px; background: #ff6900; color: #fff; font-size: 12px; font-weight: 800; text-decoration: none; text-transform: uppercase; }
  @media (max-width: 1199px) { .nav-desktop { display: none; } .menu-toggle { display: flex; } .mobile-menu:not([hidden]) { display: block; } .header-inner { padding: 0 24px; } }
  @media (max-width: 640px) { .header-inner { height: 70px; padding: 0 16px; gap: 12px; } .logo img { height: 34px; } .header-cta { display: none; } .mobile-menu { max-height: calc(100dvh - 70px); padding-inline: 18px; } }
  @media (prefers-reduced-motion: reduce) { .site-header *, .site-header *::before, .site-header *::after { transition: none !important; } }
</style>

<script>
  function initHeader() {
    const root = document.getElementById('site-header');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const toggle = root.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const mobile = root.querySelector<HTMLElement>('#mobile-menu');
    const dropdown = root.querySelector<HTMLElement>('.nav-dropdown');
    const productTrigger = root.querySelector<HTMLAnchorElement>('[data-products-trigger]');
    const setMobile = (open: boolean) => {
      if (!toggle || !mobile) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Zatvori meni' : 'Otvori meni');
      mobile.hidden = !open;
    };
    const setProducts = (open: boolean) => {
      dropdown?.classList.toggle('is-open', open);
      productTrigger?.setAttribute('aria-expanded', String(open));
    };
    toggle?.addEventListener('click', () => setMobile(toggle.getAttribute('aria-expanded') !== 'true'));
    mobile?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMobile(false)));
    productTrigger?.addEventListener('click', event => {
      // Na uređajima sa touch unosom prvo otvori submenu; drugi klik vodi u katalog.
      if (window.matchMedia('(hover: none)').matches && !dropdown?.classList.contains('is-open')) {
        event.preventDefault(); setProducts(true);
      }
    });
    document.addEventListener('click', event => { if (!root.contains(event.target as Node)) { setMobile(false); setProducts(false); } });
    document.addEventListener('keydown', event => { if (event.key === 'Escape') { setMobile(false); setProducts(false); toggle?.focus(); } });
    window.addEventListener('resize', () => { if (window.innerWidth >= 1200) setMobile(false); });
  }
  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
