---
const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Početna', href: '/' },
  { label: 'Proizvodi', href: '/proizvodi/' },
  { label: 'Inox Odvodnjavanje', href: '/inox-sistemi-odvodnjavanja/' },
  { label: 'Moderna Rasveta', href: '/moderna-rasveta/' },
  { label: 'Podni Sistemi', href: '/modularni-podni-sistemi/' },
  { label: 'Galerija', href: '/galerija/' },
  { label: 'O nama', href: '/o-nama/' },
  { label: 'Partneri', href: '/partneri/' },
  { label: 'Kontakt', href: '/kontakt/' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="header-inner">
    <!-- LOGO -->
    <a href="/" class="logo" aria-label="Modularni Sistemi – Početna">
      <img
        src="/images/brand/logo.png"
        alt="Modularni Sistemi"
        width="160"
        height="48"
        class="logo__img"
      />
    </a>

    <!-- DESKTOP NAV -->
    <nav class="nav-desktop" aria-label="Glavna navigacija">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'is-active': isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <div class="header-cta">
      <a href="/posaljite-projekat/" class="btn-cta">
        Pošaljite nam projekat
      </a>
    </div>

    <!-- MOBILE TOGGLE -->
    <button
      class="menu-toggle"
      type="button"
      aria-label="Otvori meni"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="menu-toggle"
    >
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
    </button>
  </div>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="nav-mobile" aria-label="Mobilna navigacija">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav-mobile__link', { 'is-active': isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
      <a href="/posaljite-projekat/" class="btn-cta btn-cta--mobile">
        Pošaljite nam projekat
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(7, 17, 30, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-inner {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 24px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* LOGO */
  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo__img {
    height: 42px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  /* DESKTOP NAV */
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 2px;
  }

  .nav-link {
    position: relative;
    padding: 8px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #fff;
  }

  .nav-link.is-active {
    color: #ff6900;
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 0;
    height: 2px;
    background: #ff6900;
  }

  /* CTA */
  .header-cta {
    display: none;
    flex-shrink: 0;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 20px;
    background: #ff6900;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .btn-cta:hover {
    background: #e85e00;
    transform: translateY(-1px);
  }

  .btn-cta--mobile {
    margin-top: 20px;
    width: 100%;
    padding: 14px 20px;
  }

  /* MOBILE TOGGLE */
  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .menu-toggle__bar {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* MOBILE MENU */
  .mobile-menu {
    background: #06131f;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 12px 24px 28px;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .nav-mobile {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-mobile__link {
    display: block;
    padding: 14px 4px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #94a3b8;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: color 0.2s ease;
  }

  .nav-mobile__link:hover,
  .nav-mobile__link.is-active {
    color: #ff6900;
  }

  /* BREAKPOINTS */
  @media (min-width: 1280px) {
    .nav-desktop {
      display: flex;
    }

    .header-cta {
      display: block;
    }

    .menu-toggle {
      display: none;
    }

    .mobile-menu {
      display: none !important;
    }
  }

  @media (min-width: 768px) and (max-width: 1279px) {
    .header-cta {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      height: 72px;
      padding-inline: 16px;
    }

    .logo__img {
      height: 36px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu.hidden = isOpen;
    });

    // Close on link click
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
      });
    });
  }
</script>