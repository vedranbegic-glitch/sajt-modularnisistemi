---
const pathname = Astro.url.pathname;

// 4 glavna programa unutar padajućeg menija (bez brojeva)
const productItems = [
  {
    label: 'Inox Sistemi Odvodnjavanja',
    href: '/inox-sistemi-odvodnjavanja/',
    desc: 'Ravne, lučne, kružne i S-forme'
  },
  {
    label: 'Moderna Rasveta',
    href: '/moderna-rasveta/',
    desc: 'Z-lampa i bandera (3m, 4m, 5m)'
  },
  {
    label: 'Modularni Podni Sistemi',
    href: '/modularni-podni-sistemi/',
    desc: 'Monoblok paneli i suva montaža'
  },
  {
    label: 'Fire Pit Grill',
    href: '/fire-pit-grill/',
    desc: 'Čelična vatrišta i roštilji'
  },
];

// Glavne stavke hedera
const mainNavItems = [
  { label: 'Početna', href: '/' },
  { label: 'Galerija', href: '/galerija/' },
  { label: 'O nama', href: '/o-nama/' },
  { label: 'Partneri', href: '/partneri/' },
  { label: 'Kontakt', href: '/kontakt/' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

function isProductsActive() {
  return (
    pathname.startsWith('/proizvodi') ||
    pathname.startsWith('/inox-sistemi-odvodnjavanja') ||
    pathname.startsWith('/moderna-rasveta') ||
    pathname.startsWith('/modularni-podni-sistemi') ||
    pathname.startsWith('/fire-pit-grill')
  );
}
---

<header class="site-header">
  <div class="header-inner">
    <!-- LOGO -->
    <a href="/" class="logo" aria-label="Modularni Sistemi – Početna">
      <img
        src="/images/brand/logo.png"
        alt="Modularni Sistemi"
        width="160"
        height="48"
        class="logo__img"
      />
    </a>

    <!-- DESKTOP NAV -->
    <nav class="nav-desktop" aria-label="Glavna navigacija">
      <!-- Početna -->
      <a
        href="/"
        class:list={['nav-link', { 'is-active': isActive('/') }]}
      >
        Početna
      </a>

      <!-- PADAJUĆI MENI ZA PROIZVODE -->
      <div class="nav-dropdown">
        <a
          href="/proizvodi/"
          class:list={['nav-link', 'nav-link--dropdown', { 'is-active': isProductsActive() }]}
          aria-haspopup="true"
        >
          Proizvodi
          <svg class="dropdown-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <!-- PROIZVODI SUB-MENI -->
        <div class="dropdown-menu">
          <div class="dropdown-menu__inner">
            <div class="dropdown-menu__header">
              <span>Proizvodni Program</span>
            </div>
            
            <div class="dropdown-menu__list">
              {productItems.map((prod) => (
                <a
                  href={prod.href}
                  class:list={['dropdown-item', { 'is-active': isActive(prod.href) }]}
                >
                  <div class="dropdown-item__text">
                    <span class="dropdown-item__title">{prod.label}</span>
                    <span class="dropdown-item__desc">{prod.desc}</span>
                  </div>
                </a>
              ))}
            </div>

            <div class="dropdown-menu__footer">
              <a href="/proizvodi/" class="dropdown-all-link">
                Pregled svih proizvoda (Katalog) &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- OSTALE STAVKE SA SIMETRIČNIM RAZMAKOM -->
      {mainNavItems.slice(1).map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'is-active': isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <div class="header-cta">
      <a href="/posaljite-projekat/" class="btn-cta">
        Pošaljite upit
      </a>
    </div>

    <!-- MOBILE TOGGLE -->
    <button
      class="menu-toggle"
      type="button"
      aria-label="Otvori meni"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="menu-toggle"
    >
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
    </button>
  </div>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="nav-mobile" aria-label="Mobilna navigacija">
      <a
        href="/"
        class:list={['nav-mobile__link', { 'is-active': isActive('/') }]}
      >
        Početna
      </a>

      <!-- Mobilna sekcija za proizvode -->
      <div class="nav-mobile__group">
        <div class="nav-mobile__group-title">
          <a href="/proizvodi/" class:list={[{ 'is-active': isProductsActive() }]}>
            Proizvodi (Pregled)
          </a>
        </div>
        <div class="nav-mobile__sublist">
          {productItems.map((prod) => (
            <a
              href={prod.href}
              class:list={['nav-mobile__sublink', { 'is-active': isActive(prod.href) }]}
            >
              <span>{prod.label}</span>
            </a>
          ))}
        </div>
      </div>

      {mainNavItems.slice(1).map((item) => (
        <a
          href={item.href}
          class:list={['nav-mobile__link', { 'is-active': isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}

      <a href="/posaljite-projekat/" class="btn-cta btn-cta--mobile">
        Pošaljite nam projekat
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(7, 17, 30, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-inner {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 32px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  /* LOGO */
  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo__img {
    height: 42px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  /* DESKTOP NAV SA SIMETRIČNIM ŠIROKIM RAZMAKOM */
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 32px; /* Prostran, ujednačen razmak između stavki */
  }

  .nav-link {
    position: relative;
    padding: 10px 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .nav-link:hover {
    color: #fff;
  }

  .nav-link.is-active {
    color: #ff6900;
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: #ff6900;
  }

  /* PADAJUĆI MENI (DROPDOWN) */
  .nav-dropdown {
    position: relative;
    display: flex;
    align-items: center;
    height: 80px;
  }

  .dropdown-icon {
    transition: transform 0.25s ease;
  }

  .nav-dropdown:hover .dropdown-icon {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 74px;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    width: 300px;
    background: #06131f;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6);
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .nav-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .dropdown-menu__inner {
    padding: 12px;
  }

  .dropdown-menu__header {
    padding: 8px 12px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #64748b;
  }

  .dropdown-menu__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 8px;
  }

  .dropdown-item {
    display: block;
    padding: 10px 12px;
    text-decoration: none;
    border-radius: 3px;
    transition: background 0.2s ease;
  }

  .dropdown-item:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .dropdown-item.is-active .dropdown-item__title {
    color: #ff6900;
  }

  .dropdown-item__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .dropdown-item__title {
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
  }

  .dropdown-item__desc {
    font-size: 11px;
    color: #8191a2;
    line-height: 1.3;
  }

  .dropdown-menu__footer {
    margin-top: 8px;
    padding: 10px 12px 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dropdown-all-link {
    font-size: 11px;
    font-weight: 700;
    color: #ff6900;
    text-decoration: none;
    transition: opacity 0.2s ease;
    display: block;
  }

  .dropdown-all-link:hover {
    opacity: 0.85;
  }

  /* CTA DUGME */
  .header-cta {
    display: none;
    flex-shrink: 0;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 22px;
    background: #ff6900;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .btn-cta:hover {
    background: #e85e00;
    transform: translateY(-1px);
  }

  .btn-cta--mobile {
    margin-top: 20px;
    width: 100%;
    padding: 14px 20px;
  }

  /* MOBILE TOGGLE */
  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .menu-toggle__bar {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* MOBILE MENU */
  .mobile-menu {
    background: #06131f;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 12px 24px 28px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .nav-mobile {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-mobile__link {
    display: block;
    padding: 14px 4px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #94a3b8;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: color 0.2s ease;
  }

  .nav-mobile__link:hover,
  .nav-mobile__link.is-active {
    color: #ff6900;
  }

  .nav-mobile__group {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 12px;
  }

  .nav-mobile__group-title {
    padding: 14px 4px 8px;
  }

  .nav-mobile__group-title a {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
  }

  .nav-mobile__group-title a.is-active {
    color: #ff6900;
  }

  .nav-mobile__sublist {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 12px;
    border-left: 2px solid rgba(255, 105, 0, 0.4);
    margin-top: 6px;
  }

  .nav-mobile__sublink {
    display: block;
    padding: 6px 4px;
    font-size: 12px;
    font-weight: 600;
    color: #8da0b3;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-mobile__sublink:hover,
  .nav-mobile__sublink.is-active {
    color: #ff6900;
  }

  /* BREAKPOINTS */
  @media (min-width: 1200px) {
    .header-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 32px;
    }

    .logo {
      justify-self: start;
    }

    .nav-desktop {
      display: flex;
      justify-self: center;
    }

    .header-cta {
      display: block;
      justify-self: end;
    }

    .menu-toggle {
      display: none;
    }

    .mobile-menu {
      display: none !important;
    }
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .header-cta {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      height: 72px;
      padding-inline: 16px;
    }

    .logo__img {
      height: 36px;
    }

    .dropdown-menu {
      top: 68px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu.hidden = isOpen;
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
      });
    });
  }
</script>