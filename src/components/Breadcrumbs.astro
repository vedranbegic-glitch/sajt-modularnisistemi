---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const breadcrumbsList = [
  { label: 'Početna', href: '/' },
  ...items,
];

const schemaItems = breadcrumbsList.map((item, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: item.label,
  ...(item.href ? { item: new URL(item.href, 'https://modularnisistemi.com').href } : {}),
}));

const schemaJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: schemaItems,
};
---

<nav aria-label="Navigaciona putanja" class="w-full border-b border-white/10 bg-navy-dark/60 py-3">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <ol class="flex items-center flex-wrap gap-2 text-[11px] font-mono uppercase tracking-architectural">
      {breadcrumbsList.map((item, index) => {
        const isLast = index === breadcrumbsList.length - 1;
        return (
          <li class="flex items-center gap-2">
            {index > 0 && (
              <span class="text-white/30 select-none" aria-hidden="true">/</span>
            )}
            {item.href && !isLast ? (
              <a
                href={item.href}
                class="text-slate-muted hover:text-accent transition-colors duration-150"
              >
                {item.label}
              </a>
            ) : (
              <span class="text-white font-bold" aria-current="page">
                {item.label}
              </span>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />