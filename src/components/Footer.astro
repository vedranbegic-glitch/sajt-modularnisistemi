---
const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: 'Početna', href: '/' },
  { label: 'Proizvodi', href: '/proizvodi/' },
  { label: 'Galerija', href: '/galerija/' },
  { label: 'O nama', href: '/o-nama/' },
  { label: 'Partneri', href: '/partneri/' },
  { label: 'Kontakt', href: '/kontakt/' },
];

const legalLinks = [
  { label: 'Uslovi korišćenja', href: '/uslovi-koriscenja/' },
  { label: 'Privatnost', href: '/privatnost/' },
  { label: 'Impressum', href: '/impressum/' },
];

// Dodati tek kada imamo potvrđene URL adrese zvaničnih profila.
// Ne postavljati generičke facebook.com / instagram.com / youtube.com linkove.
const socialLinks: { label: string; href: string; icon: 'facebook' | 'instagram' | 'youtube' }[] = [];
---

<footer class="site-footer" aria-label="Podnožje sajta">
  <div class="footer-inner">
    <div class="footer-main">
      <a class="footer-brand" href="/" aria-label="Modularni Sistemi — početna">
        <img
          src="/images/brand/logo.svg"
          alt="Modularni Sistemi"
          width="160"
          height="48"
          loading="lazy"
          decoding="async"
        />
      </a>

      <nav class="footer-nav" aria-label="Navigacija u podnožju">
        {footerLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>

      <div class="footer-contacts" aria-label="Kontakt informacije">
        <a class="footer-contact" href="mailto:kontakt@modularnisistemi.com">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="2.5" y="5" width="19" height="14" rx="2" />
            <path d="m3.5 7 8.5 6 8.5-6" />
          </svg>
          <span>kontakt@modularnisistemi.com</span>
        </a>
        <a class="footer-contact" href="tel:+38166241386">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 16.4v3a2 2 0 0 1-2.2 2 18.8 18.8 0 0 1-8.2-2.9 18.3 18.3 0 0 1-5.7-5.7A18.8 18.8 0 0 1 2 4.5 2 2 0 0 1 4 2.3h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8L7.2 10a15 15 0 0 0 6.8 6.8l1.2-1.7a2 2 0 0 1 1.8-.6l3 .5a2 2 0 0 1 1.7 2Z" />
          </svg>
          <span>+381 (0) 66 241 386</span>
        </a>
      </div>

      {socialLinks.length > 0 && (
        <div class="footer-socials" aria-label="Društvene mreže">
          {socialLinks.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}>
              {social.icon === 'facebook' && <span aria-hidden="true">f</span>}
              {social.icon === 'instagram' && <span aria-hidden="true">◎</span>}
              {social.icon === 'youtube' && <span aria-hidden="true">▶</span>}
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} Modularni Sistemi. Sva prava zadržana.</p>
      <nav class="footer-legal" aria-label="Pravne informacije">
        {legalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-orange: #ff6900;
    --footer-muted: #a1b0bf;
    color: var(--footer-muted);
    background: #050f1a;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    font-family: Manrope, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  .site-footer * { box-sizing: border-box; }

  .footer-inner {
    width: min(100% - 64px, 1376px);
    margin-inline: auto;
  }

  .footer-main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 2.8vw, 52px);
    padding-block: 31px 28px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    width: max-content;
  }

  .footer-brand img {
    display: block;
    width: auto;
    height: 38px;
    max-width: 185px;
    object-fit: contain;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .footer-nav a,
  .footer-legal a {
    color: var(--footer-muted);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .footer-nav a {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.7;
    white-space: nowrap;
  }

  .footer-contacts {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px 22px;
    flex-wrap: wrap;
  }

  .footer-contact {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    color: #c2ced7;
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .footer-contact svg {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
    color: var(--footer-orange);
  }

  .footer-socials {
    display: flex;
    gap: 10px;
  }

  .footer-socials a {
    display: grid;
    place-items: center;
    min-width: 36px;
    min-height: 36px;
    color: #ccd6dd;
    text-decoration: none;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    padding-block: 17px 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-bottom p {
    margin: 0;
    color: #8193a4;
    font-size: 10px;
    line-height: 1.6;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
  }

  .footer-legal a {
    font-size: 10px;
    line-height: 1.6;
  }

  .site-footer a:focus-visible {
    outline: 2px solid var(--footer-orange);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .site-footer a:hover { color: #fff; }
  }

  @media (max-width: 1240px) {
    .footer-main {
      grid-template-columns: 1fr auto;
      gap: 16px 28px;
    }
    .footer-nav {
      justify-content: flex-start;
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .footer-contacts { grid-column: 2; grid-row: 1; }
  }

  @media (max-width: 760px) {
    .footer-inner { width: min(100% - 40px, 560px); }
    .footer-main {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 22px;
      padding-block: 32px 26px;
    }
    .footer-brand img { height: 36px; }
    .footer-nav {
      grid-row: auto;
      grid-column: 1;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      gap: 4px 20px;
      justify-items: start;
    }
    .footer-nav a { padding-block: 9px; font-size: 12px; }
    .footer-contacts {
      grid-column: 1;
      grid-row: auto;
      align-items: flex-start;
      justify-content: flex-start;
      flex-direction: column;
      gap: 4px;
      width: 100%;
      padding-top: 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
    .footer-contact {
      min-height: 42px;
      font-size: 12px;
      white-space: normal;
      overflow-wrap: anywhere;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer a { transition: none; }
  }
</style>
