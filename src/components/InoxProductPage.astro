---

import BaseLayout from '../layouts/BaseLayout.astro';

import {

  inoxProducts,

  commonFacts,

  PHONE_DISPLAY,

  PHONE_HREF,

  PROJECT_URL,

} from '../data/inoxProducts';

import type { InoxProduct } from '../data/inoxProducts';

interface Props {

  product: InoxProduct;

}

const { product } = Astro.props;

const SITE_URL = 'https://modularnisistemi.com';

const sectionPath = '/inox-sistemi-odvodnjavanja/';

const pagePath = `${sectionPath}${product.slug}/`;

const canonical = `${SITE_URL}${pagePath}`;

const others = inoxProducts.filter((p) => p.slug !== product.slug);

const allForms = inoxProducts;

// Isti novi 16:9 renderi za hero i interaktivni izbor svih pet geometrija.

const grayImage = (src: string) => src.replace(/(?:-siva)?(\.[^./?#]+)([?#].*)?$/i, '-siva$1$2');

const heroImages: Record<string, string> = {

  'ravni-modularni-inox-kanal': '/images/engineering/hero-inox-ravna-16x9.webp',

  'lucni-inox-kanal': '/images/engineering/hero-inox-lucna-16x9.webp',

  'kruzni-inox-kanal': '/images/engineering/hero-inox-kruzna-16x9.webp',

  'elipsasti-inox-kanal': '/images/engineering/hero-inox-elipsasta-16x9.webp',

  's-forma-kanalica': '/images/engineering/hero-inox-s-forma-16x9.webp',

};

const productImage = heroImages[product.slug] ?? grayImage(product.image);

const modelImage = productImage;

const shape = product.slug.toLowerCase();

const imageStory = shape.includes('s-form')

  ? { title: 'Povezane krivine.', accent: 'Jedna celina.', text: 'S-forma povezuje promene pravca u neprekidnu liniju odvodnjavanja.' }

  : shape.includes('elips')

  ? { title: 'Izdužena forma.', accent: 'Zaobljena linija.', text: 'Elipsasta kanalica prati zatvorenu konturu prostora, sa geometrijom i dimenzijama na zahtev.' }

  : shape.includes('kruzn')

  ? { title: 'Kružna forma.', accent: 'Celovito rešenje.', text: 'Kontinualna kružna linija odvodnjavanja oko centralnih elemenata prostora.' }

  : shape.includes('lucn')

  ? { title: 'Linija koja', accent: 'prati luk.', text: 'Lučna kanalica prati zakrivljene ivice i povezuje odvodnjavanje sa oblikom prostora.' }

  : { title: 'Kvalitet u svakom', accent: 'detalju.', text: 'Ravna linija, brušeni inox i podesive stope za precizno uklapanje u prostor.' };

// Jedna matrica naziva za svih pet kanalica. Zamena dokumenta istim imenom

// ne zahteva nikakvu naknadnu izmenu Astro komponente.

const slugKey = product.slug.toLocaleLowerCase('sr-Latn-RS');

const technicalSheetPrefix = slugKey.includes('s-form') ? 's-forma'

  : slugKey.includes('elips') ? 'elipsasta-kanalica'

  : slugKey.includes('kruzn') ? 'kruzni-kanalica'

  : slugKey.includes('lucn') ? 'lucni-kanalica'

  : 'ravna-kanalica';

const technicalSheetImage = `/images/inox/${technicalSheetPrefix}-tehnicki-list.webp`;

const technicalSheetPdf = slugKey.includes('ravni') ? '/inox/ravna-inox-kanalica-tehnicki-list.pdf' : `/inox/${technicalSheetPrefix}-tehnicki-list.pdf`;

const breadcrumbSchema = {

  '@context': 'https://schema.org',

  '@type': 'BreadcrumbList',

  itemListElement: [

    { '@type': 'ListItem', position: 1, name: 'Početna', item: `${SITE_URL}/` },

    { '@type': 'ListItem', position: 2, name: 'Inox sistemi odvodnjavanja', item: `${SITE_URL}${sectionPath}` },

    { '@type': 'ListItem', position: 3, name: product.name, item: canonical },

  ],

};

---

<BaseLayout title={product.metaTitle} description={product.metaDescription} canonical={canonical} ogImage={productImage}>

  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} /></Fragment>

  <div class="inox-page">

    <section class="hero">

      <div class="wrap hero-grid">

        <div class="hero-copy">

          <nav class="crumbs" aria-label="Putanja"><a href="/">Početna</a><span>/</span><a href={sectionPath}>Inox odvodnjavanje</a><span>/</span><span aria-current="page">{product.name}</span></nav>

          <div class="eyebrow"><i></i> MODULARNI SISTEMI / PREMIUM ENGINEERING</div>

          <div class="model">INOX / MODEL {product.number}</div>

          <h1>{product.h1[0]} <em>{product.h1[1]}</em></h1>

          <p class="lead">{product.lead}</p>

          <div class="hero-actions"><a class="button primary" href={PROJECT_URL}>Pošaljite upit <span>↗</span></a><a class="button outline" href="#tehnicki-list">Tehnički list <span>↓</span></a></div>

          <div class="hero-foot"><span>OBLIK. FUNKCIJA. KONSTRUKCIJA.</span><span>MS / {product.number}</span></div>

        </div>

        <div class="hero-scene">

          <img src={productImage} alt={product.alt} fetchpriority="high" decoding="async" />

          <div class="scene-story">

            <div class="eyebrow"><i></i> FORMA / KONSTRUKCIJA</div>

            <h2>{imageStory.title}<br /><em>{imageStory.accent}</em></h2>

            <p>{imageStory.text}</p>

          </div>

        </div>

      </div>

    </section>

    <section class="technical" id="tehnicki-list">

      <div class="wrap">

        <div class="section-top">

          <div><div class="eyebrow"><i></i> DOKUMENTACIJA / INOX</div><h2>Tehnički list. <em>Svaki detalj.</em></h2></div>

          <p>Pregledajte tehnički list direktno na stranici, uvećajte detalje ili preuzmite PDF.</p>

        </div>

        <button class="sheet-preview" type="button" data-sheet-open aria-label={`Otvorite uvećani tehnički list: ${product.name}`}>

          <img src={technicalSheetImage} alt={`Tehnički list — ${product.name}`} loading="lazy" decoding="async" />

          <span class="sheet-preview-caption"><span>POGLEDAJTE TEHNIČKI LIST</span><strong>UVEĆAJTE <span aria-hidden="true">↗</span></strong></span>

        </button>

        <div class="sheet-download-bar">

          <div><span>DOKUMENT / {product.number}</span><strong>{product.name}</strong></div>

          <a class="button primary" href={technicalSheetPdf} download>Preuzmite tehnički list / PDF <span aria-hidden="true">↓</span></a>

        </div>

      </div>

    </section>

    <section class="overview" id="specifikacija">

      <div class="wrap">

        <div class="section-top"><div><div class="eyebrow"><i></i> INOX / KONSTRUKCIJA</div><h2>Forma koja prati <em>zadatak.</em></h2></div><p>Precizna konstrukcija i geometrija prilagođena konkretnom prostoru. Od pojedinačnog elementa do složenijeg sistema.</p></div>

        <div class="overview-grid">

          <div class="facts-panel"><div class="facts-head">TEHNIČKA OSNOVA <span>01 / 04</span></div><div class="facts-list"><div><small>MATERIJAL</small><strong>INOX AISI 304 / 316</strong></div><div><small>DEBLJINA LIMA</small><strong>2 mm</strong></div><div><small>GEOMETRIJA I DIMENZIJE</small><strong>Na zahtev</strong></div><div><small>IZRADA</small><strong>Prema usaglašenom rešenju</strong></div></div><a href="#tehnicki-list">Pregledajte tehničku dokumentaciju <span>↗</span></a></div>

          <div class="description-panel"><span class="overline">MODEL / {product.number}</span><h3>{product.name}</h3><p>{product.usage}</p><div class="fine-line"></div><div class="mini-points">{product.features.slice(0,3).map((f,i)=><div><span>0{i+1}</span><div><b>{f.title}</b><small>{f.text}</small></div></div>)}</div></div>

        </div>

      </div>

    </section>

    <section class="models"><div class="wrap"><div class="section-top"><div><div class="eyebrow"><i></i> INOX / GEOMETRIJE</div><h2>Različite forme. <em>Jedan princip.</em></h2></div><p>Pređite mišem preko naziva za trenutni pregled. Klikom otvorite stranicu izabranog modela.</p></div><div class="model-showcase" data-model-showcase><a class="model-photo" href={`${sectionPath}${product.slug}/`} data-model-link aria-label={`Pogledajte ${product.name}`}><img src={modelImage} alt={product.alt} data-model-image loading="lazy"/><span class="model-photo-bottom"><strong data-model-title>{product.name}</strong><b>↗</b></span></a><div class="model-menu"><div class="menu-caption">IZABERITE GEOMETRIJU <span>01 — 05</span></div>{allForms.map((item,i)=><a class:list={['model-option',{active:item.slug===product.slug}]} data-model-item data-image={heroImages[item.slug] ?? grayImage(item.image)} data-alt={item.alt} data-title={item.name} data-href={`${sectionPath}${item.slug}/`} href={`${sectionPath}${item.slug}/`} aria-label={`Otvorite ${item.name}`}><span class="model-option-number">{String(i+1).padStart(2,'0')}</span><strong>{item.name}</strong><span class="option-link" aria-hidden="true">↗</span></a>)}</div></div></div></section>

    <section class="cta"><div class="wrap cta-grid"><div><div class="eyebrow"><i></i> VAŠA IDEJA JE DOBAR POČETAK</div><h2>Imate geometriju?<br/><em>Razradimo rešenje.</em></h2><p>Fotografija, skica ili dimenzije dovoljni su za početak razgovora.</p></div><div class="cta-actions"><a class="button primary" href={PROJECT_URL}>Pošaljite upit <span>↗</span></a><a href="mailto:kontakt@modularnisistemi.com">kontakt@modularnisistemi.com <span>↗</span></a></div></div></section>

    <dialog class="sheet-modal" data-sheet-dialog aria-label={`Pregled tehničkog lista — ${product.name}`}>

      <div class="sheet-modal-toolbar">

        <span>TEHNIČKI LIST / {product.name}</span>

        <div class="sheet-modal-controls">

          <button type="button" data-sheet-minus aria-label="Umanji prikaz">−</button>

          <output data-sheet-percent aria-live="off">100%</output>

          <button type="button" data-sheet-plus aria-label="Uvećaj prikaz">+</button>

          <button type="button" data-sheet-reset aria-label="Vrati na početnu veličinu">↺</button>

          <button type="button" class="sheet-modal-close" data-sheet-close aria-label="Zatvori tehnički list">✕</button>

        </div>

      </div>

      <div class="sheet-modal-scroll" data-sheet-scroll tabindex="0" aria-label="Tehnički list — pomerajte prikaz nakon zumiranja">

        <div class="sheet-zoom-stage" data-sheet-stage>

          <img src={technicalSheetImage} alt={`Tehnički list u punoj veličini — ${product.name}`} data-sheet-zoom-image draggable="false" loading="lazy" />

        </div>

      </div>

      <div class="sheet-modal-footer"><span>Točkić za pomeranje · Ctrl + točkić za zum · Esc za izlaz</span><a href={technicalSheetPdf} download>PREUZMITE PDF ↓</a></div>

    </dialog>

  </div>

</BaseLayout>

<script>

 function setupInoxModels(){

  document.querySelectorAll<HTMLElement>('[data-model-showcase]').forEach((root)=>{

   if(root.dataset.initialized==='true')return;root.dataset.initialized='true';

   const image=root.querySelector<HTMLImageElement>('[data-model-image]');const title=root.querySelector<HTMLElement>('[data-model-title]');const link=root.querySelector<HTMLAnchorElement>('[data-model-link]');

   const items=Array.from(root.querySelectorAll<HTMLElement>('[data-model-item]'));

   const select=(item:HTMLElement)=>{if(!image||!title||!link)return;const next=item.dataset.image;if(!next)return;

    image.src=next;image.alt=item.dataset.alt||'';title.textContent=item.dataset.title||'';link.href=item.dataset.href||'#';link.setAttribute('aria-label',`Pogledajte ${item.dataset.title||'model'}`);

    items.forEach(el=>{const active=el===item;el.classList.toggle('active',active);if(active)el.setAttribute('aria-current','true');else el.removeAttribute('aria-current');});};

   items.forEach(item=>{const button=item;button.addEventListener('pointerenter',(ev:PointerEvent)=>{if(ev.pointerType==='mouse'||ev.pointerType==='pen')select(item)});button.addEventListener('focus',()=>select(item));});

  });

 }

 setupInoxModels();document.addEventListener('astro:page-load',setupInoxModels);

 function setupTechnicalViewer(){

  const dialog=document.querySelector<HTMLDialogElement>('[data-sheet-dialog]');

  const opener=document.querySelector<HTMLButtonElement>('[data-sheet-open]');

  if(!dialog||!opener||dialog.dataset.initialized==='true')return;

  dialog.dataset.initialized='true';

  const photo=dialog.querySelector<HTMLImageElement>('[data-sheet-zoom-image]');

  const scroll=dialog.querySelector<HTMLElement>('[data-sheet-scroll]');

  const stage=dialog.querySelector<HTMLElement>('[data-sheet-stage]');

  const output=dialog.querySelector<HTMLOutputElement>('[data-sheet-percent]');

  if(!photo||!scroll||!stage||!output)return;

  let zoom=1, fitWidth=0, fitHeight=0;

  const refreshFit=()=>{

    if(!dialog.open||!photo.naturalWidth||!photo.naturalHeight)return;

    const availableWidth=Math.max(100,scroll.clientWidth-24);

    const availableHeight=Math.max(100,scroll.clientHeight-24);

    const ratio=Math.min(availableWidth/photo.naturalWidth,availableHeight/photo.naturalHeight);

    fitWidth=photo.naturalWidth*ratio;

    fitHeight=photo.naturalHeight*ratio;

    render();

  };

  const render=()=>{

    if(!fitWidth||!fitHeight)return;

    const imageWidth=Math.round(fitWidth*zoom),imageHeight=Math.round(fitHeight*zoom);

    stage.style.width=`${Math.max(scroll.clientWidth,imageWidth+24)}px`;

    stage.style.height=`${Math.max(scroll.clientHeight,imageHeight+24)}px`;

    photo.style.width=`${imageWidth}px`;

    photo.style.height=`${imageHeight}px`;

    output.textContent=`${Math.round(zoom*100)}%`;

  };

  const setZoom=(value:number)=>{

    const midX=(scroll.scrollLeft+scroll.clientWidth/2)/(scroll.scrollWidth||1);

    const midY=(scroll.scrollTop+scroll.clientHeight/2)/(scroll.scrollHeight||1);

    zoom=Math.min(5,Math.max(.5,Math.round(value*10)/10));

    render();

    scroll.scrollLeft=Math.max(0,midX*scroll.scrollWidth-scroll.clientWidth/2);

    scroll.scrollTop=Math.max(0,midY*scroll.scrollHeight-scroll.clientHeight/2);

  };

  opener.addEventListener('click',()=>{

    zoom=1;

    dialog.showModal();

    requestAnimationFrame(()=>{refreshFit();scroll.scrollTo(0,0)});

  });

  photo.addEventListener('load',refreshFit);

  dialog.querySelector('[data-sheet-close]')?.addEventListener('click',()=>dialog.close());

  dialog.querySelector('[data-sheet-plus]')?.addEventListener('click',()=>setZoom(zoom+.25));

  dialog.querySelector('[data-sheet-minus]')?.addEventListener('click',()=>setZoom(zoom-.25));

  dialog.querySelector('[data-sheet-reset]')?.addEventListener('click',()=>{zoom=1;refreshFit();scroll.scrollTo(0,0)});

  // Običan točkić pomera dokument. Ctrl + točkić uvećava.

  scroll.addEventListener('wheel',(e:WheelEvent)=>{if(e.ctrlKey){e.preventDefault();setZoom(zoom+(e.deltaY<0?.2:-.2))}},{passive:false});

  const observer=new ResizeObserver(()=>refreshFit());observer.observe(scroll);

  let pinchStart=0,pinchZoom=1;

  const distance=(a:Touch,b:Touch)=>Math.hypot(a.clientX-b.clientX,a.clientY-b.clientY);

  scroll.addEventListener('touchstart',(e:TouchEvent)=>{if(e.touches.length===2){pinchStart=distance(e.touches[0],e.touches[1]);pinchZoom=zoom}},{passive:true});

  scroll.addEventListener('touchmove',(e:TouchEvent)=>{if(e.touches.length===2&&pinchStart){e.preventDefault();setZoom(pinchZoom*distance(e.touches[0],e.touches[1])/pinchStart)}},{passive:false});

  scroll.addEventListener('touchend',()=>pinchStart=0,{passive:true});

 }

 setupTechnicalViewer();document.addEventListener('astro:page-load',setupTechnicalViewer);

</script>

<style>

.inox-page{--dark:#061925;--panel:#0b2332;--orange:#ff6900;--pale:#eff3f4;color:#102331;background:var(--pale);font-family:Manrope,Montserrat,system-ui,sans-serif;overflow-x:clip}

.inox-page *{box-sizing:border-box}.inox-page :is(h1,h2,h3,p,figure){margin:0}.inox-page a{text-decoration:none}.inox-page :is(a,button):focus-visible{outline:2px solid var(--orange);outline-offset:3px}

.inox-page em{font-style:normal;color:var(--orange)}.wrap{width:min(1240px,calc(100% - 48px));margin-inline:auto}.eyebrow{display:flex;align-items:center;gap:11px;font-size:10px;font-weight:800;letter-spacing:.16em;color:var(--orange)}.eyebrow i{width:20px;height:2px;background:var(--orange);display:block;flex:none}

.hero{background:linear-gradient(115deg,#071a27,#06131e);color:white;border-bottom:1px solid #203542}.hero-grid{display:grid;grid-template-columns:1fr 1.06fr;align-items:center;gap:50px;padding-block:49px 44px;min-height:470px}.crumbs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:35px;color:#8a9da9;font-size:10px}.crumbs a{color:inherit}.crumbs a:hover{color:white}.model{font-size:10px;letter-spacing:.2em;color:#94a7b2;margin-top:29px}.hero h1{margin-top:13px;font-size:clamp(39px,4.7vw,65px);line-height:1.04;letter-spacing:-.055em;font-weight:800;max-width:520px}.lead{font-size:14px;color:#b7c6cf;line-height:1.7;max-width:485px;margin-top:18px!important}.hero-actions{display:flex;gap:10px;margin-top:26px}.button{min-height:42px;padding:0 17px;display:inline-flex;align-items:center;justify-content:space-between;gap:25px;font-size:11px;font-weight:800;white-space:nowrap}.button span{font-size:16px}.primary{background:var(--orange);color:#071925}.primary:hover{background:#ff852d}.outline{border:1px solid #526572;color:white}.outline:hover{background:#172e3a}.hero-foot{margin-top:39px;padding-top:13px;border-top:1px solid #29404b;display:flex;justify-content:space-between;font-size:9px;letter-spacing:.09em;color:#8ca0ac}.hero-scene{height:340px;position:relative;overflow:hidden;background:#252728;border:1px solid #30404a}.hero-scene img{width:100%;height:100%;object-fit:cover;object-position:center;display:block}.hero-scene:after{content:'';position:absolute;inset:40% 0 0;background:linear-gradient(transparent,rgba(2,12,20,.75));pointer-events:none}.scene-top,.scene-bottom{position:absolute;z-index:2;left:18px;right:18px;display:flex;justify-content:space-between;align-items:center}.scene-top{top:16px;color:#dee8e9;font-size:9px;letter-spacing:.13em}.scene-bottom{bottom:18px;color:white;font-size:17px;font-weight:800}.scene-bottom span:last-child{color:var(--orange)}

.section-top{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:23px}.section-top h2{margin-top:12px;font-size:clamp(29px,3.4vw,42px);line-height:1.08;letter-spacing:-.045em}.section-top>p{max-width:365px;color:#647783;font-size:13px;line-height:1.7}.overview{padding:60px 0 64px}.overview-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.facts-panel{background:#081e2c;color:white;padding:24px 26px;display:flex;flex-direction:column}.facts-head,.menu-caption{display:flex;justify-content:space-between;font-size:10px;font-weight:800;letter-spacing:.13em;color:#a6bac6;padding-bottom:16px;border-bottom:1px solid #2a4453}.facts-head span{color:var(--orange)}.facts-list{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:11px}.facts-list>div{padding:16px 10px 18px 0;border-bottom:1px solid #29424f}.facts-list small{display:block;color:#93a8b5;font-size:10px;letter-spacing:.1em}.facts-list strong{display:block;font-size:17px;margin-top:7px}.facts-panel>a{display:flex;justify-content:space-between;color:white;font-size:12px;font-weight:700;margin-top:auto;padding-top:21px}.facts-panel>a span{color:var(--orange)}.description-panel{padding:26px 30px;background:#fff;border:1px solid #d7e0e5}.overline{font-size:10px;letter-spacing:.13em;font-weight:800;color:var(--orange)}.description-panel h3{font-size:25px;letter-spacing:-.04em;margin-top:11px}.description-panel>p{color:#687984;font-size:13px;line-height:1.7;margin-top:10px}.fine-line{height:1px;background:#e4e9ec;margin:18px 0}.mini-points{display:grid;gap:11px}.mini-points>div{display:flex;gap:14px}.mini-points>div>span{font-size:11px;color:var(--orange);font-weight:800}.mini-points b{font-size:12px;display:block}.mini-points small{font-size:11px;line-height:1.5;color:#687984;display:block;margin-top:3px}

.engineering{padding:60px 0 65px;background:#061925;color:white}.section-top.light>p{color:#9fb3bf}.detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.detail-grid figure{min-width:0;background:#102b3a;border:1px solid #29414f}.detail-grid img{width:100%;height:220px;object-fit:cover;display:block}.detail-grid figcaption{padding:13px 16px}.detail-grid figcaption small{font-size:9px;color:var(--orange);display:block;font-weight:800;letter-spacing:.1em}.detail-grid figcaption strong{display:block;font-size:13px;margin-top:5px}

