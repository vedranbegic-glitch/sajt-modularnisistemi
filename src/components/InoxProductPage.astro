---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  inoxProducts,
  commonFacts,
  PHONE_DISPLAY,
  PHONE_HREF,
  PROJECT_URL,
} from '../data/inoxProducts';
import type { InoxProduct } from '../data/inoxProducts';
interface Props {
  product: InoxProduct;
}
const { product } = Astro.props;
const SITE_URL = 'https://modularnisistemi.com';
const sectionPath = '/inox-sistemi-odvodnjavanja/';
const pagePath = `${sectionPath}${product.slug}/`;
const canonical = `${SITE_URL}${pagePath}`;
const others = inoxProducts.filter((p) => p.slug !== product.slug);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Početna', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Inox sistemi odvodnjavanja', item: `${SITE_URL}${sectionPath}` },
    { '@type': 'ListItem', position: 3, name: product.name, item: canonical },
  ],
};
---
<BaseLayout
  title={product.metaTitle}
  description={product.metaDescription}
  canonical={canonical}
  ogImage={product.image}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <div class="product-page">
    <!-- HERO -->
    <section class="hero">
      <div class="hero__content wrap">
        <div class="hero__copy">
          <nav class="crumbs" aria-label="Putanja">
            <a href="/">Početna</a>
            <span aria-hidden="true">/</span>
            <a href={sectionPath}>Inox sistemi odvodnjavanja</a>
            <span aria-hidden="true">/</span>
            <strong aria-current="page">{product.name}</strong>
          </nav>
          <div class="eyebrow">
            <span></span>
            Inox odvodnjavanje · Po meri
          </div>
          <div class="hero__series">MODEL / {product.number} <span>·</span> INOX SISTEMI</div>
          <h1>{product.h1[0]} <em>{product.h1[1]}</em></h1>
          <p class="hero__lead">{product.lead}</p>
          <p class="hero__usage">
            <b>Karakteristična primena</b>
            {product.usage}
          </p>
          <div class="hero__actions">
            <a class="btn btn--orange" href={PROJECT_URL}>
              Pošaljite upit za ovaj model <b>→</b>
            </a>
            <a class="btn btn--ghost" href={PHONE_HREF}>{PHONE_DISPLAY}</a>
          </div>
          <div class="hero__facts">
            {commonFacts.map((fact) => (
              <div>
                <strong>{fact.value}</strong>
                <span>{fact.label}</span>
              </div>
            ))}
          </div>
        </div>
        <figure class="hero__media">
          <div class="hero__image">
            <img src={product.image} alt={product.alt} fetchpriority="high" decoding="async" />
          </div>
          <figcaption>
            <span>Konfiguracija po nacrtu</span>
            <b>MODEL {product.number}</b>
          </figcaption>
        </figure>
      </div>
    </section>
    <div class="detail-bridge" aria-label="Naš pristup">
      <div class="wrap detail-bridge__inner">
        <span>PRVO CRTEŽ. PA ONDA PROIZVOD.</span>
        <p>Oblik i detalje razrađujemo pre izrade, prema dogovorenim merama i uslovima prostora.</p>
        <a href="#specifikacija">Pogledajte karakteristike <b aria-hidden="true">↘</b></a>
      </div>
    </div>
    <!-- SPECIFIKACIJA -->
    <section class="spec" id="specifikacija">
      <div class="wrap spec__grid">
        <div class="spec__main">
          <div class="eyebrow">
            <span></span>
            Specifikacija izrade
          </div>
          <h2>Tehničke karakteristike <em>i ugradnja.</em></h2>
          <div class="spec__text">
            {product.specIntro.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <div class="info-boxes">
            <div class="info-box">
              <span class="info-box__label">Materijal i završna obrada</span>
              <p>{product.material}</p>
            </div>
            <div class="info-box">
              <span class="info-box__label">Spajanje i nivelacija</span>
              <p>{product.joining}</p>
            </div>
          </div>
        </div>
        <div class="spec__features">
          {product.features.map((feature, index) => (
            <article class="feature">
              <span class="feature__tag">0{index + 1} / {feature.tag}</span>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <!-- TEHNIČKI DETALJI + PRIMENA -->
    <section class="showcase">
      <div class:list={['wrap showcase__grid', { 'showcase__grid--single': !product.application }]}>
        <article class="show-card show-card--detail">
          <img src={product.detail.image} alt={product.detail.alt} loading="lazy" />
          <div class="show-card__shade"></div>
          <div class="show-card__content">
            <div class="eyebrow">
              <span></span>
              Tehnički detalji
            </div>
            <h2>Kvalitet u svakom <em>detalju.</em></h2>
            <p>{product.detail.text}</p>
            <div class="show-card__facts">
              {commonFacts.map((fact) => (
                <span><b>{fact.value}</b> {fact.label}</span>
              ))}
            </div>
          </div>
        </article>
        {product.application && (
          <article class="show-card show-card--application">
            <img src={product.application.image} alt={product.application.alt} loading="lazy" />
            <div class="show-card__shade"></div>
            <div class="show-card__content">
              <div class="eyebrow">
                <span></span>
                Primena u prostoru
              </div>
              <h2>{product.application.title}</h2>
              <p class="show-card__meta">{product.application.meta}</p>
              <a class="btn btn--orange" href={PROJECT_URL}>
                Pošaljite upit <b>→</b>
              </a>
            </div>
          </article>
        )}
      </div>
    </section>
    <!-- OSTALI MODELI -->
    <section class="others">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow">
              <span></span>
              Povezani sistemi
            </div>
            <h2>Ostali inox <em>drenažni modeli.</em></h2>
          </div>
          <p>Uporedite ostale oblike i izaberite formu koja odgovara vašem prostoru.</p>
        </div>
        <div class="others__grid">
          {others.map((item) => (
            <a href={`${sectionPath}${item.slug}/`} class="form-card">
              <div class="form-card__image">
                <img src={item.image} alt={item.alt} loading="lazy" />
                <span>{item.number}</span>
              </div>
              <div class="form-card__body">
                <div class="form-card__tag">{item.short}</div>
                <h3>{item.name}</h3>
                <span class="form-card__link">Više o proizvodu <b>→</b></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
    <!-- CTA -->
    <section class="cta">
      <img
        src="/images/inox/lucni-inox-kanal-sa-perforiranom-resetkom-gradski-trg.webp"
        alt="Lučni inox kanal sa perforiranom rešetkom na gradskom trgu"
        loading="lazy"
      />
      <div class="cta__shade"></div>
      <div class="wrap cta__inner">
        <div>
          <div class="eyebrow">
            <span></span>
            Upit za vaš prostor
          </div>
          <h2>Zanima vas <em>{product.name}</em>?</h2>
          <p>
            Pošaljite nam skicu, dimenzije ili jednostavno opišite šta vam je potrebno.
            Zajedno ćemo razmotriti odgovarajuće rešenje.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--orange" href={PROJECT_URL}>
            Pošaljite upit <b>→</b>
          </a>
          <a class="btn btn--ghost" href={PHONE_HREF}>{PHONE_DISPLAY}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .product-page {
    --navy: #06131f;
    --navy2: #0b1d2b;
    --orange: #ff6900;
    --orange-hover: #e85e00;
    --line: #dce2e7;
    --muted: #64717c;
    position: relative;
    z-index: 1;
    overflow-x: clip;
    background: #f6f7f9;
    color: #07111e;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .product-page h1,
  .product-page h2,
  .product-page h3,
  .product-page p,
  .product-page figure {
    margin: 0;
  }
  .product-page h1 em,
  .product-page h2 em {
    font-style: normal;
    color: var(--orange);
  }
  .wrap {
    width: min(1440px, calc(100% - 48px));
    margin-inline: auto;
  }
  /* ========== ZAJEDNIČKI ELEMENTI ========== */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--orange);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .eyebrow span {
    display: inline-block;
    width: 20px;
    height: 1.5px;
    background: var(--orange);
    flex-shrink: 0;
  }
  .btn {
    min-height: 48px;
    padding: 0 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: all 0.25s ease;
  }
  .btn b {
    font-size: 15px;
    font-weight: 600;
  }
  .btn--orange {
    background: var(--orange);
    color: #fff;
  }
  .btn--orange:hover {
    background: var(--orange-hover);
    transform: translateY(-2px);
  }
  .btn--ghost {
    border: 1px solid rgba(255, 255, 255, 0.45);
    color: #fff;
    background: rgba(0, 0, 0, 0.12);
  }
  .btn--ghost:hover {
    background: #fff;
    color: var(--navy);
    border-color: #fff;
  }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 36px;
    margin-bottom: 32px;
  }
  .section-head h2 {
    margin-top: 8px;
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: #07111e;
  }
  .section-head > p {
    max-width: 380px;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
    padding-bottom: 4px;
  }
  /* ========== HERO ========== */
  .hero {
    position: relative;
    color: #fff;
    isolation: isolate;
    background:
      radial-gradient(900px 480px at 85% 20%, rgba(255, 105, 0, 0.14), transparent 70%),
      linear-gradient(135deg, #06131f 0%, #0b1d2b 100%);
  }
  .hero__content {
    padding-top: 130px;
    padding-bottom: 72px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    gap: 64px;
    align-items: center;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    color: #94a3ad;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .crumbs a {
    color: #94a3ad;
    text-decoration: none;
    transition: color 0.2s;
  }
  .crumbs a:hover {
    color: #fff;
  }
  .crumbs strong {
    color: #fff;
    font-weight: 700;
  }
  .hero h1 {
    margin-top: 20px;
    max-width: 760px;
    font-size: clamp(38px, 4.6vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 800;
    color: #fff;
  }
  .hero__lead {
    margin-top: 20px;
    max-width: 620px;
    color: #d4dee4;
    font-size: 15px;
    line-height: 1.65;
  }
  .hero__usage {
    margin-top: 24px;
    max-width: 620px;
    padding: 14px 18px;
    border-left: 2px solid var(--orange);
    background: rgba(255, 255, 255, 0.05);
    color: #d4dee4;
    font-size: 13.5px;
    line-height: 1.55;
  }
  .hero__usage b {
    display: block;
    margin-bottom: 4px;
    color: var(--orange);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 700px;
    margin-top: 36px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .hero__facts div {
    display: flex;
    flex-direction: column;
    padding: 16px 14px 0 0;
  }
  .hero__facts div + div {
    padding-left: 16px;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }
  .hero__facts strong {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .hero__facts span {
    margin-top: 4px;
    color: #94a3ad;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }
  .hero__media {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    overflow: hidden;
    background: #0a1620;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
  }
  .hero__image {
    aspect-ratio: 5 / 4;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
  }
  .hero__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .hero__media figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 18px;
    color: #94a3ad;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero__media figcaption b {
    color: var(--orange);
    font-weight: 700;
  }
  /* ========== SPECIFIKACIJA ========== */
  .spec {
    padding: 80px 0;
    background: #f6f7f9;
    scroll-margin-top: 80px;
  }
  .spec__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .spec__main h2 {
    margin-top: 10px;
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: #07111e;
  }
  .spec__text {
    margin-top: 22px;
    display: grid;
    gap: 14px;
    max-width: 560px;
  }
  .spec__text p {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.65;
  }
  .info-boxes {
    margin-top: 28px;
    display: grid;
    gap: 12px;
    max-width: 560px;
  }
  .info-box {
    padding: 16px 18px;
    background: #fff;
    border: 1px solid var(--line);
    border-left: 2px solid var(--orange);
    border-radius: 3px;
  }
  .info-box__label {
    display: block;
    margin-bottom: 6px;
    color: var(--orange);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .info-box p {
    color: #3d4a55;
    font-size: 13.5px;
    line-height: 1.6;
  }
  .spec__features {
    display: grid;
    gap: 14px;
  }
  .feature {
    padding: 22px 24px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 4px 16px rgba(6, 19, 31, 0.04);
    transition: all 0.3s ease;
  }
  .feature:hover {
    transform: translateY(-3px);
    border-color: var(--orange);
    box-shadow: 0 16px 34px rgba(6, 19, 31, 0.1);
  }
  .feature__tag {
    display: block;
    color: var(--orange);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .feature h3 {
    margin-top: 8px;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #07111e;
  }
  .feature p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.6;
  }
  /* ========== TEHNIČKI DETALJI + PRIMENA ========== */
  .showcase {
    background: var(--navy);
    padding: 70px 0;
  }
  .showcase__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .showcase__grid--single {
    grid-template-columns: 1fr;
  }
  .show-card {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    background: #0a1620;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
  }
  .show-card > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  .show-card:hover > img {
    transform: scale(1.03);
  }
  .show-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(4, 14, 23, 0.02) 0%,
      rgba(4, 14, 23, 0.12) 30%,
      rgba(4, 14, 23, 0.88) 66%,
      rgba(4, 14, 23, 0.98) 100%
    );
  }
  .show-card__content {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 36px;
  }
  .show-card__content h2 {
    margin-top: 10px;
    max-width: 480px;
    font-size: clamp(28px, 2.8vw, 42px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: #fff;
    font-weight: 800;
  }
  .show-card__content > p {
    margin-top: 12px;
    max-width: 480px;
    color: #b8c4cb;
    font-size: 13.5px;
    line-height: 1.6;
  }
  .show-card__meta {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px !important;
    margin-bottom: 22px;
  }
  .show-card__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 560px;
    margin-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }
  .show-card__facts span {
    padding: 12px 12px 0 0;
    color: #a0b0b9;
    font-size: 11px;
    line-height: 1.4;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }
  .show-card__facts span:nth-child(2n) {
    padding-left: 12px;
    border-right: 0;
  }
  .show-card__facts span:nth-child(n + 3) {
    margin-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .show-card__facts b {
    display: block;
    margin-bottom: 2px;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }
  /* ========== OSTALI MODELI ========== */
  .others {
    padding: 70px 0 80px;
    background: #eef1f4;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .others__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .form-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #fff;
    color: var(--navy);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 4px 16px rgba(6, 19, 31, 0.04);
    transition: all 0.3s ease;
  }
  .form-card:hover {
    transform: translateY(-6px);
    border-color: var(--orange);
    box-shadow: 0 20px 40px rgba(6, 19, 31, 0.12);
  }
  .form-card__image {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    background: #fff;
    border-bottom: 1px solid #edf1f5;
  }
  .form-card__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .form-card:hover img {
    transform: scale(1.08);
  }
  .form-card__image span {
    position: absolute;
    left: 12px;
    top: 12px;
    z-index: 2;
    padding: 3px 8px;
    color: #fff;
    background: var(--orange);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    border-radius: 2px;
    box-shadow: 0 2px 6px rgba(255, 105, 0, 0.35);
  }
  .form-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 18px 16px 20px;
  }
  .form-card__tag {
    color: var(--orange);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .form-card h3 {
    margin-top: 6px;
    font-size: 14.5px;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #07111e;
  }
  .form-card__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
    padding-top: 16px;
    color: #55636e;
